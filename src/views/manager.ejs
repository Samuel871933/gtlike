<%- include('partials/header', { title: 'Gestionnaire de compte' }) %>
<%
  // Gestionnaire de compte (AccountManagerService), comme sur Guerre Tribale mais sans minimum de villages : un onglet
  // par gestionnaire. Les actions demandent le premium ; sans lui, la page présente le gestionnaire.
  const vid = ctx.village.id;
  const m = `/village/${vid}/manager`;
  // Onglets : ceux qu'on peut mettre en favori (helpers.js, FAVORITE_PAGES), le premier étant la page par défaut.
  const TABS = favoritePage('manager', ctx.cfg).tabs;
  // Villages : ses sous-onglets (Construction, Troupes, Forge) gardent l'onglet actif et son étoile de favori.
  const mainTab = tab === 'units' || tab === 'forge' ? 'buildings' : tab;
  const tabs = segMenu(TABS.map((t) => [`/village/${vid}/${t.path}`, t.name, mainTab === t.key]), { label: 'Gestionnaire de compte' });
  const starKey = favKey('manager', mainTab, ctx.cfg);
  const starTab = starKey.includes(':') ? starKey.split(':')[1] : null;
  const shopPremium = `/shop/item/premium?world=${encodeURIComponent(ctx.world.slug)}`;
  const csrf = `<input type="hidden" name="_csrf" value="${csrfToken}">`;
  // Pastilles d'état, comme l'aperçu du gestionnaire de GT : vert actif, jaune en pause, gris rien de prévu.
  const DOTS = { active: ['bg-[#4fa33a]', 'actif'], paused: ['bg-[#d9a520]', 'en pause'], none: ['bg-transparent border-dashed', 'rien de prévu'] };
  const dot = (state, label) => `<span class="inline-block size-3 rounded-full border border-black align-middle shadow-[1px_1px_0_#000] ${DOTS[state][0]}" title="${esc(label)} : ${DOTS[state][1]}" aria-label="${esc(label)} : ${DOTS[state][1]}"></span>`;
  const stateLabel = (state) => ({ active: 'Actif', paused: 'En pause', none: '—' })[state];
  const stateTag = (state) => state === 'active' ? '<span class="font-semibold text-olive-300">Actif</span>' : state === 'paused' ? '<span class="font-semibold text-gold-400">En pause</span>' : '<span class="text-parchment-600">—</span>';
  const unitsLine = (units) => Object.entries(units || {}).filter(([, n]) => n > 0).map(([id, n]) => `<span class="inline-flex items-center gap-1">${unitIcon(id, 'size-5 min-h-5 min-w-5')}${num(n)}</span>`).join(' ') || '<span class="text-parchment-600">—</span>';
  const disabled = premium ? '' : 'disabled';
  const h = { vid, m, csrf, dot, stateLabel, stateTag, unitsLine, disabled };
%>
<div class="flex flex-col gap-5">
  <%# En-tête comme les pages de bâtiment et les sceaux : vignette, titre, étoile des favoris (de l'onglet affiché), repères. %>
  <%- include('partials/content-header', {
    illustration: '/img/manager/account-manager.webp',
    title: 'Gestionnaire de compte',
    sub: 'Construit, recherche, recrute, envoie et équilibre tes ressources à ta place, même quand tu n’es pas connecté.',
    titleAction: favStar(vid, 'manager', favoriteBuildings(player, ctx).includes(starKey), csrfToken, 'size-8', starTab),
    aside: include('partials/manager-header-stats'),
  }) %>

  <section class="<%= ui.panel %>">
    <%- panelHead('Gestionnaire', tabs) %>
    <%# Onglets à liste de villages : filtrés par le groupe actif. %>
    <% if (['overview', 'buildings', 'units', 'forge', 'market'].includes(tab)) { %><%- include('partials/group-filter', { cls: tab === 'overview' || !premium ? '' : 'border-b-0' }) %><% } %>
    <% if (tab === 'overview' || !premium) { %>
    <div class="<%= ui.panelBody %>">
      <% if (tab === 'overview') { %>
        <p class="text-parchment-400">
          Le gestionnaire s’occupe de tes villages à ta place, même quand tu n’es pas connecté : il construit selon tes
          modèles, lance les recherches de la forge, recrute les troupes que tu veux, envoie tes ressources par routes commerciales et équilibre tes
          entrepôts. Il peut aussi te prévenir par e-mail des attaques. Il passe toutes les quelques minutes ; il ne
          contourne aucune règle (ressources, ferme, bâtiments requis) et n’utilise que les places de la file au prix normal.
        </p>
      <% } %>
      <% if (!premium) { %>
        <%- include('partials/premium-banner', {
          href: shopPremium, highlight: true, cls: tab === 'overview' ? '-mx-3 -mb-3' : '-m-3',
          title: 'Le gestionnaire de compte est inclus dans le premium.', detail: 'Constructions, recherches, recrutements, routes commerciales, réserve et alertes par e-mail, quel que soit ton nombre de villages · dès 30 Adartons',
        }) %>
      <% } %>
    </div>
    <% } %>
  </section>

  <%# Construction, Troupes et Forge : même vue, pour l'un ou l'autre gestionnaire. %>
  <% const which = { units: 'troops', forge: 'research' }[tab] || 'build'; %>
  <%- include(`partials/manager/${mainTab === 'buildings' ? 'buildings' : tab}`, { h, which }) %>
</div>
<%- include('partials/footer') %>
