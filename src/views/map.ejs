<%- include('partials/header', { title: 'Carte' }) %>
<%
  // Carte façon Guerre Tribale : cases de taille fixe (la taille choisie agrandit vraiment la carte), villages
  // chargés par secteurs de 20 × 20 et déplacement fluide (public/js/map.js). Rien n'est rechargé en naviguant.
  const vid = ctx.village.id;
  const TILE = 48;
  const MINI_CELL = 5;
  // Tailles et calques sont mémorisés sur le joueur : les liens n'ont besoin que du centre.
  const link = (x, y) => `/village/${vid}/map?x=${x}&y=${y}`;
  const REL_SWATCH = { own: 'bg-rel-own', tribe: 'bg-rel-tribe', ally: 'bg-rel-ally', nap: 'bg-rel-nap', enemy: 'bg-rel-enemy', other: 'bg-rel-other', barb: 'bg-rel-barb-dim' };
  const REL = Object.fromEntries(Object.entries(REL_SWATCH).map(([k, c]) => [k, [null, null, c]]));
  const legend = [['own', 'Tes villages'], ['tribe', 'Ta tribu'], ['ally', 'Alliés'], ['nap', 'PNA'], ['enemy', 'Ennemis'], ['other', 'Autres'], ['barb', 'Barbares']];
  const arrowBtn = 'map-controls absolute z-10 flex items-center justify-center border-2 border-black bg-night/80 text-gold-400 shadow-[2px_2px_0_#000] transition hover:bg-head-dark hover:text-parchment-100';
%>
<div class="flex flex-wrap items-end justify-between gap-2.5">
  <div>
    <div class="text-[13px] text-parchment-500">Carte du monde · <%= ctx.world.name %></div>
    <h1 class="m-0 font-display text-[28px] font-bold [text-shadow:2px_2px_0_#000,4px_4px_0_var(--color-blood-900)]" data-map-title>Continent <%= continent(cx, cy) %></h1>
  </div>
  <form method="get" class="flex items-center gap-1" data-map-goto>
    <span class="mr-2 text-[13px] text-parchment-500 tabular-nums max-sm:hidden" data-map-range></span>
    <label for="goto-x" class="text-[13px] text-parchment-400">Aller à</label>
    <input id="goto-x" name="x" type="text" inputmode="numeric" value="<%= cx %>" aria-label="Coordonnée x" class="<%= ui.inputSm %> w-[52px] tabular-nums">
    <span class="text-bronze-500">|</span>
    <input name="y" type="text" inputmode="numeric" value="<%= cy %>" aria-label="Coordonnée y" class="<%= ui.inputSm %> w-[52px] tabular-nums">
    <button class="<%= btn('dark', 'sm') %>">OK</button>
    <a href="<%= link(ctx.village.x, ctx.village.y) %>" class="<%= btn('dark', 'sm') %>" title="Centrer sur mon village" data-map-home>Centrer</a>
  </form>
</div>

<%# Deux colonnes, comme sur Guerre Tribale : à gauche la carte, ses marquages et ses calques ; à droite la mini-carte et les outils. %>
<div class="flex flex-wrap items-start gap-4" data-map-row>
  <div class="flex min-w-[min(100%,560px)] max-w-full flex-col gap-4" data-map-col>
    <%# Carte : cadre de taille × taille cases ; les cases sont dessinées et déplacées par map.js. %>
    <section class="<%= ui.panel %> relative max-w-full p-2">
      <div class="map-frame group/map relative select-none"<%- Object.entries(layers).filter(([, on]) => on).map(([k]) => ` data-layer-${k}`).join('') %>
           style="--tile:<%= TILE %>px" data-map data-size="<%= displaySize %>" data-tile="<%= TILE %>" data-cx="<%= cx %>" data-cy="<%= cy %>"
           data-me="<%= ctx.village.x %>|<%= ctx.village.y %>" data-sel="<%= sel ? `${sel.x}|${sel.y}` : '' %>" data-csrf="<%= csrfToken %>" data-spy="<%= spyCount %>">
        <div class="flex">
          <div class="h-[26px] w-9 shrink-0 border-r border-b border-black bg-night"></div>
          <div class="relative h-[26px] overflow-hidden border-b border-black bg-night" style="width:calc(var(--tile) * <%= displaySize %>)" data-map-ruler-x></div>
        </div>
        <div class="flex">
          <div class="relative w-9 shrink-0 overflow-hidden border-r border-black bg-night" style="height:calc(var(--tile) * <%= displaySize %>)" data-map-ruler-y></div>
          <div class="map-viewport relative cursor-grab overflow-hidden bg-map-edge touch-none active:cursor-grabbing" style="width:calc(var(--tile) * <%= displaySize %>);height:calc(var(--tile) * <%= displaySize %>)" data-map-viewport>
            <div class="absolute top-0 left-0 will-change-transform" data-map-plane></div>
            <div class="pointer-events-none absolute inset-0 shadow-[inset_0_0_50px_rgba(0,0,0,0.55)]"></div>
            <button type="button" class="<%= arrowBtn %> top-1 left-1/2 h-6 w-10 -translate-x-1/2" data-map-step="0,-1" aria-label="Vers le nord" title="Vers le nord"><%- icon('chevronUp', 'size-4', 2.6) %></button>
            <button type="button" class="<%= arrowBtn %> bottom-1 left-1/2 h-6 w-10 -translate-x-1/2" data-map-step="0,1" aria-label="Vers le sud" title="Vers le sud"><%- icon('chevronDown', 'size-4', 2.6) %></button>
            <button type="button" class="<%= arrowBtn %> top-1/2 left-1 h-10 w-6 -translate-y-1/2" data-map-step="-1,0" aria-label="Vers l’ouest" title="Vers l’ouest"><%- icon('chevronLeft', 'size-4', 2.6) %></button>
            <button type="button" class="<%= arrowBtn %> top-1/2 right-1 h-10 w-6 -translate-y-1/2" data-map-step="1,0" aria-label="Vers l’est" title="Vers l’est"><%- icon('chevronRight', 'size-4', 2.6) %></button>
            <button type="button" class="map-controls absolute top-1 right-1 z-10 <%= ui.iconBtnOn %>" data-map-center-home aria-label="Centrer sur mon village" title="Centrer sur mon village"><%- icon('center', 'size-3.5', 2.2) %></button>
          </div>
          <%# Infobulle au survol d'un village et menu d'actions au clic (remplis par map.js), hors de la zone découpée. %>
          <div class="pointer-events-none absolute z-[15] hidden w-max max-w-[min(460px,calc(100%-12px))] min-w-[280px] border-2 border-black bg-night text-[13px] shadow-[inset_0_0_0_1px_var(--color-bronze-500),4px_4px_0_#000]" data-map-tip>
            <div class="flex items-baseline justify-between gap-3 border-b border-bronze-500 bg-head-dark px-2.5 py-1.5">
              <b class="truncate font-display text-[15px] font-normal text-parchment-100" data-tip="name"></b>
              <span class="shrink-0 text-xs text-gold-400 tabular-nums"><span data-tip="coords"></span> <span class="text-parchment-400" data-tip="k"></span></span>
            </div>
            <dl class="grid grid-cols-[auto_minmax(0,1fr)] [&>*]:border-b [&>*]:border-bronze-900 [&>*]:px-2.5 [&>*]:py-1">
              <dt class="text-parchment-500">Points</dt><dd class="font-semibold tabular-nums" data-tip="points"></dd>
              <dt class="text-parchment-500">Propriétaire</dt><dd class="min-w-0"><span class="font-semibold" data-tip="owner"></span> <span class="text-parchment-400 tabular-nums" data-tip="ownerInfo"></span></dd>
              <dt class="text-parchment-500" data-tip-row="tribe">Tribu</dt><dd class="min-w-0" data-tip-row="tribe"><span class="font-semibold text-gold-200" data-tip="tribe"></span> <span data-tip="tribeName"></span> <span class="text-parchment-400 tabular-nums" data-tip="tribeInfo"></span></dd>
              <dt class="text-parchment-500">Relation</dt><dd data-tip="rel"></dd>
              <dt class="text-parchment-500" data-tip-row="dist">Distance</dt><dd class="tabular-nums" data-tip-row="dist" data-tip="dist"></dd>
              <dt class="text-parchment-500" data-tip-row="morale">Morale</dt><dd class="font-semibold tabular-nums" data-tip-row="morale" data-tip="morale"></dd>
            </dl>
            <%# Durée du trajet de chaque unité depuis le village courant (calculée par map.js avec la distance) : icône au-dessus, durée dessous. %>
            <%# Une seule rangée jusqu'à 10 unités, sinon deux rangées égales. %>
            <div class="grid gap-px bg-bronze-900 p-px" style="grid-template-columns: repeat(<%= paces.length <= 10 ? paces.length : Math.ceil(paces.length / 2) %>, minmax(0, 1fr))" data-tip-travel>
              <% for (const u of paces) { %><span class="flex flex-col items-center gap-1 bg-panel-top px-1 pt-1.5 pb-1" title="<%= u.name %>"><span class="text-gold-400"><%- unitIcon(u.id, 'size-4', 2) %></span><span class="text-[11px] text-parchment-200 tabular-nums" data-tip-pace="<%= u.minutes %>"></span></span><% } %>
            </div>
          </div>
          <div class="map-controls absolute z-[16] hidden w-[200px] border-2 border-black bg-panel-top shadow-[inset_0_0_0_1px_var(--color-bronze-500),5px_5px_0_#000]" data-map-menu>
            <div class="border-b-2 border-bronze-500 bg-head px-2 py-1 font-display text-xs font-semibold tracking-[0.02em]"><span data-menu-t="name"></span> <span class="font-sans text-parchment-300 tabular-nums" data-menu-t="coords"></span></div>
            <div data-menu-t="actions"></div>
          </div>
        </div>
      </div>
      <p class="mt-1.5 w-0 min-w-full text-xs text-parchment-600">Glisse la carte, utilise les flèches ou le clavier pour te déplacer · survole un village pour ses informations · clique pour ses actions</p>
      <script type="application/json" data-map-boot><%- JSON.stringify(mapBoot).replace(/</g, '\\u003c') %></script>
    </section>

    <%# Marquages puis calques, l'un sous l'autre ; w-0 min-w-full : largeur de la carte, sans l'élargir. %>
    <div class="flex w-0 min-w-full flex-col gap-4">
        <%# Marquages : une couleur par joueur, tribu ou village (carte, mini-carte, légende). %>
        <section class="<%= ui.panel %>" id="marquages">
          <%- panelHead('Marquages sur la carte', `<span class="text-[13px] text-parchment-300 tabular-nums">${markers.length} / 50</span>`) %>
          <form method="post" action="/village/<%= vid %>/map/markers" class="flex flex-col gap-2.5 border-b border-bronze-800 p-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% if (markForm) { %>
              <input type="hidden" name="type" value="<%= markForm.type %>"><input type="hidden" name="targetId" value="<%= markForm.targetId %>">
              <p class="text-sm text-parchment-300">Nouveau marquage : <strong class="text-parchment-100"><%= { player: 'joueur', tribe: 'tribu', village: 'village' }[markForm.type] %> <%= markForm.label %></strong> <a href="<%= link(cx, cy) %>#marquages" class="ml-1 text-[13px] text-gold-400 no-underline hover:text-parchment-100">Annuler</a></p>
            <% } else { %>
              <div class="flex flex-wrap items-end gap-2">
                <label class="<%= ui.label %>">Marquer
                  <select name="type" class="<%= ui.inputSm %>">
                    <option value="player">un joueur</option><option value="tribe">une tribu</option><option value="village">un village</option>
                  </select>
                </label>
                <label class="<%= ui.label %> min-w-0 flex-1">Nom, tag ou coordonnées<input name="target" required placeholder="Pseudo, tag de tribu ou 500|500" class="<%= ui.inputSm %> w-full"></label>
              </div>
            <% } %>
            <fieldset class="flex flex-wrap items-center gap-1.5">
              <legend class="mb-1 text-[13px] text-parchment-400">Couleur</legend>
              <% palette.forEach((color, i) => { %>
                <label class="cursor-pointer" title="<%= color %>">
                  <input type="radio" name="color" value="<%= color %>" class="peer sr-only" <%= i === 0 ? 'checked' : '' %>>
                  <span class="block size-6 border-2 border-black shadow-[1px_1px_0_#000] peer-checked:outline-2 peer-checked:outline-offset-1 peer-checked:outline-gold-200 peer-focus-visible:outline-2 peer-focus-visible:outline-gold-200" style="background:<%= color %>"></span>
                </label>
              <% }) %>
              <button class="<%= btn('gold', 'sm', 'ml-auto') %>">Enregistrer</button>
            </fieldset>
          </form>
          <% if (!markers.length) { %>
            <p class="px-3 py-2.5 text-[13px] text-parchment-500">Aucun marquage. Tu peux aussi cliquer un village de la carte puis « Marquer ».</p>
          <% } else { %>
            <ul class="max-h-72 overflow-y-auto">
              <% for (const m of markers) {
                   const href = m.targetType === 'player' ? `/village/${vid}/players/${m.targetId}` : m.targetType === 'tribe' ? `/village/${vid}/tribes/${m.targetId}` : link(m.x, m.y) + `&sx=${m.x}&sy=${m.y}`; %>
                <li class="flex items-center gap-2.5 border-b border-bronze-800 px-3 py-1.5 last:border-b-0 hover:bg-row-hover">
                  <span class="size-4 shrink-0 border-2 border-black shadow-[1px_1px_0_#000]" style="background:<%= m.color %>"></span>
                  <span class="w-14 shrink-0 text-[13px] text-parchment-500"><%= { player: 'Joueur', tribe: 'Tribu', village: 'Village' }[m.targetType] %></span>
                  <a href="<%= href %>" class="<%= ui.linkPlain %> min-w-0 flex-1 truncate font-semibold"><%= m.label %></a>
                  <form method="post" action="/village/<%= vid %>/map/markers/<%= m.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="<%= ui.iconBtnSm %>" title="Supprimer le marquage" aria-label="Supprimer le marquage"><%- icon('close', 'size-[11px]', 3.4) %></button>
                  </form>
                </li>
              <% } %>
            </ul>
            <p class="border-t border-bronze-800 px-3 py-2 text-xs text-parchment-600">Pour changer une couleur, marque à nouveau la même cible.</p>
          <% } %>
        </section>
        <%# Calques de carte : interrupteurs mémorisés sur le joueur (game.js). %>
        <section class="<%= ui.panel %>">
          <%- panelHead('Calques de carte') %>
          <div class="flex flex-col">
            <% for (const [k, label] of [['markers', 'Marquages'], ['influence', 'Influence de ta tribu'], ['enemy', 'Zones ennemies'], ['nobarb', 'Masquer les barbares'], ['grid', 'Quadrillage (5 cases)'], ['borders', 'Frontières de continent']]) { %>
              <button type="button" class="group flex cursor-pointer items-center justify-between border-b border-bronze-900 px-3 py-1.5 text-left text-parchment-400 last:border-b-0 hover:bg-thead aria-pressed:text-parchment-100" data-map-layer="<%= k %>" aria-pressed="<%= layers[k] ? 'true' : 'false' %>">
                <span><%= label %></span>
                <span class="relative h-4 w-8 border-2 border-black bg-night shadow-[inset_0_0_0_1px_var(--color-bronze-700)] group-aria-pressed:bg-blood-800"><span class="absolute top-px left-px size-2.5 border border-black bg-parchment-300 transition-[left] group-aria-pressed:left-[17px]"></span></span>
              </button>
            <% } %>
          </div>
        </section>
    </div>
  </div>

  <aside class="flex min-w-[300px] flex-[1_1_320px] flex-col gap-4">
    <%# Mini-carte : 5 px par case, comme sur Guerre Tribale ; elle suit les déplacements de la carte. %>
    <section class="<%= ui.panel %> max-w-full">
      <%- panelHead('Mini-carte', `<span class="text-[13px] text-parchment-300 tabular-nums" data-mini-label>${miniSize} × ${miniSize}</span>`) %>
      <div class="p-2">
        <canvas class="block max-w-full cursor-crosshair border-2 border-black bg-mini-bg" style="width:<%= miniSize * MINI_CELL %>px;aspect-ratio:1" data-mini-map data-size="<%= miniSize %>" aria-label="Mini-carte : clique pour recentrer la carte"></canvas>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-2 border-t border-bronze-800 px-3 py-2 text-[13px]">
        <button type="button" class="<%= ui.link %> cursor-pointer" data-world-open>Carte du monde</button>
        <span class="text-parchment-600">Clique pour recentrer</span>
      </div>
    </section>
    <%# Légende : couleurs de la diplomatie, puis les marquages du joueur. %>
      <section class="<%= ui.panel %>">
        <%- panelHead('Légende', '<a href="#marquages" class="text-[13px] text-gold-400 no-underline hover:text-parchment-100">Modifier les marquages</a>') %>
        <div class="flex flex-col gap-2 px-3 py-2.5">
          <div class="flex flex-wrap gap-x-4 gap-y-1.5">
            <% for (const [k, label] of legend) { %>
              <span class="flex items-center gap-1.5 text-[13px] text-parchment-300"><span class="size-[11px] shrink-0 border-2 border-black shadow-[1px_1px_0_#000] <%= REL[k][2] %>"></span><%= label %></span>
            <% } %>
            <span class="flex items-center gap-1.5 text-[13px] text-parchment-300"><span class="w-[11px] text-center text-gold-200">★</span>Village spécial</span>
            <span class="flex items-center gap-1.5 text-[13px] text-parchment-300"><span class="w-[11px] border-t-2 border-dashed border-blood-450"></span>Attaque en cours</span>
          </div>
          <% if (markers.length) { %>
            <div class="flex flex-wrap gap-x-4 gap-y-1.5 border-t border-bronze-800 pt-2">
              <span class="text-[13px] text-parchment-500">Marquages :</span>
              <% for (const m of markers) { %><span class="flex items-center gap-1.5 text-[13px] text-parchment-300"><span class="size-[11px] shrink-0 border-2 border-black shadow-[1px_1px_0_#000]" style="background:<%= m.color %>"></span><%= m.label %></span><% } %>
            </div>
          <% } %>
        </div>
      </section>
    <%# Recherche : joueur, village, tribu ou coordonnées. %>
    <section class="<%= ui.panel %>">
      <%- panelHead('Recherche') %>
      <form method="get" class="flex flex-col gap-1.5 p-2">
        <input type="hidden" name="x" value="<%= cx %>"><input type="hidden" name="y" value="<%= cy %>">
        <div class="grid grid-cols-4 border-2 border-black">
          <% for (const [k, label] of [['player', 'Joueur'], ['village', 'Village'], ['tribe', 'Tribu'], ['coords', 'Coord.']]) { %>
            <label class="cursor-pointer border-r border-black bg-night px-0.5 py-1 text-center text-xs font-semibold text-parchment-500 last:border-r-0 hover:text-parchment-100 has-checked:bg-blood-800 has-checked:text-parchment-100">
              <input type="radio" name="find" value="<%= k %>" class="sr-only" <%= search.find === k ? 'checked' : '' %>><%= label %>
            </label>
          <% } %>
        </div>
        <div class="flex">
          <input name="q" value="<%= search.q %>" placeholder="Nom, tag ou 500|500" aria-label="Rechercher" class="<%= ui.input %> min-w-0 flex-1">
          <button class="flex w-[34px] shrink-0 cursor-pointer items-center justify-center border-2 border-l-0 border-black bg-blood-800 text-parchment-100 hover:bg-blood-600" aria-label="Lancer la recherche"><%- icon('search', 'size-4', 2.6) %></button>
        </div>
        <% if (search.results) { %>
          <% if (!search.results.length) { %>
            <p class="px-0.5 text-[13px] text-parchment-500">Aucun résultat pour « <%= search.q %> ».</p>
          <% } else { %>
            <ul class="border border-bronze-800">
              <% for (const r of search.results) { %>
                <li class="flex items-center justify-between gap-2 border-b border-bronze-800 px-2 py-1 last:border-b-0 hover:bg-thead">
                  <span class="flex min-w-0 flex-col">
                    <% if (r.x != null) { %><a href="<%= link(r.x, r.y) %>&sx=<%= r.x %>&sy=<%= r.y %>" class="<%= ui.linkPlain %> truncate font-semibold"><%= r.label %></a><% } else { %><span class="truncate font-semibold"><%= r.label %></span><% } %>
                    <span class="truncate text-[11px] text-parchment-500"><%= r.sub %></span>
                  </span>
                  <span class="shrink-0 text-xs text-gold-400 tabular-nums">
                    <% if (r.playerId) { %><a href="/village/<%= vid %>/players/<%= r.playerId %>" class="<%= ui.link %>">Profil</a><% } else if (r.tribeId) { %><a href="/village/<%= vid %>/tribes/<%= r.tribeId %>" class="<%= ui.link %>">Tribu</a><% } else if (r.villageId) { %><a href="/village/<%= vid %>/villages/<%= r.villageId %>" class="<%= ui.link %>"><%= r.x %>|<%= r.y %></a><% } %>
                  </span>
                </li>
              <% } %>
            </ul>
          <% } %>
        <% } %>
      </form>
    </section>

    <%# Ordres rapides : modèle d'armée appliqué aux actions Attaquer / Soutenir du menu, actions affichées (game.js). %>
    <section class="<%= ui.panel %>" data-quick-orders>
      <%- panelHead('Ordres rapides', `<a href="/village/${vid}/place#modeles" class="${ui.link} font-sans text-xs">Modèles</a>`) %>
      <div class="flex flex-col gap-2 p-2">
        <select class="<%= ui.input %> w-full" data-quick-template aria-label="Modèle d'armée">
          <option value="">Modèle d’armée…</option>
          <% for (const tpl of templates) { %><option value="<%= tpl.id %>" data-units="<%= JSON.stringify(tpl.units) %>"><%= tpl.name %></option><% } %>
        </select>
        <% if (!templates.length) { %><p class="text-xs text-parchment-500">Crée tes modèles au point de ralliement.</p><% } %>
        <div class="flex flex-wrap gap-3">
          <% for (const [k, label] of [['attack', 'Attaque'], ['support', 'Soutien'], ['spy', 'Espionnage']]) { %>
            <label class="flex cursor-pointer items-center gap-1.5 font-semibold">
              <input type="checkbox" class="peer sr-only" data-quick-action="<%= k %>" checked>
              <span class="flex size-4 items-center justify-center border-2 border-black bg-night shadow-[inset_0_0_0_1px_var(--color-bronze-500)] peer-focus-visible:outline-2 peer-focus-visible:outline-gold-200 after:size-2 after:bg-transparent peer-checked:after:bg-blood-600"></span><%= label %>
            </label>
          <% } %>
        </div>
      </div>
    </section>

    <%# Favoris : villages marqués depuis le menu de la carte. %>
    <section class="<%= ui.panel %>">
      <%- panelHead('Favoris', `<span class="font-sans text-[11px] text-parchment-300 tabular-nums">${favorites.length}</span>`) %>
      <% if (!favorites.length) { %>
        <p class="p-2.5 text-[13px] text-parchment-500">Clique un village puis « Ajouter aux favoris ».</p>
      <% } else { %>
        <ul class="max-h-64 overflow-y-auto">
          <% for (const f of favorites) { const fv = f.Village; %>
            <li class="flex items-center justify-between gap-2 border-b border-bronze-800 px-2.5 py-1 last:border-b-0 hover:bg-thead">
              <span class="flex min-w-0 flex-col">
                <a href="<%= link(fv.x, fv.y) %>&sx=<%= fv.x %>&sy=<%= fv.y %>" class="<%= ui.linkPlain %> truncate font-semibold"><span class="text-gold-200">★</span> <%= fv.name %></a>
                <span class="truncate text-[11px] text-parchment-500"><%- fv.Player ? playerLink(vid, fv.Player, { cls: 'text-parchment-500 no-underline hover:text-gold-400' }) : 'Barbares' %> · <%= num(fv.points) %> pts</span>
              </span>
              <span class="flex shrink-0 items-center gap-2">
                <span class="text-xs font-semibold text-gold-400 tabular-nums"><%= fv.x %>|<%= fv.y %></span>
                <form method="post" action="/village/<%= vid %>/favorites/<%= fv.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="<%= ui.iconBtnSm %>" title="Retirer des favoris" aria-label="Retirer des favoris"><%- icon('close', 'size-[11px]', 3.4) %></button>
                </form>
              </span>
            </li>
          <% } %>
        </ul>
      <% } %>
    </section>

    <%# Tailles : appliquées en direct par map.js et mémorisées sur le joueur (sans JavaScript : formulaire). %>
    <section class="<%= ui.panel %>">
      <%- panelHead('Taille de la carte') %>
      <form method="get" class="grid grid-cols-2 gap-2.5 p-3" data-map-settings>
        <input type="hidden" name="x" value="<%= cx %>"><input type="hidden" name="y" value="<%= cy %>">
        <label class="<%= ui.label %>">Carte
          <select name="size" class="<%= ui.inputSm %>" data-map-resize="size">
            <% for (const n of mapSizes) { %><option value="<%= n %>" <%= n === displaySize ? 'selected' : '' %>><%= n %> × <%= n %></option><% } %>
          </select>
        </label>
        <label class="<%= ui.label %>">Mini-carte
          <select name="mini" class="<%= ui.inputSm %>" data-map-resize="mini">
            <% for (const n of miniSizes) { %><option value="<%= n %>" <%= n === miniSize ? 'selected' : '' %>><%= n %> × <%= n %></option><% } %>
          </select>
        </label>
        <noscript><button class="<%= btn('dark', 'sm') %>">Appliquer</button></noscript>
      </form>
    </section>
  </aside>
</div>
<%# Carte du monde : fenêtre ouverte sur la page, points chargés à l'ouverture (/map/world). %>
<div class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/70 p-4" data-world-modal role="dialog" aria-modal="true" aria-labelledby="world-title">
  <section class="<%= ui.panel %> flex max-h-full w-full max-w-[900px] flex-col">
    <%- panelHead('Carte du monde', `<button type="button" class="${ui.iconBtn}" data-world-close aria-label="Fermer la carte du monde" title="Fermer (Échap)">${icon('close', 'size-3.5', 2.6)}</button>`, { id: 'world-title' }) %>
    <div class="grid min-h-0 gap-4 p-4 sm:grid-cols-[minmax(0,1fr)_170px]">
      <canvas class="block aspect-square w-full max-w-[min(680px,calc(100vh-140px))] cursor-crosshair border-2 border-black bg-mini-bg" data-world-canvas aria-label="Carte du monde : clique pour y centrer la carte"></canvas>
      <div class="flex flex-col gap-2.5">
        <div class="<%= ui.tile %>"><div class="<%= ui.tileLabel %>">Villages</div><div class="<%= ui.tileValue %>" data-world-stat="all">…</div></div>
        <div class="<%= ui.tile %>"><div class="<%= ui.tileLabel %>">Barbares</div><div class="<%= ui.tileValue %>" data-world-stat="barb">…</div></div>
        <div class="<%= ui.tile %>"><div class="<%= ui.tileLabel %>">Tes villages</div><div class="<%= ui.tileValue %>" data-world-stat="own">…</div></div>
        <p class="text-[13px] leading-relaxed text-parchment-500">Clique un endroit pour y centrer la carte. Le cadre blanc montre la zone affichée.</p>
      </div>
    </div>
  </section>
</div>
<script src="/js/map.js" defer></script>
<%- include('partials/footer') %>
