<%- include('partials/header', { title: 'Rapport' }) %>
<%
  const d = report.data;
  const vid = ctx.village.id;
  const order = [...registry.UNITS.keys()];
  // Tableau d'unités : une colonne par unité (icône en en-tête), lignes Quantité / Pertes.
  const unitTable = (units, losses) => {
    const ids = order.filter((id) => (units && units[id] > 0) || (losses && losses[id] > 0));
    if (!ids.length) return `<p class="text-parchment-500">Aucune troupe.</p>`;
    const head = ids.map((id) => `<th class="text-center" scope="col" title="${esc(unitName(id))}"><span class="inline-flex text-gold-400">${unitIcon(id, 'size-[18px]')}</span><span class="sr-only">${esc(unitName(id))}</span></th>`).join('');
    const row = (label, src, cls) => `<tr><td class="${ui.subLabel} w-24 text-[10px]!">${label}</td>${ids.map((id) => {
      const n = (src && src[id]) || 0;
      return `<td class="text-center font-extrabold tabular-nums ${n ? cls : 'text-parchment-600'}">${num(n)}</td>`;
    }).join('')}</tr>`;
    return `<div class="overflow-x-auto"><table class="${ui.tableSm}"><thead><tr><th></th>${head}</tr></thead><tbody>`
      + row('Quantité', units, 'text-parchment-100')
      + (losses ? row('Pertes', losses, 'text-blood-300') : '')
      + `</tbody></table></div>`;
  };
  const kickers = { world: 'Annonce du monde', scavenge: 'Collecte', award: 'Succès', visit: 'Visite', trade: 'Commerce', support: 'Soutien' };
%>
<div class="mx-auto flex w-full max-w-4xl flex-col gap-5">
  <section class="<%= ui.panel %>">
    <%- panelHead('Rapport', `
      <div class="flex items-center gap-2">
        <a href="/village/${vid}/reports" class="${btn('dark', 'sm')}">${icon('arrowLeft', 'size-3.5', 2.2)}Rapports</a>
        <form method="post" action="/village/${vid}/reports/${report.id}/delete"><input type="hidden" name="_csrf" value="${csrfToken}">
          <button class="${btn('danger', 'sm')}">${icon('trash', 'size-3.5', 2)}Supprimer</button>
        </form>
      </div>`, { tag: 'h1' }) %>
    <div class="<%= ui.panelBody %> gap-4">
      <div class="flex flex-col gap-1">
        <% if (kickers[d.perspective]) { %><span class="<%= ui.kicker %>"><%= kickers[d.perspective] %></span><% } %>
        <p class="font-display text-lg font-bold wrap-break-word text-parchment-100"><%= report.title %></p>
        <p class="flex items-center gap-1.5 text-sm text-parchment-500 tabular-nums"><%- icon('clock', 'size-3.5') %><%= when(report.happenedAt, now) %></p>
      </div>

      <% if (d.perspective === 'world') { %>
        <p class="<%= ui.alertInfo %>"><%= d.text %></p>
      <% } else if (d.perspective === 'scavenge') { %>
        <div class="<%= ui.box %> flex flex-col gap-3 p-3.5">
          <p><span class="text-parchment-500">Village</span> <span class="font-bold"><%= d.village %></span></p>
          <%- include('partials/units', { units: d.units, losses: null }) %>
          <div class="flex flex-wrap items-center gap-3"><span class="<%= ui.subLabel %>">Butin</span><%- include('partials/cost', { cost: d.received, have: null }) %></div>
        </div>
        <p class="text-xs text-parchment-600">Ce qui dépasse la capacité de l'entrepôt est perdu.</p>
      <% } else if (d.perspective === 'award') { %>
        <div class="<%= ui.boxGold %> flex items-center gap-4 p-4">
          <span class="<%= ui.medallionGold %> size-12 font-display text-lg font-extrabold"><%= d.tier %></span>
          <span class="flex min-w-0 flex-col gap-0.5">
            <strong class="font-display text-[15px] text-gold-200"><%= d.name %></strong>
            <span class="text-parchment-400"><%= d.description %></span>
          </span>
        </div>
      <% } else if (d.perspective === 'visit') { %>
        <p class="<%= ui.box %> flex items-center gap-3 px-4 py-3 text-parchment-300"><span class="text-gold-400"><%- icon('moon', 'size-4') %></span><%= d.sleeper %> était en mode sommeil : aucun combat, les troupes sont reparties.</p>
        <p><span class="text-parchment-500">De</span> <span class="font-bold"><%= d.from %></span> <span class="text-parchment-500">vers</span> <span class="font-bold"><%= d.village %></span></p>
        <%- include('partials/units', { units: d.units, losses: null }) %>
      <% } else if (d.perspective === 'trade') { %>
        <p><span class="text-parchment-500">De</span> <span class="font-bold"><%= d.from %></span> <span class="text-parchment-500">vers</span> <span class="font-bold"><%= d.village %></span></p>
        <div class="<%= ui.box %> flex flex-col gap-2 p-3.5">
          <% if (d.sent) { %><div class="flex flex-wrap items-center gap-3"><span class="<%= ui.subLabel %> w-16">Envoyé</span><%- include('partials/cost', { cost: d.sent, have: null }) %></div><% } %>
          <% if (d.received) { %><div class="flex flex-wrap items-center gap-3"><span class="<%= ui.subLabel %> w-16">Reçu</span><%- include('partials/cost', { cost: d.received, have: null }) %></div><% } %>
        </div>
      <% } else if (d.perspective === 'support') { %>
        <% if (d.from) { %><p><span class="text-parchment-500">Depuis</span> <span class="font-bold"><%= d.from %></span> <span class="text-parchment-500">vers</span> <span class="font-bold"><%= d.village %></span></p><% } %>
        <%- include('partials/units', { units: d.units, losses: d.losses || null }) %>
      <% } else { %>
        <%
          const won = d.attackerWins;
          const verdict = won == null ? 'Espionnage' : (d.perspective === 'attacker' ? (won ? 'Victoire' : 'Défaite') : (won ? 'Village attaqué et vaincu' : 'Attaque repoussée'));
          const good = won == null || (d.perspective === 'attacker' ? won : !won);
        %>
        <div class="flex flex-wrap items-center gap-2">
          <span class="<%= won == null ? ui.tagMuted : (good ? ui.tagOlive : ui.tagRed) %> px-3 py-1 text-[11px]"><%= verdict %></span>
          <% if (d.conquered) { %><span class="<%= ui.tagGold %> px-3 py-1 text-[11px]">Village conquis</span><% } %>
        </div>
        <dl class="grid grid-cols-2 gap-2 sm:grid-cols-4">
          <div class="<%= ui.tile %>"><dt class="<%= ui.tileLabel %>">Chance</dt><dd class="<%= ui.tileValue %> <%= d.luck >= 0 ? 'text-olive-300' : 'text-blood-300' %>"><%= (d.luck * 100).toFixed(1) %> %</dd></div>
          <div class="<%= ui.tile %>"><dt class="<%= ui.tileLabel %>">Morale</dt><dd class="<%= ui.tileValue %>"><%= Math.round(d.morale * 100) %> %</dd></div>
          <div class="<%= ui.tile %>"><dt class="<%= ui.tileLabel %>">Bonus de nuit</dt><dd class="<%= ui.tileValue %>"><%= d.night ? 'oui' : 'non' %></dd></div>
          <div class="<%= ui.tile %>"><dt class="<%= ui.tileLabel %>">Muraille</dt><dd class="<%= ui.tileValue %>"><%= d.wall.before %><%= d.wall.after !== d.wall.before ? ` → ${d.wall.after}` : '' %></dd></div>
        </dl>
      <% } %>
    </div>
    <%- corners() %>
  </section>

  <% if (!['world', 'scavenge', 'award', 'visit', 'trade', 'support'].includes(d.perspective)) { %>
    <div class="grid gap-5 lg:grid-cols-2">
      <% for (const [label, side, medal] of [['Attaquant', d.attacker, ui.medallionRed], ['Défenseur', d.defender, ui.medallion]]) { %>
        <section class="<%= ui.panel %> min-w-0">
          <%- panelHead(label) %>
          <div class="<%= ui.panelBody %>">
            <div class="flex min-w-0 items-center gap-3">
              <span class="<%= medal %> size-9"><%- icon(label === 'Attaquant' ? 'attack' : 'wall', 'size-4', 2) %></span>
              <span class="flex min-w-0 flex-col">
                <span class="truncate font-bold text-parchment-100"><%= side.playerName %></span>
                <span class="truncate text-sm text-parchment-500"><%= side.village %></span>
              </span>
            </div>
            <% if (label === 'Défenseur' && d.hideDefender) { %>
              <p class="text-parchment-500">Aucun de vos soldats n'est revenu : aucune information.</p>
            <% } else { %>
              <%- unitTable(side.units, side.losses) %>
            <% } %>
          </div>
          <%- corners() %>
        </section>
      <% } %>
    </div>

    <% const hasLoot = d.carry > 0 || (d.loot && (d.loot.wood + d.loot.stone + d.loot.iron) > 0);
       const hasItems = d.attackerItem || (d.defenderItems && d.defenderItems.length); %>
    <% if (hasLoot || hasItems || d.loyalty || d.catapult) { %>
      <section class="<%= ui.panel %>">
        <%- panelHead('Résultat') %>
        <div class="<%= ui.panelBody %> gap-0 py-1">
          <% if (hasLoot) { %>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-bronze-700/35 py-2.5 last:border-b-0">
              <span class="<%= ui.subLabel %> w-28">Butin</span>
              <%- include('partials/cost', { cost: d.loot, have: null }) %>
              <span class="text-sm text-parchment-500 tabular-nums">(<%= num(d.loot.wood + d.loot.stone + d.loot.iron) %> / <%= num(d.carry) %>)</span>
            </div>
          <% } %>
          <% if (hasItems) { %>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-bronze-700/35 py-2.5 last:border-b-0">
              <span class="<%= ui.subLabel %> w-28">Armes de paladin</span>
              <span><%= [d.attackerItem ? `attaque — ${d.attackerItem}` : null, d.defenderItems && d.defenderItems.length ? `défense — ${d.defenderItems.join(', ')}` : null].filter(Boolean).join(' · ') %></span>
            </div>
          <% } %>
          <% if (d.loyalty) { %>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-bronze-700/35 py-2.5 last:border-b-0">
              <span class="<%= ui.subLabel %> w-28">Loyauté</span>
              <span class="font-extrabold tabular-nums"><%= d.loyalty.before %> <span class="text-parchment-500">→</span> <span class="<%= d.loyalty.after < d.loyalty.before ? 'text-blood-300' : '' %>"><%= d.loyalty.after %></span></span>
            </div>
          <% } %>
          <% if (d.catapult) { %>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-bronze-700/35 py-2.5 last:border-b-0">
              <span class="<%= ui.subLabel %> w-28">Catapultes</span>
              <span><%= d.catapult.name %> <span class="font-extrabold tabular-nums"><%= d.catapult.before %> → <%= d.catapult.after %></span></span>
            </div>
          <% } %>
        </div>
        <%- corners() %>
      </section>
    <% } %>

    <% if (d.perspective === 'attacker' && d.intel && Object.keys(d.intel).length) { %>
      <section class="<%= ui.panel %>">
        <%- panelHead('Espionnage', `<span class="text-gold-400">${icon('eye', 'size-4')}</span>`) %>
        <div class="<%= ui.panelBody %> gap-4">
          <% if (d.intel.resources) { %>
            <div class="flex flex-wrap items-center gap-3"><span class="<%= ui.subLabel %> w-28">Ressources</span><%- include('partials/cost', { cost: d.intel.resources, have: null }) %></div>
          <% } %>
          <% if (d.intel.buildings) { %>
            <div class="flex flex-col gap-2">
              <span class="<%= ui.subLabel %>">Bâtiments</span>
              <div class="flex flex-wrap gap-1.5">
                <% for (const [id, lvl] of Object.entries(d.intel.buildings).filter(([, l]) => l > 0)) { %>
                  <span class="<%= ui.chip %>"><span class="text-gold-400"><%- buildingIcon(id, 'size-3.5') %></span><%= buildingName(id) %> <strong class="text-parchment-100 tabular-nums"><%= lvl %></strong></span>
                <% } %>
              </div>
            </div>
          <% } %>
          <% if (d.intel.units) { %>
            <div class="flex flex-col gap-2">
              <span class="<%= ui.subLabel %>">Troupes</span>
              <%- unitTable(d.intel.units, null) %>
            </div>
          <% } %>
        </div>
        <%- corners() %>
      </section>
    <% } %>
  <% } %>
</div>
<%- include('partials/footer') %>
