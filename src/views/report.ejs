<%- include('partials/header', { title: 'Rapport' }) %>
<%
  const d = report.data;
  const vid = ctx.village.id;
  // Colonnes d'unités : toutes, sauf la milice quand le combat n'en compte pas.
  const withMilitia = ['attacker', 'defender'].some((k) => d[k] && ((d[k].units || {}).militia || (d[k].losses || {}).militia));
  const order = [...registry.UNITS.keys()].filter((id) => id !== 'militia' || withMilitia);
  const kickers = { world: 'Annonce du monde', scavenge: 'Collecte', award: 'Succès', visit: 'Visite', trade: 'Commerce', support: 'Soutien' };
  const isBattleReport = !['world', 'scavenge', 'award', 'visit', 'trade', 'support'].includes(d.perspective);
  const won = isBattleReport ? d.attackerWins : undefined;
  const good = isBattleReport && (won == null || (d.perspective === 'attacker' ? won : !won));
  const verdict = isBattleReport
    ? (won == null ? 'Espionnage' : (d.perspective === 'attacker' ? (won ? 'Victoire' : 'Défaite') : (won ? 'Village vaincu' : 'Attaque repoussée')))
    : null;
  const reportKinds = {
    world: { visual: 'world', label: 'Annonce du monde', icon: 'crown' },
    scavenge: { visual: 'scavenge', label: 'Collecte de ressources', icon: 'farm' },
    award: { visual: 'award', label: 'Récompense obtenue', icon: 'victory' },
    visit: { visual: 'visit', label: 'Visite', icon: 'moon' },
    trade: { visual: 'trade', label: 'Commerce', icon: 'market' },
    support: { visual: 'support', label: 'Soutien', icon: 'support' },
  };
  const reportKind = isBattleReport
    ? (d.conquered && d.perspective === 'attacker'
      ? { visual: 'conquest', label: 'Village conquis', icon: 'crown' }
      : { visual: won == null ? 'espionage' : (good ? 'victory' : 'defeat'), label: verdict, icon: won == null ? 'eye' : (good ? 'victory' : 'attack') })
    : (reportKinds[d.perspective] || { visual: 'world', label: kickers[d.perspective] || 'Rapport', icon: 'reports' });
  // Rapports de commerce comme sur GT : « Vendeur : joueur » puis « Village : nom (x|y) K55 » avec lien vers la carte.
  const partyRows = (label, p) => {
    if (!p) return '';
    const who = p.playerId ? playerLink(vid, { id: p.playerId, name: p.playerName }, { cls: `${ui.linkPlain} font-semibold` }) : `<span class="text-parchment-400">${esc(p.playerName || 'Barbares')}</span>`;
    const place = `<a href="/village/${vid}/villages/${p.villageId}" class="${ui.linkPlain} font-semibold">${esc(p.name)} (${p.x}|${p.y}) ${continent(p.x, p.y)}</a>`
      + ` <a href="/village/${vid}/map?x=${p.x}&amp;y=${p.y}" class="ml-1 inline-flex align-[-2px] text-parchment-500 hover:text-gold-200" title="Centrer la carte" aria-label="Centrer la carte sur ce village">${icon('map', 'size-3.5', 2)}</a>`;
    return `<tr><th scope="row" class="w-28 text-left">${esc(label)} :</th><th class="text-left"><span class="text-[15px]">${who}</span></th></tr>`
      + `<tr><td class="text-parchment-400">Village :</td><td>${place}</td></tr>`;
  };
  const resourceOf = (id) => RESOURCES.find((r) => r.id === id);
  const lot = (n, res) => { const r = resourceOf(res.resource);
    return `<span class="inline-flex items-center gap-1.5 font-semibold tabular-nums"><span class="text-parchment-400">${num(n)}×</span><span title="${esc(r.label)}">${resourceIcon(r.id)}</span>${num(res.amount)}</span>`; };
  const actionLink = `${ui.link} inline-flex items-center gap-1.5 text-sm`;
  const ownsVillage = (id) => myVillages.some((v) => v.id === id);
  const spiedBuildings = Object.entries(d.intel?.buildings || {}).filter(([, level]) => level > 0);
  const buildingColumnSize = Math.ceil(spiedBuildings.length / 2);
  const luckPercent = isBattleReport ? Math.round(d.luck * 1000) / 10 : 0;
  const moralePercent = isBattleReport ? Math.round(d.morale * 100) : 100;
  const luckTone = luckPercent > 0 ? 'positive' : luckPercent < 0 ? 'negative' : 'neutral';
  const moraleTone = moralePercent >= 80 ? 'positive' : moralePercent >= 50 ? 'neutral' : 'negative';
  const impactTone = d.perspective === 'attacker' ? 'text-olive-300' : 'text-blood-300';
%>
<div class="report-detail-page mx-auto flex w-full max-w-4xl flex-col gap-5">
  <section class="<%= ui.panel %>">
    <% // Archives (premium) : vers un autre dossier, ou retour dans la boîte de réception (toujours possible).
       const moveTargets = [
         ...(report.folderId ? [['', 'Nouveaux rapports']] : []),
         ...(premium ? folders.filter((f) => f.folder.id !== report.folderId).map((f) => [f.folder.id, f.folder.name]) : []),
       ]; %>
    <% const arrow = (id, dir, label) => id
         ? `<a href="/village/${vid}/reports/${id}" class="${ui.iconBtn}" title="${label}" aria-label="${label}">${icon(dir, 'size-3.5', 2.4)}</a>`
         : `<span class="${ui.iconBtn} pointer-events-none opacity-40" aria-hidden="true">${icon(dir, 'size-3.5', 2.4)}</span>`; %>
    <%- panelHead('Rapport', `
      <div class="flex items-center gap-2">
        <a href="/village/${vid}/reports${report.folderId ? `?folder=${report.folderId}` : ''}" class="${btn('dark', 'sm')}">${icon('arrowLeft', 'size-3.5', 2.2)}Rapports</a>
        ${arrow(neighbours.newer, 'chevronUp', 'Rapport plus récent')}${arrow(neighbours.older, 'chevronDown', 'Rapport plus ancien')}
        ${moveTargets.length ? `<form method="post" action="/village/${vid}/reports/${report.id}/move" class="flex items-center gap-2"><input type="hidden" name="_csrf" value="${csrfToken}">
          <select name="folder" class="${ui.inputSm}" aria-label="Déplacer vers">${moveTargets.map(([id, name]) => `<option value="${id}">${esc(name)}</option>`).join('')}</select>
          <button class="${btn('dark', 'sm')}">${report.folderId ? 'Déplacer' : 'Archiver'}</button>
        </form>` : ''}
        <form method="post" action="/village/${vid}/reports/${report.id}/delete"><input type="hidden" name="_csrf" value="${csrfToken}">
          <button class="${btn('danger', 'sm')}">${icon('trash', 'size-3.5', 2)}Effacer</button>
        </form>
      </div>`, { tag: 'h1' }) %>
    <div class="<%= ui.panelBody %> gap-4">
      <div class="report-hero report-hero--<%= reportKind.visual %>" style="background-image: url('/img/reports/<%= reportKind.visual %>.png?v=2')">
        <div class="report-hero__content">
          <span class="report-hero__eyebrow"><%- icon(reportKind.icon, 'size-4', 2.2) %><%= reportKind.label %></span>
          <h2 class="report-hero__title"><%= report.title %></h2>
          <p class="report-hero__time"><%- icon('clock', 'size-3.5') %><%= when(report.happenedAt, now) %></p>
          <% if (d.conquered && d.perspective === 'defender') { %><span class="report-hero__conquest">Village perdu</span><% } %>
        </div>
      </div>

      <%- include('partials/report/summary', { d, vid, withMilitia, order, kickers, isBattleReport, won, good, verdict, reportKinds, reportKind, partyRows, resourceOf, lot, actionLink, ownsVillage, spiedBuildings, buildingColumnSize, luckPercent, moralePercent, luckTone, moraleTone, impactTone }) %>
    </div>
  </section>

  <%- include('partials/report/battle', { d, vid, withMilitia, order, kickers, isBattleReport, won, good, verdict, reportKinds, reportKind, partyRows, resourceOf, lot, actionLink, ownsVillage, spiedBuildings, buildingColumnSize, luckPercent, moralePercent, luckTone, moraleTone, impactTone }) %>
</div>
<%- include('partials/footer') %>
