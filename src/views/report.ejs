<%- include('partials/header', { title: 'Rapport' }) %>
<%
  const d = report.data;
  const vid = ctx.village.id;
  // Colonnes d'unités : toutes, sauf la milice quand le combat n'en compte pas.
  const withMilitia = ['attacker', 'defender'].some((k) => d[k] && ((d[k].units || {}).militia || (d[k].losses || {}).militia));
  const order = [...registry.UNITS.keys()].filter((id) => id !== 'militia' || withMilitia);
  const kickers = { world: 'Annonce du monde', scavenge: 'Collecte', award: 'Succès', visit: 'Visite', trade: 'Commerce', support: 'Soutien' };
  const isBattleReport = !['world', 'scavenge', 'award', 'visit', 'trade', 'support'].includes(d.perspective);
  const won = isBattleReport ? d.attackerWins : undefined;
  const good = isBattleReport && (won == null || (d.perspective === 'attacker' ? won : !won));
  const verdict = isBattleReport
    ? (won == null ? 'Espionnage' : (d.perspective === 'attacker' ? (won ? 'Victoire' : 'Défaite') : (won ? 'Village vaincu' : 'Attaque repoussée')))
    : null;
  const reportKinds = {
    world: { visual: 'world', label: 'Annonce du monde', icon: 'crown' },
    scavenge: { visual: 'scavenge', label: 'Collecte de ressources', icon: 'farm' },
    award: { visual: 'award', label: 'Récompense obtenue', icon: 'victory' },
    visit: { visual: 'visit', label: 'Visite', icon: 'moon' },
    trade: { visual: 'trade', label: 'Commerce', icon: 'market' },
    support: { visual: 'support', label: 'Soutien', icon: 'support' },
  };
  const reportKind = isBattleReport
    ? (d.conquered && d.perspective === 'attacker'
      ? { visual: 'conquest', label: 'Village conquis', icon: 'crown' }
      : { visual: won == null ? 'espionage' : (good ? 'victory' : 'defeat'), label: verdict, icon: won == null ? 'eye' : (good ? 'victory' : 'attack') })
    : (reportKinds[d.perspective] || { visual: 'world', label: kickers[d.perspective] || 'Rapport', icon: 'reports' });
  // Rapports de commerce comme sur GT : « Vendeur : joueur » puis « Village : nom (x|y) K55 » avec lien vers la carte.
  const partyRows = (label, p) => {
    if (!p) return '';
    const who = p.playerId ? playerLink(vid, { id: p.playerId, name: p.playerName }, { cls: `${ui.linkPlain} font-semibold` }) : `<span class="text-parchment-400">${esc(p.playerName || 'Barbares')}</span>`;
    const place = `<a href="/village/${vid}/villages/${p.villageId}" class="${ui.linkPlain} font-semibold">${esc(p.name)} (${p.x}|${p.y}) ${continent(p.x, p.y)}</a>`
      + ` <a href="/village/${vid}/map?x=${p.x}&amp;y=${p.y}" class="ml-1 inline-flex align-[-2px] text-parchment-500 hover:text-gold-200" title="Centrer la carte" aria-label="Centrer la carte sur ce village">${icon('map', 'size-3.5', 2)}</a>`;
    return `<tr><th scope="row" class="w-28 text-left">${esc(label)} :</th><th class="text-left"><span class="text-[15px]">${who}</span></th></tr>`
      + `<tr><td class="text-parchment-400">Village :</td><td>${place}</td></tr>`;
  };
  const resourceOf = (id) => RESOURCES.find((r) => r.id === id);
  const lot = (n, res) => { const r = resourceOf(res.resource);
    return `<span class="inline-flex items-center gap-1.5 font-semibold tabular-nums"><span class="text-parchment-400">${num(n)}×</span><span title="${esc(r.label)}">${resourceIcon(r.id)}</span>${num(res.amount)}</span>`; };
  const actionLink = `${ui.link} inline-flex items-center gap-1.5 text-sm`;
  const ownsVillage = (id) => myVillages.some((v) => v.id === id);
  const spiedBuildings = Object.entries(d.intel?.buildings || {}).filter(([, level]) => level > 0);
  const buildingColumnSize = Math.ceil(spiedBuildings.length / 2);
  const luckPercent = isBattleReport ? Math.round(d.luck * 1000) / 10 : 0;
  const moralePercent = isBattleReport ? Math.round(d.morale * 100) : 100;
  const luckTone = luckPercent > 0 ? 'positive' : luckPercent < 0 ? 'negative' : 'neutral';
  const moraleTone = moralePercent >= 80 ? 'positive' : moralePercent >= 50 ? 'neutral' : 'negative';
  const impactTone = d.perspective === 'attacker' ? 'text-olive-300' : 'text-blood-300';
%>
<div class="report-detail-page mx-auto flex w-full max-w-4xl flex-col gap-5">
  <section class="<%= ui.panel %>">
    <% const arrow = (id, dir, label) => id
         ? `<a href="/village/${vid}/reports/${id}" class="${ui.iconBtn}" title="${label}" aria-label="${label}">${icon(dir, 'size-3.5', 2.4)}</a>`
         : `<span class="${ui.iconBtn} pointer-events-none opacity-40" aria-hidden="true">${icon(dir, 'size-3.5', 2.4)}</span>`; %>
    <%- panelHead('Rapport', `
      <div class="flex items-center gap-2">
        <a href="/village/${vid}/reports" class="${btn('dark', 'sm')}">${icon('arrowLeft', 'size-3.5', 2.2)}Rapports</a>
        ${arrow(neighbours.newer, 'chevronUp', 'Rapport plus récent')}${arrow(neighbours.older, 'chevronDown', 'Rapport plus ancien')}
        <form method="post" action="/village/${vid}/reports/${report.id}/delete"><input type="hidden" name="_csrf" value="${csrfToken}">
          <button class="${btn('danger', 'sm')}">${icon('trash', 'size-3.5', 2)}Effacer</button>
        </form>
      </div>`, { tag: 'h1' }) %>
    <div class="<%= ui.panelBody %> gap-4">
      <div class="report-hero report-hero--<%= reportKind.visual %>" style="background-image: url('/img/reports/<%= reportKind.visual %>.png?v=2')">
        <div class="report-hero__content">
          <span class="report-hero__eyebrow"><%- icon(reportKind.icon, 'size-4', 2.2) %><%= reportKind.label %></span>
          <h2 class="report-hero__title"><%= report.title %></h2>
          <p class="report-hero__time"><%- icon('clock', 'size-3.5') %><%= when(report.happenedAt, now) %></p>
          <% if (d.conquered && d.perspective === 'defender') { %><span class="report-hero__conquest">Village perdu</span><% } %>
        </div>
      </div>

      <% if (d.perspective === 'world') { %>
        <p class="<%= ui.alertInfo %>"><%= d.text %></p>
      <% } else if (d.perspective === 'scavenge') { %>
        <div class="<%= ui.box %> flex flex-col gap-3 p-3.5">
          <p><span class="text-parchment-500">Village</span> <span class="font-semibold"><%= d.village %></span></p>
          <%- include('partials/units', { units: d.units, losses: null, iconSize: 'size-8' }) %>
          <div class="flex flex-wrap items-center gap-3"><span class="<%= ui.subLabel %>">Butin</span><%- include('partials/cost', { cost: d.received, have: null }) %></div>
        </div>
        <p class="text-xs text-parchment-600">Ce qui dépasse la capacité de l'entrepôt est perdu.</p>
      <% } else if (d.perspective === 'award') { const tierIdx = d.tiers > 1 ? d.tier : 4; %>
        <%# Succès, comme l'encadré « Accomplissement reçu » de GT : icône, objectif atteint, lien, palier à droite. %>
        <div class="flex flex-col gap-3 border-2 border-black bg-panel-lo p-3.5 shadow-[3px_3px_0_#050505]">
          <h2 class="font-display text-lg font-semibold text-parchment-100"><%= d.name %><% if (d.tiers > 1) { %> <span class="<%= TIER_STYLES.text[d.tier] %>">(<%= TIER_STYLES.names[d.tier - 1] %> · niveau <%= d.tier %>)</span><% } %></h2>
          <div class="flex items-start gap-4">
            <span class="<%= TIER_STYLES.medal %> <%= TIER_STYLES.border[tierIdx] %> size-16"><%- icon(ACHIEVEMENT_ICONS[d.key] || 'victory', 'size-8') %></span>
            <div class="flex min-w-0 flex-1 flex-col gap-2 text-[15px]">
              <p class="text-parchment-200"><%= d.description %></p>
              <% if (d.goal != null) { %><p class="text-parchment-400">Objectif atteint : <span class="font-semibold text-parchment-100 tabular-nums"><%= num(d.goal) %></span><%- d.next != null ? ` · palier suivant : <span class="font-semibold text-parchment-100 tabular-nums">${num(d.next)}</span>` : ' · palier maximal' %></p><% } %>
              <a href="/village/<%= vid %>/players/<%= ctx.village.playerId %>#succes" class="<%= actionLink %> self-start">Voir vos succès</a>
            </div>
            <span class="flex shrink-0 flex-col items-center gap-1 max-sm:hidden" title="Palier <%= TIER_STYLES.names[tierIdx - 1].toLowerCase() %>">
              <span class="<%= TIER_STYLES.medal %> <%= TIER_STYLES.border[tierIdx] %> size-14 font-display text-xl font-semibold"><%= d.tiers > 1 ? d.tier : '★' %></span>
              <span class="text-xs font-semibold <%= TIER_STYLES.text[tierIdx] %>"><%= d.daily ? 'Du jour' : TIER_STYLES.names[tierIdx - 1] %></span>
            </span>
          </div>
        </div>
      <% } else if (d.perspective === 'visit') { %>
        <p class="<%= ui.box %> flex items-center gap-3 px-4 py-3 text-parchment-300"><span class="text-gold-400"><%- icon('moon', 'size-4') %></span><%= d.sleeper %> était en mode sommeil : aucun combat, les troupes sont reparties.</p>
        <p><span class="text-parchment-500">De</span> <span class="font-semibold"><%= d.from %></span> <span class="text-parchment-500">vers</span> <span class="font-semibold"><%= d.village %></span></p>
        <%- include('partials/units', { units: d.units, losses: null, iconSize: 'size-8' }) %>
      <% } else if (d.perspective === 'trade' && d.kind === 'offer') { const arrived = new Date(d.arrivesAt) <= now; %>
        <%# Offre acceptée : Vendeur / Acheteur, ce qui a été vendu et payé, arrivée du paiement, « Re-créer l'offre ». %>
        <div class="flex flex-col gap-3 border-2 border-black bg-panel-lo p-3 shadow-[3px_3px_0_#050505]">
          <div class="overflow-x-auto"><table class="<%= ui.table %>"><tbody><%- partyRows('Vendeur', d.seller) %><%- partyRows('Acheteur', d.buyer) %></tbody></table></div>
          <div class="<%= ui.box %> flex flex-col gap-1.5 self-start px-3 py-2.5 text-[15px]">
            <p class="flex flex-wrap items-center gap-x-2"><span class="font-semibold text-parchment-100"><%= d.seller.playerName %></span> <span class="text-parchment-400">a vendu :</span> <%- lot(d.lots, d.sell) %></p>
            <p class="flex flex-wrap items-center gap-x-2"><span class="font-semibold text-parchment-100"><%= d.buyer.playerName %></span> <span class="text-parchment-400">a payé :</span> <%- lot(d.lots, d.buy) %></p>
          </div>
          <p class="text-parchment-300">Les biens échangés ont bien été embarqués et <%= arrived ? 'sont arrivés' : 'arriveront' %> <span class="tabular-nums"><%= when(d.arrivesAt, now) %></span>.</p>
          <% const home = ownsVillage(d.seller.villageId) ? d.seller.villageId : vid; %>
          <a href="/village/<%= home %>/market?tab=mine&amp;sellResource=<%= d.sell.resource %>&amp;sellAmount=<%= d.sell.amount %>&amp;buyResource=<%= d.buy.resource %>&amp;buyAmount=<%= d.buy.amount %>&amp;count=<%= d.lots %>" class="<%= actionLink %> self-start"><%- icon('market', 'size-3.5', 2) %>Re-créer l'offre</a>
        </div>
      <% } else if (d.perspective === 'trade' && d.kind === 'delivery') { %>
        <%# Livraison : De / À, puis les ressources livrées. %>
        <div class="flex flex-col gap-3 border-2 border-black bg-panel-lo p-3 shadow-[3px_3px_0_#050505]">
          <div class="overflow-x-auto"><table class="<%= ui.table %>"><tbody><%- partyRows('De', d.sender) %><%- partyRows('À', d.recipient) %></tbody></table></div>
          <div class="flex flex-col gap-1.5">
            <span class="font-semibold text-parchment-100">Ressources :</span>
            <span class="flex flex-wrap items-center gap-x-4 gap-y-1 font-semibold tabular-nums">
              <% for (const r of RESOURCES.filter((x) => d.received[x.id] > 0)) { %>
                <span class="inline-flex items-center gap-1.5" title="<%= r.label %>"><span><%- resourceIcon(r.id) %></span><%= num(d.received[r.id]) %></span>
              <% } %>
            </span>
          </div>
          <p class="text-xs text-parchment-600">Ce qui dépasse la capacité de l'entrepôt est perdu.</p>
        </div>
      <% } else if (d.perspective === 'trade') { %>
        <%# Anciens rapports de commerce (avant les parties joueur / village). %>
        <p><span class="text-parchment-500">De</span> <span class="font-semibold"><%= d.from %></span> <span class="text-parchment-500">vers</span> <span class="font-semibold"><%= d.village %></span></p>
        <div class="<%= ui.box %> flex flex-col gap-2 p-3.5">
          <% if (d.sent) { %><div class="flex flex-wrap items-center gap-3"><span class="<%= ui.subLabel %> w-16">Envoyé</span><%- include('partials/cost', { cost: d.sent, have: null }) %></div><% } %>
          <% if (d.received) { %><div class="flex flex-wrap items-center gap-3"><span class="<%= ui.subLabel %> w-16">Reçu</span><%- include('partials/cost', { cost: d.received, have: null }) %></div><% } %>
        </div>
      <% } else if (d.perspective === 'support') { %>
        <% if (d.from) { %><p><span class="text-parchment-500">Depuis</span> <span class="font-semibold"><%= d.from %></span> <span class="text-parchment-500">vers</span> <span class="font-semibold"><%= d.village %></span></p><% } %>
        <%- include('partials/units', { units: d.units, losses: d.losses || null, iconSize: 'size-8' }) %>
      <% } else { %>
        <dl class="grid grid-cols-1 gap-2 sm:grid-cols-3">
          <div class="<%= ui.tile %>">
            <dt class="<%= ui.tileLabel %>">Chance de l’attaquant</dt>
            <dd class="<%= ui.tileValue %> report-stat--<%= luckTone %>"><%= luckPercent > 0 ? '+' : '' %><%= luckPercent.toFixed(1) %> %</dd>
            <dd class="report-meter report-meter--luck report-meter--<%= luckTone %>" aria-hidden="true"><span style="left: <%= luckPercent < 0 ? 50 - Math.min(50, Math.abs(luckPercent) * 2) : 50 %>%; width: <%= Math.min(50, Math.abs(luckPercent) * 2) %>%"></span></dd>
          </div>
          <div class="<%= ui.tile %>">
            <dt class="<%= ui.tileLabel %>">Moral de l’attaquant</dt>
            <dd class="<%= ui.tileValue %> report-stat--<%= moraleTone %>"><%= moralePercent %> %</dd>
            <dd class="report-meter report-meter--<%= moraleTone %>" aria-hidden="true"><span style="width: <%= Math.min(100, Math.max(0, moralePercent)) %>%"></span></dd>
          </div>
          <div class="<%= ui.tile %>"><dt class="<%= ui.tileLabel %>">Bonus de nuit</dt><dd class="<%= ui.tileValue %>"><%= d.night ? 'oui' : 'non' %></dd></div>
        </dl>
      <% } %>
    </div>
  </section>

  <% if (isBattleReport) { %>
    <div class="grid gap-4">
      <% for (const [label, side, medal] of [['Attaquant', d.attacker, ui.medallionRed], ['Défenseur', d.defender, ui.medallion]]) { %>
        <section class="report-army-card min-w-0">
          <h2 class="report-section-title"><%- icon(label === 'Attaquant' ? 'troops' : 'wall', 'size-4', 2) %><%= label %></h2>
          <div class="report-army-card__body">
            <div class="report-party">
              <span class="<%= medal %> size-9"><%- icon(label === 'Attaquant' ? 'troops' : 'wall', 'size-4', 2) %></span>
              <span class="flex min-w-0 flex-col">
                <span class="report-party__player"><%- side.playerId ? playerLink(vid, { id: side.playerId, name: side.playerName }) : esc(side.playerName) %></span>
                <span class="report-party__village"><%= side.village %></span>
              </span>
            </div>
            <% if (label === 'Défenseur' && d.hideDefender) { %>
              <p class="report-hidden-intel">Aucun de vos soldats n'est revenu : aucune information sur les troupes adverses.</p>
            <% } else { %>
              <%- include('partials/report-army-table', { ids: order, units: side.units, losses: side.losses }) %>
            <% } %>
          </div>
        </section>
      <% } %>
    </div>

    <% const hasLoot = d.carry > 0 || (d.loot && (d.loot.wood + d.loot.stone + d.loot.iron) > 0);
       const hasItems = d.attackerItem || (d.defenderItems && d.defenderItems.length); %>
    <% if (hasLoot || hasItems || d.loyalty || d.catapult || d.wall) { %>
      <section class="<%= ui.panel %>">
        <%- panelHead('Résultat') %>
        <div class="<%= ui.panelBody %> gap-0 py-1">
          <% if (hasLoot) { %>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-bronze-700/35 py-2.5 last:border-b-0">
              <span class="<%= ui.subLabel %> w-28">Butin</span>
              <%- include('partials/cost', { cost: d.loot, have: null }) %>
              <span class="text-sm text-parchment-500 tabular-nums">(<%= num(d.loot.wood + d.loot.stone + d.loot.iron) %> / <%= num(d.carry) %>)</span>
            </div>
          <% } %>
          <% if (hasItems) { %>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-bronze-700/35 py-2.5 last:border-b-0">
              <span class="<%= ui.subLabel %> w-28">Armes de paladin</span>
              <span><%= [d.attackerItem ? `attaque — ${d.attackerItem}` : null, d.defenderItems && d.defenderItems.length ? `défense — ${d.defenderItems.join(', ')}` : null].filter(Boolean).join(' · ') %></span>
            </div>
          <% } %>
          <% if (d.wall) { const wallDamage = d.wall.before - d.wall.after; %>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-bronze-700/35 py-2.5 last:border-b-0">
              <span class="<%= ui.subLabel %> w-28">Muraille</span>
              <span class="inline-flex items-center gap-2 text-sm"><%- buildingImg('wall', Math.max(1, d.wall.before), 'h-7 w-8') %><span>niveau <strong class="tabular-nums"><%= d.wall.before %></strong> → <strong class="<%= wallDamage > 0 ? impactTone : '' %> tabular-nums"><%= d.wall.after %></strong><% if (wallDamage > 0) { %> <span class="text-parchment-500">(<%= wallDamage %> niveau<%= wallDamage > 1 ? 'x' : '' %> détruit<%= wallDamage > 1 ? 's' : '' %>)</span><% } else { %> <span class="text-parchment-500">(intacte)</span><% } %></span></span>
            </div>
          <% } %>
          <% if (d.catapult) { %>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-bronze-700/35 py-2.5 last:border-b-0">
              <span class="<%= ui.subLabel %> w-28">Bâtiment ciblé</span>
              <span class="inline-flex items-center gap-2 text-sm"><%- buildingImg(d.catapult.building, Math.max(1, d.catapult.before), 'h-7 w-8') %><span><strong><%= d.catapult.name %></strong> : <% if (d.catapult.after < d.catapult.before) { %>niveau <strong class="tabular-nums"><%= d.catapult.before %></strong> → <strong class="<%= impactTone %> tabular-nums"><%= d.catapult.after %></strong> <span class="text-parchment-500">(<%= d.catapult.before - d.catapult.after %> niveau<%= d.catapult.before - d.catapult.after > 1 ? 'x' : '' %> détruit<%= d.catapult.before - d.catapult.after > 1 ? 's' : '' %>)</span><% } else { %>aucun niveau détruit<% } %></span></span>
            </div>
          <% } %>
          <% if (d.loyalty) { %>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-bronze-700/35 py-2.5 last:border-b-0">
              <span class="<%= ui.subLabel %> w-28">Loyauté</span>
              <span class="text-sm">A baissé de <strong class="tabular-nums"><%= d.loyalty.before %></strong> à <strong class="<%= impactTone %> tabular-nums"><%= d.loyalty.after %></strong><% if (d.conquered) { %> <span class="font-semibold <%= impactTone %>">· Village <%= d.perspective === 'attacker' ? 'conquis' : 'perdu' %></span><% } %></span>
            </div>
          <% } %>
        </div>
      </section>
    <% } %>

    <% if (d.perspective === 'attacker' && d.intel && Object.keys(d.intel).length) { %>
      <section class="<%= ui.panel %>">
        <%- panelHead('Espionnage', `<span class="text-gold-400">${icon('eye', 'size-4')}</span>`) %>
        <div class="<%= ui.panelBody %> report-intel gap-4">
          <% if (d.intel.resources) { %>
            <section class="report-intel__group" aria-labelledby="intel-resources">
              <h3 id="intel-resources" class="<%= ui.subLabel %> mb-1 border-b border-bronze-800 bg-thead px-2 py-1">Ressources espionnées</h3>
              <div class="<%= ui.box %> flex flex-wrap items-center gap-2 px-3 py-2"><%- include('partials/cost', { cost: d.intel.resources, have: null }) %></div>
            </section>
          <% } %>
          <% if (spiedBuildings.length) { %>
            <section class="report-intel__group" aria-labelledby="intel-buildings">
              <h3 id="intel-buildings" class="<%= ui.subLabel %> mb-1 border-b border-bronze-800 bg-thead px-2 py-1">Bâtiments</h3>
              <div class="report-intel__buildings">
                <% for (const column of [spiedBuildings.slice(0, buildingColumnSize), spiedBuildings.slice(buildingColumnSize)]) { if (!column.length) continue; %>
                  <table class="<%= ui.tableSm %> bg-panel-lo">
                    <thead><tr><th scope="col">Bâtiment</th><th scope="col">Niveau</th></tr></thead>
                    <tbody>
                      <% for (const [id, level] of column) { %>
                        <tr><td><span class="report-intel__building-name"><%- buildingImg(id, Math.max(1, level), '', { lazy: true }) %><%= buildingName(id) %></span></td><td class="text-center font-semibold tabular-nums"><%= level %></td></tr>
                      <% } %>
                    </tbody>
                  </table>
                <% } %>
              </div>
            </section>
          <% } %>
          <% if (d.intel.units) { %>
            <section class="report-intel__group" aria-labelledby="intel-units">
              <h3 id="intel-units" class="<%= ui.subLabel %> mb-1 border-b border-bronze-800 bg-thead px-2 py-1">Troupes détectées</h3>
              <%- include('partials/report-army-table', { ids: order, units: d.intel.units, losses: null }) %>
            </section>
          <% } %>
        </div>
      </section>
    <% } %>
  <% } %>
</div>
<%- include('partials/footer') %>
