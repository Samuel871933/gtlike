<%- include('partials/header', { title: 'Classement', lobbyPage: 'ranking' }) %>
<%
  const base = ctx ? `/village/${ctx.village.id}/ranking` : `/worlds/${world.slug}/ranking`;
  const types = [['players', 'Joueurs'], ['tribes', 'Tribus'], ['continent', 'Continents'], ['kills', 'Adversaires vaincus'], ['awards', 'Succès']];
  const isMe = (p) => user && p && p.userId === user.id;
  // Rang : les trois premiers en Cinzel doré dans un médaillon.
  const rankCell = (i) => i < 3
    ? `<span class="${i === 0 ? ui.medallionGold : ui.medallion} size-8 font-display text-sm font-extrabold ${i === 0 ? 'text-gold-100' : 'text-gold-300'}">${i + 1}</span>`
    : `<span class="inline-flex w-8 justify-center font-bold text-parchment-500 tabular-nums">${i + 1}</span>`;
  const tribeTag = (tr) => tr ? `<span class="${ui.tagMuted}">${esc(tr.tag)}</span>` : '<span class="text-parchment-700">—</span>';
  const empty = (msg) => `<p class="px-4.5 py-4 text-parchment-500">${esc(msg)}</p>`;
%>
<section class="<%= ui.panel %>">
  <%- panelHead('Classement', `<span class="flex flex-wrap items-center gap-3"><span class="${ui.tagMuted}">${esc(world.name)}</span>${ctx ? '' : `<a href="/worlds/${world.slug}/play" class="${btn('gold', 'sm')}">${icon('arrowLeft', 'size-3.5', 2.2)}Retour au village</a>`}</span>`, { tag: 'h1' }) %>
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-bronze-900 px-4.5 py-3">
    <%- segTabs(types.map(([id, name]) => [`${base}?type=${id}`, name, type === id])) %>
    <% if (type === 'kills') { %>
      <%- segTabs([['all', 'Total'], ['att', 'En attaque (ODA)'], ['def', 'En défense (ODD)'], ['sup', 'En soutien (ODS)']].map(([id, name]) => [`${base}?type=kills&kind=${id}`, name, kind === id])) %>
    <% } else if (type === 'continent') { const c = continentRanking; %>
      <form method="get" class="flex flex-wrap items-center gap-2 text-sm">
        <input type="hidden" name="type" value="continent">
        <select name="k" class="<%= ui.inputSm %>" onchange="this.form.submit()" aria-label="Continent">
          <% for (const k of c.list) { %><option value="<%= k %>" <%= k === c.k ? 'selected' : '' %>><%= k %></option><% } %>
        </select>
        <select name="of" class="<%= ui.inputSm %>" onchange="this.form.submit()" aria-label="Classer">
          <option value="players" <%= c.of === 'players' ? 'selected' : '' %>>Joueurs</option>
          <option value="tribes" <%= c.of === 'tribes' ? 'selected' : '' %>>Tribus</option>
        </select>
        <noscript><button class="<%= btn('dark', 'sm') %>">Afficher</button></noscript>
      </form>
    <% } else if (type === 'awards') { %>
      <p class="text-xs text-parchment-500">Bois 1 point, bronze 2, argent 3, or 4 par succès.</p>
    <% } %>
  </div>

  <% if (type === 'awards') { %>
    <% if (!awards.length) { %><%- empty("Aucun succès débloqué pour l'instant.") %><% } else { %>
    <div class="overflow-x-auto">
      <table class="<%= ui.table %>">
        <thead><tr><th class="w-20">Rang</th><th>Joueur</th><th class="text-right">Succès</th><th class="text-right">Points</th></tr></thead>
        <tbody>
        <% awards.forEach((r, i) => { %>
          <tr class="<%= isMe(r.player) ? ui.rowActive : '' %>">
            <td><%- rankCell(i) %></td>
            <td class="font-bold text-parchment-100"><%= r.player.name %></td>
            <td class="text-right tabular-nums"><%= r.count %></td>
            <td class="text-right font-extrabold text-gold-200 tabular-nums"><%= r.score %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  <% } else if (type === 'continent') { const c = continentRanking; %>
    <% if (!c.rows.length) { %><%- empty('Personne sur ce continent.') %><% } else { %>
    <div class="overflow-x-auto">
      <table class="<%= ui.table %>">
        <thead><tr><th class="w-20">Rang</th><th><%= c.of === 'tribes' ? 'Tribu' : 'Joueur' %></th><th class="text-right">Points sur <%= c.k %></th><th class="text-right">Villages</th></tr></thead>
        <tbody>
        <% c.rows.forEach((r, i) => { %>
          <tr class="<%= r.player && isMe(r.player) ? ui.rowActive : '' %>">
            <td><%- rankCell(i) %></td>
            <td class="font-bold text-parchment-100">
              <% if (r.tribe) { %><span class="inline-flex items-center gap-2 whitespace-nowrap"><span class="<%= ui.tagGold %>"><%= r.tribe.tag %></span><%= r.tribe.name %></span><% } else { %><%= r.player.name %><% } %>
            </td>
            <td class="text-right font-extrabold tabular-nums"><%= num(r.points) %></td>
            <td class="text-right tabular-nums"><%= r.villages %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  <% } else if (type === 'kills') { %>
    <% if (!kills.length) { %><%- empty("Personne n'a encore vaincu d'adversaire.") %><% } else { %>
    <div class="overflow-x-auto">
      <table class="<%= ui.table %>">
        <thead><tr><th class="w-20">Rang</th><th>Joueur</th><th>Tribu</th><th class="text-right">Points</th></tr></thead>
        <tbody>
        <% kills.forEach(({ player: p, score }, i) => { %>
          <tr class="<%= isMe(p) ? ui.rowActive : '' %>">
            <td><%- rankCell(i) %></td>
            <td class="font-bold text-parchment-100"><%= p.name %></td>
            <td><%- tribeTag(p.Tribe) %></td>
            <td class="text-right font-extrabold tabular-nums"><%= num(score) %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  <% } else if (type === 'players') { %>
    <div class="overflow-x-auto">
      <table class="<%= ui.table %>">
        <thead><tr><th class="w-20">Rang</th><th>Joueur</th><th>Tribu</th><th class="text-right">Points</th><th class="text-right">Villages</th></tr></thead>
        <tbody>
        <% players.forEach((p, i) => { %>
          <tr class="<%= isMe(p) ? ui.rowActive : '' %>">
            <td><%- rankCell(i) %></td>
            <td class="font-bold text-parchment-100"><%= p.name %></td>
            <td><%- tribeTag(p.Tribe) %></td>
            <td class="text-right font-extrabold tabular-nums"><%= num(p.points) %></td>
            <td class="text-right tabular-nums"><%= p.villageCount %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <% if (!tribes.length) { %><%- empty('Aucune tribu sur ce monde.') %><% } else { %>
    <div class="overflow-x-auto">
      <table class="<%= ui.table %>">
        <thead><tr><th class="w-20">Rang</th><th>Tribu</th><th class="text-right">Membres</th><th class="text-right">Points</th><th class="text-right">Villages</th></tr></thead>
        <tbody>
        <% tribes.forEach((r, i) => { %>
          <tr>
            <td><%- rankCell(i) %></td>
            <td class="font-bold text-parchment-100"><span class="inline-flex items-center gap-2 whitespace-nowrap"><span class="<%= ui.tagGold %>"><%= r.tribe.tag %></span><%= r.tribe.name %></span></td>
            <td class="text-right tabular-nums"><%= r.members %></td>
            <td class="text-right font-extrabold tabular-nums"><%= num(r.points) %></td>
            <td class="text-right tabular-nums"><%= r.villages %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  <% } %>
  <%- corners() %>
</section>
<%- include('partials/footer') %>
