<%- include('partials/header', { title: 'Boutique' }) %>
<%
  // Catalogue de la boutique (game/shopCatalog.js) : premium, pack, thèmes, designs. Chaque article mène à ses offres
  // (un monde, tout le compte, tout un serveur privé). `rights` : droits du compte seul, pour « Possédé partout ».
  const q = world ? `?world=${encodeURIComponent(world)}` : '';
  const from = (it) => Math.min(...it.offers.map((o) => o.price));
  const sections = [
    ['premium', 'Premium et pack', 'Des fonctionnalités en plus pour une durée choisie, ou tout l’habillage du jeu en un seul achat (nouveautés comprises).', items.filter((i) => i.kind === 'premium' || i.kind === 'bundle')],
    ['themes', 'Thèmes de jeu', 'Change tout l’intérieur du jeu : couleurs, polices, fonds. Le thème Adarma reste gratuit.', items.filter((i) => i.kind === 'theme')],
    ['designs', 'Designs de village', 'L’apparence de tes villages sur la carte, vue par tous les joueurs. Le design Beige reste gratuit.', items.filter((i) => i.kind === 'design')],
  ];
  const preview = (it) => {
    if (it.kind === 'theme') return `<div class="aspect-966/580 border-2 border-black bg-cover bg-center" style="background-image: url('/img/game-styles/${it.styleId}/background-preview.webp')" aria-hidden="true"></div>`;
    if (it.kind === 'design') return `<div class="grid grid-cols-3 gap-1 border-2 border-black bg-[url(/img/map/terrain-grass.webp)] bg-size-[220px] p-2" aria-hidden="true">${[2, 4, 6].map((l) => `<span class="village-design-preview-cell"><span class="village-marker village-marker--${l} village-design--${it.designId}"><span class="village-sprite"></span></span></span>`).join('')}</div>`;
    const artwork = { premium: 'premium', 'cosmetics:all': 'all-cosmetics' }[it.key];
    if (artwork) return `<div class="flex h-24 items-center justify-center border-2 border-black bg-night" aria-hidden="true"><img src="/img/shop/${artwork}.webp" width="512" height="512" class="h-full max-w-full object-contain p-1" alt="" loading="lazy" decoding="async"></div>`;
    return `<div class="flex h-24 items-center justify-center border-2 border-black bg-night text-gold-400" aria-hidden="true">${icon(it.kind === 'premium' ? 'bolt' : 'star', 'size-10', 1.6)}</div>`;
  };
%>
<div class="flex flex-col gap-3.5 pb-4">
  <%- include('partials/page-title', { kicker: 'Adarma', title: 'Boutique', sub: 'Le jeu reste gratuit : la boutique ajoute des options et de l’habillage, pour un monde, pour tout ton compte ou pour tout ton serveur.' }) %>

  <section class="<%= ui.panel %> flex flex-wrap items-center justify-between gap-3 px-4 py-3">
    <span class="flex items-center gap-3">
      <span class="<%= ui.medallionGold %> size-10"><%- icon('adarton', 'size-5', 2) %></span>
      <span class="flex flex-col leading-tight">
        <span class="text-[13px] text-parchment-500">Ton solde</span>
        <span class="font-display text-xl font-semibold text-gold-200 tabular-nums"><%= num(user.adartons) %> Adartons</span>
      </span>
    </span>
    <span class="flex flex-wrap gap-2">
      <a href="/shop/adartons" class="<%= btn('gold', 'sm') %>"><%- icon('plus', 'size-3.5', 2.4) %>Acheter des Adartons</a>
      <a href="/shop/purchases" class="<%= btn('dark', 'sm') %>">Mes achats</a>
    </span>
  </section>

  <% for (const [id, title, intro, list] of sections) { if (!list.length) continue; %>
    <section class="<%= ui.panel %>" id="<%= id %>">
      <%- panelHead(title) %>
      <p class="border-b border-bronze-900 px-4 py-2.5 text-sm text-parchment-400"><%= intro %></p>
      <div class="grid gap-3 p-4 sm:grid-cols-2 lg:grid-cols-3">
        <% for (const it of list) { const owned = rights.keys.has(it.key) || (it.kind !== 'premium' && rights.has(it.key)); %>
          <a href="/shop/item/<%= encodeURIComponent(it.key) %><%= q %>" class="group flex flex-col gap-2 border-2 border-black bg-panel-top p-1 text-parchment-200 no-underline shadow-[inset_0_0_0_1px_var(--color-bronze-700),4px_4px_0_#050505] transition hover:shadow-[inset_0_0_0_2px_var(--color-gold-400),4px_4px_0_#050505]">
            <%- preview(it) %>
            <span class="flex flex-1 flex-col gap-1.5 px-2.5 pb-2.5">
              <span class="flex items-center justify-between gap-2">
                <span class="font-display text-lg font-semibold text-gold-400 group-hover:text-gold-200"><%= it.name %></span>
                <% if (owned) { %><span class="<%= ui.tagGold %>"><%= it.kind === 'premium' ? 'Actif' : 'Possédé' %></span><% } %>
              </span>
              <span class="text-sm text-parchment-400"><%= it.description %></span>
              <span class="mt-auto flex items-center gap-1.5 text-sm text-parchment-300"><%- icon('adarton', 'size-3.5', 2) %>à partir de <span class="font-semibold text-gold-200 tabular-nums"><%= num(from(it)) %></span> Adartons</span>
            </span>
          </a>
        <% } %>
      </div>
    </section>
  <% } %>
  <p class="text-sm text-parchment-500">Les achats sont régis par les <a href="/cgv" class="<%= ui.link %>">conditions générales de vente</a>.</p>
</div>
<%- include('partials/footer') %>
