<%- include('partials/header', { title: 'Acheter des Adartons' }) %>
<%# Packs d'Adartons (game/shopCatalog.js PACKS) : pas encore de moyen de paiement, « Acheter » mène à une page En construction. %>
<div class="flex flex-col gap-3.5 pb-4">
  <a href="/shop<%= shopQuery %>" class="<%= ui.link %> inline-flex items-center gap-1.5 self-start text-sm"><%- icon('arrowLeft', 'size-3.5', 2.2) %>Boutique</a>
  <%- include('partials/page-title', { kicker: 'Boutique', title: 'Acheter des Adartons', sub: 'Les Adartons servent à débloquer les articles de la boutique. Ils ne sont ni remboursables, ni convertibles en argent.' }) %>
  <%- include('partials/adarton-balance', { compact: true }) %>
  <%- include('partials/happy-hour') %>
  <section class="<%= ui.panel %>">
    <%- panelHead('Packs d’Adartons') %>
    <%# Une pile de pièces par pack, plus haute à chaque pack ; repères « le plus choisi » et « meilleure affaire ». %>
    <div class="grid gap-3 p-4 sm:grid-cols-3 lg:grid-cols-5">
      <% packs.forEach((p, i) => { const tag = i === 2 ? 'Le plus choisi' : i === packs.length - 1 ? 'Meilleure affaire' : null; %>
        <div class="relative flex flex-col items-center gap-2 border-2 border-black bg-panel-top px-3 pt-5 pb-4 text-center <%= tag ? 'shadow-[inset_0_0_0_2px_var(--color-gold-400),4px_4px_0_#050505]' : 'shadow-[inset_0_0_0_1px_var(--color-bronze-700),4px_4px_0_#050505]' %>">
          <% if (tag) { %><span class="absolute -top-2.5 left-1/2 -translate-x-1/2 border-2 border-black bg-gold-400 px-2 text-[11px] font-semibold whitespace-nowrap text-night"><%= tag %></span><% } %>
          <span class="relative flex h-24 w-full items-end justify-center bg-[radial-gradient(ellipse_at_50%_80%,rgba(227,178,60,0.25),transparent_65%)]" aria-hidden="true">
            <% for (let c = 0; c <= i; c++) { const off = (c - i / 2) * 14; %>
              <span class="absolute bottom-0" style="transform: translate(<%= off %>px, <%= -Math.abs(c - i / 2) * 3 - (c % 2) * 4 %>px) rotate(<%= (c - i / 2) * 7 %>deg); z-index: <%= 10 - Math.abs(Math.round(c - i / 2)) %>">
                <%- icon('adarton', `size-20 drop-shadow-[2px_3px_0_rgba(0,0,0,0.6)]`) %>
              </span>
            <% } %>
          </span>
          <% const credit = packCredit(p, now); %>
          <span class="mt-1 text-3xl font-semibold text-gold-200 tabular-nums [text-shadow:2px_2px_0_#000]"><%= num(credit.total) %></span>
          <% if (credit.bonus) { %>
            <span class="text-[13px] text-parchment-400 tabular-nums"><%= num(credit.base) %> <span class="font-semibold text-gold-200">+ <%= num(credit.bonus) %> offerts</span></span>
          <% } %>
          <span class="text-[13px] text-parchment-500">Adartons<% if (p.bonus) { %> · <span class="font-semibold text-olive-300"><%= p.bonus %></span><% } %></span>
          <a href="/shop/coming-soon?pack=<%= p.id %><%= world ? `&world=${encodeURIComponent(world)}` : '' %>" class="<%= btn('gold', 'sm', 'mt-1 w-full') %>">Acheter · <%= p.price %></a>
        </div>
      <% }) %>
    </div>
    <p class="border-t border-bronze-900 px-4 py-2.5 text-[13px] text-parchment-500">Prix toutes taxes comprises. Bonus calculé par rapport au premier pack. Voir les <a href="/cgv" class="<%= ui.link %>">conditions générales de vente</a>.</p>
  </section>
</div>
<%- include('partials/footer') %>
