<%- include('partials/header', { title: buildingName(building) }) %>
<% const rtab = typeof tab !== 'undefined' ? tab : 'recruit';
   const vid = ctx.village.id;
   const tabsHtml = level > 0 && building !== 'snob'
     ? segTabs([[`/village/${vid}/recruit/${building}`, 'Recrutement', rtab === 'recruit'], [`/village/${vid}/recruit/${building}?tab=dismiss`, 'Désaffectation', rtab === 'dismiss']])
     : '';
   const maxBtn = `${ui.link} cursor-pointer text-xs tabular-nums`; %>
<div class="flex flex-col gap-5">
  <%- include('partials/building-header', { buildingId: building , illustration: 'wide' }) %>

  <%# Comme sur GT : grande illustration du bâtiment à gauche sur les écrans larges (vignette dans l'en-tête sinon). %>
  <div class="<%= ui.buildingGrid %>">
    <div class="<%= ui.buildingAside %>"><%- include('partials/building-illustration', { buildingId: building }) %></div>
    <div class="flex min-w-0 flex-col gap-5">

<% if (rtab === 'dismiss' && level > 0) { %>
  <%- include('partials/recruit/dismiss', { rtab, vid, tabsHtml, maxBtn }) %>
<% } else { %>
  <%- include('partials/recruit/units', { rtab, vid, tabsHtml, maxBtn }) %>
<% } %>

<% if (building === 'statue' && typeof skilled !== 'undefined') { %>
  <%- include('partials/recruit/skilled-knights', { rtab, vid, tabsHtml, maxBtn }) %>
<% } %>

<% if (building === 'statue' && typeof knight !== 'undefined' && knight.enabled) { %>
  <%- include('partials/recruit/knight', { rtab, vid, tabsHtml, maxBtn }) %>
<% } %>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
