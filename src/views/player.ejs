<%- include('partials/header', { title: subject.name }) %>
<%
  // Profil d'un joueur, organisé comme sur Guerre Tribale : à gauche la mini-carte, la fiche et les villages
  // (ordre alphabétique) ; à droite le texte personnel puis les succès obtenus, par catégorie.
  const vid = ctx.village.id;
  const killsTotal = subject.killsAttacker + subject.killsDefender + subject.killsSupporter;
  const fmt = (a) => a.value == null ? '—' : a.def.rank ? `${num(a.value)}ᵉ` : num(a.value);
  const tierName = (t) => TIER_NAMES[t - 1].charAt(0).toUpperCase() + TIER_NAMES[t - 1].slice(1);
  // Illustrations et paliers (rien, bois, bronze, argent, or) communs avec les rapports de succès.
  const achImage = ACHIEVEMENT_IMAGES;
  const medal = TIER_STYLES.medal;
  const tierMedal = TIER_STYLES.border;
  const tierText = TIER_STYLES.text;
  const GROUPS = [['progress', 'Étapes'], ['battle', 'Combat'], ['misc', 'Divers']];
  const mm = miniMap;
  // Même liste d'actions que sur la fiche d'un village : une ligne cliquable et un séparateur par action.
  const action = 'flex w-full cursor-pointer items-center gap-2.5 border-b border-bronze-800 px-3 py-2 text-left font-semibold text-parchment-200 no-underline transition hover:bg-row-hover hover:text-parchment-50';
  const actionIcon = (name) => `<span class="flex w-5 justify-center text-gold-400">${icon(name, 'size-4', 2)}</span>`;
  const stats = [
    ['Points', num(subject.points)],
    ['Rang', `${num(rank)}ᵉ`],
    ['Adversaires vaincus', `${num(killsTotal)}${killsRank ? ` (${num(killsRank)}ᵉ)` : ''}`,
      `En attaque ${num(subject.killsAttacker)} · en défense ${num(subject.killsDefender)} · en soutien ${num(subject.killsSupporter)}`],
  ];
%>
<%# Thème du propriétaire du profil, limité au contenu : `contents` ne change pas la mise en page, mais tout ce qu'il
    contient lit les jetons de ce thème ; le calque fixe montre son fond de page derrière le contenu (en dessous de
    l'en-tête et du pied de page, qui gardent le thème du visiteur). %>
<% if (profileStyle) { %><div class="contents font-sans text-parchment-100" data-game-style="<%= profileStyle.id %>"><div class="game-page-bg pointer-events-none fixed inset-0 -z-10 bg-night" aria-hidden="true"></div><% } %>
<h1 class="<%= ui.h1 %>">Profil</h1>

<%# Comme sur GT : à gauche la fiche (mini-carte, chiffres, tribu) et les villages ; à droite le texte et les succès. %>
<div class="grid grid-cols-1 items-start gap-5 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)]">
  <div class="flex min-w-0 flex-col gap-5">
    <section class="<%= ui.panel %>">
      <%- panelHead(subject.Tribe ? `${subject.name} [${subject.Tribe.tag}]` : subject.name, `${subject.isBot ? botTag() : ''}${avatarThumb('player', { avatar: ownerPremium ? subject.avatar : null })}`) %>
      <% if (mm) { %>
        <a href="/village/<%= vid %>/map?x=<%= mm.cx %>&y=<%= mm.cy %>" class="block border-b-2 border-black bg-mini-bg" title="Voir sur la carte">
          <canvas class="block w-full" style="aspect-ratio:<%= mm.width %>/<%= mm.height %>" data-minimap="<%= JSON.stringify({ x0: mm.x0, y0: mm.y0, width: mm.width, height: mm.height, villages: mm.villages }) %>" role="img" aria-label="Villages de <%= subject.name %> sur la carte"></canvas>
        </a>
      <% } %>
      <table class="<%= ui.table %> text-sm [&_td]:py-1.5">
        <tbody>
          <% for (const [label, value, title] of stats) { %>
            <tr><td class="w-2/5 text-parchment-500"><%= label %></td><td class="font-semibold text-parchment-100 tabular-nums"<% if (title) { %> title="<%= title %>"<% } %>><%= value %></td></tr>
          <% } %>
          <tr>
            <td class="text-parchment-500">Tribu</td>
            <td><%- subject.Tribe ? tribeLink(vid, subject.Tribe, { name: true, tagCls: ui.tagGold, avatar: true }) : '<span class="text-parchment-500">Sans tribu</span>' %></td>
          </tr>
        </tbody>
      </table>
    </section>

    <% if (!isMe) { %>
      <section class="<%= ui.panel %>">
        <%- panelHead('Actions') %>
        <div class="flex flex-col [&>*:last-child]:border-b-0 [&>form:last-child>button]:border-b-0">
          <% if (!subject.isBot) { %><a href="/village/<%= vid %>/messages/new?to=<%= encodeURIComponent(subject.name) %>" class="<%= action %>"><%- actionIcon('messages') %>Écrire un message</a><% } %>
          <% if (canInvite && !subject.isBot) { %>
            <form method="post" action="/village/<%= vid %>/tribe/invite"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="name" value="<%= subject.name %>">
              <button class="<%= action %>"><%- actionIcon('tribe') %>Inviter dans ma tribu</button>
            </form>
          <% } %>
          <a href="/village/<%= vid %>/map?<%= new URLSearchParams({ mark: `player:${subject.id}`, label: subject.name }) %>#marquages" class="<%= action %>"><%- actionIcon('flag') %>Marquer sur la carte</a>
        </div>
      </section>
    <% } %>

    <%# Villages, par ordre alphabétique %>
    <section class="<%= ui.panel %>">
      <%- panelHead(`Villages (${villages.length})`) %>
      <div class="overflow-x-auto">
        <table class="<%= ui.table %> text-sm [&_td]:px-3 [&_td]:py-1.5 [&_th]:px-3">
          <thead><tr><th>Village</th><th class="text-right">Points</th></tr></thead>
          <tbody>
          <% for (const v of villages) { %>
            <tr>
              <td class="max-w-0 w-full"><%- villageLink(vid, v, { truncate: true }) %></td>
              <td class="text-right font-semibold tabular-nums"><%= num(v.points) %></td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <div class="flex min-w-0 flex-col gap-5">
    <%# Image du profil (comme le blason de GT), masquée chez les autres joueurs s'ils n'en ont pas %>
    <% if (isMe || (ownerPremium && subject.avatar)) { %>
    <section class="<%= ui.panel %>" id="image">
      <%- panelHead('Image du profil') %>
      <div class="<%= ui.panelBody %>">
        <% if (subject.avatar) { %>
          <%- avatarImage('player', subject, { cls: ownerPremium ? 'mx-auto' : 'mx-auto grayscale opacity-50' }) %>
          <% if (!ownerPremium) { %><p class="text-center text-[13px] text-parchment-500">Aperçu privé : cette image n’est plus visible par les autres joueurs sans premium.</p><% } %>
        <% } else { %>
          <p class="text-center text-parchment-500">Vous n'avez pas encore d'image de profil.</p>
        <% } %>
        <% if (isMe && ownerPremium) { %>
          <details class="border-t border-bronze-800 pt-3" <%= subject.avatar ? '' : 'open' %>>
            <summary class="flex cursor-pointer list-none items-center gap-2 font-semibold text-gold-400 hover:text-parchment-100 [&::-webkit-details-marker]:hidden"><%- icon('edit', 'size-3.5', 2.2) %>Modifier</summary>
            <div class="mt-2.5"><%- include('partials/avatar-form', { action: `/village/${vid}/profile/avatar`, avatar: subject.avatar }) %></div>
          </details>
        <% } else if (isMe && subject.avatar) { %>
          <form method="post" action="/village/<%= vid %>/profile/avatar/delete" class="border-t border-bronze-800 pt-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="<%= btn('dark', 'sm') %>">Supprimer l'image</button>
          </form>
        <% } %>
      </div>
      <% if (isMe && !ownerPremium) { %>
        <%# Sans premium : même bandeau pleine largeur et même fond que dans le quartier général. %>
        <%- include('partials/premium-banner', {
          href: `/shop/item/premium?world=${encodeURIComponent(ctx.world.slug)}`, highlight: true,
          title: 'L’image de profil est réservée au premium.', detail: 'Mets ta propre image sur ton profil · dès 30 Adartons',
        }) %>
      <% } %>
    </section>
    <% } %>

    <%# Texte personnel %>
    <section class="<%= ui.panel %>" id="texte">
      <%- panelHead('Texte personnel') %>
      <div class="<%= ui.panelBody %>">
        <% if (subject.profileText) { %>
          <p class="text-center whitespace-pre-line wrap-break-word text-parchment-200"><%= subject.profileText %></p>
        <% } else { %>
          <p class="text-center text-parchment-500"><%= isMe ? "Vous n'avez pas encore écrit de texte personnel." : "Ce joueur n'a pas encore écrit de texte personnel." %></p>
        <% } %>
        <% if (isMe) { %>
          <details class="border-t border-bronze-800 pt-3" <%= subject.profileText ? '' : 'open' %>>
            <summary class="flex cursor-pointer list-none items-center gap-2 font-semibold text-gold-400 hover:text-parchment-100 [&::-webkit-details-marker]:hidden"><%- icon('edit', 'size-3.5', 2.2) %>Modifier</summary>
            <form method="post" action="/village/<%= vid %>/profile/text" class="mt-2.5 flex flex-col gap-2.5"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <textarea name="profileText" rows="6" maxlength="2000" class="<%= ui.textarea %> w-full" aria-label="Texte personnel" placeholder="Présentez-vous : recrutement, horaires, devise…"><%= subject.profileText || '' %></textarea>
              <button class="<%= btn('gold', 'md', 'self-start') %>">Enregistrer</button>
            </form>
          </details>
        <% } %>
      </div>
    </section>

    <%# Succès quotidiens, en tête des succès (ceux obtenus au moins une fois ; tous sur son propre profil) ; porte l'ancre #succes. %>
    <% const shownDaily = isMe ? daily : daily.filter((d) => d.count); %>
    <% if (shownDaily.length) { %>
    <section class="<%= ui.panel %> scroll-mt-28" id="succes">
      <%- panelHead('Succès quotidiens', `<span class="text-[13px] text-parchment-500">4 points chacun</span>`) %>
      <ul class="grid grid-cols-2 gap-2 p-3 sm:grid-cols-3">
        <% for (const d of shownDaily) { %>
          <li class="flex items-center gap-2.5 border px-2.5 py-2 <%= d.count ? 'border-bronze-500 bg-linear-to-b from-gold-400/12 to-gold-400/2' : 'border-bronze-900 bg-black/25' %>" title="<%= d.def.text ? 'Avoir ' + d.def.text + ' dans la journée' : d.def.name %>">
            <span class="<%= medal %> shrink-0 <%= d.count ? tierMedal[4] : tierMedal[0] %> achievement-art achievement-art--daily" data-achievement-tier="<%= d.count ? 4 : 0 %>"><img src="<%= achImage[d.def.key] %>" alt="" width="96" height="96"></span>
            <span class="flex min-w-0 flex-col">
              <span class="text-lg leading-none font-semibold tabular-nums <%= d.count ? 'text-gold-200' : 'text-parchment-600' %>"><%= d.count %></span>
              <span class="truncate text-xs <%= d.count ? 'text-parchment-300' : 'text-parchment-500' %>"><%= d.def.name %></span>
              <% if (d.best) { %><span class="text-[11px] leading-tight text-parchment-500">Meilleur score : <span class="tabular-nums text-parchment-300"><%= num(d.best.value) %></span><br><% const bestDay = dayLabel(d.best.day, now); %><%= /^\d/.test(bestDay) ? `le ${bestDay}` : bestDay %></span><% } %>
            </span>
          </li>
        <% } %>
      </ul>
    </section>
    <% } %>

    <%# Succès obtenus, par catégorie ; les autres dans un volet repliable %>
    <% let anchored = shownDaily.length > 0;
       for (const [group, title] of GROUPS) {
         const list = achievements.filter((a) => a.def.group === group);
         const won = list.filter((a) => a.tier).sort((a, b) => b.tier - a.tier);
         // Profil d'un autre joueur : seules les catégories où il a obtenu quelque chose, comme sur GT.
         if (!list.length || (!isMe && !won.length)) continue;
         const rest = list.filter((a) => !a.tier || a.tier < a.def.tiers.length);
         // Ancre #succes (lien « Voir vos succès » des rapports) sur la première section de succès.
         const anchor = anchored ? '' : ' id="succes"'; anchored = true; %>
      <section class="<%= ui.panel %> scroll-mt-28"<%- anchor %>>
        <%- panelHead(`Succès · ${title}`, `<span class="text-[13px] text-parchment-500 tabular-nums">${won.length} / ${list.length}</span>`) %>
        <% if (!won.length) { %><p class="<%= ui.empty %>">Aucun succès obtenu dans cette catégorie.</p><% } %>
        <ul>
          <% for (const a of won) { const multi = a.def.tiers.length > 1; %>
            <li class="flex items-center gap-3.5 border-b border-bronze-800 px-4 py-2.5 last:border-b-0">
              <span class="<%= medal %> <%= tierMedal[a.tier] %> achievement-art achievement-art--main" data-achievement-tier="<%= a.tier %>"><img src="<%= achImage[a.def.key] %>" alt="" width="96" height="96"></span>
              <span class="flex min-w-0 flex-col gap-0.5">
                <span class="font-semibold text-parchment-100"><%= a.def.name %><% if (multi) { %> <span class="<%= tierText[a.tier] %>">(<%= tierName(a.tier) %> · niveau <%= a.tier %>)</span><% } %></span>
                <span class="text-[13px] leading-snug text-parchment-400"><%= a.def.description %></span>
                <span class="text-xs text-parchment-500 tabular-nums">Total : <strong class="font-bold text-parchment-100"><%= fmt(a) %></strong></span>
              </span>
            </li>
          <% } %>
        </ul>
        <% if (isMe && rest.length) { %>
          <details class="group border-t border-bronze-800">
            <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-2 text-[13px] font-semibold text-gold-400 hover:text-parchment-100 [&::-webkit-details-marker]:hidden"><%- icon('plus', 'size-3', 2.6) %>Prochains paliers (<%= rest.length %>)</summary>
            <ul class="grid gap-1.5 px-4 pb-3 sm:grid-cols-2">
              <% for (const a of rest) { const next = a.def.tiers[a.tier];
                   const pct = !a.def.rank && a.value != null ? Math.max(0, Math.min(100, (a.value / next) * 100)) : null; %>
                <li class="flex items-center gap-2.5 border border-bronze-900 bg-black/25 p-2">
                  <span class="<%= medal %> <%= tierMedal[a.tier] %> achievement-art achievement-art--compact opacity-70" data-achievement-tier="<%= a.tier %>"><img src="<%= achImage[a.def.key] %>" alt="" width="96" height="96"></span>
                  <span class="flex min-w-0 flex-1 flex-col gap-1">
                    <span class="flex items-baseline justify-between gap-2 text-[13px]"><span class="truncate font-semibold text-parchment-300"><%= a.def.name %></span><span class="shrink-0 text-parchment-500 tabular-nums"><%= fmt(a) %> / <%= a.def.rank ? num(next) + 'ᵉ' : num(next) %></span></span>
                    <% if (pct != null) { %><span class="<%= ui.track %> h-1"><span class="<%= ui.fill %>" style="width: <%= pct.toFixed(1) %>%"></span></span><% } %>
                  </span>
                </li>
              <% } %>
            </ul>
          </details>
        <% } %>
      </section>
    <% } %>

  </div>
</div>
<% if (profileStyle) { %></div><% } %>
<% if (mm) { %><script src="<%= asset('/js/terrain.js') %>" defer></script>
<script src="<%= asset('/js/minimap.js') %>" defer></script><% } %>
<%- include('partials/footer') %>
