<%- include('partials/header', { title: subject.name }) %>
<%
  // Profil d'un joueur, organisé comme sur Guerre Tribale : à gauche la mini-carte, la fiche, les actions et les
  // villages (ordre alphabétique) ; à droite le texte personnel puis les succès obtenus, par catégorie.
  const vid = ctx.village.id;
  const killsTotal = subject.killsAttacker + subject.killsDefender + subject.killsSupporter;
  const fmt = (a) => a.value == null ? '—' : a.def.rank ? `${num(a.value)}ᵉ` : num(a.value);
  const tierName = (t) => TIER_NAMES[t - 1].charAt(0).toUpperCase() + TIER_NAMES[t - 1].slice(1);
  // Icône de chaque succès et de chaque succès quotidien.
  const achIcon = {
    points: 'ranking', topscorer: 'crown', continent: 'map', robber: 'coin', plunderer: 'attack', conqueror: 'flag', leader: 'sword',
    hero: 'support', vandal: 'catapult', wallbreaker: 'wall', butcher: 'axe', kingslayer: 'crown', reinforcement: 'support',
    counterspy: 'eye', warlord: 'attack', lucky: 'victory', unlucky: 'victory', merchant: 'market', croesus: 'coin',
    brothers: 'tribe', paladin: 'helm', worldWinner: 'victory', phoenix: 'bolt',
  };
  const dailyIcon = { dailyPlunderer: 'attack', dailyAttacker: 'sword', dailyDefender: 'wall', dailyConqueror: 'crown', dailyRobber: 'coin', dailySupporter: 'support' };
  // Palier atteint : rien, bois, bronze, argent, or.
  const medal = 'flex shrink-0 items-center justify-center border-2 bg-night shadow-[2px_2px_0_#000]';
  const tierMedal = ['border-bronze-800 text-parchment-700', 'border-wood text-wood', 'border-bronze-300 text-bronze-200', 'border-iron text-iron', 'border-gold-400 text-gold-200'];
  const tierText = ['text-parchment-600', 'text-wood', 'text-bronze-200', 'text-iron', 'text-gold-200'];
  const score = achievements.reduce((n, a) => n + a.tier, 0);
  const GROUPS = [['progress', 'Étapes'], ['battle', 'Combat'], ['misc', 'Divers']];
  const actionItem = 'flex items-center gap-2.5 border-b border-bronze-800 px-3 py-2 font-semibold text-parchment-200 no-underline transition last:border-b-0 hover:bg-row-hover hover:text-gold-200';
  const mm = miniMap;
  const mmFill = { player: 'fill-parchment-100', tribe: 'fill-rel-tribe', other: 'fill-rel-other', barb: 'fill-rel-barb-dim' };
  const stats = [
    ['Points', num(subject.points)],
    ['Rang', `${num(rank)}ᵉ`],
    ['Adversaires vaincus', `${num(killsTotal)}${killsRank ? ` (${num(killsRank)}ᵉ)` : ''}`],
    ['Villages', num(villages.length)],
    ['Succès', `${score} points`],
  ];
%>
<div class="flex flex-col gap-1">
  <h1 class="<%= ui.h1 %>"><%= subject.name %><% if (subject.Tribe) { %> <span class="font-sans text-lg font-medium text-blood-450">[<%= subject.Tribe.tag %>]</span><% } %></h1>
</div>

<div class="grid grid-cols-1 items-start gap-5 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)]">
  <div class="flex min-w-0 flex-col gap-5">
    <%# Fiche : mini-carte et statistiques %>
    <section class="<%= ui.panel %>">
      <%- panelHead(subject.name, `<span class="${ui.medallion} size-7">${icon('profile', 'size-3.5')}</span>`) %>
      <% if (mm) { %>
        <a href="/village/<%= vid %>/map?x=<%= mm.cx %>&y=<%= mm.cy %>" class="block border-b-2 border-black bg-mini-bg" title="Voir sur la carte">
          <svg viewBox="0 0 <%= mm.width %> <%= mm.height %>" class="block w-full" shape-rendering="crispEdges" role="img" aria-label="Villages de <%= subject.name %> sur la carte">
            <rect width="<%= mm.width %>" height="<%= mm.height %>" class="fill-mini-grass-1"/>
            <% for (let i = 0; i < mm.width; i++) { const x = mm.x0 + i; if (x % 10) continue; %><rect x="<%= i %>" y="0" width="<%= x % 100 === 0 ? 0.5 : 0.12 %>" height="<%= mm.height %>" class="<%= x % 100 === 0 ? 'fill-gold-400/70' : 'fill-black/40' %>"/><% } %>
            <% for (let i = 0; i < mm.height; i++) { const y = mm.y0 + i; if (y % 10) continue; %><rect x="0" y="<%= i %>" width="<%= mm.width %>" height="<%= y % 100 === 0 ? 0.5 : 0.12 %>" class="<%= y % 100 === 0 ? 'fill-gold-400/70' : 'fill-black/40' %>"/><% } %>
            <% for (const k of ['barb', 'other', 'tribe', 'player']) { for (const v of mm.villages) { if (v.kind !== k) continue; %><% if (k === 'player') { %><rect x="<%= v.x - mm.x0 - 0.15 %>" y="<%= v.y - mm.y0 - 0.15 %>" width="1.3" height="1.3" class="fill-parchment-100 stroke-black stroke-[0.2]"/><% } else { %><rect x="<%= v.x - mm.x0 + 0.1 %>" y="<%= v.y - mm.y0 + 0.1 %>" width="0.8" height="0.8" class="<%= mmFill[k] %>"/><% } %><% } } %>
          </svg>
        </a>
        <div class="flex flex-wrap gap-x-3 gap-y-1 border-b border-bronze-800 px-3 py-1.5 text-[11px] text-parchment-500">
          <span class="inline-flex items-center gap-1.5"><span class="size-2 bg-parchment-100"></span>Ce joueur</span>
          <% if (subject.Tribe) { %><span class="inline-flex items-center gap-1.5"><span class="size-2 bg-rel-tribe"></span>Sa tribu</span><% } %>
          <span class="inline-flex items-center gap-1.5"><span class="size-2 bg-rel-other"></span>Autres joueurs</span>
          <span class="inline-flex items-center gap-1.5"><span class="size-2 bg-rel-barb-dim"></span>Barbares</span>
        </div>
      <% } %>
      <table class="<%= ui.table %> text-sm [&_td]:py-1.5">
        <tbody>
          <% for (const [label, value] of stats) { %>
            <tr><td class="w-1/2 text-parchment-500"><%= label %></td><td class="font-bold text-parchment-100 tabular-nums"><%= value %></td></tr>
          <% } %>
          <tr>
            <td class="text-parchment-500">Tribu</td>
            <td><%- subject.Tribe ? tribeLink(vid, subject.Tribe, { name: true, tagCls: ui.tagGold }) : '<span class="text-parchment-500">Sans tribu</span>' %></td>
          </tr>
          <tr>
            <td class="text-parchment-500">ODA · ODD · ODS</td>
            <td class="text-parchment-300 tabular-nums"><%= num(subject.killsAttacker) %> · <%= num(subject.killsDefender) %> · <%= num(subject.killsSupporter) %></td>
          </tr>
        </tbody>
      </table>
    </section>

    <%# Actions %>
    <section class="<%= ui.panel %>">
      <%- panelHead('Actions') %>
      <div class="flex flex-col">
        <% if (!isMe) { %>
          <a href="/village/<%= vid %>/messages/new?to=<%= encodeURIComponent(subject.name) %>" class="<%= actionItem %>"><span class="text-gold-400"><%- icon('messages', 'size-4', 2) %></span>Écrire un message</a>
        <% } %>
        <% if (mm) { %>
          <a href="/village/<%= vid %>/map?x=<%= mm.cx %>&y=<%= mm.cy %>" class="<%= actionItem %>"><span class="text-gold-400"><%- icon('map', 'size-4', 2) %></span>Voir sur la carte</a>
        <% } %>
        <% if (canInvite) { %>
          <form method="post" action="/village/<%= vid %>/tribe/invite" class="contents"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="name" value="<%= subject.name %>">
            <button class="<%= actionItem %> w-full cursor-pointer text-left"><span class="text-gold-400"><%- icon('tribe', 'size-4', 2) %></span>Inviter dans ma tribu</button>
          </form>
        <% } %>
        <a href="/village/<%= vid %>/ranking" class="<%= actionItem %>"><span class="text-gold-400"><%- icon('ranking', 'size-4', 2) %></span>Voir le classement</a>
        <% if (isMe) { %>
          <a href="#texte" class="<%= actionItem %>"><span class="text-gold-400"><%- icon('edit', 'size-4', 2) %></span>Modifier le texte personnel</a>
        <% } %>
      </div>
    </section>

    <%# Villages, par ordre alphabétique %>
    <section class="<%= ui.panel %>">
      <%- panelHead(`Villages (${villages.length})`) %>
      <div class="overflow-x-auto">
        <table class="<%= ui.table %> text-sm [&_td]:px-3 [&_td]:py-1.5 [&_th]:px-3">
          <thead><tr><th>Village</th><th>Coordonnées</th><th class="text-right">Points</th></tr></thead>
          <tbody>
          <% for (const v of villages) { %>
            <tr>
              <td class="max-w-0 w-full"><a href="/village/<%= vid %>/villages/<%= v.id %>" class="<%= ui.linkPlain %> block truncate font-bold"><%= v.name %></a></td>
              <td class="whitespace-nowrap tabular-nums"><a href="/village/<%= vid %>/map?x=<%= v.x %>&y=<%= v.y %>&sx=<%= v.x %>&sy=<%= v.y %>" class="<%= ui.linkPlain %>"><%= v.x %>|<%= v.y %></a> <span class="text-parchment-600"><%= continent(v.x, v.y) %></span></td>
              <td class="text-right font-extrabold tabular-nums"><%= num(v.points) %></td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <div class="flex min-w-0 flex-col gap-5">
    <%# Texte personnel %>
    <section class="<%= ui.panel %>" id="texte">
      <%- panelHead('Texte personnel') %>
      <div class="<%= ui.panelBody %>">
        <% if (subject.profileText) { %>
          <p class="text-center whitespace-pre-line wrap-break-word text-parchment-200"><%= subject.profileText %></p>
        <% } else { %>
          <p class="text-center text-parchment-500"><%= isMe ? "Vous n'avez pas encore écrit de texte personnel." : "Ce joueur n'a pas encore écrit de texte personnel." %></p>
        <% } %>
        <% if (isMe) { %>
          <details class="border-t border-bronze-800 pt-3" <%= subject.profileText ? '' : 'open' %>>
            <summary class="flex cursor-pointer list-none items-center gap-2 font-bold text-gold-400 hover:text-parchment-100 [&::-webkit-details-marker]:hidden"><%- icon('edit', 'size-3.5', 2.2) %>Modifier</summary>
            <form method="post" action="/village/<%= vid %>/profile/text" class="mt-2.5 flex flex-col gap-2.5"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <textarea name="profileText" rows="6" maxlength="2000" class="<%= ui.textarea %> w-full" aria-label="Texte personnel" placeholder="Présentez-vous : recrutement, horaires, devise…"><%= subject.profileText || '' %></textarea>
              <button class="<%= btn('gold', 'md', 'self-start') %>">Enregistrer</button>
            </form>
          </details>
        <% } %>
      </div>
    </section>

    <%# Succès obtenus, par catégorie ; les autres dans un volet repliable %>
    <% for (const [group, title] of GROUPS) {
         const list = achievements.filter((a) => a.def.group === group);
         if (!list.length) continue;
         const won = list.filter((a) => a.tier).sort((a, b) => b.tier - a.tier);
         const rest = list.filter((a) => !a.tier || a.tier < a.def.tiers.length); %>
      <section class="<%= ui.panel %>">
        <%- panelHead(`Succès · ${title}`, `<span class="text-[13px] text-parchment-500 tabular-nums">${won.length} / ${list.length}</span>`) %>
        <% if (!won.length) { %><p class="px-4.5 py-3 text-parchment-500">Aucun succès obtenu dans cette catégorie.</p><% } %>
        <ul>
          <% for (const a of won) { const multi = a.def.tiers.length > 1; %>
            <li class="flex items-center gap-3.5 border-b border-bronze-800 px-4 py-2.5 last:border-b-0">
              <span class="<%= medal %> <%= tierMedal[a.tier] %> size-12"><%- icon(achIcon[a.def.key] || 'victory', 'size-6') %></span>
              <span class="flex min-w-0 flex-col gap-0.5">
                <span class="font-bold text-parchment-100"><%= a.def.name %><% if (multi) { %> <span class="<%= tierText[a.tier] %>">(<%= tierName(a.tier) %> · niveau <%= a.tier %>)</span><% } %></span>
                <span class="text-[13px] leading-snug text-parchment-400"><%= a.def.description %> <span class="text-parchment-500 tabular-nums">— <%= fmt(a) %></span></span>
              </span>
            </li>
          <% } %>
        </ul>
        <% if (rest.length) { %>
          <details class="group border-t border-bronze-800">
            <summary class="flex cursor-pointer list-none items-center gap-2 px-4 py-2 text-[13px] font-bold text-gold-400 hover:text-parchment-100 [&::-webkit-details-marker]:hidden"><%- icon('plus', 'size-3', 2.6) %>Prochains paliers (<%= rest.length %>)</summary>
            <ul class="grid gap-1.5 px-4 pb-3 sm:grid-cols-2">
              <% for (const a of rest) { const next = a.def.tiers[a.tier];
                   const pct = !a.def.rank && a.value != null ? Math.max(0, Math.min(100, (a.value / next) * 100)) : null; %>
                <li class="flex items-center gap-2.5 border border-bronze-900 bg-black/25 p-2">
                  <span class="<%= medal %> <%= tierMedal[a.tier] %> size-8 opacity-70"><%- icon(achIcon[a.def.key] || 'victory', 'size-4') %></span>
                  <span class="flex min-w-0 flex-1 flex-col gap-1">
                    <span class="flex items-baseline justify-between gap-2 text-[13px]"><span class="truncate font-bold text-parchment-300"><%= a.def.name %></span><span class="shrink-0 text-parchment-500 tabular-nums"><%= fmt(a) %> / <%= a.def.rank ? num(next) + 'ᵉ' : num(next) %></span></span>
                    <% if (pct != null) { %><span class="<%= ui.track %> h-1"><span class="<%= ui.fill %>" style="width: <%= pct.toFixed(1) %>%"></span></span><% } %>
                  </span>
                </li>
              <% } %>
            </ul>
          </details>
        <% } %>
      </section>
    <% } %>

    <%# Succès quotidiens %>
    <section class="<%= ui.panel %>">
      <%- panelHead('Succès quotidiens', `<span class="text-[13px] text-parchment-500">4 points chacun</span>`) %>
      <ul class="grid grid-cols-2 gap-2 p-3 sm:grid-cols-3">
        <% for (const d of daily) { %>
          <li class="flex items-center gap-2.5 border px-2.5 py-2 <%= d.count ? 'border-bronze-500 bg-linear-to-b from-gold-400/12 to-gold-400/2' : 'border-bronze-900 bg-black/25' %>" title="<%= d.def.text ? 'Avoir ' + d.def.text + ' dans la journée' : d.def.name %>">
            <span class="<%= medal %> <%= d.count ? tierMedal[4] : tierMedal[0] %> size-9"><%- icon(dailyIcon[d.def.key] || 'victory', 'size-4') %></span>
            <span class="flex min-w-0 flex-col">
              <span class="text-lg leading-none font-extrabold tabular-nums <%= d.count ? 'text-gold-200' : 'text-parchment-600' %>"><%= d.count %></span>
              <span class="truncate text-xs <%= d.count ? 'text-parchment-300' : 'text-parchment-500' %>"><%= d.def.name %></span>
            </span>
          </li>
        <% } %>
      </ul>
    </section>
  </div>
</div>
<%- include('partials/footer') %>
