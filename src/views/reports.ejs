<%- include('partials/header', { title: 'Rapports' }) %>
<%
  const vid = ctx.village.id;
  // Médaillon de type (couleur de la charte et icône) ; attaques et défenses : la gommette commune du résultat
  // (attackDot, comme sur la carte), et l'espionnage sur fond bleu.
  const SPY_MEDAL = 'flex shrink-0 items-center justify-center border-2 border-black bg-[#3f7fd1] text-night shadow-[2px_2px_0_#000]';
  const kind = (r) => {
    const o = reportOutcome(r);
    if (o) {
      const medal = o.spyOnly ? SPY_MEDAL : o.result === 'loss' ? ui.medallionRed : o.result === 'partial' ? ui.medallionGold : ui.medallionOlive;
      return { medal, icon: o.spyOnly ? 'eye' : r.type === 'attack' ? 'attack' : 'wall', dot: attackDot(o.result, 'size-4'), haul: o.haul };
    }
    const plain = (cls) => `<span class="inline-block size-2.5 shrink-0 border border-night ${cls}" aria-hidden="true"></span>`;
    if (r.type === 'support') return { medal: ui.medallionOlive, icon: 'support', dot: plain('bg-olive-300') };
    if (r.type === 'trade') return { medal: ui.medallionGold, icon: 'market', dot: plain('bg-gold-400') };
    if (r.type === 'award') return { medal: ui.medallionGold, icon: 'victory', dot: plain('bg-rel-nap') };
    if (r.type === 'scavenge') return { medal: ui.medallionOlive, icon: 'farm', dot: plain('bg-olive-500') };
    if (r.type === 'world') return { medal: ui.medallionGold, icon: 'crown', dot: plain('bg-rel-special') };
    return { medal: ui.medallion, icon: r.data && r.data.visit ? 'moon' : 'eye', dot: plain('bg-parchment-600') };
  };
  // Sans Collecte ni Succès sur les mondes qui ne les ont pas.
  const tabs = [['all', 'Tous'], ['attack', 'Attaques'], ['defense', 'Défenses'], ['support', 'Soutiens'], ['trade', 'Commerce'], ['scavenge', 'Collecte'], ['award', 'Succès']]
    .filter(([f]) => (f !== 'scavenge' || ctx.cfg.scavenging.active) && (f !== 'award' || ctx.cfg.achievements.active));
  // Boîte de réception ou dossier d'archives (?folder=), en gardant le filtre de type.
  const link = (f, p, fid = all ? 'all' : folder && folder.id) => `/village/${vid}/reports?filter=${f}${fid ? `&folder=${fid}` : ''}${p > 1 ? `&page=${p}` : ''}`;
  // Vue « Tout » : nom du dossier des rapports archivés.
  const folderName = new Map(folders.map((f) => [f.folder.id, f.folder.name]));
  const shopPremium = `/shop/item/premium?world=${encodeURIComponent(ctx.world.slug)}`;
  // Destinations du déplacement : les autres dossiers (premium), et la boîte de réception depuis un dossier.
  const targets = [
    ...(folder || all ? [['', 'Nouveaux rapports']] : []),
    ...(premium ? folders.filter((f) => !folder || f.folder.id !== folder.id).map((f) => [f.folder.id, f.folder.name]) : []),
  ];
%>
<div class="flex flex-col gap-5">
  <section class="<%= ui.panel %>">
    <%- panelHead('Rapports', `
      <div class="flex flex-wrap items-center gap-3">
        <span class="${ui.headCount}">${total}</span>
        <form method="post" action="/village/${vid}/reports/bulk"><input type="hidden" name="_csrf" value="${csrfToken}">
          <button name="action" value="read-all" class="${btn('dark', 'sm')}">${icon('check', 'size-3.5', 2.2)}Tout marquer comme lu</button>
        </form>
      </div>`, { tag: 'h1' }) %>

    <div class="@container"><div class="inbox-hero inbox-hero--reports">
      <p class="inbox-hero__title">Les nouvelles du royaume</p>
      <p class="inbox-hero__subtitle">Batailles, commerce et découvertes de vos villages</p>
    </div></div>

    <%# Comme sur GT : types de rapport et dossiers dans une colonne à gauche (au-dessus sur mobile), la liste à droite. %>
    <div class="grid md:grid-cols-[200px_minmax(0,1fr)]">
    <%- sideNav([
      { heading: 'Type' },
      ...tabs.map(([id, name]) => ({ href: link(id, 1), label: name, active: filter === id })),
      { heading: 'Dossiers' },
      ...(folders.length ? [{ href: link(filter, 1, 'all'), label: 'Tout', active: all }] : []),
      { href: link(filter, 1, null), label: 'Nouveaux rapports', active: !folder && !all },
      ...folders.map((f) => ({ href: link(filter, 1, f.folder.id), label: f.folder.name, active: Boolean(folder) && folder.id === f.folder.id, count: f.total })),
      // Matchup : pas d'archives (premium).
      ...(inMatch ? [] : [{
        href: `/village/${vid}/reports/folders`, icon: icon(premium ? 'edit' : 'reports', 'size-3.5', 2),
        label: premium ? (folders.length ? 'Gérer les dossiers' : 'Créer un dossier') : 'Archives (premium)',
      }]),
    ], { label: 'Rapports', cls: 'border-b border-bronze-800 md:border-r md:border-b-0' }) %>
    <div class="flex min-w-0 flex-col">

    <% if (!reports.length) { %>
      <p class="<%= ui.empty %>">Aucun rapport.</p>
    <% } else { %>
      <%# Chargement progressif (lazyLists) : data-page-ids envoie aussi les rapports pas encore affichés quand « Tout » est coché. %>
      <% const lr = lazy('reports', reports) %>
      <form method="post" action="/village/<%= vid %>/reports/bulk" data-bulk data-page-ids="<%= reports.map((r) => r.id).join(',') %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="flex flex-wrap items-center gap-2 border-b border-bronze-900 bg-black/25 px-4.5 py-2.5">
          <label class="<%= ui.checkLabel %> mr-2 text-sm">
            <input type="checkbox" data-check-all class="<%= ui.checkbox %>"> Tout
          </label>
          <button name="action" value="read" class="<%= btn('dark', 'sm') %>">Marquer lus</button>
          <button name="action" value="unread" class="<%= btn('dark', 'sm') %>">Marquer non lus</button>
          <button name="action" value="delete" class="<%= btn('danger', 'sm') %>"><%- icon('trash', 'size-3.5', 2) %>Supprimer</button>
          <% if (targets.length) { %>
            <span class="flex items-center gap-2">
              <select name="folder" class="<%= ui.inputSm %>" aria-label="Déplacer vers">
                <% for (const [id, name] of targets) { %><option value="<%= id %>"><%= name %></option><% } %>
              </select>
              <button name="action" value="move" class="<%= btn('dark', 'sm') %>">Déplacer</button>
            </span>
          <% } else if (inMatch) { %>
          <% } else if (!premium) { %>
            <a href="<%= shopPremium %>" class="<%= ui.link %> text-sm">Archiver des rapports (premium)</a>
          <% } else { %>
            <a href="/village/<%= vid %>/reports/folders" class="<%= ui.link %> text-sm">Créer un dossier pour archiver</a>
          <% } %>
        </div>
        <ul data-lazy-list="reports">
          <% for (const r of lr.items) { const k = kind(r); %>
            <li class="flex min-h-13.5 items-center gap-3 border-b border-bronze-700/35 px-4.5 py-2 last:border-b-0 <%= r.isRead ? '' : 'bg-gold-400/5' %>"<%- r.isRead ? '' : ' data-report-unread' %>>
              <input type="checkbox" name="ids" value="<%= r.id %>" class="<%= ui.checkbox %>" aria-label="Sélectionner">
              <a href="/village/<%= vid %>/reports/<%= r.id %>" class="group flex min-w-0 flex-1 items-center gap-3 no-underline">
                <span class="relative">
                  <span class="<%= k.medal %> size-8 <%= r.isRead ? 'opacity-70' : '' %>"><%- icon(k.icon, 'size-[15px]', 2.1) %></span>
                  <span class="absolute -right-1.5 -bottom-1.5 flex"><%- k.dot %></span>
                </span>
                <span class="flex min-w-0 flex-1 flex-col">
                  <span class="flex min-w-0 items-center gap-2">
                    <span class="truncate transition group-hover:text-gold-200 <%= r.isRead ? 'text-parchment-400' : 'font-semibold text-parchment-100' %>"><%= reportTitle(r) %></span>
                    <%- haulIcon(k.haul) %>
                    <% if (all && r.folderId && folderName.has(r.folderId)) { %><span class="shrink-0 border border-bronze-700 px-1 text-[12px] text-parchment-400"><%= folderName.get(r.folderId) %></span><% } %>
                  </span>
                  <span class="text-xs text-parchment-500 tabular-nums sm:hidden"><%= when(r.happenedAt, now) %></span>
                </span>
                <% if (!r.isRead) { %>
                  <span class="size-2 shrink-0 rotate-45 border border-black bg-gold-200" title="Non lu"></span><span class="sr-only">Non lu</span>
                <% } %>
                <span class="hidden shrink-0 text-[13px] text-parchment-500 tabular-nums sm:block"><%= when(r.happenedAt, now) %></span>
              </a>
            </li>
          <% } %>
          <%- lazyMore(lr, { tag: 'li', label: 'rapports' }) %>
        </ul>
      </form>
    <% } %>
    <%- include('partials/pagination', { list: 'reports', pagination, href: (n) => link(filter, n) }) %>
    <% if (all) { %>
      <p class="<%= ui.panelNote %>">Tous tes rapports : la boîte de réception (<%= keepLimit %> rapports au plus) et tes archives (gardées <%= archiveMonths %> mois).</p>
    <% } else if (folder) { %>
      <p class="<%= ui.panelNote %>">Rapports archivés : hors de la limite de la boîte de réception, supprimés <%= archiveMonths %> mois après leur date (réglable dans les <a href="/village/<%= vid %>/reports/folders" class="<%= ui.link %>">dossiers</a>).</p>
    <% } else { %>
      <p class="<%= ui.panelNote %>">Les <%= keepLimit %> rapports les plus récents de la boîte sont conservés (100 + 10 par village) ; les plus anciens sont supprimés automatiquement.<% if (!inMatch) { %> Les rapports archivés dans un dossier (premium) n’entrent pas dans cette limite.<% } %></p>
    <% } %>
    </div>
    </div>
  </section>
</div>
<%- include('partials/footer') %>
