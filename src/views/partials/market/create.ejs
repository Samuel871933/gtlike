<%# Marché, onglet « Créer des offres (et ses propres offres de ce village) » (inclus par market.ejs, avec ses helpers : m, vid, res, resIcon, amount…). %>
<% const perOffer = Math.ceil((Number(offerForm.sellAmount) || cap) / cap); %>
      <section class="<%= ui.panel %>">
        <%- panelHead('Créer une offre') %>
        <form method="post" action="<%= m %>/offers" class="flex flex-col gap-3 p-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <p class="text-sm text-parchment-400">Les offres de ressources sont possibles avec un ratio entre 1:<%= ctx.cfg.market.maxRatio %> et <%= ctx.cfg.market.maxRatio %>:1. Les ressources et les marchands sont réservés tant que l'offre est en ligne.</p>
          <table class="<%= ui.table %> w-auto! self-start">
            <tbody>
              <tr>
                <th scope="row" class="w-24 text-left">J'offre :</th>
                <td><input type="number" name="sellAmount" min="1" required value="<%= offerForm.sellAmount %>" class="<%= ui.inputSm %> w-24 text-right tabular-nums" aria-label="Quantité offerte"></td>
                <td><span class="flex items-center gap-5"><%- radios('sellResource', offerForm.sellResource) %></span></td>
              </tr>
              <tr>
                <th scope="row" class="text-left">Je veux :</th>
                <td><input type="number" name="buyAmount" min="1" required value="<%= offerForm.buyAmount %>" class="<%= ui.inputSm %> w-24 text-right tabular-nums" aria-label="Quantité voulue"></td>
                <td><span class="flex items-center gap-5"><%- radios('buyResource', offerForm.buyResource) %></span></td>
              </tr>
            </tbody>
          </table>
          <table class="<%= ui.table %> w-auto! self-start">
            <thead><tr><th colspan="3">Limitations</th></tr></thead>
            <tbody>
              <tr><td>Nombre d'offres :</td><td><input type="number" name="count" min="1" value="<%= offerForm.count %>" class="<%= ui.inputSm %> w-20 text-right tabular-nums"></td><td class="text-parchment-500">fois</td></tr>
              <tr><td>Durée maximale du voyage :</td><td><input type="number" name="maxHours" min="1" value="<%= offerForm.maxHours %>" placeholder="—" class="<%= ui.inputSm %> w-20 text-right tabular-nums"></td><td class="text-parchment-500">heures (vide : sans limite)</td></tr>
              <tr><td><label for="tribe-only" class="cursor-pointer">Commerce de tribu uniquement ?</label></td><td class="text-center"><input id="tribe-only" type="checkbox" name="tribeOnly" value="1" class="<%= ui.checkbox %>" <%= offerForm.tribeOnly ? 'checked' : '' %>></td><td></td></tr>
            </tbody>
          </table>
          <div class="flex flex-wrap items-center gap-3">
            <button class="<%= btn('gold') %>"><%- icon('plus', 'size-3.5', 2.2) %>Créer</button>
            <span class="text-sm text-parchment-500">Une offre de <%= num(Number(offerForm.sellAmount) || cap) %> demande <%= perOffer %> marchand<%= perOffer > 1 ? 's' : '' %> ; <%= merchants.free %> disponible<%= merchants.free > 1 ? 's' : '' %>.</span>
          </div>
        </form>
      </section>

      <section class="<%= ui.panel %>">
        <%- panelHead('Tes offres dans ce village', count(ownOffers.length)) %>
        <% if (!ownOffers.length) { %>
          <p class="<%= ui.empty %>">Aucune offre en ligne depuis ce village.</p>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="<%= ui.table %> text-sm [&_td]:py-1.5">
              <thead><tr><th>J'offre</th><th>Je veux</th><th class="text-right">Offres</th><th>Limites</th><th class="text-right">Marchands</th><th></th></tr></thead>
              <tbody>
              <% for (const o of ownOffers) { %>
                <tr>
                  <td><%- amount(o.sellResource, o.sellAmount) %></td>
                  <td><%- amount(o.buyResource, o.buyAmount) %></td>
                  <td class="text-right font-semibold tabular-nums"><%= o.count %></td>
                  <td><%- limitTags(o) || '<span class="text-parchment-500">—</span>' %></td>
                  <td class="text-right text-parchment-300 tabular-nums"><%= o.count * o.merchantsPerOffer %></td>
                  <td class="text-right"><form method="post" action="<%= m %>/offers/<%= o.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="<%= btn('danger', 'sm') %>"><%- icon('close', 'size-3', 2.6) %>Retirer</button></form></td>
                </tr>
              <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </section>
