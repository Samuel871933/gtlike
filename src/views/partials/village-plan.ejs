<%#
  Plan du village (maquette « Ton oppidum ») : bâtiments en médaillons sur le fond du style de jeu (--game-image-village, voir src/styles/game-styles/).
  Emplacements en % d'une scène 966 × 580 : bâtiments militaires et QG dans l'enceinte, mines et ferme
  aux abords, muraille à la porte sud. Un chantier en cours affiche un anneau de progression.
  `view` : 'city' (plan, écrans moyens et plus) ou 'list' (liste, toujours utilisée sur mobile).
%>
<%
  const SPOTS = {
    statue: 'left-[31.06%] top-[23.28%]', main: 'left-[50%] top-[23.28%]', barracks: 'left-[68.94%] top-[23.28%]',
    snob: 'left-[31.06%] top-[44.83%]', place: 'left-[50%] top-[44.83%]', market: 'left-[68.94%] top-[44.83%]',
    smith: 'left-[31.06%] top-[66.38%]', storage: 'left-[50%] top-[66.38%]', garage: 'left-[68.94%] top-[66.38%]',
    wood: 'left-[10.35%] top-[18.97%]', stable: 'left-[10.35%] top-[44.83%]', stone: 'left-[10.35%] top-[72.41%]',
    farm: 'left-[89.65%] top-[18.97%]', hide: 'left-[89.65%] top-[44.83%]', iron: 'left-[89.65%] top-[72.41%]',
    wall: 'left-[50%] top-[85.34%]',
  };
  const vid = ctx.village.id;
  const plan = Object.keys(SPOTS).map((id) => registry.BUILDINGS.get(id)).filter((b) => b && b.isAvailableIn(ctx.cfg)).map((b) => {
    const orders = ctx.buildOrders.filter((o) => o.building === b.id);
    const running = orders.find((o) => new Date(o.startsAt) <= now) || null;
    const last = orders.length ? orders[orders.length - 1] : null;
    const pct = running ? Math.max(0, Math.min(100, ((now - new Date(running.startsAt)) / (new Date(running.endsAt) - new Date(running.startsAt))) * 100)) : 0;
    return { b, level: ctx.state.level(b.id), orders, running, last, pct, href: `/village/${vid}/${buildingPath(b.id, ctx.cfg)}` };
  });
  const ringBuilt = 'bg-linear-to-b from-bronze-200 to-bronze-950 shadow-[0_4px_8px_rgba(0,0,0,0.6)]';
  const ringWork = 'bg-[conic-gradient(var(--color-gold-200)_0%,var(--color-gold-400)_var(--p),rgba(0,0,0,0.55)_var(--p))] shadow-[0_0_0_3px_var(--color-glow-soft),0_0_18px_var(--color-glow),0_4px_8px_rgba(0,0,0,0.6)]';
  const ringNone = 'bg-linear-to-b from-bronze-700 to-bronze-900 opacity-70 shadow-[0_4px_8px_rgba(0,0,0,0.6)]';
  const core = 'flex size-[52px] items-center justify-center rounded-full bg-radial-[at_35%_30%] from-core-hi to-core-lo to-75% shadow-[inset_0_0_0_2px_rgba(0,0,0,0.6)]';
  const medal = (p, big) => `
    <span class="relative block size-[58px] shrink-0 rounded-full p-[3px] ${p.running ? ringWork : p.level ? ringBuilt : ringNone}"${p.running ? ` style="--p: ${p.pct.toFixed(1)}%" data-progress-ring data-progress-start="${new Date(p.running.startsAt).getTime()}" data-progress-end="${new Date(p.running.endsAt).getTime()}"` : ''}>
      <span class="${core} ${p.level || p.running ? 'text-gold-250' : 'text-parchment-600'}">${buildingIcon(p.b.id, 'size-[26px]', 1.6)}</span>
      ${p.level ? `<span class="absolute -right-1.5 -bottom-1 ${ui.levelBadge}">${p.level}</span>` : ''}
    </span>`;
  const works = ctx.buildOrders.length;
%>
<div class="<%= view === 'list' ? 'hidden' : 'hidden md:block' %> relative aspect-[966/580] overflow-hidden rounded-b-md bg-(image:--game-image-village) bg-cover bg-center">
  <% for (const p of plan) { %>
    <a href="<%= p.href %>" class="group absolute <%= SPOTS[p.b.id] %> flex w-[140px] -translate-x-1/2 -translate-y-[29px] flex-col items-center gap-[5px] no-underline"
       title="<%= p.b.name %> · <%= p.level ? `niveau ${p.level}` : 'non construit' %><%= p.last ? ` · niveau ${p.last.level} en file` : '' %>">
      <span class="block transition group-hover:scale-105 group-hover:brightness-115"><%- medal(p) %></span>
      <span class="rounded-[3px] border border-bronze-700/80 bg-plate px-2 py-0.5 font-display text-[11px] font-bold tracking-[0.1em] whitespace-nowrap uppercase transition group-hover:border-bronze-400 <%= p.level ? 'text-parchment-100' : 'text-parchment-500' %>"><%= p.b.name %></span>
      <% if (p.last) { %>
        <span class="rounded-[3px] bg-black/60 px-2 py-px text-xs font-extrabold whitespace-nowrap text-gold-200 tabular-nums">→ <%= p.last.level %> · <span data-countdown="<%= new Date(p.last.endsAt).getTime() %>"><%= duration((new Date(p.last.endsAt) - now) / 1000) %></span></span>
      <% } %>
    </a>
  <% } %>
  <div class="absolute bottom-3.5 left-4 flex flex-wrap items-center gap-2.5 rounded border border-bronze-700 bg-plate-strong px-3 py-2 text-[13px]">
    <span class="size-2.5 rounded-full <%= works ? 'bg-gold-400 shadow-[0_0_8px_var(--color-gold-400)]' : 'bg-parchment-700' %>"></span>
    <span class="text-parchment-200"><%= works ? `${works} chantier${works > 1 ? 's' : ''} en cours` : 'Aucun chantier' %></span>
    <span class="text-parchment-700">·</span>
    <span class="text-parchment-500">Cliquez un bâtiment pour l’améliorer</span>
  </div>
</div>

<%# Vue liste (et rendu mobile de la vue cité). %>
<div class="<%= view === 'list' ? '' : 'md:hidden' %> grid gap-2 p-4 sm:grid-cols-2 xl:grid-cols-3">
  <% for (const p of plan) { %>
    <a href="<%= p.href %>" class="<%= ui.box %> flex items-center gap-3 p-2.5 no-underline transition hover:border-bronze-500">
      <span class="block shrink-0"><%- medal(p) %></span>
      <span class="flex min-w-0 flex-1 flex-col">
        <span class="truncate font-bold <%= p.level ? 'text-parchment-100' : 'text-parchment-500' %>"><%= p.b.name %></span>
        <span class="text-[13px] text-parchment-500"><%= p.level ? `Niveau ${p.level}` : 'Non construit' %></span>
      </span>
      <% if (p.last) { %>
        <span class="shrink-0 text-right text-xs font-extrabold text-gold-200 tabular-nums">→ <%= p.last.level %><br><span data-countdown="<%= new Date(p.last.endsAt).getTime() %>"><%= duration((new Date(p.last.endsAt) - now) / 1000) %></span></span>
      <% } %>
    </a>
  <% } %>
</div>
