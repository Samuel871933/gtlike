<%#
  Plan du village : décor médiéval illustré et sprites en trois paliers visuels. Comme dans Guerre Tribale,
  l'apparence change par tranche de niveaux et non à chaque niveau. Les ressources restent hors de l'enceinte.
  Chaque bloc porte son niveau (LV.x), son nom et, s'il est en chantier, le compte à rebours. Le survol d'un
  bâtiment affiche son encart sous le plan (coût et durée du niveau suivant, Améliorer) ; un clic ouvre sa page.
  Local requis : buildOptions (VillageService.buildOption par bâtiment).
  `view` : 'city' (plan, écrans moyens et plus) ou 'list' (liste, toujours utilisée sur mobile).
%>
<%
  // [centre horizontal, pied du bâtiment, largeur], en % du décor.
  // Ancrer au sol garde les trois paliers sur leur parcelle, quelle que soit leur hauteur.
  // Le quartier général domine le fond ; les ateliers entourent le puits sans couper les chemins.
  const SPOTS = {
    wood: [11, 25, 14], iron: [90, 25, 14],
    snob: [36, 23, 15], main: [60, 23, 17],
    stable: [72, 61, 12], barracks: [76, 45, 15], hide: [43, 34, 7],
    statue: [37, 47, 6.5], market: [30, 35, 13], smith: [40, 67, 13],
    place: [60, 41, 9], storage: [25, 54, 14], garage: [59, 69, 13],
    stone: [10, 79, 14], farm: [90, 77, 14],
  };
  const WALL_SPOT = [50, 78, 14];
  // Décor uniquement : les mondes actuels ne proposent pas le bâtiment église.
  const CHURCH_SPOT = [73, 29, 13];
  // Image de chaque bâtiment selon son niveau : helpers.buildingSprite (commune aux pages de bâtiment).
  const spriteOf = buildingSprite;
  const spotStyle = ([x, y, width], ratio = 7 / 8) => `left:${x - width / 2}%;top:${y - width * ratio * 1.5}%;width:${width}%;--plot-depth:${Math.round(y)}`;
  const vid = ctx.village.id;
  const favs = new Set(favoriteBuildings(player, ctx));
  // Étoile toujours visible, indépendamment du survol et de l’état du favori.
  const plotStar = (id) => `<span class="village-building-favorite absolute right-[3px] top-0 z-[2]">${favStar(vid, id, favs.has(id), csrfToken, 'size-5 border border-black bg-night/85')}</span>`;
  const plotOf = (id) => {
    const b = registry.BUILDINGS.get(id);
    if (!b || !b.isAvailableIn(ctx.cfg)) return null;
    const orders = ctx.buildOrders.filter((o) => o.building === b.id);
    const running = orders.find((o) => new Date(o.startsAt) <= now) || null;
    const last = orders.length ? orders[orders.length - 1] : null;
    return { b, level: ctx.state.level(b.id), orders, running, last, href: `/village/${vid}/${buildingPath(b.id, ctx.cfg)}` };
  };
  const plan = Object.keys(SPOTS).map(plotOf).filter(Boolean);
  const wall = plotOf('wall');
  const works = ctx.buildOrders.length;
  const head = ctx.buildOrders[0] || null;
  const titleOf = (p) => `${p.b.name} · ${p.level ? `niveau ${p.level}` : 'non construit'}${p.last ? ` · niveau ${p.last.level} en file` : ''}`;
  const activityMap = typeof activities === 'undefined' ? {} : activities;
  const timer = (p) => (activityMap[p.b.id] || []).map((a) =>
    `<span class="village-building-timer" title="${a.label}" aria-label="${a.label}"><span>${a.label}</span><span data-countdown="${a.end}">${duration((a.end - now) / 1000)}</span></span>`
  ).join('');
%>
<div class="<%= view === 'list' ? 'hidden' : 'hidden md:block' %> bg-night p-2">
  <div class="village-scene-medieval spacing-normal relative overflow-hidden border-[3px] border-black">
    <div class="village-building-plot village-building-plot--decorative absolute" style="<%= spotStyle(CHURCH_SPOT) %>" title="Église · Indisponible dans ce monde">
      <img src="/img/village/medieval/church.png" alt="Église — indisponible dans ce monde" width="320" height="280" class="village-building-sprite pointer-events-none absolute inset-0 size-full object-contain">
      <span class="village-building-name absolute z-[2] border-2 border-black px-1 py-px text-center text-[10px] font-bold">Église · Indisponible</span>
    </div>
    <% for (const p of plan) { %>
      <div class="village-building-plot group/plot absolute" style="<%= spotStyle(SPOTS[p.b.id]) %>">
      <a href="<%= p.href %>" data-plot="<%= p.b.id %>" class="group absolute inset-0 cursor-pointer no-underline"
         title="<%= titleOf(p) %>">
        <% if (p.level) { %>
          <img src="<%= spriteOf(p.b.id, p.level) %>" alt="" width="320" height="280" class="village-building-sprite pointer-events-none absolute inset-0 size-full object-contain">
        <% } else { %>
          <span class="village-building-empty absolute flex items-center justify-center border-2 border-dashed"><%- buildingIcon(p.b.id, 'size-6', 1.8) %></span>
        <% } %>
        <span class="village-building-level absolute z-[2] border-2 border-black px-1 text-[10px] font-bold"><%= p.level %></span>
        <span class="village-building-activities"><%- timer(p) %></span>
        <span class="village-building-name absolute z-[2] truncate border-2 border-black px-1 py-px text-center text-[10px] font-bold tracking-[0.02em] transition group-hover:bg-head-dark group-hover:text-on-accent"><%= p.b.name %></span>
      </a>
      <%- plotStar(p.b.id) %>
      </div>
    <% } %>
    <% if (wall) { %>
      <%# La porte appartient déjà au décor : sa zone cliquable suit exactement son emplacement. %>
      <div class="village-building-plot village-building-plot--wall absolute" style="<%= spotStyle(WALL_SPOT, 4 / 7) %>">
      <a href="<%= wall.href %>" data-plot="wall" class="group absolute inset-0 cursor-pointer no-underline" title="<%= titleOf(wall) %>">
        <span class="village-building-level absolute z-[2] border-2 border-black px-1 text-[10px] font-bold"><%= wall.level %></span>
        <span class="village-building-name village-building-name--wall absolute z-[2] truncate border-2 border-black px-1 py-px text-center text-[10px] font-bold"><%= wall.b.name %></span>
        <span class="village-building-activities"><%- timer(wall) %></span>
      </a>
      <%- plotStar(wall.b.id) %>
      </div>
    <% } %>
    <div class="pointer-events-none absolute right-2 bottom-2 flex gap-[3px]">
      <span class="border border-bronze-700 bg-night px-1.5 py-0.5 text-[11px] tracking-[0.02em] text-parchment-500">Loyauté <%= Math.floor(ctx.state.loyalty) %></span>
    </div>
  </div>
  <%# Bandeau sous le plan : par défaut le chantier en tête de file ; le survol d'un bâtiment (game.js) affiche son encart. %>
  <div class="mt-2 flex flex-wrap items-center justify-between gap-3 border border-bronze-800 border-l-4 border-l-bronze-500 bg-panel-top px-2.5 py-2" data-plot-info="">
    <div class="min-w-0 flex-[1_1_260px]">
      <% if (head) { %>
        <div class="font-display text-base font-semibold tracking-[0.02em]"><%= buildingName(head.building) %> <span class="font-sans text-sm text-gold-400">→ niveau <%= head.level %></span></div>
        <div class="text-[13px] text-parchment-500"><%= works %> chantier<%= works > 1 ? 's' : '' %> en file · fin <%= when(ctx.buildOrders[works - 1].endsAt, now) %></div>
      <% } else { %>
        <div class="font-display text-base font-semibold tracking-[0.02em]">Aucun chantier</div>
        <div class="text-[13px] text-parchment-500">Clique un bâtiment pour ouvrir sa page. Les ouvriers attendent tes ordres.</div>
      <% } %>
    </div>
    <a href="/village/<%= vid %>/main" class="<%= btn('gold', 'md') %>"><%- icon('overview', 'size-3.5', 2.2) %>Quartier général</a>
  </div>
  <% for (const p of [...plan, ...(wall ? [wall] : [])]) { const o = buildOptions[p.b.id]; if (!o) continue;
       const reason = o.blockers[0] || (o.lacksResources ? resourcesWhen(ctx.state, o.cost, now) : null); %>
    <div class="mt-2 hidden flex-wrap items-center justify-between gap-3 border border-bronze-800 border-l-4 border-l-bronze-500 bg-panel-top px-2.5 py-2" data-plot-info="<%= p.b.id %>">
      <div class="min-w-0 flex-[1_1_260px]">
        <div class="font-display text-base font-semibold tracking-[0.02em]"><%= p.b.name %> <span class="font-sans text-sm text-gold-400">· <%= p.level ? `niveau ${p.level}` : 'non construit' %></span></div>
        <div class="text-[13px] text-parchment-500"><%= p.b.description %></div>
      </div>
      <div class="flex flex-wrap items-center gap-2.5 text-[13px] tabular-nums">
        <% if (o.maxed) { %>
          <span class="text-parchment-500">Niveau maximum atteint</span>
        <% } else if (o.missing && o.missing.length) { %>
          <span class="text-parchment-500">Requiert : <%= o.blockers.join(' · ') %></span>
        <% } else { %>
          <span class="text-parchment-500">Niv. <%= o.level %> :</span>
          <%- include('cost', { cost: o.cost, pop: o.pop, have: ctx.state.resources }) %>
          <span class="inline-flex items-center gap-1 text-gold-400"><%- icon('clock', 'size-3.5', 2) %><%= duration(o.duration) %></span>
          <form method="post" action="/village/<%= vid %>/build" class="flex items-center gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="building" value="<%= p.b.id %>">
            <button class="<%= btn('gold', 'md') %>" <%= reason ? 'disabled' : '' %> title="<%= reason || '' %>"><%= o.level === 1 ? 'Construire' : 'Améliorer' %></button>
          </form>
          <% if (reason) { %><span class="w-full text-right text-xs text-blood-450"><%= reason %></span><% } %>
        <% } %>
        <a href="<%= p.href %>" class="<%= btn('dark', 'md') %>">Ouvrir</a>
      </div>
    </div>
  <% } %>
</div>

<%# Vue liste (et rendu mobile de la vue cité). %>
<div class="<%= view === 'list' ? '' : 'md:hidden' %> grid gap-1.5 p-2.5 sm:grid-cols-2 xl:grid-cols-3">
  <div class="<%= ui.box %> flex items-center gap-2.5 p-1.5" title="Église · Indisponible dans ce monde">
    <img src="/img/village/medieval/church.png" alt="" width="320" height="280" class="h-12 w-16 shrink-0 object-contain">
    <span class="flex min-w-0 flex-col">
      <span class="font-semibold text-parchment-100">Église</span>
      <span class="text-[13px] text-parchment-500">Indisponible dans ce monde</span>
    </span>
  </div>
  <% for (const p of [...plan, ...(wall ? [wall] : [])]) { %>
    <div class="<%= ui.box %> flex items-center gap-1 pr-1.5 transition hover:bg-row-hover">
    <a href="<%= p.href %>" class="flex min-w-0 flex-1 items-center gap-2.5 p-1.5 no-underline" title="<%= titleOf(p) %>">
      <span class="relative block h-12 w-16 shrink-0 overflow-hidden <%= p.level ? '' : 'border-2 border-dashed border-bronze-700 bg-black/45' %>">
        <% if (p.level) { %><img src="<%= spriteOf(p.b.id, p.level) %>" alt="" width="320" height="280" class="absolute inset-0 size-full object-contain"><% } %>
      </span>
      <span class="flex min-w-0 flex-1 flex-col">
        <span class="truncate font-semibold <%= p.level ? 'text-parchment-100' : 'text-parchment-500' %>"><%= p.b.name %></span>
        <span class="text-[13px] text-gold-400"><%= p.level ? `LV.${p.level}` : 'Non construit' %></span>
      </span>
      <span class="village-building-activities-list"><%- timer(p) %></span>
    </a>
    <%- favStar(vid, p.b.id, favs.has(p.b.id), csrfToken) %>
    </div>
  <% } %>
</div>
