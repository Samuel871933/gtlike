<%# Mondes, pages publiques des mondes officiels (inclus par worlds.ejs, avec ses helpers). %>
  <section class="mx-auto w-full max-w-[1100px] px-3.5 py-5">
    <div class="mb-3 flex items-center gap-3">
      <span class="size-[9px] rotate-45 border border-black bg-gold-400"></span>
      <h2 class="m-0 font-display text-lg font-semibold tracking-[0.02em]">Chroniques des mondes</h2>
      <span class="h-0.5 flex-1 bg-linear-to-r from-bronze-500 to-transparent"></span>
    </div>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-3">
      <% for (const { world } of official) { %>
        <article class="flex flex-col gap-1 border-2 border-black bg-parchment-300 px-3 py-2 text-panel-hi shadow-[inset_0_0_0_2px_var(--color-bld-marble),4px_4px_0_#000]">
          <div class="flex items-center justify-between border-b-2 border-panel-hi pb-[5px]">
            <span class="text-xs font-semibold tracking-[0.02em] text-head-dark"><%= new Date(world.createdAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
            <span class="bg-panel-hi px-1.5 py-px text-[11px] font-semibold tracking-[0.02em] text-parchment-300"><%= world.endedAt ? 'Terminé' : 'Monde' %></span>
          </div>
          <span class="font-display text-[15px] leading-tight font-semibold"><%= world.name %></span>
          <span class="text-[13px] leading-snug text-bld-soot"><%= subtitle(world) %> · victoire : <%= victoryNames[world.getConfig().victory.type] %></span>
          <span class="mt-auto flex flex-wrap gap-x-3 gap-y-0.5 text-xs font-semibold whitespace-nowrap">
            <a href="/worlds/<%= world.slug %>/info" class="text-head-dark no-underline hover:text-panel-hi">» Infos monde</a>
            <a href="/worlds/<%= world.slug %>/ranking" class="text-head-dark no-underline hover:text-panel-hi">» Classement</a>
            <a href="/worlds/<%= world.slug %>/ranking?type=victory" class="text-head-dark no-underline hover:text-panel-hi">» Fin du monde</a>
          </span>
        </article>
      <% } %>
    </div>
  </section>
