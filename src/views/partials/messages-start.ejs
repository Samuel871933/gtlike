<%# Cadre de la messagerie comme sur GT : titre et recherche, menu à gauche (Messages, Mail circulaire, Écrire un message).
    À fermer avec partials/messages-end. `tab` : inbox | circular | new | conversation ; `q` optionnel. %>
<% const m = `/village/${ctx.village.id}/messages`;
   const menu = [['inbox', 'Messages', m], ['circular', 'Mail circulaire', `${m}/circular`], ['new', 'Écrire un message', `${m}/new`]];
   const active = tab === 'conversation' ? 'inbox' : tab; %>
<section class="<%= ui.panel %>">
  <%- panelHead('Messages', `<form method="get" action="${m}" class="flex items-center" role="search">
      <input type="search" name="q" value="${esc(typeof q !== 'undefined' ? q : '')}" placeholder="Rechercher" aria-label="Rechercher dans les messages" class="${ui.inputSm} w-40 sm:w-52">
      <button class="-ml-px inline-flex h-8 w-9 shrink-0 cursor-pointer items-center justify-center border border-black bg-head-dark text-parchment-100 transition hover:bg-night hover:text-gold-200" title="Rechercher" aria-label="Rechercher">${icon('search', 'size-4', 2.2)}</button>
    </form>`, { tag: 'h1' }) %>
  <%# Bandeau illustré sur toutes les pages de la messagerie (boîte de réception, circulaire, conversation, écriture). %>
  <div class="@container"><div class="inbox-hero inbox-hero--messages">
    <p class="inbox-hero__title">Correspondances du royaume</p>
    <p class="inbox-hero__subtitle">Messages des joueurs et de votre tribu</p>
  </div></div>
  <div class="grid grid-cols-1 md:grid-cols-[180px_minmax(0,1fr)]">
    <%- sideNav(menu.map(([id, label, href]) => ({ href, label, active: id === active })), {
      label: 'Messagerie', cls: 'border-b border-bronze-800 md:border-r md:border-b-0',
    }) %>
    <div class="min-w-0">
