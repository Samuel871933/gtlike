<!doctype html>
<%# En jeu, <html> porte le thème de jeu (src/web/gameStyles.js) et le style de jeu (src/web/gameLayouts.js) : la page d'accueil garde le style par défaut. %>
<html lang="fr" class="h-full scheme-dark medieval:scheme-light<%= ctx && gameStyle ? ' game_style' : '' %>"<%- ctx && gameStyle ? ` data-game-style="${gameStyle.id}"` : '' %><%- ctx && gameLayout ? ` data-game-layout="${gameLayout.id}"` : '' %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>GTLike</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <% const fontLinks = ctx && page === 'account' ? [...new Set(Object.values(GAME_STYLES).map((s) => s.fonts))] : [ctx && gameStyle ? gameStyle.fonts : GAME_STYLES.roman.fonts]; %>
  <% for (const href of fontLinks) { %><link rel="stylesheet" href="<%= href %>"><% } %>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body class="relative flex min-h-full flex-col minimal:text-sm bg-night bg-radial-[ellipse_at_50%_-10%] from-halo via-panel-lo via-45% to-night font-sans text-[15px] leading-snug text-parchment-100 antialiased [font-synthesis-weight:none]">
<%# Grain de papier sur toute la page (maquette : trame de points clairs). %>
<div class="pointer-events-none fixed inset-0 z-[1] bg-[radial-gradient(var(--color-grain)_1px,transparent_1.2px)] bg-size-[4px_4px] mix-blend-screen" aria-hidden="true"></div>
<%
  // Logo : aplat parchemin, double ombre d'encre et de sang.
  const logoText = (cls) => `<span class="font-logo font-bold tracking-[0.02em] ${ui.goldText} ${cls}">GTLIKE</span>`;
  const navLink = 'flex shrink-0 items-center gap-[7px] border-r border-bronze-800 px-3.5 text-sm font-semibold tracking-[0.02em] whitespace-nowrap no-underline transition';
  // Onglet actif et survol : aplat rouge (brun en style Médiéval), texte et icône clairs.
  const navOn = 'bg-blood-800 text-on-accent shadow-[inset_0_-3px_0_var(--color-gold-400)] medieval:bg-action medieval:shadow-[inset_0_-3px_0_var(--color-action-line)] medieval:[&>span:first-child]:text-on-accent';
  const navOff = 'text-parchment-300 hover:bg-blood-700 hover:text-on-accent medieval:hover:bg-action-hi medieval:hover:[&>span:first-child]:text-on-accent';
%>

<% if (ctx) {
  const v = `/village/${ctx.village.id}`;
  const navItems = [
    [v, 'Aperçu', 'overview', page === 'overview', 0, ui.countBadge],
    [`${v}/map`, 'Carte', 'map', page === 'map', 0, ui.countBadge],
    [`${v}/reports`, 'Rapports', 'reports', page === 'reports', unreadReports, ui.countBadge],
    [`${v}/messages`, 'Messages', 'messages', page === 'messages', unreadMessages, `${ui.countBadge} bg-gold-400 text-night`],
    [`${v}/tribe`, 'Tribu', 'tribe', page === 'tribe', tribeInvites + tribeForumUnread, ui.countBadge],
    [`${v}/ranking`, 'Classement', 'ranking', page === 'ranking', 0, ui.countBadge],
    [`${v}/players/${ctx.village.playerId}`, 'Profil', 'profile', page === 'profile', 0, ui.countBadge],
  ];
%>
<%# 1. Barre du haut : logo et monde, menu principal, joueur et réglages. %>
<header class="sticky top-0 z-40 border-b-[3px] border-bronze-500 bg-night shadow-[0_2px_0_var(--color-head-dark),0_6px_0_rgba(0,0,0,0.6)]">
<div class="mx-auto flex min-h-12 w-full max-w-[1500px] minimal:max-w-[1120px] items-stretch">
  <a href="<%= v %>" class="flex shrink-0 items-center gap-2.5 border-r-[3px] border-black bg-head-dark pr-6 pl-3 no-underline shadow-[inset_-1px_0_0_var(--color-bronze-500)] [clip-path:polygon(0_0,100%_0,calc(100%-10px)_100%,0_100%)]" title="Aperçu du village">
    <%- logoText('text-[22px] minimal:text-lg') %>
    <span class="border border-bronze-500 bg-night px-[5px] py-px text-[11px] font-semibold tracking-[0.02em] text-gold-400 max-md:hidden"><%= ctx.world.name %></span>
  </a>
  <nav class="flex min-w-0 flex-1 items-stretch overflow-x-auto [scrollbar-width:none]" aria-label="Menu principal">
    <%# Menus déroulants : Rapports, et Tribu quand le joueur en a une. %>
    <% for (const [href, label, ic, active, badge, badgeCls] of navItems) { const menu = ic === 'reports' || (ic === 'tribe' && player && player.tribeId) ? ic : null; %>
      <a href="<%= href %>" class="<%= navLink %> <%= active ? navOn : navOff %>"<%- active ? ' aria-current="page"' : '' %><%- menu ? ` data-menu-toggle="${menu}" aria-haspopup="true" aria-expanded="false"` : '' %>>
        <span class="text-gold-400"><%- icon(ic, 'size-4', 2.2) %></span><%= label %>
        <% if (badge) { %><span class="<%= badgeCls %>"><%= badge %></span><% } %>
        <%# Couleur du texte de l'onglet (claire sur l'onglet actif ou survolé, quel que soit le style de jeu). %>
        <% if (menu) { %><span class="opacity-70"><%- icon('chevronDown', 'size-3', 3) %></span><% } %>
      </a>
    <% } %>
  </nav>
  <div class="flex shrink-0 items-center gap-2 border-l-[3px] border-black px-2.5 shadow-[inset_1px_0_0_var(--color-bronze-800)]">
    <% if (player) { %>
      <a href="<%= v %>/ranking" class="flex flex-col items-end leading-[1.05] no-underline max-md:hidden" title="Votre classement sur <%= ctx.world.name %>">
        <span class="text-[15px] font-semibold text-parchment-100"><%= player.name %><% if (player.Tribe) { %> <span class="text-blood-600">[<%= player.Tribe.tag %>]</span><% } %></span>
        <span class="text-[11px] text-parchment-500 tabular-nums">#<%= num(playerRank) %> · <%= num(player.points) %> pts</span>
      </a>
    <% } %>
    <a href="<%= v %>/account" class="<%= page === 'account' ? ui.iconBtnOn : ui.iconBtn %>" title="Compte" aria-label="Compte"><%- icon('settings', 'size-4', 2.2) %></a>
    <%# Fausse déconnexion, comme sur Guerre Tribale : on quitte le monde et on revient au choix des mondes (la session reste ouverte). %>
    <a href="/worlds" class="<%= ui.iconBtn %>" title="Déconnexion : retour au choix des mondes" aria-label="Déconnexion"><%- icon('logout', 'size-4', 2.2) %></a>
  </div>
</div>

<%
  // Contenu des menus déroulants de la barre du haut (ouverts au survol par game.js sous leur bouton ; le clic sur le bouton suit son lien).
  const menus = [['reports', 'Rapports', [['all', 'Tous'], ['attack', 'Attaques'], ['defense', 'Défenses'], ['support', 'Soutiens'], ['trade', 'Commerce'], ['scavenge', 'Collecte'], ['award', 'Succès']]
    .map(([f, label]) => [`${v}/reports?filter=${f}`, label, unreadByFilter[f] || 0])]];
  if (player && player.tribeId) {
    menus.push(['tribe', player.Tribe ? `Tribu [${player.Tribe.tag}]` : 'Tribu', [
      [`${v}/tribe`, 'Aperçu', 0],
      [`${v}/tribe?tab=members`, 'Membres', 0],
      [`${v}/tribe?tab=diplomacy`, 'Diplomatie', 0],
      [`${v}/tribe?tab=forum`, 'Forum', tribeForumUnread],
      [`${v}/tribes/${player.tribeId}`, 'Page publique', 0],
    ]]);
  }
%>
<div class="relative mx-auto h-0 w-full max-w-[1500px] minimal:max-w-[1120px]">
  <% for (const [id, title, items] of menus) { %>
    <div class="absolute top-0 left-0 z-50 hidden w-[210px] border-2 border-black bg-panel-top shadow-[inset_0_0_0_1px_var(--color-bronze-500),5px_5px_0_#000]" data-menu="<%= id %>">
      <div class="border-b-2 border-bronze-500 bg-head px-2.5 py-[5px] font-display text-xs font-semibold tracking-[0.02em]"><%= title %></div>
      <% for (const [href, label, n] of items) { %>
        <a href="<%= href %>" class="flex items-center justify-between border-b border-bronze-800 px-2.5 py-1.5 font-semibold no-underline last:border-b-0 hover:bg-head-dark hover:text-parchment-100 <%= n || id === 'tribe' ? 'text-parchment-100' : 'text-parchment-500' %>">
          <span class="flex items-center gap-1.5"><span class="size-[5px] rotate-45 bg-bronze-500"></span><%= label %></span>
          <span class="text-xs text-gold-400 tabular-nums"><%= n || '' %></span>
        </a>
      <% } %>
    </div>
  <% } %>
</div>

<%
  const cap = ctx.state.storageCapacity();
  const prod = ctx.state.productionPerHour();
  const idx = myVillages.findIndex((x) => x.id === ctx.village.id);
  const prev = myVillages.length > 1 ? myVillages[(idx - 1 + myVillages.length) % myVillages.length] : null;
  const next = myVillages.length > 1 ? myVillages[(idx + 1) % myVillages.length] : null;
  // Barre rapide de Guerre Tribale : accès direct aux bâtiments construits.
  const chip = 'flex items-center gap-[5px] border border-bronze-800 bg-night px-2 py-[3px] whitespace-nowrap no-underline shadow-[inset_0_-2px_0_var(--color-panel-lo),1px_1px_0_#000] transition hover:border-bronze-500 hover:bg-row-hover';
  // Chaque encart mène à son bâtiment : camp de bois, carrière d'argile, mine de fer (même identifiant que la
  // ressource), entrepôt, ferme.
  const bld = (id) => `/village/${ctx.village.id}/building/${id}`;
  const arrow = 'flex size-[26px] shrink-0 items-center justify-center border-2 border-black bg-night text-gold-400 no-underline shadow-[inset_0_0_0_1px_var(--color-bronze-700)] transition hover:bg-head-dark hover:text-parchment-100';
%>
<%# 2. Barre du village : changement de village, attaques entrantes, barre rapide, ressources. %>
<div class="border-t border-black bg-panel-hi shadow-[inset_0_1px_0_var(--color-bronze-800)]">
<div class="mx-auto flex w-full max-w-[1500px] minimal:max-w-[1120px] flex-wrap items-center justify-between gap-1.5 px-2.5 py-[5px]">
  <div class="flex min-w-0 flex-[1_1_520px] items-center gap-1.5">
    <div class="flex shrink-0 items-center gap-1">
      <% if (prev) { %><a href="/village/<%= prev.id %>" data-village-link class="<%= arrow %>" title="Village précédent : <%= prev.name %>" aria-label="Village précédent"><%- icon('chevronLeft', 'size-3.5', 2.6) %></a><% } %>
      <% if (myVillages.length > 1) { %>
        <details class="group relative">
          <summary class="flex h-[26px] cursor-pointer list-none items-center gap-1.5 border border-bronze-500 bg-night px-2 text-sm font-semibold text-parchment-100 hover:text-gold-200 [&::-webkit-details-marker]:hidden" title="Changer de village">
            <span class="max-w-44 truncate"><%= ctx.village.name %></span><span class="text-xs text-gold-400 tabular-nums"><%= ctx.village.x %>|<%= ctx.village.y %></span><%- icon('chevronDown', 'size-3 text-parchment-500 transition group-open:rotate-180', 3) %>
          </summary>
          <ul class="<%= ui.popover %> left-0 max-h-80 w-72 overflow-y-auto p-0">
            <% for (const mv of myVillages) { %>
              <li><a href="/village/<%= mv.id %>" data-village-link class="flex items-center justify-between gap-3 border-b border-bronze-800 px-2.5 py-1.5 text-sm font-semibold no-underline <%= mv.id === ctx.village.id ? 'bg-head-dark text-parchment-100' : 'text-parchment-300 hover:bg-head-dark hover:text-parchment-100' %>">
                <span class="flex items-center gap-1.5 truncate"><span class="size-[5px] shrink-0 rotate-45 bg-bronze-500"></span><%= mv.name %></span><span class="shrink-0 text-xs text-gold-400 tabular-nums"><%= mv.x %>|<%= mv.y %></span>
              </a></li>
            <% } %>
          </ul>
        </details>
      <% } else { %>
        <a href="/village/<%= ctx.village.id %>" class="flex h-[26px] items-center gap-1.5 border border-bronze-500 bg-night px-2 text-sm font-semibold text-parchment-100 no-underline hover:text-gold-200">
          <span class="max-w-44 truncate"><%= ctx.village.name %></span><span class="text-xs text-gold-400 tabular-nums"><%= ctx.village.x %>|<%= ctx.village.y %></span>
        </a>
      <% } %>
      <% if (next) { %><a href="/village/<%= next.id %>" data-village-link class="<%= arrow %>" title="Village suivant : <%= next.name %>" aria-label="Village suivant"><%- icon('chevronRight', 'size-3.5', 2.6) %></a><% } %>
      <% if (incomingAttacks) { %>
        <a href="/village/<%= ctx.village.id %>/place?tab=troops" class="<%= ui.tagRed %> h-[26px] gap-1 no-underline" title="Attaques en approche"><%- icon('attack', 'size-3', 2.6) %><%= incomingAttacks %></a>
      <% } %>
    </div>
    <%- include('quickbar') %>
  </div>
  <div class="flex min-w-0 flex-[0_1_auto] gap-[3px] overflow-x-auto [scrollbar-width:none]">
    <% for (const r of RESOURCES) { const value = ctx.state.resources[r.id]; %>
      <a href="<%= bld(r.id) %>" class="<%= chip %>" title="<%= r.label %> · +<%= num(prod[r.id]) %>/h · entrepôt <%= num(cap) %>">
        <span><%- resourceIcon(r.id, 'size-5') %></span>
        <span class="text-sm font-semibold tabular-nums <%= value >= cap ? 'text-blood-450' : 'text-parchment-100' %>" data-res="<%= value %>" data-rate="<%= prod[r.id] %>" data-cap="<%= cap %>"
              data-at="<%= ctx.state.resourcesAt.getTime() %>"><%= num(value) %></span>
      </a>
    <% } %>
    <a href="<%= bld('storage') %>" class="<%= chip %>" title="Capacité de l'entrepôt">
      <span><%- resourceIcon('storage', 'size-5') %></span><span class="text-sm font-semibold text-parchment-100 tabular-nums"><%= num(cap) %></span>
    </a>
    <a href="<%= bld('farm') %>" class="<%= chip %>" title="Population utilisée / capacité de la ferme">
      <span><%- resourceIcon('pop', 'size-5') %></span><span class="text-sm font-semibold text-parchment-100 tabular-nums"><%= num(ctx.popUsed()) %>/<%= num(ctx.state.farmCapacity()) %></span>
    </a>
  </div>
</div>
</div>
</header>

<main class="relative z-[2] mx-auto flex w-full max-w-[1500px] minimal:max-w-[1120px] grow flex-col gap-3.5 px-2.5 pt-3.5 pb-10 minimal:gap-2.5 minimal:py-6">
<% } else {
  const w = typeof world !== 'undefined' && world ? world : null;
  const lobbyLink = (href, label, active) => `<a href="${href}" class="shrink-0 text-[13px] font-semibold tracking-[0.02em] no-underline transition ${active ? 'text-parchment-100' : 'text-gold-400 hover:text-parchment-100'}">${label}</a>`;
  const current = typeof lobbyPage !== 'undefined' ? lobbyPage : null;
%>
<%# En-tête hors partie : accueil, compte, pages publiques d'un monde. %>
<header class="relative z-20 border-b-2 border-bronze-500 bg-night">
<div class="mx-auto flex min-h-11 w-full max-w-[1200px] flex-wrap items-center justify-between gap-x-6 gap-y-1 px-3.5 py-2">
  <a href="<%= user ? '/worlds' : '/login' %>" class="no-underline"><%- logoText('text-lg') %></a>
  <nav class="flex min-w-0 flex-wrap gap-x-4 gap-y-1" aria-label="Menu">
    <% if (user) { %>
      <%- lobbyLink('/worlds', 'Accueil', current === 'worlds') %>
      <%- lobbyLink('/rules', 'Règles', current === 'rules') %>
      <%- lobbyLink('/help', 'Aide', current === 'help') %>
      <%- lobbyLink('/forum', 'Forum', current === 'forum') %>
      <% if (w) { %>
        <%- lobbyLink(`/worlds/${w.slug}/ranking`, 'Classement', current === 'ranking') %>
        <%- lobbyLink(`/worlds/${w.slug}/play`, 'Jouer', false) %>
      <% } %>
      <%- lobbyLink('/account', 'Mon compte', current === 'account') %>
    <% } else { %>
      <%- lobbyLink('/login', 'Accueil', current === 'login') %>
      <%- lobbyLink('/register', 'Inscription', current === 'register') %>
      <%- lobbyLink('/rules', 'Règles', current === 'rules') %>
      <%- lobbyLink('/help', 'Aide', current === 'help') %>
      <%- lobbyLink('/forum', 'Forum', current === 'forum') %>
    <% } %>
  </nav>
  <div class="flex shrink-0 items-center gap-2.5">
  <span class="border border-bronze-700 px-1.5 py-0.5 text-xs text-parchment-500" title="Langue : français">FR</span>
  <% if (user) { %>
    <form method="post" action="/logout" class="shrink-0"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="cursor-pointer text-xs font-semibold tracking-[0.02em] text-gold-400 transition hover:text-parchment-100">Déconnexion</button>
    </form>
  <% } else { %>
    <a href="/login" class="text-xs font-semibold tracking-[0.02em] text-gold-400 no-underline hover:text-parchment-100">Connexion</a>
  <% } %>
  </div>
</div>
</header>

<% if (typeof hero !== 'undefined' && hero) { %>
<%# Accueil : le héros occupe toute la largeur, chaque section recentre son contenu. %>
<main class="relative z-[2] flex w-full grow flex-col">
<% } else { %>
<main class="relative z-[2] mx-auto flex w-full max-w-[1200px] grow flex-col gap-4 px-3.5 pt-5">
<% } %>
<% } %>

<% if (ctx && ctx.world.endedAt) { %>
  <div class="<%= ui.alertInfo %> flex flex-wrap items-center gap-2">
    <%- icon('victory', 'size-4') %><span class="font-semibold">Monde terminé :</span> <%= (ctx.world.victoryState || {}).winnerName %> a gagné. Le monde est en paix.
    <a href="/village/<%= ctx.village.id %>/ranking?type=victory" class="<%= ui.link %> ml-auto">Détails</a>
  </div>
<% } %>
<% if (asSitter) { %>
  <div class="<%= ui.alertInfo %> flex flex-wrap items-center gap-2">
    <span class="font-semibold">Mode vacances :</span> vous jouez le compte de <strong><%= player.name %></strong> en tant que remplaçant.
    <a href="/worlds" class="<%= ui.link %> ml-auto">Revenir à mes mondes</a>
  </div>
<% } %>
<% if (player && player.sleepEndsAt && new Date(player.sleepEndsAt) > now) { const asleep = player.isAsleep(now); %>
  <div class="<%= ui.alertInfo %> flex flex-wrap items-center gap-2">
    <%- icon('moon', 'size-4') %><span class="font-semibold"><%= asleep ? 'Mode sommeil actif' : 'Mode sommeil programmé' %></span>
    <span><%= asleep ? `fin ${when(player.sleepEndsAt, now)}` : `début ${when(player.sleepStartsAt, now)}` %></span>
    <a href="/village/<%= ctx.village.id %>/account" class="<%= ui.link %> ml-auto">Gérer</a>
  </div>
<% } %>
<% if (flash) { const bad = flash.type === 'error'; %>
  <%# Notification (maquette : encart en haut à droite) ; game.js la ferme après quelques secondes. %>
  <div class="fixed top-[108px] right-3.5 minimal:top-[86px] z-[70] flex max-w-[340px] items-center gap-2.5 border-2 border-black bg-panel-top px-3 py-2 shadow-[inset_0_0_0_1px_var(--color-bronze-500),5px_5px_0_#000] transition-opacity duration-500 max-sm:inset-x-3.5 max-sm:max-w-none" role="<%= bad ? 'alert' : 'status' %>" data-toast>
    <span class="size-2.5 shrink-0 rotate-45 border border-black <%= bad ? 'bg-blood-600' : 'bg-olive-500' %>"></span>
    <span class="font-semibold"><%= flash.message %></span>
    <button type="button" class="ml-auto shrink-0 cursor-pointer text-parchment-500 hover:text-parchment-100" data-toast-close aria-label="Fermer"><%- icon('close', 'size-3.5', 3) %></button>
  </div>
<% } %>
