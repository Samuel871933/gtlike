<!doctype html>
<%# En jeu, <html> porte le thème choisi ; les pages publiques partagent une palette neutre inspirée des quatre époques. %>
<html lang="fr" class="h-full scheme-dark light:scheme-light<%= ctx && gameStyle ? ' game_style' : ' lobby_style' %>"<%- ctx && gameStyle ? ` data-game-style="${gameStyle.id}"` : '' %><%- ctx && gameLayout ? ` data-game-layout="${gameLayout.id}"` : '' %><%- ctx && gameLayout && !gameShadows ? ' data-shadows="off"' : '' %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%# Attaques en approche en tête du titre de l'onglet, « (3) Arrivant · Adarma » (mis à jour par game.js). %>
  <title><%= seo ? `${seo.title} | Adarma` : `${incomingAttacks ? `(${incomingAttacks}) ` : ''}${typeof title !== 'undefined' ? `${title} · ` : ''}Adarma` %></title>
  <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png?v=2">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2">
  <meta name="theme-color" content="#1b1715">
  <% if (seo) { %>
  <meta name="description" content="<%= seo.description %>">
  <% if (siteUrl) { const canonicalUrl = siteUrl + seo.canonical; %>
  <link rel="canonical" href="<%= canonicalUrl %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Adarma">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:title" content="<%= seo.title %> | Adarma">
  <meta property="og:description" content="<%= seo.description %>">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:image" content="<%= siteUrl %>/img/brand/adarma-logo-cream.png">
  <meta property="og:image:alt" content="Logo Adarma">
  <meta property="og:image:width" content="1839">
  <meta property="og:image:height" content="362">
  <meta name="twitter:card" content="summary">
  <% if (seo.canonical === '/') { %>
  <script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Adarma', url: siteUrl + '/' }).replace(/</g, '\\u003c') %></script>
  <% } %>
  <% } %>
  <% } else { %><meta name="robots" content="noindex, follow"><% } %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <%# Profil d'un joueur : les polices de son thème en plus (voir views/player.ejs). %>
  <% const fontLinks = ctx && page === 'account' && tab === 'theme' ? [...new Set(Object.values(GAME_STYLES).map((s) => s.fonts))] : [...new Set([ctx && gameStyle ? gameStyle.fonts : GAME_STYLES.roman.fonts, ...(typeof profileStyle !== 'undefined' && profileStyle ? [profileStyle.fonts] : [])])]; %>
  <% for (const href of fontLinks) { %><link rel="stylesheet" href="<%= href %>"><% } %>
  <link rel="stylesheet" href="<%= asset('/css/app.css') %>">
</head>
<%# Dégradé sans répétition : il s'arrête sur la couleur de fond (to-night), sans cassure sous la hauteur de l'écran. %>
<body class="relative flex min-h-full flex-col minimal:text-sm bg-night bg-no-repeat bg-radial-[ellipse_at_50%_-10%] from-halo via-panel-lo via-45% to-night font-sans text-[15px] leading-snug text-parchment-100 antialiased [font-synthesis-weight:none]">
<%# Grain de papier sur toute la page (maquette : trame de points clairs). %>
<div class="pointer-events-none fixed inset-0 z-[1] bg-[radial-gradient(var(--color-grain)_1px,transparent_1.2px)] bg-size-[4px_4px] mix-blend-screen" aria-hidden="true"></div>
<%
  const logo = (cls, style = '') => `<img src="/img/brand/adarma-logo-cream.png" alt="Adarma" width="1839" height="362" class="block w-auto ${cls}"${style ? ` style="${style}"` : ''}>`;
  // Tablette et mobile : les six onglets se partagent toute la largeur d'une seconde ligne, icône au-dessus du libellé.
  const navLink = 'relative flex shrink-0 items-center gap-[7px] border-r border-bronze-800 px-3.5 text-sm font-semibold tracking-[0.02em] whitespace-nowrap no-underline transition max-lg:min-w-0 max-lg:flex-1 max-lg:flex-col max-lg:justify-center max-lg:gap-0.5 max-lg:px-0.5 max-lg:py-1 max-lg:text-[11px] max-lg:last:border-r-0';
  // Onglet actif et survol : aplat rouge (couleur d'action dans les styles clairs), texte et icône clairs.
  // Égypte : barre noire au texte or, onglet actif or au texte noir.
  const navOn = 'bg-blood-800 text-on-accent shadow-[inset_0_-3px_0_var(--color-gold-400)] light:bg-action light:shadow-[inset_0_-3px_0_var(--color-action-line)] light:[&>span:first-child]:text-on-accent adarma:bg-action egypt:bg-head egypt:text-parchment-100 egypt:shadow-[inset_0_-3px_0_var(--color-action)] egypt:[&>span:first-child]:text-parchment-100';
  const navOff = 'text-parchment-300 hover:bg-blood-700 hover:text-on-accent light:hover:bg-action-hi light:hover:[&>span:first-child]:text-on-accent adarma:hover:bg-action-hi egypt:text-on-accent egypt:[&>span:first-child]:text-on-accent';
%>

<% if (ctx) {
  const v = `/village/${ctx.village.id}`;
  const navItems = [
    [`${v}/villages`, 'Aperçu', 'overview', page === 'overview' || page === 'villages' || page === 'manager', 0, ui.countBadge],
    [`${v}/map`, 'Carte', 'map', page === 'map', 0, ui.countBadge],
    [`${v}/reports`, 'Rapports', 'reports', page === 'reports', unreadReports, ui.countBadge],
    [`${v}/messages`, 'Messages', 'messages', page === 'messages', unreadMessages, `${ui.countBadge} bg-gold-400 text-night`],
    [`${v}/tribe`, inMatch ? 'Équipe' : 'Tribu', 'tribe', page === 'tribe', tribeInvites + tribeForumUnread, ui.countBadge],
    // Matchup : pas de classement du monde (la barre de partie donne le score des équipes).
    ...(inMatch ? [] : [[`${v}/ranking`, 'Classement', 'ranking', page === 'ranking', 0, ui.countBadge]]),
  ];
%>
<%# 1. Barre du haut : logo et monde, menu principal, joueur et réglages. %>
<%# Collée en haut de l'écran sur grand écran seulement : sur tablette et mobile, ses trois lignes prendraient un tiers de la hauteur. %>
<header class="relative top-0 z-40 lg:sticky border-b-[3px] border-bronze-500 bg-night shadow-[0_2px_0_var(--color-head-dark),0_6px_0_rgba(0,0,0,0.6)] egypt:border-action-line egypt:bg-action">
<div class="mx-auto flex min-h-12 w-full max-w-[1500px] minimal:max-w-[1120px] items-stretch max-lg:flex-wrap">
  <a href="<%= v %>" class="flex min-h-11 shrink-0 items-center gap-2.5 border-r-[3px] border-black <%= gameStyle.id === 'medieval' || gameStyle.id === 'egypt' ? 'bg-[#3b3d2e]' : 'bg-head-dark' %> pr-6 pl-3 no-underline shadow-[inset_-1px_0_0_var(--color-bronze-500)] [clip-path:polygon(0_0,100%_0,calc(100%-10px)_100%,0_100%)]" title="Aperçu du village">
    <%- logo('h-8 minimal:h-7', 'transform: translateY(-2px)') %>
    <span class="border border-bronze-500 bg-night px-[5px] py-px text-[11px] font-semibold tracking-[0.02em] text-gold-400 max-md:hidden" style="transform: translateY(1px)"><%= ctx.world.name %></span>
  </a>
  <nav class="flex min-w-0 flex-1 items-stretch overflow-x-auto [scrollbar-width:none] max-lg:order-last max-lg:w-full max-lg:flex-none max-lg:overflow-visible max-lg:border-t-2 max-lg:border-black" aria-label="Menu principal">
    <%# Menus déroulants : Rapports, et Tribu quand le joueur en a une. %>
    <% for (const [href, label, ic, active, badge, badgeCls] of navItems) { const menu = ic === 'reports' || (ic === 'tribe' && player && player.tribeId) ? ic : null; %>
      <a href="<%= href %>" class="<%= navLink %> <%= active ? navOn : navOff %>"<%- active ? ' aria-current="page"' : '' %><%- menu ? ` data-menu-toggle="${menu}" aria-haspopup="true" aria-expanded="false"` : '' %>>
        <span class="text-gold-400"><%- icon(ic, 'size-4', 2.2) %></span><%= label %>
        <%# Rapports et messages non lus : relus toutes les 20 s par game.js (data-live-count), même à zéro (masqués). %>
        <% const live = ic === 'reports' || ic === 'messages' ? ic : null; %>
        <% if (badge || live) { %><span class="<%= badgeCls %> max-lg:absolute max-lg:top-0.5 max-lg:left-1/2 max-lg:ml-1.5"<%- live ? ` data-live-count="${live}"` : '' %><%- badge ? '' : ' hidden' %>><%= badge %></span><% } %>
        <%# Couleur du texte de l'onglet (claire sur l'onglet actif ou survolé, quel que soit le style de jeu). %>
        <% if (menu) { %><span class="opacity-70 max-lg:hidden"><%- icon('chevronDown', 'size-3', 3) %></span><% } %>
      </a>
    <% } %>
  </nav>
  <div class="flex shrink-0 items-center gap-2 border-l-[3px] border-black px-2.5 shadow-[inset_1px_0_0_var(--color-bronze-800)] max-lg:ml-auto max-lg:min-w-0 max-lg:shrink">
    <% if (player) { %>
      <%# Pseudo : lien vers son profil (plus d'onglet « Profil » dans le menu) ; rang et points en dessous. %>
      <a href="<%= v %>/players/<%= ctx.village.playerId %>" class="group flex min-w-0 flex-col items-end leading-[1.05] no-underline" title="Votre profil"<%- page === 'profile' ? ' aria-current="page"' : '' %>>
        <span class="max-w-32 truncate text-[15px] max-sm:max-w-24 font-semibold group-hover:text-gold-200 <%= page === 'profile' ? 'text-gold-200' : 'text-parchment-100 egypt:text-on-accent' %>"><%= player.name %></span>
        <span class="text-[11px] text-parchment-500 tabular-nums max-md:hidden egypt:text-gold-700">#<%= num(playerRank) %> · <%= num(player.points) %> pts</span>
      </a>
    <% } %>
    <%# Boutique (hors partie), avec ce monde présélectionné pour les achats « un monde ». %>
    <%# Pièce d'Adarton et solde : accès à la boutique. Pas en matchup (rien ne s'y achète pour la partie). %>
    <% if (!inMatch) { %>
    <a href="/shop?world=<%= encodeURIComponent(ctx.world.slug) %>" class="group flex shrink-0 items-center gap-1 no-underline" title="Boutique" aria-label="Boutique · <%= num(user ? user.adartons : 0) %> Adartons">
      <%- icon('adarton', 'size-7 minimal:size-6 drop-shadow-[0_0_6px_rgba(227,178,60,0.35)] transition group-hover:-rotate-12') %>
      <span class="text-[13px] font-semibold text-gold-200 tabular-nums max-sm:hidden egypt:text-gold-700"><%= num(user ? user.adartons : 0) %></span>
    </a>
    <% } %>
    <a href="<%= v %>/account" class="<%= page === 'account' ? ui.iconBtnOn : ui.iconBtn %>" title="Compte" aria-label="Compte"><%- icon('settings', 'size-4', 2.2) %></a>
    <%# Fausse déconnexion, comme sur Guerre Tribale : on quitte le monde et on revient au choix des mondes (la session reste ouverte). %>
    <a href="<%= inMatch ? '/matchup' : '/worlds' %>" class="<%= ui.iconBtn %>" title="<%= inMatch ? 'Retour au matchup' : 'Déconnexion : retour au choix des mondes' %>" aria-label="<%= inMatch ? 'Retour au matchup' : 'Déconnexion' %>"><%- icon('logout', 'size-4', 2.2) %></a>
  </div>
</div>

<%
  // Contenu des menus déroulants de la barre du haut (ouverts au survol par game.js sous leur bouton ; le clic sur le bouton suit son lien).
  // Filtres des rapports : sans Collecte ni Succès sur les mondes qui ne les ont pas.
  const reportFilters = [['all', 'Tous'], ['attack', 'Attaques'], ['defense', 'Défenses'], ['support', 'Soutiens'], ['trade', 'Commerce'], ['scavenge', 'Collecte'], ['award', 'Succès']]
    .filter(([f]) => (f !== 'scavenge' || ctx.cfg.scavenging.active) && (f !== 'award' || ctx.cfg.achievements.active));
  const menus = [['reports', 'Rapports', reportFilters.map(([f, label]) => [`${v}/reports?filter=${f}`, label, unreadByFilter[f] || 0])]];
  if (player && player.tribeId && inMatch) {
    // Matchup : l'équipe (tribu créée pour la partie, figée) ; ni droits, ni invitations, ni diplomatie.
    menus.push(['tribe', player.Tribe ? `Équipe [${player.Tribe.tag}]` : 'Équipe', [
      [`${v}/tribe`, 'Aperçu', 0],
      [`${v}/tribe?tab=members`, 'Membres', 0],
      [`${v}/tribe?tab=operations`, 'Opérations', 0],
      [`${v}/tribe?tab=forum`, 'Forum', tribeForumUnread],
    ]]);
  } else if (player && player.tribeId) {
    menus.push(['tribe', player.Tribe ? `Tribu [${player.Tribe.tag}]` : 'Tribu', [
      [`${v}/tribe`, 'Aperçu', 0],
      [`${v}/tribe?tab=members`, 'Membres', 0],
      // Droits et Invitations : seulement pour ceux qui ont le droit (comme les onglets de la page Tribu).
      ...(tribeRights.has(player, 'baron') ? [[`${v}/tribe?tab=rights`, 'Droits', 0]] : []),
      ...(tribeRights.has(player, 'invite') ? [[`${v}/tribe?tab=invites`, 'Invitations', 0]] : []),
      [`${v}/tribe?tab=diplomacy`, 'Diplomatie', 0],
      [`${v}/tribe?tab=operations`, 'Opérations', 0],
      [`${v}/tribe?tab=forum`, 'Forum', tribeForumUnread],
      [`${v}/tribes/${player.tribeId}`, 'Page publique', 0],
    ]]);
  }
%>
<div class="relative mx-auto h-0 w-full max-w-[1500px] minimal:max-w-[1120px]">
  <% for (const [id, title, items] of menus) { %>
    <div class="absolute top-0 left-0 z-50 hidden w-[210px] border-2 border-black bg-panel-top shadow-[inset_0_0_0_1px_var(--color-bronze-500),5px_5px_0_#000]" data-menu="<%= id %>">
      <div class="border-b-2 border-bronze-500 bg-head px-2.5 py-[5px] font-display text-xs font-semibold tracking-[0.02em]"><%= title %></div>
      <% for (const [href, label, n] of items) { %>
        <a href="<%= href %>" class="flex items-center justify-between border-b border-bronze-800 px-2.5 py-1.5 font-semibold no-underline last:border-b-0 hover:bg-head-dark hover:text-parchment-100 <%= n || id === 'tribe' ? 'text-parchment-100' : 'text-parchment-500' %>">
          <span class="flex items-center gap-1.5"><span class="size-[5px] rotate-45 bg-bronze-500"></span><%= label %></span>
          <span class="text-xs text-gold-400 tabular-nums"<%- id === 'reports' ? ` data-live-count="reports:${href.split('filter=')[1]}"` : '' %>><%= n || '' %></span>
        </a>
      <% } %>
    </div>
  <% } %>
</div>

<%
  const cap = ctx.state.storageCapacity();
  const prod = ctx.state.productionPerHour();
  // Villages parcourus par les flèches et la liste : ceux du groupe actif (contexte choisi dans la liste ou les aperçus).
  const { prev, next } = villageNav;
  // Barre rapide de Guerre Tribale : accès direct aux bâtiments construits.
  const chip = 'flex items-center gap-[5px] border border-bronze-800 bg-night px-2 py-[3px] whitespace-nowrap no-underline shadow-[inset_0_-2px_0_var(--color-panel-lo),1px_1px_0_#000] transition hover:border-bronze-500 hover:bg-row-hover';
  // Chaque encart mène à son bâtiment : camp de bois, carrière d'argile, mine de fer (même identifiant que la
  // ressource), entrepôt, ferme.
  const bld = (id) => `/village/${ctx.village.id}/building/${id}`;
  const arrow = 'flex size-[26px] shrink-0 items-center justify-center border-2 border-black bg-night text-gold-400 no-underline shadow-[inset_0_0_0_1px_var(--color-bronze-700)] transition hover:bg-head-dark hover:text-parchment-100';
%>
<%# 2. Barre du village : changement de village, attaques entrantes, barre rapide, ressources. %>
<div class="border-t border-black bg-panel-hi shadow-[inset_0_1px_0_var(--color-bronze-800)]">
<div class="mx-auto flex w-full max-w-[1500px] minimal:max-w-[1120px] flex-wrap items-center justify-between gap-1.5 px-2.5 py-[5px]">
  <%# Écran étroit : les favoris passent sous le nom du village, sur toute la largeur. %>
  <div class="flex min-w-0 flex-[1_1_520px] items-center gap-1.5 max-md:flex-wrap">
    <div class="flex shrink-0 items-center gap-1">
      <%# Quêtes et récompenses (le livre des quêtes de GT) : sur les mondes à quêtes, ou tant que le monde donne des
          récompenses de construction ou qu'il en reste à récupérer ; la pastille compte les récompenses en attente. %>
      <% if (rewardsPending || ctx.cfg.tutorial.active || buildRewardsOpen(ctx.cfg, ctx.world, now)) {
           // Première arrivée sur le monde (titulaire) : bulle d'accueil vers les quêtes ; le bouton clignote aussi.
           const questIntro = questHints && questHints.intro && !asSitter;
           const toQuests = questHints && (questHints.ready || questIntro); %>
        <div class="relative mr-1 flex">
          <%# Quête terminable : le bouton clignote (.quest-hint), et ses cibles restent éteintes. %>
          <a href="/village/<%= ctx.village.id %>/rewards<%= toQuests ? '?tab=quests' : '' %>" class="<%= arrow %> relative <%= rewardsPending ? 'text-gold-200' : '' %> <%= questHints && (questHints.ready || questIntro) ? 'quest-hint' : '' %>" title="<%= questHints && questHints.ready ? `Quête « ${questHints.title} » : terminée, viens chercher ta récompense` : `Quêtes et récompenses${rewardsPending ? ` : ${rewardsPending} à récupérer` : ''}` %>" aria-label="Quêtes et récompenses<%= rewardsPending ? ` (${rewardsPending} à récupérer)` : '' %>">
            <%- icon('gift', 'size-4', 2) %>
            <% if (rewardsPending) { %><span class="absolute -top-2 -right-2 min-w-4 border border-black bg-blood-600 px-0.5 text-center text-[10px] leading-[14px] font-semibold text-on-accent tabular-nums"><%= rewardsPending > 99 ? '99+' : rewardsPending %></span><% } %>
          </a>
          <% if (questIntro) { %>
            <%# Bulle d'accueil, flèche vers le bouton : disparaît une fois les quêtes ouvertes ou la bulle fermée. %>
            <div class="quest-intro absolute top-full left-0 z-40 mt-3.5 w-[min(20rem,calc(100vw-1.5rem))] border-2 border-black bg-panel-top p-3.5 shadow-[3px_3px_0_#000]" role="dialog" aria-labelledby="quest-intro-title">
              <span class="absolute -top-[9px] left-[6px] size-4 rotate-45 border-t-2 border-l-2 border-black bg-panel-top" aria-hidden="true"></span>
              <form method="post" action="/village/<%= ctx.village.id %>/quests/intro/dismiss" class="absolute top-1.5 right-1.5"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="flex size-6 cursor-pointer items-center justify-center text-parchment-500 hover:text-parchment-100" title="Fermer" aria-label="Fermer"><%- icon('close', 'size-3.5', 2.6) %></button>
              </form>
              <div class="flex items-start gap-3 pr-5">
                <span class="<%= ui.medallionGold %> size-9"><%- icon('gift', 'size-4.5', 2) %></span>
                <div class="min-w-0">
                  <p id="quest-intro-title" class="m-0 font-display text-lg leading-tight text-parchment-100">Nouveau sur ce monde ?</p>
                  <p class="mt-1 mb-0 text-sm text-parchment-300">Les quêtes te guident pas à pas dans tes premières heures et rapportent des ressources et des troupes.</p>
                </div>
              </div>
              <a href="/village/<%= ctx.village.id %>/rewards?tab=quests" class="<%= btn('gold', 'md', 'mt-3 w-full justify-center') %>">Voir les quêtes<%- icon('arrowRight', 'size-3.5', 2.2) %></a>
            </div>
          <% } %>
        </div>
      <% } %>
      <%# Cibles de la quête en cours (game/tutorial.js) : game.js fait clignoter les liens et boutons concernés. %>
      <% if (questHints && !questHints.ready && questHints.targets.length) { %><span hidden data-quest-hints="<%= JSON.stringify(questHints.targets) %>" data-quest-title="<%= questHints.title %>" data-quest-village="<%= ctx.village.id %>"></span><% } %>
      <% if (prev) { %><a href="/village/<%= prev.id %>" data-village-link class="<%= arrow %>" title="Village précédent : <%= prev.name %>" aria-label="Village précédent"><%- icon('chevronLeft', 'size-3.5', 2.6) %></a><% } %>
      <%# Nom du village : lien vers son aperçu. Le bouton à côté ouvre la liste des villages pour changer de village
          (même page, autre village). %>
      <div class="relative flex items-center">
        <a href="/village/<%= ctx.village.id %>" class="flex h-[26px] items-center gap-1.5 border border-bronze-500 bg-night px-2 text-sm font-semibold text-parchment-100 no-underline hover:text-gold-200" title="Aperçu du village">
          <span class="max-w-44 truncate"><%= ctx.village.name %></span><span class="text-xs text-gold-400 tabular-nums"><%= ctx.village.x %>|<%= ctx.village.y %></span>
        </a>
        <% if (myVillages.length > 1 || villageGroups.length) { %>
          <details class="group">
            <summary class="flex h-[26px] cursor-pointer list-none items-center gap-1 border border-l-0 border-bronze-500 bg-night px-1.5 text-parchment-500 hover:bg-head-dark hover:text-gold-200 [&::-webkit-details-marker]:hidden" title="Changer de village<%= activeGroup ? ` (groupe ${activeGroup.name})` : '' %>" aria-label="Changer de village">
              <% if (activeGroup) { %><span class="max-w-28 truncate text-xs text-gold-400"><%= activeGroup.name %></span><% } %>
              <%- icon('chevronDown', 'size-3 transition group-open:rotate-180', 3) %>
            </summary>
            <div class="<%= ui.popover %> top-full left-0 w-72 p-0">
              <%# Groupes de villages : « Tous » et les groupes du village courant (plus le groupe actif) ; le groupe choisi
                  devient le contexte (flèches, liste, aperçus, gestionnaire). %>
              <% if (headerGroups.length || activeGroup) { %>
                <%# Beaucoup de groupes : la liste des puces défile. %>
                <div class="flex max-h-28 flex-wrap gap-1 overflow-y-auto border-b-2 border-bronze-700 p-2" aria-label="Groupe de villages">
                  <% for (const [id, label] of [[0, 'Tous']].concat(headerGroups.map((g) => [g.id, g.name]))) { const on = (activeGroup ? activeGroup.id : 0) === id; %>
                    <a href="<%= groupHref(id) %>" class="<%= (on ? ui.filterChipOn : ui.filterChip).replace('h-8', 'h-6').replace('px-3', 'px-2').replace('text-[13px]', 'text-xs').replace('max-w-48', 'max-w-full') %>"<%- on ? ' aria-current="true"' : '' %>><span class="truncate"><%= label %></span></a>
                  <% } %>
                </div>
              <% } %>
              <%# Au-delà de 100 villages, la liste part en JSON compact ([id, nom, x, y]) et game.js la construit à la première
                  ouverture du menu, d'après la ligne modèle : sinon chaque page porterait des centaines de Ko de lignes. %>
              <% const navOn = 'bg-head-dark text-parchment-100'; const navOff = 'text-parchment-300 hover:bg-head-dark hover:text-parchment-100'; %>
              <% const navLine = (mv) => `<li><a href="/village/${mv.id}" data-village-link class="flex items-center justify-between gap-3 border-b border-bronze-800 px-2.5 py-1.5 text-sm font-semibold no-underline ${mv.id === ctx.village.id ? navOn : navOff}"><span class="flex items-center gap-1.5 truncate"><span class="size-[5px] shrink-0 rotate-45 bg-bronze-500"></span><span data-nav-name>${esc(mv.name)}</span></span><span class="shrink-0 text-xs text-gold-400 tabular-nums" data-nav-coords>${mv.x}|${mv.y}</span></a></li>`; %>
              <% const lazyNav = navVillages.length > 100; %>
              <ul class="max-h-80 overflow-y-auto"<% if (lazyNav) { %> data-nav-villages="<%= JSON.stringify(navVillages.map((v) => [v.id, v.name, v.x, v.y])) %>" data-nav-current="<%= ctx.village.id %>" data-nav-on="<%= navOn %>" data-nav-off="<%= navOff %>"<% } %>>
                <% if (lazyNav) { %><template data-nav-line><%- navLine({ id: 0, name: '', x: 0, y: 0 }) %></template><% } else { %>
                  <% for (const mv of navVillages) { %><%- navLine(mv) %><% } %>
                <% } %>
                <% if (!navVillages.length) { %><li class="px-2.5 py-2 text-[13px] text-parchment-500">Aucun village dans ce groupe.</li><% } %>
              </ul>
              <a href="/village/<%= ctx.village.id %>/villages?mode=groups" class="block border-t border-bronze-800 px-2.5 py-1.5 text-[13px] text-gold-400 no-underline hover:bg-head-dark hover:text-parchment-100">Gérer les groupes</a>
            </div>
          </details>
        <% } %>
      </div>
      <% if (next) { %><a href="/village/<%= next.id %>" data-village-link class="<%= arrow %>" title="Village suivant : <%= next.name %>" aria-label="Village suivant"><%- icon('chevronRight', 'size-3.5', 2.6) %></a><% } %>
    </div>
    <% if (quickbarPos === 'top') { %><%- include('quickbar') %><% } %>
  </div>
  <%# Écran étroit : les encarts se partagent la largeur et passent à la ligne au lieu d'être coupés (trois par ligne sur
      mobile, l'alerte d'attaques sur toute la largeur) ; nombres abrégés (400k). %>
  <div class="flex min-w-0 flex-[0_1_auto] gap-[3px] overflow-x-auto [scrollbar-width:none] max-md:w-full max-md:flex-wrap max-md:overflow-visible max-md:[&>a]:flex-auto max-md:[&>a]:justify-center max-md:[&>a]:px-1.5 max-sm:grid max-sm:grid-cols-3 max-sm:[&>a:last-child]:col-span-3">
    <% for (const r of RESOURCES) { const value = ctx.state.resources[r.id]; %>
      <a href="<%= bld(r.id) %>" class="<%= chip %>" title="<%= r.label %> · +<%= num(prod[r.id]) %>/h · entrepôt <%= num(cap) %>">
        <span><%- resourceIcon(r.id, 'size-5') %></span>
        <span class="text-sm font-semibold tabular-nums <%= value >= cap ? 'text-blood-450' : 'text-parchment-100' %>" data-res="<%= value %>" data-res-short data-rate="<%= prod[r.id] %>" data-cap="<%= cap %>"
              data-at="<%= ctx.state.resourcesAt.getTime() %>"><%= num(value) %></span>
      </a>
    <% } %>
    <a href="<%= bld('storage') %>" class="<%= chip %>" title="Capacité de l'entrepôt">
      <span><%- resourceIcon('storage', 'size-5') %></span><span class="text-sm font-semibold text-parchment-100 tabular-nums"><span class="md:hidden"><%= numShort(cap) %></span><span class="max-md:hidden"><%= num(cap) %></span></span>
    </a>
    <a href="<%= bld('farm') %>" class="<%= chip %>" title="Population utilisée / capacité de la ferme">
      <span><%- resourceIcon('pop', 'size-5') %></span><span class="text-sm font-semibold text-parchment-100 tabular-nums"><span class="md:hidden"><%= numShort(ctx.popUsed()) %>/<%= numShort(ctx.state.farmCapacity()) %></span><span class="max-md:hidden"><%= num(ctx.popUsed()) %>/<%= num(ctx.state.farmCapacity()) %></span></span>
    </a>
    <%# Sceau du village (module features.seals) : vers la page des sceaux. %>
    <% if (ctx.cfg.features.seals) { const seal = ctx.state.seal; %>
      <a href="/village/<%= ctx.village.id %>/seals" class="<%= chip %>" title="<%= seal ? `Sceau ${SEALS.type(seal.type).name} ${seal.level} : ${SEALS.type(seal.type).effect(SEALS.value(seal.type, seal.level))}` : 'Aucun sceau sur ce village' %>">
        <%# Image seule (pas de libellé) : la barre garde sa largeur et ne passe pas à la ligne. %>
        <%- seal ? sealSvg(seal.type, seal.level, { cls: 'size-6' }) : sealSvg('production', 1, { cls: 'size-6', muted: true, blank: true, title: 'Aucun sceau' }) %>
      </a>
    <% } %>
    <%# Attaques en approche de tous les villages du compte : vers l'aperçu Arrivant. game.js relit le compte toutes les
        30 s (data-incoming-alerts) : compteur, titre de l'onglet et son d'une nouvelle attaque. %>
    <a href="/village/<%= ctx.village.id %>/incomings?type=attacks" class="flex shrink-0 items-center gap-1.5 border-2 border-black bg-blood-600 px-2.5 text-[15px] font-semibold text-on-accent no-underline shadow-[2px_2px_0_#000] transition hover:bg-blood-500" title="Attaques en approche" data-incoming-alerts="/village/<%= ctx.village.id %>/alerts" data-world="<%= ctx.village.worldId %>" <%= incomingAttacks ? '' : 'hidden' %>><%- icon('attack', 'size-[18px]', 2.4) %><span class="tabular-nums" data-incoming-count><%= incomingAttacks %></span></a>
  </div>
</div>
</div>
</header>

<% if (quickbarPos !== 'top') { %><%- include('quickbar') %><% } %>
<main class="relative z-[2] mx-auto flex w-full max-w-[1500px] minimal:max-w-[1120px] grow flex-col gap-3.5 px-2.5 pt-3.5 pb-10 minimal:gap-2.5 minimal:py-6">
<%# Quête en cours : encart de rappel sur les pages où elle se joue (pas sur les quêtes elles-mêmes, ni pendant la
    bulle d'accueil). %>
<% if (questTrackerShown(questHints, asSitter, currentPath, ctx.village.id, user)) { %><%- include('quest-tracker', { variant: 'top' }) %><% } %>
<% if (happyPopup) { %><%- include('happy-hour-popup') %><% } %>
<% } else {
  const lobbyLink = (href, label, active) => `<a href="${href}" class="shrink-0 text-[13px] font-semibold tracking-[0.02em] no-underline transition ${active ? 'text-parchment-100' : 'text-gold-400 hover:text-parchment-100'}">${label}</a>`;
  const current = typeof lobbyPage !== 'undefined' ? lobbyPage : null;
%>
<%# En-tête hors partie : accueil, compte, pages publiques d'un monde. %>
<header class="relative z-20 border-b-2 border-bronze-500 bg-night">
<div class="mx-auto flex min-h-11 w-full max-w-[1200px] flex-wrap items-center justify-between gap-x-6 gap-y-1 px-3.5 py-2">
  <a href="<%= user ? '/worlds' : '/' %>" class="no-underline"><%- logo('h-7') %></a>
  <nav class="flex min-w-0 flex-wrap gap-x-4 gap-y-1" aria-label="Menu">
    <% if (user) { %>
      <%- lobbyLink('/worlds', 'Accueil', current === 'worlds') %>
      <%- lobbyLink('/servers', 'Serveurs', current === 'servers') %>
      <%- lobbyLink('/rules', 'Règles', current === 'rules') %>
      <%- lobbyLink('/help', 'Aide', current === 'help') %>
      <%- lobbyLink('/forum', 'Forum', current === 'forum') %>
      <%- lobbyLink('/shop', 'Boutique', current === 'shop') %>
      <%- lobbyLink('/account', 'Mon compte', current === 'account') %>
    <% } else { %>
      <%- lobbyLink('/', 'Accueil', current === 'home') %>
      <%- lobbyLink('/servers', 'Serveurs', current === 'servers') %>
      <%- lobbyLink('/register', 'Inscription', current === 'register') %>
      <%- lobbyLink('/rules', 'Règles', current === 'rules') %>
      <%- lobbyLink('/help', 'Aide', current === 'help') %>
      <%- lobbyLink('/forum', 'Forum', current === 'forum') %>
    <% } %>
  </nav>
  <div class="flex shrink-0 items-center gap-2.5">
  <span class="border border-bronze-700 px-1.5 py-0.5 text-xs text-parchment-500" title="Langue : français">FR</span>
  <% if (user) { %>
    <form method="post" action="/logout" class="shrink-0"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="cursor-pointer text-xs font-semibold tracking-[0.02em] text-gold-400 transition hover:text-parchment-100">Déconnexion</button>
    </form>
  <% } else { %>
    <a href="/login" class="text-xs font-semibold tracking-[0.02em] text-gold-400 no-underline hover:text-parchment-100">Connexion</a>
  <% } %>
  </div>
</div>
</header>

<% if (typeof hero !== 'undefined' && hero) { %>
<%# Accueil : le héros occupe toute la largeur, chaque section recentre son contenu. %>
<main class="relative z-[2] flex w-full grow flex-col">
<% } else { %>
<main class="relative z-[2] mx-auto flex w-full max-w-[1200px] grow flex-col gap-4 px-3.5 pt-5">
<% } %>
<% } %>

<% if (ctx && typeof matchBar !== 'undefined' && matchBar) { %>
  <%- include('match-bar') %>
<% } else if (ctx && ctx.world.endedAt) { %>
  <div class="<%= ui.alertInfo %> flex flex-wrap items-center gap-2">
    <%- icon('victory', 'size-4') %><span class="font-semibold">Monde terminé :</span> <%= ctx.world.winnerFaction ? `les ${(ctx.world.victoryState || {}).winnerName} ont` : `${(ctx.world.victoryState || {}).winnerName} a` %> gagné. Le monde est en paix.
    <a href="/village/<%= ctx.village.id %>/ranking?type=victory" class="<%= ui.link %> ml-auto">Détails</a>
  </div>
<% } %>
<% if (asSitter) { %>
  <div class="<%= ui.alertInfo %> flex flex-wrap items-center gap-2">
    <span class="font-semibold">Mode vacances :</span> vous jouez le compte de <strong><%= player.name %></strong> en tant que remplaçant.
    <a href="/worlds" class="<%= ui.link %> ml-auto">Revenir à mes mondes</a>
  </div>
<% } %>
<% if (player && player.sleepEndsAt && new Date(player.sleepEndsAt) > now) { const asleep = player.isAsleep(now); %>
  <div class="<%= ui.alertInfo %> flex flex-wrap items-center gap-2">
    <%- icon('moon', 'size-4') %><span class="font-semibold"><%= asleep ? 'Mode sommeil actif' : 'Mode sommeil programmé' %></span>
    <span><%= asleep ? `fin ${when(player.sleepEndsAt, now)}` : `début ${when(player.sleepStartsAt, now)}` %></span>
    <a href="/village/<%= ctx.village.id %>/account" class="<%= ui.link %> ml-auto">Gérer</a>
  </div>
<% } %>
<%# Modèle des notifications affichées par game.js après une action sans rechargement (window.adarmaToast). %>
<template id="toast-template">
  <div class="fixed top-[108px] right-3.5 minimal:top-[86px] z-[70] flex max-w-[340px] items-center gap-2.5 border-2 border-black bg-panel-top px-3 py-2 shadow-[inset_0_0_0_1px_var(--color-bronze-500),5px_5px_0_#000] transition-opacity duration-500 max-sm:inset-x-3.5 max-sm:max-w-none" role="status" data-toast>
    <span class="size-2.5 shrink-0 rotate-45 border border-black bg-olive-500" data-toast-dot></span>
    <span class="font-semibold" data-toast-text></span>
    <button type="button" class="ml-auto shrink-0 cursor-pointer text-parchment-500 hover:text-parchment-100" data-toast-close aria-label="Fermer"><%- icon('close', 'size-3.5', 3) %></button>
  </div>
</template>
<% if (flash) { const bad = flash.type === 'error'; %>
  <%# Notification (maquette : encart en haut à droite) ; game.js la ferme après quelques secondes. %>
  <div class="fixed top-[108px] right-3.5 minimal:top-[86px] z-[70] flex max-w-[340px] items-center gap-2.5 border-2 border-black bg-panel-top px-3 py-2 shadow-[inset_0_0_0_1px_var(--color-bronze-500),5px_5px_0_#000] transition-opacity duration-500 max-sm:inset-x-3.5 max-sm:max-w-none" role="<%= bad ? 'alert' : 'status' %>" data-toast>
    <span class="size-2.5 shrink-0 rotate-45 border border-black <%= bad ? 'bg-blood-600' : 'bg-olive-500' %>"></span>
    <span class="font-semibold"><%= flash.message %></span>
    <button type="button" class="ml-auto shrink-0 cursor-pointer text-parchment-500 hover:text-parchment-100" data-toast-close aria-label="Fermer"><%- icon('close', 'size-3.5', 3) %></button>
  </div>
<% } %>
