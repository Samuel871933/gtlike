<%# Gestionnaire de compte, onglet Marché : le gestionnaire de marché (inclus par manager.ejs avec ses helpers h).
    Routes commerciales (de A vers B, des quantités fixes, à intervalle régulier certains jours) et réserve
    (équilibrage automatique des ressources). %>
<%
  const { m, csrf } = h;
  const DAYS = [[1, 'lundi', 'L'], [2, 'mardi', 'M'], [3, 'mercredi', 'M'], [4, 'jeudi', 'J'], [5, 'vendredi', 'V'], [6, 'samedi', 'S'], [0, 'dimanche', 'D']];
  const pad = (n) => String(n).padStart(2, '0');
  const time = (minute) => `${pad(Math.floor(minute / 60))}:${pad(minute % 60)}`;
  const every = (min) => (min % 60 ? `toutes les ${min} min` : min === 1440 ? 'toutes les 24 h' : `toutes les ${min / 60} h`);
  const daysLabel = (days) => (days.length === 7 ? 'tous les jours' : DAYS.filter(([d]) => days.includes(d)).map(([, l]) => l).join(', '));
  // Rythme d'une route en clair ; anciennes routes sans intervalle : une fois par jour à leur heure.
  const schedule = (r) => `${r.intervalMinutes ? every(r.intervalMinutes) : `une fois par jour à ${time(r.minute)}`}, ${daysLabel(r.days)}`;
  const resLine = (res) => `<span class="inline-flex items-center gap-2.5 align-middle">${RESOURCES.filter((r) => res[r.id]).map((r) => `<span class="inline-flex items-center gap-0.5">${resourceIcon(r.id, 'size-7')}${num(res[r.id])}</span>`).join('')}</span>`;
  // Départ et destination : champs « x|y » avec la liste de ses villages en suggestion (myVillages, de l'en-tête :
  // nom et coordonnées seulement, même pour un compte à des centaines de villages).
  const coords = (v) => `${v.x}|${v.y}`;
  const { reserve } = settings;
  const ROLES = [['both', 'Donne et reçoit'], ['send', 'Donne seulement'], ['receive', 'Reçoit seulement'], ['off', 'Hors réserve']];
  const next = myVillages.find((v) => v.id !== ctx.village.id);
  const listCls = 'whitespace-nowrap [&_td]:h-[44px] [&_td]:py-1 [&_td_img]:min-h-0 [&_td_img]:min-w-0';
%>
<section class="<%= ui.panel %>" id="routes">
  <%- panelHead('Routes commerciales', `<span class="${ui.headCount}">${routes.length}</span>`) %>
  <form method="post" action="<%= m %>/routes" class="flex flex-col gap-3 p-3"><%- csrf %>
    <div class="flex flex-wrap items-end gap-x-3 gap-y-2">
      <label class="<%= ui.label %>">De
        <input name="originCoords" list="own-villages" required value="<%= coords(ctx.village) %>" placeholder="x|y" class="<%= ui.inputSm %> w-28 text-center tabular-nums" autocomplete="off">
      </label>
      <span class="pb-1.5 text-parchment-500"><%- icon('arrowRight', 'size-4', 2.2) %></span>
      <label class="<%= ui.label %>">Vers
        <input name="coords" list="own-villages" required value="<%= next ? coords(next) : '' %>" placeholder="x|y" class="<%= ui.inputSm %> w-28 text-center tabular-nums" autocomplete="off">
      </label>
      <datalist id="own-villages"><% for (const v of myVillages) { %><option value="<%= coords(v) %>"><%= v.name %></option><% } %></datalist>
      <span class="pb-1.5 text-[13px] text-parchment-500">coordonnées, ou tape le nom d’un de tes villages</span>
    </div>
    <div class="flex flex-wrap items-end gap-x-3 gap-y-2">
      <% for (const r of RESOURCES) { %>
        <label class="flex items-center gap-1" title="<%= r.label %>"><%- resourceIcon(r.id, 'size-7') %><input type="number" name="<%= r.id %>" min="0" placeholder="0" class="<%= ui.inputSm %> w-24 text-right tabular-nums" aria-label="<%= r.label %>"></label>
      <% } %>
    </div>
    <div class="flex flex-wrap items-end gap-x-3 gap-y-2">
      <label class="<%= ui.label %>">Fréquence
        <span class="flex items-center gap-1.5">
          <span class="text-sm text-parchment-300">toutes les</span>
          <input type="number" name="every" min="1" step="any" required value="4" class="<%= ui.inputSm %> w-20 text-right tabular-nums" aria-label="Intervalle entre deux envois">
          <select name="unit" class="<%= ui.inputSm %>" aria-label="Unité"><option value="hours" selected>heures</option><option value="minutes">minutes</option></select>
        </span>
      </label>
      <fieldset class="flex flex-col gap-1">
        <legend class="mb-1 text-[13px] text-parchment-400">Jours</legend>
        <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <% for (const [d, label] of DAYS) { %>
            <label class="<%= ui.checkLabel %> text-sm"><input type="checkbox" name="days" value="<%= d %>" class="<%= ui.checkbox %>" checked><%= label %></label>
          <% } %>
        </span>
      </fieldset>
      <button class="<%= btn('gold', 'sm') %>" <%= h.disabled %>><%- icon('plus', 'size-3.5', 2.2) %>Créer la route</button>
    </div>
    <p class="text-[13px] text-parchment-500">Premier envoi dès la création (ou au premier créneau d’un jour coché), puis à chaque intervalle, les jours cochés seulement. Rien ne part si le village de départ n’a pas les ressources ou assez de marchands libres à ce moment-là.</p>
  </form>

  <% if (!routes.length) { %>
    <p class="<%= ui.empty %> border-t border-bronze-800">Aucune route commerciale.</p>
  <% } else { %>
    <div class="relative overflow-x-auto border-t border-bronze-800">
      <table class="<%= ui.table %> <%= listCls %>">
        <thead><tr><th>Route</th><th>Ressources</th><th>Quand</th><th>Prochain envoi</th><th class="max-lg:hidden">Dernier envoi</th><th class="w-8"><span class="sr-only">Supprimer</span></th></tr></thead>
        <tbody>
          <% for (const r of routes) { const other = r.target.Player && r.target.playerId !== ctx.village.playerId; %>
            <tr>
              <td><span class="inline-flex items-center gap-1.5 align-middle"><%- villageLink(h.vid, r.origin, { k: false, truncate: true }) %><span class="text-parchment-500"><%- icon('arrowRight', 'size-3.5', 2.2) %></span><%- villageLink(h.vid, r.target, { k: false, truncate: true }) %><% if (other) { %><span class="text-xs text-parchment-500"><%= r.target.Player.name %></span><% } %></span></td>
              <td class="tabular-nums"><%- resLine(r.resources) %></td>
              <td class="text-parchment-300"><%= schedule(r) %></td>
              <td class="tabular-nums"><%= r.nextAt ? when(r.nextAt, now).replace(/:\d{2}:\d{3}$/, '') : '—' %></td>
              <td class="max-w-56 truncate max-lg:hidden <%= r.lastResult && r.lastResult !== 'Envoyée' ? 'text-blood-450' : 'text-parchment-400' %>" title="<%= r.lastResult || '' %>"><%= r.lastResult || '—' %></td>
              <td>
                <form method="post" action="<%= m %>/routes/delete" class="flex"><%- csrf %><input type="hidden" name="ids" value="<%= r.id %>">
                  <button class="cursor-pointer text-blood-450 hover:text-blood-300 disabled:opacity-40" title="Supprimer la route" aria-label="Supprimer la route" <%= h.disabled %>><%- icon('trash', 'size-3.5', 2.2) %></button>
                </form>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>

<section class="<%= ui.panel %>" id="reserve">
  <%- panelHead('Réserve', reserve.enabled ? '<span class="font-sans text-xs font-semibold text-olive-300">activée</span>' : '<span class="font-sans text-xs text-parchment-500">désactivée</span>') %>
  <form method="post" action="<%= m %>/reserve" class="<%= ui.panelBody %>"><%- csrf %>
    <p class="text-sm text-parchment-400">
      La réserve équilibre tes ressources toute seule, toutes les 8 heures : les villages en <strong class="font-semibold text-parchment-200">excédent</strong>
      (au-dessus du seuil haut) envoient leurs marchands vers les villages en <strong class="font-semibold text-parchment-200">manque</strong>
      (sous le seuil bas), les plus proches d’abord, jusqu’à mi-chemin des deux seuils. Seuls les villages avec un marché y prennent part.
    </p>
    <label class="<%= ui.checkLabel %>"><input type="checkbox" name="enabled" value="1" class="<%= ui.checkbox %>" <%= reserve.enabled ? 'checked' : '' %>>Activer la réserve</label>
    <div class="flex flex-wrap items-end gap-4">
      <label class="<%= ui.label %>">Manque sous<input type="number" name="low" min="0" value="<%= reserve.low %>" class="<%= ui.inputSm %> w-28 text-right tabular-nums"></label>
      <label class="<%= ui.label %>">Excédent au-dessus de<input type="number" name="high" min="0" value="<%= reserve.high %>" class="<%= ui.inputSm %> w-28 text-right tabular-nums"></label>
      <fieldset class="flex flex-col gap-1">
        <legend class="mb-1 text-[13px] text-parchment-400">Ces valeurs sont</legend>
        <label class="<%= ui.checkLabel %> text-sm"><input type="radio" name="mode" value="percent" class="accent-gold-400" <%= reserve.mode === 'percent' ? 'checked' : '' %>>un pourcentage de la capacité de l’entrepôt</label>
        <label class="<%= ui.checkLabel %> text-sm"><input type="radio" name="mode" value="fixed" class="accent-gold-400" <%= reserve.mode === 'fixed' ? 'checked' : '' %>>une quantité fixe de chaque ressource</label>
      </fieldset>
    </div>
    <div class="flex flex-wrap items-center gap-3">
      <button class="<%= btn('gold', 'sm') %>" <%= h.disabled %>><%- icon('check', 'size-3.5', 2.2) %>Enregistrer</button>
      <% if (reserve.lastRunAt) { %><span class="text-sm text-parchment-500">Dernier équilibrage <%= when(reserve.lastRunAt, now) %> : <%= reserve.lastSent || 0 %> livraison<%= reserve.lastSent > 1 ? 's' : '' %>.</span><% } %>
    </div>
  </form>

  <form method="post" action="<%= m %>/reserve-role" class="border-t border-bronze-800"><%- csrf %>
    <div class="relative overflow-x-auto">
      <table class="<%= ui.table %> text-sm">
        <thead><tr>
          <th class="w-8"><input type="checkbox" class="<%= ui.checkbox %>" data-check-all aria-label="Tout sélectionner"></th>
          <th>Village</th><th>Rôle dans la réserve</th><th class="text-right">Routes au départ</th>
        </tr></thead>
        <tbody data-lazy-list="manager">
          <% const lv = lazy('manager', villages, { chunk: 50 }); for (const row of lv.items) { %>
            <tr>
              <td><input type="checkbox" name="ids" value="<%= row.village.id %>" class="<%= ui.checkbox %>" aria-label="<%= row.village.name %>"></td>
              <td><%- villageLink(h.vid, row.village, { k: false, truncate: true }) %><% if (!(row.village.buildings || {}).market) { %> <span class="text-xs text-parchment-500">sans marché</span><% } %></td>
              <td class="<%= row.reserveRole === 'off' ? 'text-parchment-500' : '' %>"><%= ROLES.find(([id]) => id === row.reserveRole)[1] %></td>
              <td class="text-right tabular-nums"><%= row.routeCount %></td>
            </tr>
          <% } %>
          <%- lazyMore(lv, { colspan: 4, label: 'villages' }) %>
        </tbody>
      </table>
    </div>
    <div class="flex flex-wrap items-end gap-3 border-t border-bronze-800 px-3 py-2.5">
      <label class="<%= ui.label %>">Rôle
        <select name="role" class="<%= ui.inputSm %>"><% for (const [id, label] of ROLES) { %><option value="<%= id %>"><%= label %></option><% } %></select>
      </label>
      <%- include('../manager-scope') %>
      <button class="<%= btn('dark', 'sm') %>" <%= h.disabled %>>Confirmer</button>
    </div>
  </form>
  <%- include('../pagination', { list: 'manager', pagination, href: (n) => `${m}?tab=market&page=${n}#reserve` }) %>
</section>
