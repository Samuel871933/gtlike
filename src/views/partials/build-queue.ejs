<%# File de construction (à placer dans un panelBody). %>
<% if (ctx.buildOrders.length) { %>
  <% for (const o of ctx.buildOrders) { const running = new Date(o.startsAt) <= now; const start = new Date(o.startsAt).getTime(); const end = new Date(o.endsAt).getTime();
       const pct = running ? Math.max(0, Math.min(100, ((now - start) / (end - start)) * 100)) : 0; %>
    <div class="<%= running ? ui.boxGold : ui.box %> flex items-center gap-3 p-2.5 ">
      <%- buildingImg(o.building, o.level, 'h-[35px] w-10 minimal:h-7 minimal:w-8') %>
      <div class="flex min-w-0 flex-1 flex-col gap-1.5">
        <div class="flex flex-wrap justify-between gap-x-2">
          <span class="truncate font-semibold"><%= buildingName(o.building) %> <span class="font-medium <%= o.demolish ? 'text-blood-300' : 'text-parchment-500' %>"><%= o.demolish ? `démolition → niveau ${o.level}` : `niveau ${o.level}` %></span></span>
          <% if (running) { %>
            <span class="font-semibold text-gold-200 tabular-nums" data-countdown="<%= end %>"><%= duration((end - now) / 1000) %></span>
          <% } else { %>
            <span class="font-semibold text-parchment-500 tabular-nums"><%= duration((end - start) / 1000) %></span>
          <% } %>
        </div>
        <span class="<%= ui.track %>"><span class="<%= ui.fill %>" style="width: <%= pct.toFixed(1) %>%"<%- running ? ` data-progress-start="${start}" data-progress-end="${end}"` : '' %>></span></span>
        <span class="text-[13px] text-parchment-500">Achèvement <%= when(o.endsAt, now) %></span>
      </div>
<% if (running && !o.demolish) { const freeAt = end - ctx.cfg.freeFinishSeconds * 1000; %>
        <%# Terminer gratuitement : visible dès qu'il reste au plus 3 minutes (game.js l'affiche au bon moment). %>
        <form method="post" action="/village/<%= ctx.village.id %>/build/<%= o.id %>/finish" class="<%= now >= freeAt ? '' : 'hidden' %>" data-free-at="<%= freeAt %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="<%= btn('gold', 'sm') %>" title="Gratuit : moins de <%= Math.round(ctx.cfg.freeFinishSeconds / 60) %> minutes restantes">Terminer</button>
        </form>
      <% } %>
      <form method="post" action="/village/<%= ctx.village.id %>/build/<%= o.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="<%= ui.iconBtnSm %>" title="Annuler" aria-label="Annuler"><%- icon('close', 'size-3', 2.6) %></button>
      </form>
    </div>
  <% } %>
  <p class="text-xs text-parchment-600">
    File <%= ctx.buildOrders.length %>/<%= ctx.buildQueueSlots %><% if (ctx.premium) { %> (premium)<% } else { %> (<a href="/shop/item/premium?world=<%= encodeURIComponent(ctx.world.slug) %>" class="<%= ui.link %>">premium : <%= ctx.buildQueueSlots + ctx.cfg.premium.buildQueueBonus %></a>)<% } %> · une annulation rembourse <%= Math.round(ctx.cfg.cancelRefund * 100) %> % des ressources · une construction se termine gratuitement quand il lui reste moins de <%= Math.round(ctx.cfg.freeFinishSeconds / 60) %> minutes.
  </p>
<% } else { %>
  <p class="text-parchment-500">Aucune construction en cours.</p>
<% } %>
