<%
  const r = sim.result;
  const inp = sim.input;
  const visual = r.hasBattle ? (r.attackerWins ? 'victory' : 'defeat') : 'espionage';
  const verdict = r.hasBattle ? (r.attackerWins ? "Victoire de l'attaquant" : 'Défense victorieuse') : (r.attackerWins ? 'Espionnage réussi' : 'Espionnage repoussé');
  const luckPercent = Math.round(inp.luck * 1000) / 10;
  const moralePercent = Math.round(inp.morale * 100);
  const luckTone = luckPercent > 0 ? 'positive' : luckPercent < 0 ? 'negative' : 'neutral';
  const moraleTone = moralePercent >= 80 ? 'positive' : moralePercent >= 50 ? 'neutral' : 'negative';
  const ids = allUnits.map((u) => u.id);
%>
<div class="report-detail-page mx-auto flex w-full max-w-4xl scroll-mt-16 flex-col gap-5" id="simulation-result">
  <section class="<%= ui.panel %>">
    <%- panelHead('Simulation de combat') %>
    <div class="<%= ui.panelBody %> gap-4">
      <div class="report-hero report-hero--<%= visual %>" style="background-image: url('/img/reports/<%= visual %>.png?v=2')">
        <div class="report-hero__content">
          <span class="report-hero__eyebrow"><%- icon('sword', 'size-4', 2.2) %>Simulation</span>
          <h2 class="report-hero__title"><%= verdict %></h2>
          <p class="report-hero__time">Résultat calculé avec les troupes et paramètres saisis</p>
        </div>
      </div>
      <dl class="grid grid-cols-1 gap-2 sm:grid-cols-3">
        <div class="<%= ui.tile %>"><dt class="<%= ui.tileLabel %>">Chance de l’attaquant</dt><dd class="<%= ui.tileValue %> report-stat--<%= luckTone %>"><%= luckPercent > 0 ? '+' : '' %><%= luckPercent.toFixed(1) %> %</dd><dd class="report-meter report-meter--luck report-meter--<%= luckTone %>" aria-hidden="true"><span style="left: <%= luckPercent < 0 ? 50 - Math.min(50, Math.abs(luckPercent) * 2) : 50 %>%; width: <%= Math.min(50, Math.abs(luckPercent) * 2) %>%"></span></dd></div>
        <div class="<%= ui.tile %>"><dt class="<%= ui.tileLabel %>">Moral de l’attaquant</dt><dd class="<%= ui.tileValue %> report-stat--<%= moraleTone %>"><%= moralePercent %> %</dd><dd class="report-meter report-meter--<%= moraleTone %>" aria-hidden="true"><span style="width: <%= moralePercent %>%"></span></dd></div>
        <div class="<%= ui.tile %>"><dt class="<%= ui.tileLabel %>">Bonus de nuit</dt><dd class="<%= ui.tileValue %>"><%= inp.night ? 'oui' : 'non' %></dd></div>
        <% if (inp.attFaithless || inp.defFaithless) { %>
          <div class="<%= ui.tile %> sm:col-span-3"><dt class="<%= ui.tileLabel %>">Foi</dt><dd class="<%= ui.tileValue %>">Attaquant <%= inp.attFaithless ? '50' : '100' %> % · défenseur <%= inp.defFaithless ? '50' : '100' %> %</dd></div>
        <% } %>
      </dl>
    </div>
  </section>

  <div class="grid gap-4">
    <% for (const [label, units, losses, medal, symbol] of [['Attaquant', inp.attackers, r.attackerLosses, ui.medallionRed, 'troops'], ['Défenseur', inp.defenders, r.defenderLosses, ui.medallion, 'wall']]) { %>
      <section class="report-army-card min-w-0">
        <h2 class="report-section-title"><%- icon(symbol, 'size-4', 2) %><%= label %></h2>
        <div class="report-army-card__body">
          <div class="report-party"><span class="<%= medal %> size-9"><%- icon(symbol, 'size-4', 2) %></span><span class="flex min-w-0 flex-col"><span class="report-party__player">Armée simulée</span><span class="report-party__village"><%= label === 'Attaquant' ? 'Unités envoyées' : `Unités présentes · muraille niveau ${inp.wall}` %></span></span></div>
          <%- include('report-army-table', { ids, units, losses }) %>
        </div>
      </section>
    <% } %>
  </div>

  <section class="<%= ui.panel %>">
    <%- panelHead('Résultat') %>
    <div class="<%= ui.panelBody %> gap-0 py-1">
      <% if (r.hasBattle) { %>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-bronze-700/35 py-2.5"><span class="<%= ui.subLabel %> w-28">Forces</span><span class="text-sm tabular-nums">Attaque <strong><%= num(Math.round(r.attackStrength)) %></strong> · Défense <strong><%= num(Math.round(r.defenseStrength)) %></strong></span></div>
      <% } %>
      <% if (inp.wall > 0 || r.wallAfter !== r.wallBefore) { %>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-bronze-700/35 py-2.5"><span class="<%= ui.subLabel %> w-28"><%= buildingName('wall') %></span><span class="inline-flex items-center gap-2 text-sm"><%- buildingImg('wall', Math.max(1, inp.wall), 'h-7 w-8') %><span>niveau <strong class="tabular-nums"><%= r.wallBefore %></strong> → <strong class="tabular-nums <%= r.wallAfter < r.wallBefore ? 'text-blood-300' : '' %>"><%= r.wallAfter %></strong><% if (r.wallAfter < r.wallBefore) { %> <span class="text-parchment-500">(<%= r.wallBefore - r.wallAfter %> niveau<%= r.wallBefore - r.wallAfter > 1 ? 'x' : '' %> détruit<%= r.wallBefore - r.wallAfter > 1 ? 's' : '' %>)</span><% } %></span></span></div>
      <% } %>
      <p class="py-2.5 text-xs text-parchment-500">Simulation uniquement : aucune troupe, ressource ou muraille n’est modifiée.</p>
    </div>
  </section>
</div>
