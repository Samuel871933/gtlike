<%#
  Héros de l'accueil : panorama des quatre époques et palette commune aux pages publiques,
  titre, puis deux colonnes : à gauche la vitrine du village (partials/village-showcase) et la présentation du jeu, à droite
  les encarts de la page (ui.lobbyCard : connexion, parties en cours, mondes…).
  La page ouvre la colonne de droite avec ce partial, y place ses encarts, puis la referme avec landing-hero-end.
  Locals : cta = { href, label } (bouton principal, absent une fois connecté), login = true pour afficher « Se connecter ».
%>
<%
  const features = [
    ['overview', 'Construire', 'Élève quartier général, forge et muraille.'],
    ['attack', 'Conquérir', 'Lance tes troupes sur les villages voisins.'],
    ['ranking', 'Dominer', 'Unis ta tribu, règne sur le continent.'],
  ];
  // Serveurs privés, présentés sous le jeu : un clic mène à la création (ou à l'inscription hors connexion).
  const privateFeatures = [
    ['settings', 'Tes règles', 'Vitesse, unités, nuit, durée : tout se règle.'],
    ['lock', 'Entre amis', 'Ouvert à tous ou réservé à ceux qui ont le code.'],
    ['gift', 'Gratuit', 'Le jeu est gratuit ; la boutique est facultative.'],
  ];
  const privateHref = typeof user !== 'undefined' && user ? '/servers/new' : '/register';
%>
<%# Au moins la hauteur de l'écran sous le menu (46 px) : les sections suivantes commencent sous la ligne de flottaison. %>
<section class="landing-hero relative flex min-h-[calc(100svh-46px)] flex-col justify-center overflow-hidden border-b-[3px] border-black">
  <div class="pointer-events-none absolute inset-0 bg-[repeating-linear-gradient(115deg,rgba(0,0,0,0.18)_0_2px,transparent_2px_7px)] opacity-35" aria-hidden="true"></div>

  <div class="relative mx-auto w-full max-w-[1100px] px-3.5 pt-6 pb-10">
    <div class="mb-6 text-center">
      <img src="/img/brand/adarma-logo-cream.png" alt="Adarma" width="1839" height="362" class="mx-auto block h-auto w-[min(72vw,430px)] [filter:drop-shadow(3px_3px_2px_#000)]">
      <div class="mt-2 flex items-center justify-center gap-3">
        <span class="h-0.5 w-10 bg-bronze-500 sm:w-15"></span>
        <span class="font-display text-sm font-semibold tracking-[0.02em] text-gold-400 sm:text-base">Forge ton empire</span>
        <span class="h-0.5 w-10 bg-bronze-500 sm:w-15"></span>
      </div>
    </div>

    <%# Deux colonnes : à gauche la vitrine du village puis la présentation, à droite la carte fournie par la page. %>
    <%# Colonnes étirées : les deux font au moins la même hauteur (la présentation et le dernier encart s'allongent). %>
    <div class="grid items-stretch gap-4 lg:grid-cols-2">
      <div class="flex min-w-0 flex-col gap-4">
      <%# Vitrine : un village développé, tel qu'il apparaît en jeu (même décor et mêmes bâtiments que le plan). %>
      <%# Vitrine : prend la hauteur libre de la colonne (au moins 220 px), recadrée depuis le haut du village pour
          garder le quartier général ; la présentation garde sa hauteur naturelle. %>
      <div class="relative isolate flex min-h-[220px] flex-1 items-end overflow-hidden border-2 border-black bg-night shadow-[inset_0_0_0_2px_var(--color-head),5px_5px_0_#000]">
        <%- include('village-showcase', { cls: 'absolute! inset-x-0 top-0 w-full' }) %>
        <div class="absolute inset-x-2.5 bottom-2.5 z-[300] border border-bronze-500 bg-night/90 px-2.5 py-1.5 text-xs text-parchment-400">
          <span class="font-semibold text-gold-400">Ton village</span> · quartier général, caserne, forge et muraille : chaque bâtiment compte.
        </div>
      </div>

      <%# Présentation %>
      <div class="flex flex-col gap-2.5 border-2 border-black bg-night/80 p-3 shadow-[inset_0_0_0_1px_var(--color-bronze-700),5px_5px_0_#000]">
        <% if (typeof lobbyPage !== 'undefined' && (lobbyPage === 'login' || lobbyPage === 'home')) { %>
          <h1 class="m-0 font-display text-[19px] leading-[1.15] font-semibold text-balance">Jeu de stratégie et de gestion en ligne</h1>
        <% } else { %>
          <h2 class="m-0 font-display text-[19px] leading-[1.15] font-semibold text-balance">Le monde appartient aux conquérants</h2>
        <% } %>
        <p class="m-0 text-sm leading-snug text-pretty text-parchment-300">Développe ton village, gère tes ressources et tes bâtiments, forme ton armée et noue des alliances au sein de ta tribu. Conquiers des territoires dans un monde persistant où chaque décision compte.</p>
        <div class="grid grid-cols-3 gap-2">
          <% for (const [ic, t, sub] of features) { %>
            <div class="flex flex-col gap-0.5 border border-black bg-panel-top px-2 py-1.5 shadow-[inset_0_0_0_1px_var(--color-bronze-700),2px_2px_0_#000]">
              <span class="flex items-center gap-1.5"><span class="flex size-5 shrink-0 items-center justify-center border border-black bg-head text-parchment-100"><%- icon(ic, 'size-3', 2.3) %></span>
              <span class="font-display text-xs font-semibold tracking-[0.02em]"><%= t %></span></span>
              <span class="text-[11px] leading-tight text-parchment-500"><%= sub %></span>
            </div>
          <% } %>
        </div>
        <%# Serveurs privés : trois encarts (création et liste des serveurs : encart « Serveurs privés » de l'accueil). %>
        <div class="flex items-center gap-2 pt-1">
          <span class="size-[7px] rotate-45 border border-black bg-gold-400"></span>
          <span class="font-display text-[15px] font-semibold tracking-[0.02em]">Serveurs privés</span>
          <span class="h-px flex-1 bg-bronze-700"></span>
        </div>
        <div class="grid grid-cols-3 gap-2">
          <% for (const [ic, t, sub] of privateFeatures) { %>
            <a href="<%= privateHref %>" class="group flex flex-col gap-0.5 border border-black bg-panel-top px-2 py-1.5 text-parchment-100 no-underline shadow-[inset_0_0_0_1px_var(--color-bronze-700),2px_2px_0_#000] transition hover:-translate-y-px hover:bg-thead">
              <span class="flex items-center gap-1.5"><span class="flex size-5 shrink-0 items-center justify-center border border-black bg-steel-500 text-parchment-100"><%- icon(ic, 'size-3', 2.3) %></span>
              <span class="font-display text-xs font-semibold tracking-[0.02em] group-hover:text-gold-200"><%= t %></span></span>
              <span class="text-[11px] leading-tight text-parchment-500"><%= sub %></span>
            </a>
          <% } %>
        </div>
        <%# Inscription et connexion : seulement hors connexion, en bas de l'encart, côte à côte. %>
        <% if (typeof cta !== 'undefined' && cta) { %>
        <div class="mt-auto flex flex-wrap gap-2 border-t border-dashed border-bronze-700 pt-2.5">
          <a href="<%= cta.href %>" class="<%= btn('gold', 'sm', 'flex-1') %>"><%= cta.label %></a>
          <% if (typeof login !== 'undefined' && login) { %><a href="/login" class="<%= btn('dark', 'sm', 'flex-1') %>">Se connecter</a><% } %>
        </div>
        <% } %>
      </div>
      </div>

      <%# Colonne de droite : un ou plusieurs encarts (ui.lobbyCard) fournis par la page. %>
      <div class="flex min-w-0 flex-col gap-4 [&>*:last-child]:flex-1">
