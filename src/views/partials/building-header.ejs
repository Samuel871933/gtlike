<%# En-tête commun des pages de bâtiment : médaillon, nom, niveau, description, statistique principale (actuel → prochain niveau). %>
<% const bType = registry.building(buildingId); const bLevel = ctx.state.level(buildingId); const stat = buildingStat(buildingId, bLevel, ctx.cfg);
   const nextStat = bLevel < bType.maxLevel ? buildingStat(buildingId, bLevel + 1, ctx.cfg) : null; %>
<section class="<%= ui.panel %>">
  <div class="flex flex-col gap-4 px-4.5 py-4 sm:flex-row sm:items-center sm:gap-5">
    <div class="flex min-w-0 flex-1 items-center gap-4">
      <span class="relative block size-18 shrink-0 rounded-full p-[3px] <%= bLevel ? 'bg-linear-to-b from-gold-300 to-gold-700' : 'bg-bronze-700' %> shadow-[0_3px_8px_rgba(0,0,0,0.6)]">
        <span class="flex size-full items-center justify-center rounded-full border border-black/60 bg-radial-[at_35%_30%] from-well-hi to-well-lo to-75% <%= bLevel ? 'text-gold-300' : 'text-parchment-600' %>">
          <%- buildingIcon(buildingId, 'size-8', 1.6) %>
        </span>
        <% if (bLevel) { %><span class="absolute -right-1.5 -bottom-1 <%= ui.levelBadge %>"><%= bLevel %></span><% } %>
      </span>
      <div class="flex min-w-0 flex-col gap-1">
        <h1 class="m-0 font-display text-xl font-bold tracking-[0.06em] text-gold-200 sm:text-2xl"><%= bType.name %> <span class="font-sans text-base font-medium tracking-normal text-parchment-500"><%= bLevel ? `niveau ${bLevel}` : 'non construit' %></span></h1>
        <p class="text-[15px] text-parchment-400"><%= bType.description %></p>
      </div>
    </div>
    <% if (stat) { %>
      <dl class="<%= ui.boxGold %> flex shrink-0 flex-col gap-1 px-4 py-2.5 sm:min-w-56 sm:text-right">
        <dt class="<%= ui.kicker %>"><%= stat.label %></dt>
        <dd class="flex flex-wrap items-baseline gap-x-2 sm:justify-end">
          <span class="text-lg font-extrabold text-parchment-100 tabular-nums"><%= stat.value %></span>
          <% if (nextStat) { %>
            <span class="inline-flex items-center gap-1.5 text-sm text-parchment-500"><span class="text-gold-400"><%- icon('arrowRight', 'size-3.5', 2.2) %></span><span class="font-bold text-gold-200 tabular-nums"><%= nextStat.value %></span> au niveau <%= bLevel + 1 %></span>
          <% } %>
        </dd>
      </dl>
    <% } %>
  </div>
  <% if (typeof body !== 'undefined' && body) { %><div class="border-t border-bronze-900 px-4.5 py-3"><%- body %></div><% } %>
  <%- corners() %>
</section>
