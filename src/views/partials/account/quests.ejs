<%# Compte, panneau « Quêtes » (onglet de account.ejs, avec vid) : encarts de rappel de la quête en cours, réglage du
    compte connecté (User.questReminders). Deux cartes à appliquer, comme le style de jeu ; aperçus en px fixes. %>
<section class="<%= ui.panel %>" id="quetes">
  <%- panelHead('Rappels des quêtes', `<span class="text-[13px] text-parchment-500">Gratuit · tous les mondes</span>`) %>
  <p class="border-b border-bronze-900 px-4 py-2.5 text-sm text-parchment-400">Un encart en haut des pages où se joue la quête du tutoriel (sous l’illustration des bâtiments sur grand écran) : ses conditions, leur progression et sa récompense. Le bouton des quêtes et ce qu’il faut cliquer restent signalés dans les deux cas.</p>
  <div class="grid gap-3 p-4.5 sm:grid-cols-2">
    <% for (const [value, name, description] of [['on', 'Avec rappels', 'La quête en cours s’affiche sur les pages où elle se joue.'], ['off', 'Sans rappels', 'Pages sans encart de quête ; les quêtes restent dans le bouton cadeau.']]) { const on = value === 'on'; const active = user.questReminders === on; %>
      <form method="post" action="/village/<%= vid %>/account/quest-reminders"
            class="flex flex-col overflow-hidden border-2 border-black bg-panel-top text-parchment-200 <%= active ? 'shadow-[inset_0_0_0_2px_var(--color-gold-200),5px_5px_0_#050505]' : 'shadow-[inset_0_0_0_1px_var(--color-bronze-700),5px_5px_0_#050505]' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="reminders" value="<%= value %>">
        <%# Page schématique : l'encart de quête (bord doré, vignette, barre) au-dessus d'un encart de contenu. %>
        <div class="m-1 flex h-[112px] flex-col gap-[8px] border-2 border-black bg-night p-[10px]" aria-hidden="true" data-layout-preview>
          <% if (on) { %>
            <span class="flex h-[30px] shrink-0 items-center gap-[8px] border-2 border-l-[4px] border-black border-l-gold-400 bg-panel-top px-[6px]">
              <span class="h-[16px] w-[34px] shrink-0 bg-olive-600"></span>
              <span class="flex flex-1 flex-col gap-[4px]">
                <span class="h-[4px] w-[46%] bg-parchment-100/70"></span>
                <span class="flex h-[6px] w-full border border-black bg-night"><span class="h-full w-[55%] bg-blood-700"></span></span>
              </span>
              <span class="h-[12px] w-[30px] shrink-0 border border-black bg-action"></span>
            </span>
          <% } %>
          <span class="flex flex-1 flex-col border-2 border-black bg-panel-top">
            <span class="h-[12px] border-b-2 border-b-bronze-500 bg-head"></span>
            <span class="flex flex-col gap-[5px] p-[6px]"><% for (const w of ['w-[88%]', 'w-[70%]', 'w-[80%]']) { %><span class="h-[4px] <%= w %> bg-parchment-500/40"></span><% } %></span>
          </span>
        </div>
        <div class="flex flex-1 flex-col gap-2 border-t-2 border-bronze-500 p-3">
          <span class="flex items-center justify-between gap-2">
            <span class="font-display text-lg font-semibold tracking-[0.02em] text-gold-400"><%= name %></span>
            <% if (active) { %><span class="<%= ui.tagGold %>">Actif</span><% } else if (on) { %><span class="text-[13px] text-parchment-500">Par défaut</span><% } %>
          </span>
          <span class="text-sm text-parchment-400"><%= description %></span>
          <% if (!active) { %><button class="<%= btn('gold', 'sm', 'mt-auto w-full') %>">Appliquer</button><% } %>
        </div>
      </form>
    <% } %>
  </div>
</section>
