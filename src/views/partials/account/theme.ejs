<%# Compte, panneau « Thème de jeu » (onglet de account.ejs, avec sleep, vid, scheduled, shopLink, ownFilter). %>
<%# Thème de jeu : réglage du compte connecté (un remplaçant choisit donc le sien). Cartes comme à la boutique. %>
<section class="<%= ui.panel %>">
  <%- panelHead('Thème de jeu', `<span class="text-[13px] text-parchment-500">Le thème Adarma est gratuit, les autres s’achètent à la <a href="/shop#themes" class="text-gold-200 underline hover:text-parchment-100">boutique</a></span>`) %>
  <p class="border-b border-bronze-900 px-4 py-2.5 text-sm text-parchment-400">Le thème change tout l’intérieur du jeu : couleurs, polices et fonds. Il ne s’applique qu’à toi.</p>
  <% const list = ownFilter(Object.values(GAME_STYLES).map((s) => ({ s, owned: shopRights.has(`theme:${s.id}`) }))); %>
  <%- list.bar %>
  <div class="grid gap-3 p-4.5 sm:grid-cols-2 xl:grid-cols-3">
    <% if (!list.shown.length) { %><p class="text-parchment-500 sm:col-span-2 xl:col-span-3"><%= own === 'owned' ? 'Aucun thème possédé.' : 'Tu possèdes déjà tous les thèmes.' %></p><% } %>
    <% for (const { s, owned } of list.shown) { const active = gameStyle && gameStyle.id === s.id; %>
      <%# Carte et aperçu de la boutique (helpers.cosmeticPreview), aux couleurs du thème affiché. %>
      <form method="post" action="/village/<%= vid %>/account/game-style" class="group flex flex-col gap-2 border-2 border-black bg-panel-top p-1 text-parchment-200 <%= active ? 'shadow-[inset_0_0_0_2px_var(--color-gold-200),4px_4px_0_#050505]' : 'shadow-[inset_0_0_0_1px_var(--color-bronze-700),4px_4px_0_#050505]' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="style" value="<%= s.id %>">
        <%- cosmeticPreview('theme', s.id) %>
        <span class="flex flex-1 flex-col gap-1.5 px-2.5 pb-2.5">
          <span class="flex items-center justify-between gap-2">
            <span class="font-display text-lg font-semibold text-gold-400"><%= s.name %></span>
            <% if (active) { %><span class="<%= ui.tagGold %>">Actif</span><% } else if (!owned) { %><span class="inline-flex items-center gap-1 text-[13px] text-parchment-500"><%- icon('lock', 'size-3.5', 2) %>À débloquer</span><% } %>
          </span>
          <span class="text-sm text-parchment-400"><%= s.description %></span>
          <span class="mt-auto flex border-t border-bronze-900 pt-2">
            <% if (!active && owned) { %><button class="<%= btn('gold', 'sm', 'w-full') %>">Appliquer</button><% } %>
            <% if (!owned) { %><a href="<%= shopLink(`theme:${s.id}`) %>" class="<%= btn('dark', 'sm', 'w-full') %>"><%- icon('adarton', 'size-5') %>Débloquer</a><% } %>
            <% if (active) { %><span class="text-sm text-parchment-500">Utilisé en ce moment</span><% } %>
          </span>
        </span>
      </form>
    <% } %>
  </div>
</section>
