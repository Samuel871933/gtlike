<%# File de recrutement comme sur GT (pleine largeur d'un panneau, hors panelBody) : prochaine unité, puis
    tableau Formation / Durée / Achèvement / Annuler. `showEmpty` optionnel. %>
<% if (orders.length) { const first = orders[0]; const firstNext = new Date(first.nextAt); %>
  <p class="flex flex-wrap items-center gap-x-2 border-b border-bronze-900 px-4.5 py-2.5 text-[15px] text-parchment-400">
    Achèvement de la prochaine unité (<%= unitName(first.unit) %>) :
    <span class="font-semibold text-gold-200 tabular-nums" data-countdown="<%= firstNext.getTime() %>"><%= duration((firstNext - now) / 1000) %></span>
  </p>
  <div class="overflow-x-auto">
    <table class="<%= ui.table %>">
      <thead><tr><th>Formation</th><th>Durée</th><th class="max-sm:hidden">Achèvement</th><th class="text-right">Annuler</th></tr></thead>
      <tbody>
      <% for (const o of orders) { const running = new Date(o.startsAt) <= now; const end = new Date(o.endsAt); %>
        <tr class="<%= running ? ui.rowActive : '' %>">
          <td>
            <span class="flex items-center gap-3">
              <span class="<%= running ? ui.medallionGold : ui.medallion %> size-[34px] minimal:size-[26px]"><%- unitIcon(o.unit, 'size-[17px]') %></span>
              <span class="flex min-w-0 flex-col">
                <span class="font-semibold text-parchment-100"><span class="tabular-nums"><%= num(o.count - o.done) %></span> <%= unitName(o.unit) %></span>
                <span class="text-[13px] text-parchment-500 sm:hidden"><%= when(end, now) %></span>
              </span>
            </span>
          </td>
          <td class="whitespace-nowrap tabular-nums">
            <% if (running) { %>
              <span class="font-semibold text-gold-200" data-countdown="<%= end.getTime() %>"><%= duration((end - now) / 1000) %></span>
            <% } else { %>
              <span class="text-parchment-300"><%= duration((end - new Date(o.startsAt)) / 1000) %></span>
            <% } %>
          </td>
          <td class="whitespace-nowrap text-parchment-300 max-sm:hidden"><%= when(end, now) %></td>
          <td class="text-right">
            <form method="post" action="/village/<%= ctx.village.id %>/recruit-order/<%= o.id %>/cancel" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="<%= btn('danger', 'sm') %>"><%- icon('close', 'size-3', 2.6) %>Annuler</button>
            </form>
          </td>
        </tr>
      <% } %>
      </tbody>
    </table>
  </div>
  <p class="border-t border-bronze-900 px-4.5 py-2 text-xs text-parchment-600">Une annulation rembourse <%= Math.round(ctx.cfg.cancelRefund * 100) %> % des unités restantes.</p>
<% } else if (typeof showEmpty === 'undefined' || showEmpty) { %>
  <p class="px-4.5 py-3 text-parchment-500">Aucune formation en cours.</p>
<% } %>
