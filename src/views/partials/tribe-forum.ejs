<%#
  Forum de la tribu (onglet « Forum » de la page Tribu), agencement de Guerre Tribale dans la DA Adarma :
  rangée des sous-forums, encadré « Nouveaux messages du forum », titre du sous-forum et ses liens (lu, sourdine),
  Nouveau sujet / Créer un sondage / recherche, puis le tableau Sujets · Auteur · Dernier message · Réponses.
  `forum.view` : 'section', 'thread' ou 'settings' (gestion des sous-forums par les chefs).
%>
<%
  const f = `${t}/forum`;
  const csrf = `<input type="hidden" name="_csrf" value="${csrfToken}">`;
  const nameOf = (a) => (a ? a.name : 'Joueur parti');
  const who = (a) => (a ? `<a href="/village/${ctx.village.id}/players/${a.id}" class="${ui.link}">${esc(a.name)}</a>` : '<span class="text-parchment-500">Joueur parti</span>');
  const PAGE = 20;
  const pagesOf = (th) => Math.max(1, Math.ceil(th.postCount / PAGE));
  // Liens de page d'un sujet long : « ( 1, 2, dernière page ) ».
  const pageLinks = (th) => {
    const n = pagesOf(th);
    if (n < 2) return '';
    const shown = Array.from({ length: Math.min(n, 3) }, (_, i) => i + 1);
    return ` <span class="text-[11px] font-semibold text-parchment-500">( ${shown.map((p) => `<a href="${f}/t/${th.id}?page=${p}" class="${ui.link}">${p}</a>`).join(', ')}, <a href="${f}/t/${th.id}?page=last" class="${ui.link}">dernière page</a> )</span>`;
  };
  const chip = 'inline-flex h-8 items-center gap-1.5 border-2 border-black px-3 text-[13px] font-semibold  no-underline shadow-[2px_2px_0_#000] transition';
  const currentSection = forum.view === 'section' ? forum.section.id : forum.view === 'thread' ? forum.section.id : null;
  const mutedSet = forum.muted || new Set();
  // Rangée des sous-forums : les réglages reçoivent { section, threads } par sous-forum.
  const tabs = forum.view === 'settings' ? forum.sections.map((x) => x.section) : forum.sections;
%>

<%# Rangée des sous-forums (et réglages pour les chefs) %>
<% if (tabs) { %>
  <nav class="flex flex-wrap gap-1.5" aria-label="Sous-forums">
    <% for (const s of tabs) { const on = s.id === currentSection; const mute = mutedSet.has(s.id); %>
      <a href="<%= f %>/<%= s.id %>" class="<%= chip %> <%= on ? 'bg-head-dark text-parchment-100 shadow-[inset_0_0_0_1px_var(--color-bronze-500),2px_2px_0_#000]' : 'bg-panel-hi text-gold-400 hover:bg-row-hover hover:text-parchment-100' %> <%= mute && !on ? 'opacity-60' : '' %>"<%- on ? ' aria-current="page"' : '' %> title="<%= mute ? 'Forum ignoré (en sourdine)' : s.name %>">
        <% if (mute) { %><%- icon('moon', 'size-3', 2.4) %><% } %><%= s.name %>
      </a>
    <% } %>
    <% if (forum.manager) { %>
      <a href="<%= f %>/settings" class="<%= chip %> <%= forum.view === 'settings' ? 'bg-head-dark text-parchment-100' : 'bg-night text-parchment-500 hover:text-parchment-100' %>"><%- icon('settings', 'size-3.5', 2.2) %>Réglages du forum</a>
    <% } %>
  </nav>
<% } %>

<% if (forum.view === 'section') { const s = forum.section; const r = forum.recent; %>
  <%# Nouveaux messages du forum %>
  <details class="<%= ui.panel %> group" open>
    <summary class="<%= ui.panelHead %> cursor-pointer list-none [&::-webkit-details-marker]:hidden">
      <span class="<%= ui.panelTitle %>"><span class="<%= ui.diamond %>" aria-hidden="true"></span>Nouveaux messages du forum <% if (r.total) { %><span class="<%= ui.countBadge %> ml-1"><%= r.total %></span><% } %></span>
      <span class="flex size-5 items-center justify-center border border-black bg-night text-parchment-300" aria-hidden="true"><span class="group-open:hidden">+</span><span class="hidden group-open:inline">−</span></span>
    </summary>
    <form method="get" class="flex justify-end border-b border-bronze-800 px-3 py-1.5 text-xs text-parchment-300">
      <% for (const [k, v] of Object.entries(forum.query)) { if (!['sourdine', 'np'].includes(k)) { %><input type="hidden" name="<%= k %>" value="<%= v %>"><% } } %>
      <input type="hidden" name="sourdine" value="<%= r.excludeMuted ? '0' : '1' %>">
      <label class="flex cursor-pointer items-center gap-1.5"><input type="checkbox" class="<%= ui.checkbox %>" <%= r.excludeMuted ? 'checked' : '' %> data-autosubmit> Exclure les messages des forums mis en sourdine</label>
      <noscript><button class="<%= ui.link %> ml-2">OK</button></noscript>
    </form>
    <% if (!r.threads.length) { %>
      <p class="px-3 py-2.5 text-[13px] text-parchment-500">Aucun nouveau message. Tu es à jour !</p>
    <% } else { %>
      <table class="<%= ui.table %>">
        <thead><tr><th>Sujet</th><th class="text-center">Forum</th><th class="text-center">Dernier message</th></tr></thead>
        <tbody>
          <% for (const { thread: th, lastPost } of r.threads) { %>
            <tr>
              <td><a href="<%= f %>/t/<%= th.id %>?page=last" class="<%= ui.linkPlain %> font-semibold"><%= th.title %></a></td>
              <td class="text-center font-semibold text-gold-400"><%= th.section.name %></td>
              <td class="text-center text-[13px] leading-tight"><%- lastPost ? who(lastPost.author) : '' %><br><span class="text-parchment-500"><%= when(th.lastPostAt, now) %></span></td>
            </tr>
          <% } %>
        </tbody>
      </table>
      <% if (r.pages > 1) { const q = (n) => '?' + new URLSearchParams({ ...forum.query, np: n }).toString(); %>
        <div class="flex justify-between border-t-2 border-black bg-thead px-3 py-1.5 text-[13px] font-semibold">
          <% if (r.page > 1) { %><a href="<%= q(r.page - 1) %>" class="<%= ui.link %>">« Précédent 5</a><% } else { %><span></span><% } %>
          <% if (r.page < r.pages) { %><a href="<%= q(r.page + 1) %>" class="<%= ui.link %>">Suivant 5 »</a><% } %>
        </div>
      <% } %>
    <% } %>
  </details>

  <%# Titre du sous-forum et liens %>
  <div class="flex flex-wrap items-end justify-between gap-3 pt-2">
    <h2 class="m-0 font-display text-[26px] font-bold tracking-[0.02em] [text-shadow:2px_2px_0_var(--color-title-shadow),4px_4px_0_var(--color-title-shadow-2)]"><%= s.name %><% if (forum.isMuted) { %> <span class="<%= ui.tagMuted %> align-middle">En sourdine</span><% } %></h2>
    <div class="flex flex-col items-end gap-0.5 text-[13px] font-semibold">
      <span class="flex flex-wrap justify-end gap-x-4">
        <form method="post" action="<%= f %>/<%= s.id %>/read"><%- csrf %><button class="<%= ui.link %> cursor-pointer">» Marquer le forum comme lu</button></form>
        <form method="post" action="<%= f %>/read-all"><%- csrf %><button class="<%= ui.link %> cursor-pointer">» Marquer tous les forums comme lus</button></form>
      </span>
      <form method="post" action="<%= f %>/<%= s.id %>/mute"><%- csrf %><button class="<%= ui.link %> cursor-pointer">» <%= forum.isMuted ? 'Ne plus ignorer le forum' : 'Ignorer le forum' %></button></form>
    </div>
  </div>

  <%# Nouveau sujet, sondage, recherche %>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div class="flex flex-wrap gap-2">
      <a href="<%= f %>/<%= s.id %>?nouveau=sujet#redaction" class="<%= btn('dark', 'md') %>"><%- icon('edit', 'size-4', 2.2) %>Nouveau sujet</a>
      <a href="<%= f %>/<%= s.id %>?nouveau=sondage#redaction" class="<%= btn('dark', 'md') %>"><%- icon('ranking', 'size-4', 2.2) %>Créer un sondage</a>
    </div>
    <form method="get" action="<%= f %>/<%= s.id %>" class="flex" role="search">
      <input name="q" value="<%= forum.q %>" placeholder="Rechercher :" aria-label="Rechercher dans le forum" class="<%= ui.input %> w-56">
      <button class="flex w-[38px] cursor-pointer items-center justify-center border-2 border-l-0 border-black bg-blood-800 text-on-accent hover:bg-blood-600" aria-label="Rechercher"><%- icon('search', 'size-4', 2.6) %></button>
    </form>
  </div>

  <% if (forum.compose) { const poll = forum.compose === 'sondage'; %>
    <section class="<%= ui.panel %>" id="redaction">
      <%- panelHead(poll ? 'Créer un sondage' : 'Nouveau sujet', `<a href="${f}/${s.id}" class="${ui.link} font-sans text-xs">Annuler</a>`) %>
      <form method="post" action="<%= f %>/<%= s.id %>" class="<%= ui.panelBody %>"><%- csrf %>
        <% if (forum.error) { %><div class="<%= ui.alertError %>"><%= forum.error %></div><% } %>
        <label class="<%= ui.label %>"><%= poll ? 'Question' : 'Titre' %><input name="title" value="<%= forum.form.title || '' %>" minlength="3" maxlength="80" required autofocus class="<%= ui.input %>"></label>
        <% if (poll) { %>
          <label class="<%= ui.label %>">Réponses (une par ligne, 2 à 10)<textarea name="options" rows="4" required class="<%= ui.textarea %>" placeholder="Oui&#10;Non"><%= Array.isArray(forum.form.options) ? forum.form.options.join('\n') : (forum.form.options || '') %></textarea></label>
        <% } %>
        <label class="<%= ui.label %>">Message<textarea name="body" rows="6" maxlength="5000" required class="<%= ui.textarea %>"><%= forum.form.body || '' %></textarea></label>
        <button class="<%= btn('gold', 'md', 'self-start') %>"><%= poll ? 'Publier le sondage' : 'Publier le sujet' %></button>
      </form>
    </section>
  <% } %>

  <%# Sujets (ou résultats de recherche) %>
  <% const list = forum.results || forum.threads; %>
  <section class="<%= ui.panel %>">
    <% if (forum.results) { %><%- panelHead(`Résultats pour « ${forum.q} »`, `<a href="${f}/${s.id}" class="${ui.link} font-sans text-xs">Effacer la recherche</a>`) %><% } %>
    <% if (!list.length) { %>
      <p class="p-3 text-parchment-500"><%= forum.results ? 'Aucun sujet ne correspond.' : 'Aucun sujet. Lance la discussion !' %></p>
    <% } else { %>
      <div class="overflow-x-auto">
        <table class="<%= ui.table %> min-w-[640px]">
          <thead><tr><th>Sujets</th><th class="text-center">Auteur</th><th class="text-center">Dernier message</th><th class="w-24 text-center">Réponses</th></tr></thead>
          <tbody>
            <% for (const th of list) { const isNew = forum.results ? false : forum.unread.has(th.id); %>
              <tr>
                <td>
                  <span class="flex min-w-0 items-center gap-2">
                    <span class="flex size-6 shrink-0 items-center justify-center border-2 border-black <%= isNew ? 'bg-blood-600 text-on-accent' : 'bg-night text-parchment-500' %>" title="<%= isNew ? 'Nouveaux messages' : 'Lu' %>"><%- icon(th.poll ? 'ranking' : 'messages', 'size-3.5', 2.2) %></span>
                    <span class="min-w-0">
                      <% if (th.pinned) { %><span class="<%= ui.tagGold %> mr-1">Épinglé</span><% } %><% if (th.locked) { %><span class="<%= ui.tagMuted %> mr-1">Verrouillé</span><% } %><% if (th.poll) { %><span class="<%= ui.tagOlive %> mr-1">Sondage</span><% } %>
                      <a href="<%= f %>/t/<%= th.id %><%= isNew ? '?page=last' : '' %>" class="<%= ui.linkPlain %> <%= isNew ? 'font-semibold' : 'font-semibold' %>"><%= th.title %></a><%- pageLinks(th) %>
                      <% if (forum.results) { %><span class="block text-[11px] text-parchment-500"><%= th.section.name %></span><% } %>
                    </span>
                  </span>
                </td>
                <td class="text-center text-[13px] leading-tight"><%- who(th.author) %><br><span class="text-parchment-500"><%= when(th.createdAt, now) %></span></td>
                <td class="text-center text-[13px] leading-tight"><%- th.lastPost ? who(th.lastPost.author) : '' %><br><span class="text-parchment-500"><%= when(th.lastPostAt, now) %></span></td>
                <td class="text-center font-semibold tabular-nums"><%= num(th.postCount - 1) %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
    <% if (!forum.results && forum.pages > 1) { %><div class="border-t border-bronze-800 px-3 py-2"><%- include('pager', { page: forum.page, pages: forum.pages, href: (n) => `${f}/${s.id}?page=${n}` }) %></div><% } %>
  </section>
<% } %>

<% if (forum.view === 'settings') { %>
  <section class="<%= ui.panel %>">
    <%- panelHead('Réglages du forum', `<span class="font-sans text-[11px] text-parchment-300">Sous-forums de la tribu</span>`) %>
    <div class="overflow-x-auto">
      <table class="<%= ui.table %> min-w-[520px]">
        <thead><tr><th>Sous-forum</th><th class="text-right">Sujets</th><th class="text-right">Gestion</th></tr></thead>
        <tbody>
          <% forum.sections.forEach(({ section, threads }, i) => { %>
            <tr>
              <td><a href="<%= f %>/<%= section.id %>" class="<%= ui.linkPlain %> inline-flex items-center gap-2 font-display font-semibold "><span class="size-[7px] shrink-0 rotate-45 border border-black bg-gold-400"></span><%= section.name %></a></td>
              <td class="text-right font-semibold tabular-nums"><%= num(threads) %></td>
              <td class="text-right whitespace-nowrap">
                <form method="post" action="<%= f %>/sections/<%= section.id %>/move" class="inline"><%- csrf %><input type="hidden" name="dir" value="-1"><button class="<%= ui.iconBtn %> size-[26px] align-middle" title="Monter" aria-label="Monter" <%= i === 0 ? 'disabled' : '' %>><%- icon('chevronUp', 'size-3', 2.6) %></button></form>
                <form method="post" action="<%= f %>/sections/<%= section.id %>/move" class="inline"><%- csrf %><input type="hidden" name="dir" value="1"><button class="<%= ui.iconBtn %> size-[26px] align-middle" title="Descendre" aria-label="Descendre" <%= i === forum.sections.length - 1 ? 'disabled' : '' %>><%- icon('chevronDown', 'size-3', 2.6) %></button></form>
                <details class="relative inline-block align-middle">
                  <summary class="<%= ui.iconBtn %> size-[26px] list-none [&::-webkit-details-marker]:hidden" title="Renommer" aria-label="Renommer"><%- icon('edit', 'size-3', 2.4) %></summary>
                  <form method="post" action="<%= f %>/sections/<%= section.id %>/rename" class="<%= ui.popover %> right-0 flex w-72 gap-2"><%- csrf %>
                    <input name="name" value="<%= section.name %>" maxlength="40" required class="<%= ui.input %> min-w-0 flex-1" aria-label="Nom du sous-forum">
                    <button class="<%= btn('gold', 'md') %>">OK</button>
                  </form>
                </details>
                <% if (forum.sections.length > 1) { %>
                  <form method="post" action="<%= f %>/sections/<%= section.id %>/delete" class="inline" data-confirm="Supprimer « <%= section.name %> » et tous ses sujets ?"><%- csrf %><button class="<%= ui.iconBtnSm %> align-middle" title="Supprimer" aria-label="Supprimer le sous-forum"><%- icon('close', 'size-[11px]', 3.4) %></button></form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <form method="post" action="<%= f %>/sections" class="flex flex-wrap items-end gap-2 border-t border-bronze-800 px-3 py-2.5"><%- csrf %>
      <label class="<%= ui.label %> min-w-56 flex-1 sm:max-w-80">Nouveau sous-forum<input name="name" maxlength="40" required placeholder="Opérations, Diplomatie…" class="<%= ui.input %>"></label>
      <button class="<%= btn('dark', 'md') %>"><%- icon('plus', 'size-3.5', 2.6) %>Créer</button>
    </form>
  </section>
<% } %>

<% if (forum.view === 'thread') { const th = forum.thread; const pageHref = (n) => `${f}/t/${th.id}?page=${n}`; %>
  <div class="flex flex-wrap items-end justify-between gap-2 pt-2">
    <div>
      <a href="<%= f %>/<%= forum.section.id %>" class="<%= ui.link %> inline-flex items-center gap-1.5 text-[13px]"><%- icon('arrowLeft', 'size-3.5', 2.4) %><%= forum.section.name %></a>
      <h2 class="m-0 font-display text-[24px] font-bold [text-shadow:2px_2px_0_var(--color-title-shadow),4px_4px_0_var(--color-title-shadow-2)]"><%= th.title %></h2>
    </div>
    <%- include('pager', { page: forum.page, pages: forum.pages, href: pageHref }) %>
  </div>

  <% if (forum.poll) { const pl = forum.poll; %>
    <section class="<%= ui.panel %>">
      <%- panelHead('Sondage', `<span class="font-sans text-[11px] text-parchment-300 tabular-nums">${num(pl.total)} VOTE${pl.total > 1 ? 'S' : ''}</span>`) %>
      <form method="post" action="<%= f %>/t/<%= th.id %>/vote" class="<%= ui.panelBody %> gap-2"><%- csrf %>
        <% pl.options.forEach((opt, i) => { const pct = pl.total ? Math.round((pl.counts[i] / pl.total) * 100) : 0; %>
          <label class="grid cursor-pointer grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-2.5">
            <input type="radio" name="option" value="<%= i %>" class="accent-blood-700" <%= pl.mine === i ? 'checked' : '' %> <%= th.locked ? 'disabled' : '' %> required>
            <span class="flex flex-col gap-1">
              <span class="font-semibold <%= pl.mine === i ? 'text-gold-200' : '' %>"><%= opt %></span>
              <span class="<%= ui.track %>"><span class="<%= ui.fill %>" style="width: <%= pct %>%"></span></span>
            </span>
            <span class="w-20 text-right text-[13px] tabular-nums"><b><%= pct %> %</b> <span class="text-parchment-500">(<%= pl.counts[i] %>)</span></span>
          </label>
        <% }) %>
        <% if (!th.locked) { %><button class="<%= btn('gold', 'sm', 'self-start') %>"><%= pl.mine == null ? 'Voter' : 'Changer mon vote' %></button><% } %>
      </form>
    </section>
  <% } %>

  <section class="<%= ui.panel %>">
    <%- panelHead(forum.poll ? 'Discussion' : 'Messages', forum.manager ? `
      <div class="flex gap-1">
        <form method="post" action="${f}/t/${th.id}/flag">${csrf}<input type="hidden" name="flag" value="pinned"><input type="hidden" name="on" value="${th.pinned ? '' : '1'}"><button class="${th.pinned ? ui.segOn : ui.segOff} cursor-pointer">${th.pinned ? 'Désépingler' : 'Épingler'}</button></form>
        <form method="post" action="${f}/t/${th.id}/flag">${csrf}<input type="hidden" name="flag" value="locked"><input type="hidden" name="on" value="${th.locked ? '' : '1'}"><button class="${th.locked ? ui.segOn : ui.segOff} cursor-pointer">${th.locked ? 'Déverrouiller' : 'Verrouiller'}</button></form>
      </div>` : (th.locked ? `<span class="${ui.tagMuted}">Verrouillé</span>` : '')) %>
    <% for (const post of forum.posts) { const mine = post.playerId === forum.player.id; const first = post.id === forum.firstPostId;
         const canDelete = forum.manager || (mine && (!first || th.postCount === 1)); %>
      <article class="border-b border-bronze-800 last:border-b-0" id="p<%= post.id %>">
        <div class="flex flex-wrap items-center justify-between gap-2 bg-thead px-3 py-1.5">
          <span class="flex items-center gap-2">
            <span class="flex size-6 items-center justify-center border-2 border-black bg-night font-display text-xs font-bold text-gold-400"><%= post.author ? post.author.name[0].toUpperCase() : '?' %></span>
            <b><%- who(post.author) %></b>
            <% if (post.author && th.playerId === post.playerId) { %><span class="<%= ui.tagGold %>">Auteur</span><% } %>
          </span>
          <span class="text-xs text-parchment-500 tabular-nums"><%= when(post.createdAt, now) %><%= post.editedAt ? ' · modifié' : '' %></span>
        </div>
        <div class="px-3.5 py-3 leading-snug break-words whitespace-pre-line text-parchment-100"><%= post.body %></div>
        <% if (mine || canDelete) { %>
          <div class="flex flex-wrap items-start gap-3 px-3 pb-2">
            <% if (mine) { %>
              <details class="min-w-0 flex-1">
                <summary class="cursor-pointer list-none text-[13px] font-semibold text-gold-400 hover:text-parchment-100 [&::-webkit-details-marker]:hidden">Modifier</summary>
                <form method="post" action="<%= f %>/p/<%= post.id %>/edit" class="mt-2 flex flex-col gap-2"><%- csrf %><input type="hidden" name="page" value="<%= forum.page %>">
                  <textarea name="body" rows="5" maxlength="5000" required class="<%= ui.textarea %>" aria-label="Message"><%= post.body %></textarea>
                  <button class="<%= btn('gold', 'sm', 'self-start') %>">Enregistrer</button>
                </form>
              </details>
            <% } %>
            <% if (canDelete) { %>
              <form method="post" action="<%= f %>/p/<%= post.id %>/delete" class="ml-auto" data-confirm="<%= first ? 'Supprimer ce sujet et toutes ses réponses ?' : 'Supprimer ce message ?' %>"><%- csrf %>
                <button class="cursor-pointer text-[13px] font-semibold text-blood-500 hover:text-parchment-100"><%= first ? 'Supprimer le sujet' : 'Supprimer' %></button>
              </form>
            <% } %>
          </div>
        <% } %>
      </article>
    <% } %>
  </section>
  <% if (forum.pages > 1) { %><%- include('pager', { page: forum.page, pages: forum.pages, href: pageHref }) %><% } %>

  <section class="<%= ui.panel %>" id="repondre">
    <%- panelHead('Répondre') %>
    <% if (th.locked && !forum.manager) { %>
      <p class="p-3 text-parchment-500">Ce sujet est verrouillé par les chefs de la tribu.</p>
    <% } else { %>
      <form method="post" action="<%= f %>/t/<%= th.id %>" class="<%= ui.panelBody %>"><%- csrf %>
        <% if (forum.error) { %><div class="<%= ui.alertError %>"><%= forum.error %></div><% } %>
        <textarea name="body" rows="5" maxlength="5000" required class="<%= ui.textarea %>" aria-label="Ta réponse"><%= forum.form.body || '' %></textarea>
        <button class="<%= btn('gold', 'md', 'self-start') %>">Envoyer</button>
      </form>
    <% } %>
  </section>
<% } %>
