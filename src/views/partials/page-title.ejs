<%# Barre de titre d'une page de contenu (liseré aux couleurs du thème, grand titre Cinzel). Locals : kicker, title, sub. %>
<div class="<%= ui.panel %> flex flex-col gap-0.5 py-3 pr-3.5 pl-5">
  <div class="absolute inset-y-0 left-0 w-1.5 border-r-2 border-black bg-[repeating-linear-gradient(180deg,var(--color-head)_0_8px,var(--color-head-dark)_8px_16px)]" aria-hidden="true"></div>
  <% if (typeof kicker !== 'undefined' && kicker) { %><span class="text-[11px] tracking-[0.02em] text-gold-400"><%= kicker %></span><% } %>
  <h1 class="m-0 font-display text-[26px] font-bold tracking-[0.02em] text-parchment-100 [text-shadow:2px_2px_0_var(--color-title-shadow),4px_4px_0_var(--color-title-shadow-2)] sm:text-[30px]"><%= title %></h1>
  <% if (typeof sub !== 'undefined' && sub) { %><p class="text-sm text-parchment-500"><%= sub %></p><% } %>
</div>
