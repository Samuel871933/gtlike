</main>
<%
  // Pages légales, en pied de page en jeu comme hors partie (routes : web/routes/legal.js).
  const legalLinks = [
    ['/mentions-legales', 'Mentions légales'],
    ['/cgu', 'CGU'],
    ['/cgv', 'CGV'],
    ['/confidentialite', 'Confidentialité'],
    ['/cookies', 'Cookies'],
  ];
%>
<% if (ctx) { %>
<footer class="relative z-[2] border-t-2 border-bronze-500 bg-night">
<div class="mx-auto flex w-full max-w-[1500px] minimal:max-w-[1120px] flex-wrap items-center justify-between gap-3 px-2.5 py-1.5 text-xs text-parchment-500">
  <div class="flex flex-wrap gap-3">
    <b class="text-gold-400"><%= ctx.world.name %></b>
    <a href="/worlds/<%= ctx.world.slug %>/info" class="<%= ui.link %> font-normal">Réglages du monde</a>
    <a href="/forum" class="<%= ui.link %> font-normal">Forum</a>
    <a href="/help" class="<%= ui.link %> font-normal">Aide</a>
    <a href="/rules" class="<%= ui.link %> font-normal">Règles</a>
    <a href="/village/<%= ctx.village.id %>/invite" class="<%= ui.link %> font-normal">Inviter des joueurs</a>
    <a href="/village/<%= ctx.village.id %>/ranking" class="<%= ui.link %> font-normal">Classement</a>
    <a href="/village/<%= ctx.village.id %>/account" class="<%= ui.link %> font-normal">Compte</a>
    <a href="/worlds" class="<%= ui.link %> font-normal">Déconnexion</a>
  </div>
  <div class="tabular-nums">Heure du serveur : <b class="text-parchment-100" data-clock="<%= now.getTime() %>"><%= now.toLocaleString('fr-FR') %></b></div>
  <nav class="flex basis-full flex-wrap gap-x-3 gap-y-0.5 border-t border-bronze-800 pt-1 text-parchment-700" aria-label="Informations légales">
    <% for (const [href, label] of legalLinks) { %><a href="<%= href %>" class="no-underline transition hover:text-parchment-100"><%= label %></a><% } %>
  </nav>
</div>
</footer>
<% } else { %>
<footer class="relative z-[2] mt-10 shrink-0 border-t-[3px] border-bronze-500 bg-night-deep shadow-[inset_0_2px_0_var(--color-head-dark)]">
<div class="mx-auto flex w-full max-w-[1200px] flex-col gap-3.5 px-3.5 pt-4.5 pb-4.5">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(150px,1fr))] gap-3.5">
    <div class="flex flex-col gap-[3px]">
      <img src="/img/brand/adarma-logo-cream.png" alt="Adarma" width="1839" height="362" class="mb-[3px] block h-6 w-auto self-start">
      <span class="text-[13px] text-parchment-500">Jeu de stratégie par navigateur, par mondes.</span>
    </div>
    <div class="flex flex-col gap-[3px]">
      <b class="mb-[3px] font-display text-sm text-gold-400">Jeu</b>
      <% if (user) { %>
        <a href="/worlds" class="text-[13px] text-parchment-500 no-underline hover:text-parchment-100">Mondes</a>
        <a href="/shop" class="text-[13px] text-parchment-500 no-underline hover:text-parchment-100">Boutique</a>
        <a href="/account" class="text-[13px] text-parchment-500 no-underline hover:text-parchment-100">Mon compte</a>
      <% } else { %>
        <a href="/" class="text-[13px] text-parchment-500 no-underline hover:text-parchment-100">Accueil</a>
        <a href="/register" class="text-[13px] text-parchment-500 no-underline hover:text-parchment-100">Inscription</a>
      <% } %>
    </div>
    <div class="flex flex-col gap-[3px]">
      <b class="mb-[3px] font-display text-sm text-gold-400">Communauté</b>
      <a href="/forum" class="text-[13px] text-parchment-500 no-underline hover:text-parchment-100">Forum</a>
    </div>
    <div class="flex flex-col gap-[3px]">
      <b class="mb-[3px] font-display text-sm text-gold-400">Support</b>
      <a href="/rules" class="text-[13px] text-parchment-500 no-underline hover:text-parchment-100">Règles</a>
      <a href="/help" class="text-[13px] text-parchment-500 no-underline hover:text-parchment-100">Aide</a>
      <a href="/password/forgot" class="text-[13px] text-parchment-500 no-underline hover:text-parchment-100">Mot de passe oublié</a>
    </div>
    <div class="flex flex-col gap-[3px]">
      <b class="mb-[3px] font-display text-sm text-gold-400">Informations légales</b>
      <% for (const [href, label] of legalLinks) { %>
        <a href="<%= href %>" class="text-[13px] text-parchment-500 no-underline hover:text-parchment-100"><%= label %></a>
      <% } %>
    </div>
  </div>
  <div class="flex flex-wrap justify-between gap-2 border-t border-bronze-800 pt-2.5 text-xs text-parchment-700">
    <span>© <%= now.getFullYear() %> Adarma · Monde persistant de stratégie</span>
    <span class="tabular-nums">Heure du serveur : <span data-clock="<%= now.getTime() %>"><%= now.toLocaleString('fr-FR') %></span></span>
  </div>
</div>
</footer>
<% } %>
<script src="/js/game.js"></script>
</body>
</html>
