<%- include('partials/header', { title: 'Nouveau mot de passe', hero: true, lobbyPage: 'login' }) %>
<%- include('partials/landing-hero-start', { cta: { href: '/register', label: 'Jouer gratuitement' }, login: true }) %>
<div class="<%= ui.lobbyCard %>">
  <h1 class="<%= ui.lobbyCardHead %>">Nouveau mot de passe</h1>
  <div class="flex flex-1 flex-col gap-2.5 p-3.5">
    <% if (error) { %><div class="<%= ui.alertError %>"><%= error %></div><% } %>
    <% if (!valid) { %>
      <p class="text-sm text-parchment-300">Ce lien est invalide, a déjà servi ou a expiré.</p>
      <a href="/password/forgot" class="<%= btn('gold', 'md', 'w-full') %>">Demander un nouveau lien</a>
    <% } else { %>
      <form method="post" action="/password/reset/<%= token %>" class="flex flex-col gap-2.5"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="<%= ui.label %>">Nouveau mot de passe
          <input type="password" name="password" minlength="8" required autofocus class="<%= ui.input %> h-9 w-full">
          <span class="text-xs font-normal tracking-normal text-parchment-500 normal-case">8 caractères minimum.</span>
        </label>
        <label class="<%= ui.label %>">Confirmation
          <input type="password" name="confirm" minlength="8" required class="<%= ui.input %> h-9 w-full">
        </label>
        <button class="<%= btn('gold', 'md', 'w-full') %>">Enregistrer</button>
      </form>
    <% } %>
    <div class="mt-auto border-t border-dashed border-bronze-700 pt-2.5">
      <a href="/login" class="<%= ui.link %> text-[13px]">» Retour à la connexion</a>
    </div>
  </div>
</div>
<%- include('partials/landing-hero-end') %>
<%- include('partials/footer') %>
