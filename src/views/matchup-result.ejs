<%- include('partials/header', { title: 'Fin de partie' }) %>
<%
  // Écran de fin d'une partie du matchup (voir MatchService.results) : résultat, scores, joueurs des deux équipes.
  const mine = user ? teams.flatMap((t) => t.rows).find((r) => r.userId === user.id) : null;
  const winner = match.winnerTeam ? teams[match.winnerTeam - 1] : null;
  const result = mine ? (match.winnerTeam === null ? 'Égalité' : match.winnerTeam === mine.team ? 'Victoire' : 'Défaite') : null;
  const banner = result === 'Victoire' ? 'victory' : result === 'Défaite' ? 'defeat' : 'neutral';
  const title = result || (winner ? `Les ${winner.short.toLowerCase()} gagnent` : 'Égalité');
  const why = { conquest: 'par conquête : l’équipe adverse n’a plus aucun village', forfeit: 'par abandon de l’équipe adverse', time: 'aux points, à la fin du temps' }[match.reason] || '';
  const minutes = Math.max(1, Math.round((new Date(match.endedAt) - new Date(match.startedAt)) / 60000));
  const scores = match.scores || [0, 0];
  // Partie de placement : l'elo visible ne bouge pas, sauf à la dernière (il est révélé).
  const delta = mine && mine.eloAfter !== null && !mine.placement ? mine.eloAfter - mine.eloBefore : null;
  const rank = mine ? ratings[match.ladder].rank : null;
  const color = { 1: 'bg-steel-500', 2: 'bg-blood-600' };
%>
<div class="flex flex-col gap-3.5 pb-6">
  <section class="<%= ui.panel %> matchup-result-hero matchup-result-hero--<%= banner %>" aria-labelledby="matchup-result-title">
    <div class="matchup-result-hero__content">
      <p class="text-xs font-semibold tracking-wide text-gold-200">Matchup <%= match.format %> · partie terminée</p>
      <h1 id="matchup-result-title" class="m-0 font-display text-3xl font-bold text-parchment-100 sm:text-4xl"><%= title %></h1>
      <p class="text-sm text-parchment-200"><%= result && winner ? `Les ${winner.short.toLowerCase()} gagnent ` : '' %><%= why %> · <%= minutes %> min de jeu.</p>
    </div>
  </section>

  <section class="<%= ui.panel %> flex flex-wrap items-center justify-center gap-x-8 gap-y-3 px-4 py-4">
    <% for (const t of teams) { %>
      <span class="flex items-center gap-2.5 <%= mine && mine.team === t.n ? 'text-parchment-100' : 'text-parchment-300' %>">
        <span class="size-3.5 rotate-45 border border-black <%= color[t.n] %>"></span>
        <span class="font-display text-xl font-semibold"><%= t.short %></span>
        <b class="font-display text-3xl font-semibold tabular-nums <%= match.winnerTeam === t.n ? 'text-gold-200' : '' %>"><%= num(scores[t.n - 1]) %></b>
      </span>
      <% if (t.n === 1) { %><span class="text-parchment-500">contre</span><% } %>
    <% } %>
    <% if (mine && mine.placement) { %>
      <span class="flex basis-full flex-wrap items-center justify-center gap-x-4 gap-y-1 border-t border-bronze-800 pt-3 text-sm">
        <span class="text-parchment-400"><%= mine.eloAfter !== mine.eloBefore ? `Placement terminé : te voilà classé à ${num(mine.eloAfter)} elo` : 'Partie de placement : ton elo sera révélé à la fin du placement' %></span>
        <span class="text-parchment-400">Ligue : <b class="text-parchment-100"><%= rank.label %></b></span>
      </span>
    <% } else if (delta !== null) { %>
      <span class="flex basis-full flex-wrap items-center justify-center gap-x-4 gap-y-1 border-t border-bronze-800 pt-3 text-sm">
        <span class="text-parchment-400">Ton elo <%= mu.LADDERS[match.ladder].toLowerCase() %> : <b class="text-parchment-100 tabular-nums"><%= num(mine.eloBefore) %> → <%= num(mine.eloAfter) %></b></span>
        <span class="font-semibold tabular-nums <%= delta >= 0 ? 'text-olive-300' : 'text-blood-450' %>"><%= delta >= 0 ? '+' : '' %><%= delta %></span>
        <span class="text-parchment-400">Ligue : <b class="text-parchment-100"><%= rank.label %></b></span>
      </span>
    <% } %>
  </section>

  <div class="grid gap-3.5 lg:grid-cols-2">
    <% for (const t of teams) { %>
      <section class="<%= ui.panel %>">
        <%- panelHead(`${t.name}${match.winnerTeam === t.n ? ' · victoire' : match.winnerTeam ? ' · défaite' : ''}`) %>
        <div class="overflow-x-auto">
          <table class="<%= ui.table %> text-sm [&_td]:px-3 [&_td]:py-1.5 [&_th]:px-3">
            <thead><tr><th>Joueur</th><th class="text-right">Points</th><th class="text-right">Villages</th><th class="text-right">Vaincus</th><th class="text-right">Elo</th></tr></thead>
            <tbody>
              <% for (const r of t.rows) { const d = r.eloAfter === null ? null : r.eloAfter - r.eloBefore; %>
                <tr class="<%= mine && r.userId === mine.userId ? 'bg-thead' : '' %>">
                  <td class="font-semibold"><%= r.name %><% if (r.forfeited) { %> <span class="text-xs font-normal text-parchment-500">(abandon)</span><% } %></td>
                  <td class="text-right tabular-nums"><%= num(r.points) %></td>
                  <td class="text-right tabular-nums"><%= num(r.villages) %></td>
                  <td class="text-right tabular-nums"><%= num(r.kills) %></td>
                  <td class="text-right tabular-nums whitespace-nowrap"><% if (r.placement) { %><span class="text-xs text-parchment-500">placement</span><% } else if (d !== null) { %><span class="<%= d >= 0 ? 'text-olive-300' : 'text-blood-450' %>"><%= d >= 0 ? '+' : '' %><%= d %></span> <span class="text-parchment-500"><%= num(r.eloAfter) %></span><% } %></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>
    <% } %>
  </div>

  <div class="flex flex-wrap justify-center gap-2.5">
    <a href="/matchup" class="<%= btn('gold', 'md') %>"><%- icon('sword', 'size-4', 2.2) %>Rejouer</a>
    <a href="/matchup/classement?ladder=<%= match.ladder %>" class="<%= btn('dark', 'md') %>"><%- icon('ranking', 'size-4', 2.2) %>Classement</a>
  </div>
</div>
<%- include('partials/footer') %>
