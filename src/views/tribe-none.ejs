<%- include('partials/header', { title: 'Tribu' }) %>
<div class="grid grid-cols-1 items-start gap-5 lg:grid-cols-2">
  <section class="<%= ui.panel %>">
    <%- panelHead('Fonder une tribu', '', { tag: 'h1' }) %>
    <div class="<%= ui.panelBody %> gap-4">
      <div class="flex items-start gap-3">
        <span class="<%= ui.medallionGold %> size-[42px] minimal:size-[32px]"><%- icon('tribe', 'size-[21px]') %></span>
        <p class="text-parchment-400">Une tribu permet de s'entraider, de coordonner les attaques et de partager la diplomatie. Jusqu'à <strong class="text-parchment-200 tabular-nums"><%= ctx.cfg.tribe.memberLimit %></strong> membres sur ce monde.</p>
      </div>
      <form method="post" action="/village/<%= ctx.village.id %>/tribe/create" class="flex flex-col gap-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="<%= ui.label %>">Nom
          <input name="name" minlength="3" maxlength="32" required class="<%= ui.input %> w-full">
        </label>
        <label class="<%= ui.label %>">Tag
          <input name="tag" maxlength="6" required class="<%= ui.input %> w-32 uppercase">
          <span class="text-xs text-parchment-600">1 à 6 caractères, affiché sur la carte et dans les classements.</span>
        </label>
        <div><button class="<%= btn('gold') %>" data-tribe-join><%- icon('flag', 'size-3.5', 2.2) %>Fonder la tribu</button></div>
      </form>
    </div>
  </section>

  <section class="<%= ui.panel %>">
    <%- panelHead('Invitations', invites.length ? `<span class="${ui.countBadge}">${invites.length}</span>` : '') %>
    <div class="<%= ui.panelBody %>">
      <% if (!invites.length) { %>
        <p class="text-parchment-500">Aucune invitation pour le moment.</p>
      <% } else { %>
        <% for (const inv of invites) { %>
          <div class="<%= ui.box %> flex flex-wrap items-center gap-3 p-2.5">
            <span class="flex min-w-40 flex-1"><%- tribeLink(ctx.village.id, inv.Tribe, { name: true, tagCls: ui.tagGold, avatar: true }) %></span>
            <div class="flex gap-2">
              <form method="post" action="/village/<%= ctx.village.id %>/tribe/invites/<%= inv.id %>/accept"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="<%= btn('gold', 'sm') %>" data-tribe-join>Rejoindre</button></form>
              <form method="post" action="/village/<%= ctx.village.id %>/tribe/invites/<%= inv.id %>/decline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="<%= btn('danger', 'sm') %>">Refuser</button></form>
            </div>
          </div>
        <% } %>
      <% } %>
    </div>
  </section>
</div>
<%- include('partials/footer') %>
