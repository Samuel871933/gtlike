<%- include('partials/header', { title: `${thread.title} · Forum` }) %>
<% const pageHref = (n) => `/forum/t/${thread.id}?page=${n}`; %>
<div class="flex flex-col gap-3.5 pb-4">
  <%- include('partials/page-title', { kicker: `Forum · ${section.name}`, title: thread.title }) %>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <a href="/forum/<%= section.id %>" class="<%= ui.link %> inline-flex items-center gap-1.5 text-[13px]"><%- icon('arrowLeft', 'size-3.5', 2.4) %><%= section.name %></a>
    <%- include('partials/pager', { page, pages, href: pageHref }) %>
  </div>

  <% for (const post of posts) { const mine = user && post.userId === user.id; const first = post.id === firstPostId; %>
    <article class="<%= ui.panel %>" id="p<%= post.id %>">
      <div class="flex flex-wrap items-center justify-between gap-2 border-b-2 border-bronze-500 bg-head px-3 py-1.5">
        <span class="flex items-center gap-2">
          <span class="flex size-6 items-center justify-center border-2 border-black bg-night font-display text-xs font-bold text-gold-400"><%= post.author ? post.author.username[0].toUpperCase() : '?' %></span>
          <b class="<%= post.author ? '' : 'text-parchment-500' %>"><%= post.author ? post.author.username : 'Compte supprimé' %></b>
          <% if (post.author && thread.userId === post.userId) { %><span class="<%= ui.tagGold %>">Auteur</span><% } %>
        </span>
        <span class="text-xs text-parchment-300 tabular-nums"><%= when(post.createdAt, now) %><%= post.editedAt ? ' · modifié' : '' %></span>
      </div>
      <div class="px-3.5 py-3 leading-snug break-words whitespace-pre-line text-parchment-100"><%= post.body %></div>
      <% if (mine) { %>
        <div class="flex flex-wrap items-start gap-2 border-t border-bronze-800 px-3 py-1.5">
          <details class="group min-w-0 flex-1">
            <summary class="cursor-pointer list-none text-[13px] font-semibold text-gold-400 hover:text-parchment-100 [&::-webkit-details-marker]:hidden">Modifier</summary>
            <form method="post" action="/forum/p/<%= post.id %>/edit" class="mt-2 flex flex-col gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="page" value="<%= page %>">
              <textarea name="body" rows="5" maxlength="5000" required class="<%= ui.textarea %>" aria-label="Message"><%= post.body %></textarea>
              <button class="<%= btn('gold', 'sm', 'self-start') %>">Enregistrer</button>
            </form>
          </details>
          <% if (!first || thread.postCount === 1) { %>
            <form method="post" action="/forum/p/<%= post.id %>/delete" data-confirm="<%= first ? 'Supprimer ce sujet ?' : 'Supprimer ce message ?' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="cursor-pointer text-[13px] font-semibold text-blood-500 hover:text-parchment-100"><%= first ? 'Supprimer le sujet' : 'Supprimer' %></button>
            </form>
          <% } %>
        </div>
      <% } %>
    </article>
  <% } %>

  <% if (pages > 1) { %><%- include('partials/pager', { page, pages, href: pageHref }) %><% } %>

  <section class="<%= ui.panel %>" id="repondre">
    <%- panelHead('Répondre') %>
    <% if (!user) { %>
      <p class="p-3 text-parchment-500"><a href="/login" class="<%= ui.link %>">Connecte-toi</a> pour répondre.</p>
    <% } else { %>
      <form method="post" action="/forum/t/<%= thread.id %>" class="<%= ui.panelBody %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% if (error) { %><div class="<%= ui.alertError %>"><%= error %></div><% } %>
        <textarea name="body" rows="5" maxlength="5000" required class="<%= ui.textarea %>" aria-label="Ta réponse"><%= form.body || '' %></textarea>
        <button class="<%= btn('gold', 'md', 'self-start') %>">Envoyer</button>
      </form>
    <% } %>
  </section>
</div>
<%- include('partials/footer') %>
