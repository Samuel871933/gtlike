<%- include('partials/header', { title: 'Compte' }) %>
<% const sleep = ctx.cfg.sleep; const vid = ctx.village.id; const scheduled = player.sleepEndsAt && new Date(player.sleepEndsAt) > now;
   // Boutique : thèmes et designs possédés sur ce monde (compte, monde ou serveur entier) ; les autres mènent à leur offre.
   const shopLink = (key) => `/shop/item/${encodeURIComponent(key)}?world=${encodeURIComponent(ctx.world.slug)}`; %>
<%# Thème de jeu : réglage du compte connecté (un remplaçant choisit donc le sien). Chaque aperçu porte son propre data-game-style. %>
<section class="<%= ui.panel %>">
  <%- panelHead('Thème de jeu', `<span class="text-[13px] text-parchment-500">Adarma gratuit, les autres à la <a href="/shop#themes" class="text-gold-200 underline hover:text-parchment-100">boutique</a> · change tout l’intérieur du jeu</span>`) %>
  <div class="grid gap-3 p-4.5 sm:grid-cols-2 xl:grid-cols-3">
    <% for (const s of Object.values(GAME_STYLES)) { const active = gameStyle && gameStyle.id === s.id; const owned = shopRights.has(`theme:${s.id}`); %>
      <form method="post" action="/village/<%= vid %>/account/game-style" data-game-style="<%= s.id %>"
            class="flex flex-col overflow-hidden border-2 border-black bg-panel-top text-parchment-200 <%= active ? 'shadow-[inset_0_0_0_2px_var(--color-gold-200),5px_5px_0_#050505]' : 'shadow-[inset_0_0_0_1px_var(--color-bronze-700),5px_5px_0_#050505]' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="style" value="<%= s.id %>">
        <div class="m-1 aspect-966/580 border-2 border-black bg-cover bg-center" style="background-image: url('/img/game-styles/<%= s.id %>/<%= s.id === 'adarma' ? 'background-texture.webp' : 'background-preview.webp' %>')" role="img" aria-label="Fond du thème <%= s.name %>"></div>
        <div class="flex flex-1 flex-col gap-2 border-t-2 border-bronze-500 p-3">
          <span class="flex items-center justify-between gap-2">
            <span class="font-display text-lg font-semibold tracking-[0.02em] text-gold-400"><%= s.name %></span>
            <% if (active) { %><span class="<%= ui.tagGold %>">Actif</span><% } else if (!owned) { %><span class="inline-flex items-center gap-1 text-[13px] text-parchment-500"><%- icon('lock', 'size-3.5', 2) %>À débloquer</span><% } %>
          </span>
          <span class="text-sm text-parchment-400"><%= s.description %></span>
          <% if (!active && owned) { %><button class="<%= btn('gold', 'sm', 'mt-auto w-full') %>">Appliquer</button><% } %>
          <% if (!owned) { %><a href="<%= shopLink(`theme:${s.id}`) %>" class="<%= btn('dark', 'sm', 'mt-auto w-full') %>"><%- icon('adarton', 'size-3.5', 2) %>Débloquer</a><% } %>
        </div>
      </form>
    <% } %>
  </div>
</section>
<%# Design des villages : skin de ses propres villages sur la carte, vu par tous les joueurs (réglage du compte connecté). %>
<section class="<%= ui.panel %>" id="design-villages">
  <%- panelHead('Design des villages', `<span class="text-[13px] text-parchment-500">Beige gratuit, les autres à la <a href="/shop#designs" class="text-gold-200 underline hover:text-parchment-100">boutique</a> · tes villages sur la carte, vus par tous</span>`) %>
  <div class="grid gap-3 p-4.5 sm:grid-cols-2 xl:grid-cols-3">
    <% for (const d of Object.values(VILLAGE_DESIGNS)) { const active = villageDesign && villageDesign.id === d.id; const owned = shopRights.has(`design:${d.id}`); %>
      <form method="post" action="/village/<%= vid %>/account/village-design"
            class="flex flex-col overflow-hidden border-2 border-black bg-panel-top <%= active ? 'shadow-[inset_0_0_0_2px_var(--color-gold-200),5px_5px_0_#050505]' : 'shadow-[inset_0_0_0_1px_var(--color-bronze-700),5px_5px_0_#050505]' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="design" value="<%= d.id %>">
        <%# Les six niveaux utilisent les mêmes marqueurs et échelles que sur la carte. %>
        <div class="m-1 grid grid-cols-3 gap-1 border-2 border-black bg-[url(/img/map/terrain-grass.webp)] bg-size-[220px] p-2" aria-hidden="true">
          <% for (let level = 1; level <= 6; level++) { %>
            <span class="village-design-preview-cell"><span class="village-marker village-marker--<%= level %> village-design--<%= d.id %>"><span class="village-sprite"></span></span></span>
          <% } %>
        </div>
        <div class="flex flex-1 flex-col gap-2 border-t-2 border-bronze-500 p-3">
          <span class="flex items-center justify-between gap-2">
            <span class="font-display text-lg font-semibold tracking-[0.02em] text-gold-400"><%= d.name %></span>
            <% if (active) { %><span class="<%= ui.tagGold %>">Actif</span><% } else if (!owned) { %><span class="inline-flex items-center gap-1 text-[13px] text-parchment-500"><%- icon('lock', 'size-3.5', 2) %>À débloquer</span><% } %>
          </span>
          <span class="text-sm text-parchment-400"><%= d.description %></span>
          <% if (!active && owned) { %><button class="<%= btn('gold', 'sm', 'mt-auto w-full') %>">Appliquer</button><% } %>
          <% if (!owned) { %><a href="<%= shopLink(`design:${d.id}`) %>" class="<%= btn('dark', 'sm', 'mt-auto w-full') %>"><%- icon('adarton', 'size-3.5', 2) %>Débloquer</a><% } %>
        </div>
      </form>
    <% } %>
  </div>
</section>
<%# Style de jeu : densité de l'interface (src/web/gameLayouts.js), réglage du compte connecté. Aperçus en px fixes, pour ne pas suivre le style actif. %>
<section class="<%= ui.panel %>" id="style-de-jeu">
  <%- panelHead('Style de jeu', `<span class="text-[13px] text-parchment-500">Gratuit · taille des encarts, quel que soit le thème</span>`) %>
  <div class="grid gap-3 p-4.5 sm:grid-cols-2">
    <% for (const l of Object.values(GAME_LAYOUTS)) { const active = gameLayout && gameLayout.id === l.id; const mini = l.id === 'minimal'; %>
      <form method="post" action="/village/<%= vid %>/account/game-layout"
            class="flex flex-col overflow-hidden border-2 border-black bg-panel-top text-parchment-200 <%= active ? 'shadow-[inset_0_0_0_2px_var(--color-gold-200),5px_5px_0_#050505]' : 'shadow-[inset_0_0_0_1px_var(--color-bronze-700),5px_5px_0_#050505]' %>">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="layout" value="<%= l.id %>">
        <%# Deux encarts schématiques : en-tête et lignes, à l'échelle de chaque style. %>
        <div class="m-1 flex h-[132px] flex-col overflow-hidden border-2 border-black bg-night <%= mini ? 'gap-[5px] p-[6px]' : 'gap-[10px] p-[10px]' %>" aria-hidden="true" data-layout-preview>
          <% for (const rows of [3, 4]) { %>
            <span class="flex shrink-0 flex-col border-2 border-black bg-panel-top <%= mini ? '' : 'shadow-[4px_4px_0_#050505]' %>">
              <span class="flex items-center gap-[5px] border-b-bronze-500 bg-head <%= mini ? 'h-[10px] border-b px-[5px]' : 'h-[20px] border-b-2 px-[8px]' %>">
                <span class="shrink-0 rotate-45 bg-gold-400 <%= mini ? 'size-[3px]' : 'size-[5px]' %>"></span>
                <span class="w-1/3 bg-parchment-100/70 <%= mini ? 'h-[3px]' : 'h-[5px]' %>"></span>
              </span>
              <span class="flex flex-col <%= mini ? 'gap-[3px] p-[4px]' : 'gap-[6px] p-[8px]' %>">
                <% for (let i = 0; i < (mini ? rows + 2 : rows - 1); i++) { %><span class="bg-parchment-500/40 <%= mini ? 'h-[3px]' : 'h-[5px]' %> <%= ['w-[90%]', 'w-[72%]', 'w-[54%]'][i % 3] %>"></span><% } %>
              </span>
            </span>
          <% } %>
        </div>
        <div class="flex flex-1 flex-col gap-2 border-t-2 border-bronze-500 p-3">
          <span class="flex items-center justify-between gap-2">
            <span class="font-display text-lg font-semibold tracking-[0.02em] text-gold-400"><%= l.name %></span>
            <% if (active) { %><span class="<%= ui.tagGold %>">Actif</span><% } %>
          </span>
          <span class="text-sm text-parchment-400"><%= l.description %></span>
          <% if (!active) { %><button class="<%= btn('gold', 'sm', 'mt-auto w-full') %>">Appliquer</button><% } %>
        </div>
      </form>
    <% } %>
  </div>
</section>
<% if (asSitter) { %>
  <section class="<%= ui.panel %>">
    <%- panelHead('Compte', '', { tag: 'h1' }) %>
    <div class="<%= ui.panelBody %>">
      <p class="text-parchment-500">Les réglages du compte sont réservés à son titulaire.</p>
    </div>
  </section>
<% } else { %>
<div class="grid items-start gap-5 lg:grid-cols-2">
  <section class="<%= ui.panel %>">
    <%- panelHead('Mode sommeil', `<span class="text-gold-400">${icon('moon', 'size-4')}</span>`, { tag: 'h1' }) %>
    <div class="<%= ui.panelBody %> gap-4">
      <% if (!sleep.active) { %>
        <p class="text-parchment-500">Le mode sommeil n'existe pas sur ce monde.</p>
      <% } else { %>
        <p class="text-parchment-400">
          Pendant votre sommeil, les attaques qui arrivent sur vos villages deviennent de simples visites : pas de combat,
          les troupes repartent. Vous ne pouvez pas attaquer pendant ce temps. Le sommeil commence <%= sleep.delayMinutes %> min
          après l'activation, dure de <%= sleep.minHours %> à <%= sleep.maxHours %> h, et il faut rester éveillé
          <%= sleep.minAwakeHours %> h entre deux sommeils.
        </p>
        <% if (scheduled) { %>
          <div class="<%= ui.boxGold %> flex flex-wrap items-center gap-3 px-4 py-3">
            <span class="<%= ui.medallionGold %> size-9"><%- icon('moon', 'size-4') %></span>
            <span class="flex min-w-0 flex-1 flex-col">
              <span class="<%= ui.kicker %>"><%= player.isAsleep(now) ? 'Sommeil en cours' : 'Sommeil programmé' %></span>
              <span class="font-semibold text-gold-200 tabular-nums"><%= when(player.sleepStartsAt, now) %> → <%= when(player.sleepEndsAt, now) %></span>
            </span>
            <form method="post" action="/village/<%= vid %>/account/sleep/stop"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="<%= btn('dark', 'sm') %>"><%= player.isAsleep(now) ? 'Me réveiller' : 'Annuler' %></button>
            </form>
          </div>
        <% } else { %>
          <form method="post" action="/village/<%= vid %>/account/sleep" class="flex flex-wrap items-end gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <label class="<%= ui.label %>">Durée (heures)
              <input type="number" name="hours" min="<%= sleep.minHours %>" max="<%= sleep.maxHours %>" step="any" value="<%= sleep.minHours %>" required class="<%= ui.input %> w-32 tabular-nums">
            </label>
            <button class="<%= btn('gold') %>"><%- icon('moon', 'size-3.5', 2.2) %>Activer</button>
          </form>
        <% } %>
      <% } %>
    </div>
  </section>

  <section class="<%= ui.panel %> min-w-0 lg:row-span-2">
    <%- panelHead('Mode vacances (remplaçant)', '') %>
    <div class="<%= ui.panelBody %> gap-4">
      <p class="text-parchment-400">
        Pendant une absence, un joueur de ce monde peut jouer vos villages à votre place. Il ne peut pas modifier
        ces réglages ni vous faire quitter votre tribu. Vous pouvez retirer son accès à tout moment.
      </p>
      <% if (!ctx.cfg.sitter.allow) { %>
        <p class="text-parchment-500">Les remplaçants ne sont pas autorisés sur ce monde.</p>
      <% } else if (sitter) { %>
        <div class="<%= ui.box %> flex flex-wrap items-center gap-3 px-4 py-3">
          <span class="<%= player.sitterAcceptedAt ? ui.medallionOlive : ui.medallion %> size-9"><%- icon(player.sitterAcceptedAt ? 'check' : 'clock', 'size-4', 2) %></span>
          <span class="min-w-48 flex-1 text-parchment-300">
            <% if (player.sitterAcceptedAt) { %><strong class="text-parchment-100"><%= sitter.name %></strong> vous remplace depuis <%= when(player.sitterAcceptedAt, now) %>.
            <% } else { %>Demande envoyée à <strong class="text-parchment-100"><%= sitter.name %></strong>, en attente d'acceptation.<% } %>
          </span>
          <form method="post" action="/village/<%= vid %>/account/sitter/revoke"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button class="<%= btn('danger', 'sm') %>"><%= player.sitterAcceptedAt ? 'Retirer l’accès' : 'Annuler la demande' %></button>
          </form>
        </div>
      <% } else { %>
        <form method="post" action="/village/<%= vid %>/account/sitter" class="flex flex-wrap items-end gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="<%= ui.label %> min-w-0 flex-1 sm:flex-none">Pseudo du remplaçant
            <input name="name" required class="<%= ui.input %> w-full sm:w-64">
          </label>
          <button class="<%= btn('gold') %>"><%- icon('send', 'size-3.5', 2.2) %>Envoyer la demande</button>
        </form>
      <% } %>

      <% if (sitting.length) { %>
        <p class="<%= ui.sectionLabel %> mt-2">Comptes que l'on vous confie</p>
        <ul class="flex flex-col gap-2">
          <% for (const o of sitting) { %>
            <li class="<%= ui.box %> flex flex-wrap items-center gap-3 px-3.5 py-2.5">
              <span class="min-w-40 flex-1 font-semibold text-parchment-100"><%= o.name %> <span class="font-normal text-parchment-500"><%= o.sitterAcceptedAt ? '· vous le remplacez' : '· demande en attente' %></span></span>
              <div class="flex items-center gap-2">
                <% if (!o.sitterAcceptedAt) { %>
                  <form method="post" action="/village/<%= vid %>/account/sitting/<%= o.id %>/accept"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="<%= btn('gold', 'sm') %>">Accepter</button></form>
                <% } else { %>
                  <a href="/worlds/<%= ctx.world.slug %>/sit/<%= o.id %>" class="<%= btn('dark', 'sm') %>">Jouer</a>
                <% } %>
                <form method="post" action="/village/<%= vid %>/account/sitting/<%= o.id %>/resign"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="<%= btn('danger', 'sm') %>"><%= o.sitterAcceptedAt ? 'Arrêter' : 'Refuser' %></button>
                </form>
              </div>
            </li>
          <% } %>
        </ul>
      <% } %>
    </div>
  </section>

  <%# Réglages tribu : une ligne par élément partageable, colonnes « Partager avec la tribu » et « Afficher la tribu »
      (liste TRIBE_SHARING de src/services/VillageNoteService.js). %>
  <section class="<%= ui.panel %>" id="reglages-tribu">
    <%- panelHead('Réglages tribu') %>
    <form method="post" action="/village/<%= vid %>/account/tribe-settings" data-tribe-sharing><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="overflow-x-auto">
        <table class="<%= ui.table %>">
          <thead><tr>
            <th>Élément</th>
            <th class="w-40 text-center">Partager avec la tribu<label class="mt-1 flex cursor-pointer items-center justify-center gap-1.5 text-[11px] font-normal text-parchment-300"><input type="checkbox" class="<%= ui.checkbox %>" data-tribe-select-all="share" aria-label="Tout sélectionner : partager avec la tribu">Tout sélectionner</label></th>
            <th class="w-40 text-center">Afficher la tribu<label class="mt-1 flex cursor-pointer items-center justify-center gap-1.5 text-[11px] font-normal text-parchment-300"><input type="checkbox" class="<%= ui.checkbox %>" data-tribe-select-all="show" aria-label="Tout sélectionner : afficher la tribu">Tout sélectionner</label></th>
          </tr></thead>
          <tbody>
            <% for (const item of tribeSharing) { %>
              <tr>
                <td><span class="font-semibold text-parchment-100"><%= item.label %></span><span class="block text-[13px] text-parchment-500"><%= item.text %></span></td>
                <td class="text-center"><input type="checkbox" name="<%= item.share %>" value="1" class="<%= ui.checkbox %>" data-tribe-column="share" aria-label="<%= item.label %> : partager avec la tribu" <%= player[item.share] ? 'checked' : '' %>></td>
                <td class="text-center"><input type="checkbox" name="<%= item.show %>" value="1" class="<%= ui.checkbox %>" data-tribe-column="show" aria-label="<%= item.label %> : afficher la tribu" <%= player[item.show] ? 'checked' : '' %>></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <div class="flex items-center justify-between gap-3 border-t border-bronze-900 px-3 py-2.5">
        <span class="text-[13px] text-parchment-500"><%= player.tribeId ? '' : "Tu n'es dans aucune tribu : ces réglages serviront quand tu en rejoindras une." %></span>
        <button class="<%= btn('dark', 'sm') %>">Enregistrer</button>
      </div>
    </form>
  </section>

  <section class="<%= ui.panel %>">
    <%- panelHead('Quitter ce monde') %>
    <div class="<%= ui.panelBody %> gap-4">
      <p class="text-parchment-400">
        Vos villages redeviennent barbares (avec leurs troupes), vos troupes et marchands à l'extérieur, vos offres et vos
        rapports sont supprimés. Si vous fondez une tribu, elle passe à un autre membre. Vous pourrez revenir plus tard avec un nouveau départ.
      </p>
      <form method="post" action="/village/<%= vid %>/account/leave-world" class="flex flex-wrap items-end gap-2" data-confirm="Quitter définitivement ce monde ?"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="<%= ui.label %> min-w-0 flex-1 sm:flex-none">Mot de passe
          <input type="password" name="password" required class="<%= ui.input %> w-full sm:w-64">
        </label>
        <button class="<%= btn('red') %>"><%- icon('logout', 'size-3.5', 2.2) %>Quitter ce monde</button>
      </form>
    </div>
  </section>
</div>
<% } %>
<%- include('partials/footer') %>
