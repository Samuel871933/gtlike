<%- include('partials/header', { title: 'Mondes', hero: true, lobbyPage: 'worlds' }) %>
<%
  const directionNames = { random: 'Aléatoire', nw: 'Nord-Ouest', ne: 'Nord-Est', sw: 'Sud-Ouest', se: 'Sud-Est' };
  const victoryNames = VICTORY_NAMES;
  const playing = (w) => w.player && w.player.villageCount > 0;
  // Mondes officiels (encart 1) et serveurs privés (encart 2, voir PrivateServerService).
  const official = worlds.filter((w) => !w.world.isPrivate());
  const current = official.filter((w) => !w.world.endedAt && playing(w));
  const available = official.filter((w) => !w.world.endedAt && !playing(w) && w.world.isOpen);
  const ended = official.filter((w) => w.world.endedAt);
  // Tes serveurs privés : ceux où tu joues et ceux que tu as créés.
  const myServers = worlds.filter((w) => w.world.isPrivate() && (playing(w) || w.world.ownerUserId === user.id));
  // Serveurs publics les plus peuplés : tous les serveurs ouverts, les tiens compris.
  const publicServers = popularServers;
  const accessName = (world) => (world.access === 'code' ? 'Sur code' : 'Ouvert');
  const sittings = worlds.flatMap((w) => w.sitting.map((s) => ({ world: w.world, s })));
  // Libellés communs d'un monde (src/web/worldLabels.js).
  const modulesOf = worldModules;
  const subtitle = worldSubtitle;
  const isNew = (world) => now - new Date(world.createdAt) < 7 * 86400000;
  // Ancienneté d'un monde, affichée sur chaque tuile et dans la fiche.
  const age = (world) => worldAge(world, now);
  // Tuile d'un monde, commune aux parties en cours, aux mondes officiels et aux serveurs privés : compacte (nom, puis
  // pastille et une ligne `primary`), le détail dans l'infobulle « i » au survol ou au focus (`details`, puis modules, vitesse et
  // ancienneté). Toute la tuile est cliquable (partie en cours : on entre ; autre monde : sa fiche). HTML déjà échappé.
  const worldTile = (world, href, { tag = '', primary = '', details = [], edge = 'border-t-action' } = {}) => {
    const cfg = world.getConfig(); const a = age(world); const dom = cfg.victory.dominance;
    const rows = [
      ...details,
      esc(subtitle(world)) + ` · unités ×${cfg.unitSpeed}`,
      `Carte ${cfg.mapSize} × ${cfg.mapSize} · protection ${cfg.newbieDays} j`,
      cfg.night.active ? `Bonus de nuit ${cfg.night.startHour} h-${cfg.night.endHour} h (×${cfg.night.defFactor})` : 'Pas de bonus de nuit',
      cfg.victory.type === 'dominance' ? `Victoire : ${dom.endgamePercent} % pendant ${dom.holdDays} j, après ${dom.minWorldAgeDays} j` : `Victoire : ${esc(victoryNames[cfg.victory.type])}`,
      `<span class="text-parchment-500">${a.startsWith('créé') ? 'Créé à l’instant' : `Ouvert ${esc(a)}`}</span>`,
    ];
    return `
    <a href="${href}" class="group relative flex min-w-0 flex-col gap-0.5 border border-bronze-800 border-t-[3px] ${edge} bg-night px-2 py-1 text-parchment-100 no-underline shadow-[2px_2px_0_#000] transition hover:z-50 hover:-translate-y-px hover:border-gold-400 hover:bg-thead hover:shadow-[3px_4px_0_#000] focus-within:z-50">
      <span class="flex min-w-0 items-center gap-1.5">
        <span class="min-w-0 flex-1 truncate font-display text-[15px] leading-tight font-semibold group-hover:text-gold-200">${esc(world.name)}</span>
        <span class="group/info relative flex shrink-0" tabindex="0" aria-label="Détails de ${esc(world.name)}">
          <span class="flex size-4 items-center justify-center rounded-full border border-bronze-600 font-serif text-[10px] leading-none font-semibold text-gold-400 italic group-hover/info:border-gold-400 group-hover/info:bg-gold-400 group-hover/info:text-night">i</span>
          <span class="pointer-events-none absolute right-0 bottom-full z-30 mb-1.5 hidden w-60 flex-col gap-0.5 border-2 border-black bg-panel-top px-2.5 py-2 text-left text-xs font-normal text-parchment-300 not-italic shadow-[inset_0_0_0_1px_var(--color-bronze-500),4px_4px_0_#000] group-focus/info:flex group-hover/info:flex" role="tooltip">
            <span class="font-display text-sm font-semibold text-parchment-100">${esc(world.name)}</span>
            ${rows.map((r) => `<span>${r}</span>`).join('')}
          </span>
        </span>
      </span>
      ${primary || tag ? `<span class="flex min-w-0 items-center gap-1.5 text-xs text-parchment-500">${tag}<span class="truncate">${primary}</span></span>` : ''}
    </a>`;
  };
  const tileGrid = 'grid grid-cols-2 gap-1.5 sm:grid-cols-3';
  const smallTag = (cls, label) => `<span class="${cls} shrink-0 px-1 py-0 text-[10px]">${label}</span>`;
%>
<%- include('partials/landing-hero-start', { cta: null }) %>
<%# 1. Mondes officiels : tes parties en cours puis les autres mondes (ou la fiche du monde choisi). %>
<%- include('partials/worlds/official', { directionNames, victoryNames, playing, official, current, available, ended, myServers, publicServers, accessName, sittings, modulesOf, subtitle, isNew, age, worldTile, tileGrid, smallTag }) %>

<%# 2. Serveurs privés : les tiens, les serveurs ouverts les plus peuplés, puis rejoindre avec un code ou créer le sien. %>
<% if (!selected) { %>
<%- include('partials/worlds/private', { directionNames, victoryNames, playing, official, current, available, ended, myServers, publicServers, accessName, sittings, modulesOf, subtitle, isNew, age, worldTile, tileGrid, smallTag }) %>
<% } %>
<%- include('partials/landing-hero-end') %>

<%# Pages publiques de chaque monde officiel, en cartes parchemin (maquette : « Chroniques de l'empire »). %>
<% if (official.length) { %>
<%- include('partials/worlds/chronicles', { directionNames, victoryNames, playing, official, current, available, ended, myServers, publicServers, accessName, sittings, modulesOf, subtitle, isNew, age, worldTile, tileGrid, smallTag }) %>
<% } %>
<%- include('partials/footer') %>
