<%- include('partials/header', { title: 'Mondes', hero: true, lobbyPage: 'worlds' }) %>
<%
  const directionNames = { random: 'Aléatoire', nw: 'Nord-Ouest', ne: 'Nord-Est', sw: 'Sud-Ouest', se: 'Sud-Est' };
  const victoryNames = { dominance: 'Domination', pointsVillages: 'Points et villages', runes: 'Runes', siege: 'Grand Siège', none: 'aucune' };
  const featureNames = { knight: 'paladin', archer: 'archers' };
  const playing = (w) => w.player && w.player.villageCount > 0;
  const current = worlds.filter((w) => !w.world.endedAt && playing(w));
  const available = worlds.filter((w) => !w.world.endedAt && !playing(w) && w.world.isOpen);
  const ended = worlds.filter((w) => w.world.endedAt);
  const sittings = worlds.flatMap((w) => w.sitting.map((s) => ({ world: w.world, s })));
  const modulesOf = (cfg) => Object.entries(cfg.features).filter(([, on]) => on).map(([k]) => featureNames[k] || k);
  const subtitle = (world) => { const cfg = world.getConfig(); const m = modulesOf(cfg); return `Vitesse ×${cfg.speed}${m.length ? ' · ' + m.join(', ') : ' · classique'}`; };
  const isNew = (world) => now - new Date(world.createdAt) < 7 * 86400000;
  const worldRow = (world, href, extra = '', edge = 'border-l-blood-600') => `
    <a href="${href}" class="flex items-center justify-between gap-3 border border-bronze-800 border-l-[3px] ${edge} bg-panel-lo px-2.5 py-[7px] text-parchment-100 no-underline transition hover:border-blood-800 hover:bg-thead">
      <span class="flex min-w-0 flex-col">
        <b class="truncate ">${esc(world.name)}</b>
        <span class="truncate text-xs text-parchment-500">${esc(subtitle(world))}</span>
      </span>
      ${extra}
    </a>`;
  const joinHref = current.length ? `/worlds/${current[0].world.slug}/play` : available.length ? `/worlds?w=${available[0].world.slug}` : '#mondes';
%>
<%- include('partials/landing-hero-start', { cta: { href: joinHref, label: current.length ? 'Reprendre la partie' : 'Jouer gratuitement' } }) %>
  <div class="border-b-2 border-bronze-500 bg-head px-3.5 py-2.5" id="mondes">
    <div class="font-display text-[22px] font-bold tracking-[0.02em]">Salve, <%= user.username %></div>
    <form method="post" action="/logout" class="text-xs text-parchment-300"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
      Pas <%= user.username %> ? <button class="<%= ui.link %> cursor-pointer">Se déconnecter</button>
    </form>
  </div>
  <div class="flex flex-1 flex-col gap-2.5 px-3.5 py-3">
    <% if (selected) { const { world, player } = selected; const cfg = world.getConfig(); const modules = modulesOf(cfg); %>
      <%# Fiche du monde choisi %>
      <a href="/worlds" class="<%= ui.link %> inline-flex items-center gap-1.5 self-start text-[13px]"><%- icon('arrowLeft', 'size-3.5', 2.4) %>Retour</a>
      <div class="<%= ui.kicker %>"><%= world.endedAt ? 'Monde terminé' : world.isOpen ? 'Inscriptions ouvertes' : 'Inscriptions fermées' %></div>
      <div class="flex items-center justify-between border-2 border-black bg-night p-2.5 shadow-[inset_0_0_0_1px_var(--color-bronze-700)]">
        <div><div class="font-display text-xl font-bold tracking-[0.02em]"><%= world.name %></div><div class="text-xs text-parchment-500"><%= world.slug %></div></div>
        <div class="text-right text-xs text-parchment-500"><%= player ? `${num(player.villageCount)} village(s)` : 'Pas encore inscrit' %><br><b class="text-parchment-100"><%= player ? `${num(player.points)} pts` : '—' %></b></div>
      </div>
      <div class="grid grid-cols-2 gap-1">
        <div class="<%= ui.tile %>"><div class="<%= ui.tileLabel %>">Vitesse</div><div class="<%= ui.tileValue %>">×<%= cfg.speed %></div></div>
        <div class="<%= ui.tile %>"><div class="<%= ui.tileLabel %>">Unités</div><div class="<%= ui.tileValue %>">×<%= cfg.unitSpeed %></div></div>
        <div class="<%= ui.tile %>"><div class="<%= ui.tileLabel %>">Modules</div><div class="<%= ui.tileValue %> first-letter:uppercase"><%= modules.join(', ') || 'classique' %></div></div>
        <div class="<%= ui.tile %>"><div class="<%= ui.tileLabel %>">Victoire</div><a href="/worlds/<%= world.slug %>/ranking?type=victory" class="<%= ui.link %> text-base"><%= victoryNames[cfg.victory.type] %></a></div>
      </div>
      <% if (playing(selected)) { %>
        <a class="<%= btn('gold', 'lg', 'w-full border-[3px]') %>" href="/worlds/<%= world.slug %>/play">Entrer dans le monde</a>
      <% } else if (world.isOpen && !world.endedAt) { %>
        <form method="post" action="/worlds/<%= world.slug %>/join" class="flex flex-col gap-2.5"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label class="<%= ui.label %>">Où commencer sur la carte ?
            <select name="direction" class="<%= ui.input %> w-full">
              <% for (const d of directions) { %><option value="<%= d %>"><%= directionNames[d] %></option><% } %>
            </select>
          </label>
          <button class="<%= btn('gold', 'lg', 'w-full border-[3px]') %>"><%= player ? 'Recommencer sur ce monde' : 'Rejoindre ce monde' %></button>
        </form>
      <% } else { %>
        <p class="text-parchment-500">Inscriptions fermées.</p>
      <% } %>
    <% } else { %>
      <%# Parties en cours %>
      <% if (current.length) { %>
        <div class="<%= ui.kicker %>">Partie<%= current.length > 1 ? 's' : '' %> en cours</div>
        <% for (const w of current) { const c = w.campaign || {}; %>
          <div class="flex items-center justify-between gap-3 border-2 border-black bg-night p-2.5 shadow-[inset_0_0_0_1px_var(--color-bronze-700)]">
            <div class="min-w-0">
              <div class="truncate font-display text-xl font-bold tracking-[0.02em]"><%= w.world.name %></div>
              <% if (c.nextAttackAt) { %>
                <div class="flex items-center gap-1.5 text-xs text-blood-450"><span class="size-1.5 shrink-0 rotate-45 bg-blood-600"></span>Attaque dans <b class="tabular-nums" data-countdown="<%= new Date(c.nextAttackAt).getTime() %>"><%= duration((new Date(c.nextAttackAt) - now) / 1000) %></b></div>
              <% } else { %>
                <div class="text-xs text-olive-300">● <%= subtitle(w.world) %></div>
              <% } %>
            </div>
            <div class="shrink-0 text-right text-xs text-parchment-500"><%= c.village ? c.village.name : '' %><br><b class="text-parchment-100">#<%= c.rank ? num(c.rank) : '—' %> · <%= num(w.player.points) %> pts</b></div>
          </div>
          <a href="/worlds/<%= w.world.slug %>/play" class="<%= btn('gold', 'lg', 'w-full border-[3px]') %>">Entrer dans le monde</a>
        <% } %>
      <% } %>

      <% if (sittings.length) { %>
        <div class="<%= ui.kicker %> mt-1">Vous remplacez</div>
        <% for (const { world, s } of sittings) { %>
          <a href="/worlds/<%= world.slug %>/sit/<%= s.id %>" class="flex items-center justify-between gap-2 border border-bronze-800 border-l-[3px] border-l-gold-400 bg-panel-lo px-2.5 py-[7px] text-parchment-100 no-underline hover:bg-thead">
            <b class=""><%= s.name %></b><span class="text-xs text-parchment-500"><%= world.name %> · jouer</span>
          </a>
        <% } %>
      <% } %>

      <%# Mondes ouverts, puis terminés %>
      <div class="<%= ui.kicker %> mt-1"><%= current.length ? 'Autres mondes' : 'Rejoindre un monde' %></div>
      <% for (const { world } of available) { %>
        <%- worldRow(world, `/worlds?w=${world.slug}`, isNew(world) ? `<span class="${ui.tagRed}">Nouveau</span>` : '') %>
      <% } %>
      <% for (const { world } of ended) { %>
        <%- worldRow(world, `/worlds?w=${world.slug}`, `<span class="${ui.tagMuted}">Terminé</span>`, 'border-l-rel-barb') %>
      <% } %>
      <% if (!available.length && !ended.length) { %><p class="text-sm text-parchment-500">Aucun autre monde ouvert.</p><% } %>
    <% } %>
  </div>
<%- include('partials/landing-hero-end') %>

<%# Pages publiques de chaque monde, en cartes parchemin (maquette : « Chroniques de l'empire »). %>
<% if (worlds.length) { %>
  <section class="mx-auto w-full max-w-[1200px] px-3.5 py-6.5">
    <div class="mb-3 flex items-center gap-3">
      <span class="size-[9px] rotate-45 border border-black bg-gold-400"></span>
      <h2 class="m-0 font-display text-xl font-bold tracking-[0.02em]">Chroniques des mondes</h2>
      <span class="h-0.5 flex-1 bg-linear-to-r from-bronze-500 to-transparent"></span>
    </div>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-3">
      <% for (const { world } of worlds) { %>
        <article class="flex flex-col gap-1.5 border-[3px] border-black bg-parchment-300 px-3.5 py-3 text-panel-hi shadow-[inset_0_0_0_3px_var(--color-bld-marble),5px_5px_0_#000]">
          <div class="flex items-center justify-between border-b-2 border-panel-hi pb-[5px]">
            <span class="text-xs font-semibold tracking-[0.02em] text-blood-800"><%= new Date(world.createdAt).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
            <span class="bg-panel-hi px-1.5 py-px text-[11px] font-semibold tracking-[0.02em] text-parchment-300"><%= world.endedAt ? 'Terminé' : 'Monde' %></span>
          </div>
          <b class="font-display text-base leading-tight "><%= world.name %></b>
          <span class="text-sm leading-snug text-bld-soot"><%= subtitle(world) %> · victoire : <%= victoryNames[world.getConfig().victory.type] %></span>
          <span class="mt-auto flex gap-4 text-[13px] font-semibold">
            <a href="/worlds/<%= world.slug %>/info" class="text-blood-800 no-underline hover:text-panel-hi">» Infos monde</a>
            <a href="/worlds/<%= world.slug %>/ranking" class="text-blood-800 no-underline hover:text-panel-hi">» Classement</a>
            <a href="/worlds/<%= world.slug %>/ranking?type=victory" class="text-blood-800 no-underline hover:text-panel-hi">» Fin du monde</a>
          </span>
        </article>
      <% } %>
    </div>
  </section>
<% } %>
<%- include('partials/footer') %>
