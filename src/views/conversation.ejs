<%- include('partials/header', { title: conversation.subject }) %>
<% const myId = ctx.village.playerId; const others = conversation.participants.filter((p) => p.playerId !== myId); %>
<%- include('partials/messages-start', { tab: 'conversation' }) %>
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-bronze-900 px-3 py-2">
      <a href="/village/<%= ctx.village.id %>/messages" class="<%= ui.link %> inline-flex items-center gap-1.5 text-sm"><%- icon('arrowLeft', 'size-3.5', 2.2) %>Boîte de réception</a>
      <form method="post" action="/village/<%= ctx.village.id %>/messages/<%= conversation.id %>/leave" data-confirm="Effacer cette conversation ?"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="<%= btn('danger', 'sm') %>"><%- icon('trash', 'size-3.5', 2) %>Effacer</button>
      </form>
    </div>
    <div class="<%= ui.panelBody %> gap-4">
      <div class="flex flex-col gap-1">
        <h2 class="font-display text-lg font-semibold wrap-break-word text-parchment-100"><%= conversation.subject %></h2>
        <% if (conversation.recipientGroup) { %><p class="text-sm text-parchment-400">Mail circulaire · <%= (MessageGroups[conversation.recipientGroup] || {}).name %></p><% } %>
        <p class="text-sm text-parchment-500">Avec
          <% others.forEach((p, i) => { %><a href="/village/<%= ctx.village.id %>/players/<%= p.playerId %>" class="<%= ui.linkPlain %> font-semibold"><%= p.Player.name %></a><%= i < others.length - 1 ? ', ' : '' %><% }) %>
          <%= others.length ? '' : 'personne (les autres ont quitté la conversation)' %>
        </p>
      </div>

      <% const pg = conversation.pagination; %>
      <% if (pg.pages > 1) { %>
        <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
          <span class="text-parchment-400"><%= pg.total %> messages · <%= pg.perPage %> par page · page 1 : les plus récents</span>
          <%- include('partials/pager', { page: pg.page, pages: pg.pages, href: (n) => `?page=${n}` }) %>
        </div>
      <% } %>
      <ul class="messages-scroll flex flex-col gap-3 p-1" data-conversation-messages>
        <% for (const m of conversation.messages) { const mine = m.playerId === myId; %>
          <li class="flex <%= mine ? 'justify-end' : '' %>">
            <div class="max-w-[85%] border-2 border-black px-3.5 py-2.5 shadow-[3px_3px_0_#050505] <%= mine ? 'border-l-4 border-l-bronze-500 bg-head-dark/70' : 'bg-panel-lo' %>">
              <p class="text-xs text-parchment-500"><strong class="font-display text-[13px] <%= mine ? 'text-gold-200' : 'text-parchment-200' %>"><%- playerLink(ctx.village.id, m.author, { none: 'Joueur supprimé', cls: 'no-underline text-inherit hover:text-gold-400' }) %></strong> · <span class="tabular-nums"><%= when(m.createdAt, now) %></span></p>
              <p class="mt-1 whitespace-pre-line wrap-break-word text-parchment-200"><%= m.body %></p>
            </div>
          </li>
        <% } %>
      </ul>
    </div>

  <% if (others.length) { %>
    <section class="border-t border-bronze-900">
      <p class="px-4.5 pt-3 font-semibold text-parchment-200">Répondre</p>
      <form id="bas" method="post" action="/village/<%= ctx.village.id %>/messages/<%= conversation.id %>/reply" class="<%= ui.panelBody %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <textarea name="body" rows="4" maxlength="5000" required placeholder="Votre réponse…" aria-label="Votre réponse" class="<%= ui.textarea %> w-full"></textarea>
        <div class="flex justify-end">
          <button class="<%= btn('gold') %>"><%- icon('send', 'size-3.5', 2.2) %>Répondre</button>
        </div>
      </form>
    </section>
  <% } %>
<%- include('partials/messages-end') %>
<%- include('partials/footer') %>
