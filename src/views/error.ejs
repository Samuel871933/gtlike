<%- include('partials/header', { title: 'Erreur' }) %>
<section class="<%= ui.panel %> mx-auto mt-6 w-full max-w-md sm:mt-10">
  <%- panelHead('Oups', '', { tag: 'h1' }) %>
  <div class="flex flex-col items-center gap-4 px-4.5 py-6 text-center">
    <span class="<%= ui.medallionRed %> size-12"><%- icon('close', 'size-5', 2.2) %></span>
    <p class="text-parchment-300"><%= message %></p>
    <a href="/" class="<%= btn('dark', 'md') %>"><%- icon('arrowLeft', 'size-3.5', 2.2) %>Retour</a>
  </div>
</section>
<%- include('partials/footer') %>
