<%- include('partials/header', { title: buildingName('smith') }) %>
<% const running = ctx.researchOrders[0]; %>
<div class="flex flex-col gap-5">
  <%- include('partials/building-header', { buildingId: 'smith' , illustration: 'wide' }) %>

  <%# Comme sur GT : grande illustration du bâtiment à gauche sur les écrans larges (vignette dans l'en-tête sinon). %>
  <div class="<%= ui.buildingGrid %>">
    <div class="<%= ui.buildingAside %>"><%- include('partials/building-illustration', { buildingId: 'smith' }) %><%- include('partials/quest-aside') %></div>
    <div class="flex min-w-0 flex-col gap-5">

  <section class="<%= ui.panel %>">
    <%- panelHead('Recherches') %>
    <div class="<%= ui.panelBody %>">
      <p class="text-[15px] text-parchment-400">
        Chaque unité se recherche une seule fois par village, une recherche à la fois.
        Chaque niveau de forge réduit la durée des recherches de 10 % (composé).
      </p>
      <% if (running) { %>
        <div class="<%= ui.boxGold %> flex flex-wrap items-center gap-3 p-3">
          <span class="<%= ui.medallionGold %> size-[38px] minimal:size-[28px]"><%- unitIcon(running.unit, 'size-[19px]') %></span>
          <span class="flex min-w-0 flex-1 flex-col">
            <span class="<%= ui.kicker %>">Recherche en cours</span>
            <span class="text-parchment-300"><strong class="font-display text-gold-200"><%= unitName(running.unit) %></strong> · <%= when(running.endsAt, now) %></span>
          </span>
          <span class="<%= ui.figure %>" data-countdown="<%= new Date(running.endsAt).getTime() %>"><%= duration((new Date(running.endsAt) - now) / 1000) %></span>
          <form method="post" action="/village/<%= ctx.village.id %>/research/<%= running.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="<%= btn('danger', 'sm') %>">Annuler</button></form>
        </div>
      <% } %>
    </div>
    <div class="<%= ui.tableScroll %>">
      <table class="<%= ui.table %>">
        <thead><tr><th>Unité</th><th>Coût</th><th>Durée</th><th class="text-right">État</th></tr></thead>
        <tbody>
        <% for (const o of options) { %>
          <tr class="<%= o.running ? ui.rowActive : '' %>">
            <td class="min-w-44">
              <span class="flex items-center gap-3">
                <span class="<%= o.done ? ui.medallionGold : ui.medallion %> size-[38px] minimal:size-[28px]"><%- unitIcon(o.type.id, 'size-[19px]') %></span>
                <span class="flex min-w-0 flex-col">
                  <span class="font-semibold text-parchment-100"><%= nameOf(o.type) %></span>
                  <span class="text-[13px] text-parchment-500"><%= buildingName(o.type.building) %></span>
                </span>
              </span>
            </td>
            <td><%- include('partials/cost', { cost: o.cost, have: o.done ? null : ctx.state.resources }) %></td>
            <td class="whitespace-nowrap text-parchment-300 tabular-nums"><%= o.done ? '—' : duration(o.duration) %></td>
            <td class="text-right">
              <% if (o.done) { %>
                <span class="<%= ui.tagOlive %>">Recherchée</span>
              <% } else if (o.running) { %>
                <span class="<%= ui.tagGold %>">En cours</span>
              <% } else { %>
                <form method="post" action="/village/<%= ctx.village.id %>/research" class="inline-flex flex-col items-end gap-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="unit" value="<%= o.type.id %>">
                  <button class="<%= btn('gold', 'sm') %>" <%= o.blocker ? 'disabled' : '' %>>Rechercher</button>
                  <% if (o.blocker) { %><span class="text-xs whitespace-nowrap text-blood-300"><%= o.lacksResources ? resourcesWhen(ctx.state, o.cost, now) : o.blocker %></span><% } %>
                </form>
              <% } %>
            </td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
    <p class="border-t border-bronze-900 px-4.5 py-3 text-sm text-parchment-500">Lancier et porte-épée ne demandent pas de recherche.</p>
  </section>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
