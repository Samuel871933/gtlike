<%- include('partials/header', { title: 'Académie' }) %>
<% const vid = ctx.village.id; const maxBtn = `${ui.link} cursor-pointer text-xs tabular-nums`; %>
<div class="flex flex-col gap-5">
  <%- include('partials/building-header', { buildingId: 'snob', illustration: 'wide' }) %>

  <%# Comme sur GT : grande illustration du bâtiment à gauche sur les écrans larges (vignette dans l'en-tête sinon). %>
  <div class="<%= ui.buildingGrid %>">
    <div class="max-xl:hidden xl:sticky xl:top-24"><%- include('partials/building-illustration', { buildingId: 'snob' }) %></div>
    <div class="flex min-w-0 flex-col gap-5">

  <section class="<%= ui.panel %>">
    <%- panelHead('Emplacements de noble') %>
    <div class="<%= ui.panelBody %>">
      <p class="text-[15px] text-parchment-400">
        Chaque noble demande un emplacement. Les emplacements s'obtiennent avec des pièces d'or : 1 pièce pour le premier,
        2 de plus pour le deuxième, 3 de plus pour le troisième… Chaque village conquis garde son emplacement.
      </p>
      <dl class="grid grid-cols-2 gap-2 sm:grid-cols-4">
        <div class="<%= ui.tile %> flex items-center gap-3">
          <span class="<%= ui.medallionGold %> size-9"><%- icon('coin', 'size-[18px]') %></span>
          <span class="flex flex-col"><dt class="<%= ui.tileLabel %>">Pièces d'or</dt><dd class="<%= ui.tileValue %>"><%= num(slots.coins) %></dd></span>
        </div>
        <div class="<%= ui.tile %> flex items-center gap-3">
          <span class="<%= ui.medallion %> size-9"><%- icon('academy', 'size-[18px]') %></span>
          <span class="flex flex-col"><dt class="<%= ui.tileLabel %>">Emplacements</dt><dd class="<%= ui.tileValue %>"><%= slots.used %> / <%= slots.max %></dd></span>
        </div>
        <div class="<%= ui.tile %> flex items-center gap-3">
          <span class="<%= ui.medallion %> size-9"><%- unitIcon('snob', 'size-[18px]') %></span>
          <span class="flex flex-col"><dt class="<%= ui.tileLabel %>">Nobles</dt><dd class="<%= ui.tileValue %>"><%= slots.nobles %></dd></span>
        </div>
        <div class="<%= ui.tile %> flex items-center gap-3">
          <span class="<%= ui.medallion %> size-9"><%- icon('flag', 'size-[18px]') %></span>
          <span class="flex flex-col"><dt class="<%= ui.tileLabel %>">Villages conquis</dt><dd class="<%= ui.tileValue %>"><%= slots.conquered %></dd></span>
        </div>
      </dl>
    </div>
  </section>

  <div class="grid grid-cols-1 gap-5">
    <section class="<%= ui.panel %>">
      <%- panelHead("Frapper des pièces d'or") %>
      <div class="<%= ui.panelBody %>">
        <form method="post" action="/village/<%= vid %>/academy/mint" class="flex flex-wrap items-center gap-x-4 gap-y-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <span class="flex flex-wrap items-center gap-2">
            <span class="text-parchment-400">1 pièce :</span>
            <%- include('partials/cost', { cost: coin, have: ctx.state.resources }) %>
          </span>
          <span class="ml-auto flex items-center gap-2">
            <input type="number" name="count" min="1" max="<%= maxCoins %>" value="<%= maxCoins > 0 ? 1 : '' %>" class="<%= ui.input %> w-24 text-right tabular-nums" aria-label="Nombre de pièces">
            <button type="button" class="<%= maxBtn %>" data-fill="count" data-max="<%= maxCoins %>">max <%= maxCoins %></button>
            <button class="<%= btn('gold', 'md') %>" <%= maxCoins < 1 ? 'disabled' : '' %>><%- icon('coin', 'size-3.5', 2) %>Frapper</button>
          </span>
          <% if (maxCoins < 1) { %><span class="w-full text-right text-xs text-blood-300"><%= resourcesWhen(ctx.state, coin, now) %></span><% } %>
        </form>
        <p class="text-xs text-parchment-600">Encore <span class="font-semibold text-parchment-400 tabular-nums"><%= num(slots.coinsForNextSlot) %></span> pièce(s) pour l'emplacement suivant.</p>
      </div>
    </section>

    <section class="<%= ui.panel %>">
      <%- panelHead('Former un noble') %>
      <%- include('partials/recruit-queue', { orders: queue, showEmpty: false }) %>
      <div class="<%= ui.panelBody %>">
        <% for (const o of available) { %>
          <form method="post" action="/village/<%= vid %>/recruit/snob" class="<%= ui.box %> flex flex-wrap items-center gap-x-4 gap-y-3 p-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <span class="flex min-w-0 items-center gap-3">
              <span class="<%= ui.medallionGold %> size-[42px] minimal:size-[32px]"><%- unitIcon(o.type.id, 'size-[21px]') %></span>
              <span class="flex min-w-0 flex-col gap-1">
                <span class="font-display font-semibold text-gold-200"><%= o.type.name %></span>
                <span class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                  <%- include('partials/cost', { cost: o.type.cost, pop: o.type.pop, have: ctx.state.resources }) %>
                  <span class="inline-flex items-center gap-1.5 text-parchment-300 tabular-nums"><span class="text-parchment-600"><%- icon('clock', 'size-3.5', 2) %></span><%= duration(o.duration) %></span>
                </span>
              </span>
            </span>
            <span class="ml-auto flex items-center gap-2">
              <input type="number" name="snob" min="0" max="<%= o.max %>" placeholder="0" class="<%= ui.input %> w-20 text-right tabular-nums" aria-label="Nombre de nobles">
              <button type="button" class="<%= maxBtn %>" data-fill="snob" data-max="<%= o.max %>">max <%= o.max %></button>
              <button class="<%= btn('gold', 'md') %>" <%= o.max < 1 ? 'disabled' : '' %>>Former</button>
            </span>
            <% if (o.max < 1) { const why = resourcesWhen(ctx.state, o.type.cost, now)
                 || (ctx.state.farmCapacity() - ctx.popUsed() < o.type.pop ? 'La ferme est trop petite' : null)
                 || (slots.free < 1 ? "Aucun emplacement libre : frappez des pièces d'or" : null); %>
              <% if (why) { %><span class="w-full text-right text-xs text-blood-300"><%= why %></span><% } %>
            <% } %>
          </form>
        <% } %>
        <p class="text-xs text-parchment-600">
          Portée maximale d'un noble : <%= ctx.cfg.snob.maxDistance %> cases. Chaque attaque gagnante avec un noble survivant baisse la loyauté
          de <%= ctx.cfg.snob.loyaltyLossMin %> à <%= ctx.cfg.snob.loyaltyLossMax %> ; à 0, le village change de propriétaire.
        </p>
      </div>
    </section>
  </div>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
