<%- include('partials/header', { title: target.name }) %>
<%
  // Aperçu d'un village, comme sur GT : à gauche la fiche (mini-carte, informations) et les actions ; à droite le
  // carnet de notes, tes ordres en cours vers ce village et les durées de trajet ; en bas tes rapports le concernant.
  const vid = ctx.village.id;
  const REL = {
    own: ['Ton village', 'border-rel-own text-rel-own'], tribe: ['Ta tribu', 'border-rel-tribe text-rel-tribe'],
    ally: ['Allié', 'border-rel-ally text-rel-ally'], nap: ['PNA', 'border-rel-nap text-rel-nap'], enemy: ['Ennemi', 'border-rel-enemy text-rel-enemy'],
    other: ['Joueur', 'border-rel-other text-rel-other'], barb: ['Barbare', 'border-rel-barb text-rel-barb'],
  };
  // relationsOf renvoie 'own' pour la tribu du joueur : c'est « Ta tribu » quand le village n'est pas à lui.
  const rel = REL[relation === 'own' && target.playerId !== ctx.village.playerId ? 'tribe' : relation] || REL.other;
  const owner = target.Player;
  const tribe = owner && owner.Tribe;
  const mine = target.playerId === ctx.village.playerId;
  const k = continent(target.x, target.y);
  const mapHref = `/village/${vid}/map?x=${target.x}&y=${target.y}&sx=${target.x}&sy=${target.y}`;
  const markHref = `/village/${vid}/map?${new URLSearchParams({ x: target.x, y: target.y, mark: `village:${target.id}`, label: `${target.name} (${target.x}|${target.y})` })}#marquages`;
  const verbs = { attack: 'Attaque', support: 'Soutien', return: 'Retour' };
  const action = 'flex w-full cursor-pointer items-center gap-2.5 border-b border-bronze-800 px-3 py-2 text-left font-semibold text-parchment-200 no-underline transition hover:bg-row-hover hover:text-parchment-50';
  const actionIcon = (name, cls = 'text-gold-400') => `<span class="flex w-5 justify-center ${cls}">${icon(name, 'size-4', 2)}</span>`;
%>
<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="<%= ui.h1 %> flex flex-wrap items-center gap-3"><%= target.name %> <span class="border px-1.5 py-px font-sans text-[11px] font-semibold tracking-[0.02em] <%= rel[1] %>"><%= rel[0] %></span></h1>
</div>

<div class="grid grid-cols-1 items-start gap-4 lg:grid-cols-[320px_minmax(0,1fr)]">
  <div class="flex min-w-0 flex-col gap-4">
    <%# Fiche : mini-carte centrée sur le village et informations %>
    <section class="<%= ui.panel %>">
      <%- panelHead(target.name, `<a href="${mapHref}" class="${ui.iconBtn}" title="Voir sur la carte" aria-label="Voir sur la carte">${icon('map', 'size-3.5', 2.2)}</a>`) %>
      <a href="<%= mapHref %>" class="block border-b-2 border-black bg-mini-bg" title="Voir sur la carte">
        <canvas class="block w-full" style="aspect-ratio:1/1" data-minimap="<%= JSON.stringify(mini) %>" role="img" aria-label="Environs de <%= target.name %> sur la carte"></canvas>
      </a>
      <table class="<%= ui.table %> text-sm [&_td]:py-1.5 [&_td:first-child]:whitespace-nowrap">
        <tbody>
          <tr><td class="w-28 text-parchment-500">Coordonnées</td><td class="font-semibold tabular-nums"><%= target.x %>|<%= target.y %> <span class="text-parchment-400"><%= k %></span></td></tr>
          <tr><td class="text-parchment-500">Points</td><td class="font-semibold tabular-nums"><%= num(target.points) %></td></tr>
          <tr><td class="text-parchment-500">Joueur</td><td><% if (owner) { %><a href="/village/<%= vid %>/players/<%= owner.id %>" class="<%= ui.link %>"><%= owner.name %></a><% } else { %><span class="text-parchment-400">Barbares · abandonné</span><% } %></td></tr>
          <% if (tribe) { %><tr><td class="text-parchment-500">Tribu</td><td><a href="/village/<%= vid %>/tribes/<%= tribe.id %>" class="<%= ui.link %>">[<%= tribe.tag %>] <%= tribe.name %></a></td></tr><% } %>
          <% if (morale != null) { %><tr><td class="text-parchment-500">Morale</td><td><b class="tabular-nums <%= morale < 1 ? 'text-blood-450' : '' %>"><%= Math.round(morale * 100) %> %</b></td></tr><% } %>
          <% if (target.special) { %><tr><td class="text-parchment-500">Particularité</td><td class="font-semibold text-gold-400"><%= target.special === 'rune' ? 'Village de rune' : 'Quartier du Grand Siège' %></td></tr><% } %>
        </tbody>
      </table>
    </section>

    <%# Actions, en liste comme sur GT %>
    <section class="<%= ui.panel %>">
      <%- panelHead('Actions') %>
      <div class="flex flex-col [&>*:last-child]:border-b-0 [&>form:last-child>button]:border-b-0">
        <% if (mine) { %>
          <a href="/village/<%= target.id %>" class="<%= action %>"><%- actionIcon('overview') %>Ouvrir le village</a>
        <% } %>
        <a href="<%= mapHref %>" class="<%= action %>"><%- actionIcon('center') %>Centrer sur la carte</a>
        <% if (!mine) { %>
          <%# Envoyer des troupes, avec un modèle d'armée au choix (unités préremplies au point de ralliement). %>
          <form method="get" action="/village/<%= vid %>/place" class="flex flex-col gap-1.5 border-b border-bronze-800 px-3 py-2">
            <input type="hidden" name="x" value="<%= target.x %>"><input type="hidden" name="y" value="<%= target.y %>">
            <button class="flex cursor-pointer items-center gap-2.5 text-left font-semibold text-parchment-200 hover:text-parchment-50"><%- actionIcon('attack', 'text-blood-500') %>Envoyer des troupes</button>
            <% if (templates.length) { %>
              <select name="tpl" class="<%= ui.inputSm %> ml-7.5" aria-label="Modèle d'armée" onchange="this.form.submit()">
                <option value="">choisir un modèle…</option>
                <% for (const t of templates) { %><option value="<%= t.id %>"><%= t.name %></option><% } %>
              </select>
            <% } %>
          </form>
          <a href="/village/<%= vid %>/market?tab=send&x=<%= target.x %>&y=<%= target.y %>" class="<%= action %>"><%- actionIcon('market') %>Envoyer des ressources</a>
          <% if (owner) { %><a href="/village/<%= vid %>/messages/new?to=<%= encodeURIComponent(owner.name) %>" class="<%= action %>"><%- actionIcon('messages') %>Écrire au joueur</a><% } %>
        <% } %>
        <form method="post" action="/village/<%= vid %>/favorites/<%= target.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="<%= action %>"><span class="flex w-5 justify-center text-gold-200">★</span><%= favorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %></button>
        </form>
        <a href="<%= markHref %>" class="<%= action %>"><%- actionIcon('flag') %>Modifier les marquages sur la carte</a>
      </div>
    </section>
  </div>

  <div class="flex min-w-0 flex-col gap-4">
    <%# Opérations de la tribu qui ciblent ce village : une ligne par attaque, toutes opérations confondues, dans l'ordre
        des arrivées (heure, compte à rebours, opération, troupes, joueur, départ depuis le village courant d'après
        l'unité la plus lente) ; revendiquer une place précise, libérer les attaques cochées. %>
    <% if (operations.length) { const opBase = `/village/${vid}/tribe/operations`; const csrfIn = `<input type="hidden" name="_csrf" value="${csrfToken}">`;
         const travelOf = new Map(travel.map((u) => [u.id, u.seconds]));
         const timeline = operations.flatMap((r) => r.slots.map((sl) => ({ ...sl, r })))
           .sort((a, b) => (a.at ? a.at.getTime() : Infinity) - (b.at ? b.at.getTime() : Infinity) || a.r.op.id - b.r.op.id || a.slot - b.slot);
         const claimed = timeline.filter((e) => e.claim).length;
         const ops = [...new Map(operations.map((r) => [r.op.id, r.op])).values()];
         const releasable = timeline.some((e) => e.claim && (e.claim.playerId === ctx.village.playerId || opOrganizer)); %>
    <section class="<%= ui.panel %>">
      <%- panelHead('Opérations de la tribu', `<span class="text-[13px] text-parchment-300 tabular-nums"><b class="text-parchment-100">${claimed} / ${timeline.length}</b> attaques revendiquées</span>`) %>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-bronze-800 px-3 py-1.5 text-[13px]">
        <% for (const op of ops) { %><a href="<%= opBase %>/<%= op.id %>" class="<%= ui.linkPlain %> inline-flex items-center gap-1.5 font-semibold"><span class="inline-block size-2.5 shrink-0 border border-black" style="background: <%= op.color %>"></span><%= op.name %></a><% } %>
      </div>
      <div class="overflow-x-auto">
        <table class="<%= ui.table %> min-w-[720px] text-[13px] [&_td]:py-1 [&_th]:py-1">
          <thead>
            <tr>
              <th class="w-7"><% if (releasable) { %><input type="checkbox" class="<%= ui.checkbox %>" data-select-all="op-release" aria-label="Tout cocher"><% } %></th>
              <th>Arrivée</th><th>Dans</th><th>Opération</th><th>Troupes</th><th>Joueur</th><th title="Depuis <%= ctx.village.name %>, d'après l'unité la plus lente demandée">Départ d'ici</th>
            </tr>
          </thead>
          <tbody>
            <% for (const e of timeline) { const x = e.r.target; const c = e.claim; const me = c && c.playerId === ctx.village.playerId;
                 const troops = Object.entries(x.units || {}).filter(([, n]) => n > 0);
                 const slowest = Math.max(0, ...troops.map(([u]) => travelOf.get(u) || 0));
                 const depart = e.at && slowest ? new Date(e.at.getTime() - slowest * 1000) : null;
                 const left = e.at ? Math.floor((e.at.getTime() - now.getTime()) / 1000) : null; %>
              <tr class="<%= me ? 'bg-gold-400/15' : '' %>" style="box-shadow: inset 3px 0 0 <%= e.r.op.color %>">
                <td><% if (c && (me || opOrganizer)) { %><input type="checkbox" name="slots" value="<%= x.id %>:<%= e.slot %>" form="op-release" data-select-item class="<%= ui.checkbox %>" aria-label="Libérer l'attaque <%= e.slot + 1 %> de <%= e.r.op.name %>"><% } %></td>
                <td class="font-semibold tabular-nums whitespace-nowrap" title="<%= e.at ? e.at.toLocaleString('fr-FR') : '' %>"><%= e.at ? `${e.at.toLocaleDateString('fr-FR', { day: '2-digit', month: '2-digit' })} ${e.at.toLocaleTimeString('fr-FR')}` : '—' %></td>
                <td class="tabular-nums whitespace-nowrap"><% if (left > 0) { %><span data-countdown="<%= e.at.getTime() %>" data-countdown-noreload><%= duration(left) %></span><% } else if (left !== null) { %><span class="text-parchment-500">passée</span><% } %></td>
                <td class="whitespace-nowrap" title="<%= x.note || '' %>"><%= e.r.op.name %> <span class="text-parchment-500 tabular-nums"><%= e.slot + 1 %>/<%= x.count %></span><% if (x.units && x.units.snob > 0) { %> <span class="text-gold-400" title="Noblage">♛</span><% } %></td>
                <td><span class="flex flex-nowrap items-center gap-x-2"><% if (!troops.length) { %><span class="text-parchment-500">libres</span><% } %><% for (const [u, n] of troops) { %><span class="inline-flex items-center gap-0.5 tabular-nums whitespace-nowrap" title="<%= unitName(u) %>"><%- unitIcon(u, 'size-4 min-h-4 min-w-4') %><%= num(n) %></span><% } %></span></td>
                <td class="whitespace-nowrap">
                  <% if (c) { %><span class="<%= me ? 'font-semibold text-gold-200' : 'font-semibold' %>"><%= c.Player ? c.Player.name : '?' %></span>
                  <% } else { %><form method="post" action="<%= opBase %>/targets/<%= x.id %>/claim" class="inline"><%- csrfIn %><input type="hidden" name="slot" value="<%= e.slot %>"><button class="<%= btn('gold', 'sm') %> h-6 px-2 text-[12px]" title="Revendiquer cette attaque">Prendre</button></form><% } %>
                </td>
                <td class="tabular-nums whitespace-nowrap"><% if (depart) { %><span class="<%= depart < now ? 'text-parchment-500 line-through' : me ? 'font-semibold text-gold-200' : '' %>"><%= depart.toLocaleTimeString('fr-FR') %></span><% } else { %><span class="text-parchment-500">—</span><% } %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <% if (releasable) { %>
        <form id="op-release" method="post" action="<%= opBase %>/release" class="flex flex-wrap items-center gap-2 border-t border-bronze-800 px-3 py-1.5"><%- csrfIn %>
          <button class="<%= btn('dark', 'sm') %>">Libérer les attaques cochées</button>
          <span class="text-[12px] text-parchment-500"><%= opOrganizer ? 'Tes attaques, ou celles des autres membres (droit Opérations).' : 'Seules tes attaques peuvent être cochées.' %></span>
        </form>
      <% } %>
    </section>
    <% } %>

    <%# Carnet de notes (visible de toi seul) %>
    <section class="<%= ui.panel %>">
      <details class="group">
        <summary data-panel-head class="<%= ui.panelHead %> cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <span class="<%= ui.panelTitle %>"><span class="<%= ui.diamond %>" aria-hidden="true"></span>Carnet de notes</span>
          <span class="text-[13px] font-semibold text-gold-400 group-open:hidden">Modifier</span><span class="hidden text-[13px] font-semibold text-gold-400 group-open:inline">Fermer</span>
        </summary>
        <form method="post" action="/village/<%= vid %>/villages/<%= target.id %>/note" class="flex flex-col gap-2 border-b border-bronze-800 p-3"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <textarea name="text" rows="4" maxlength="2000" class="<%= ui.textarea %> w-full" aria-label="Note sur ce village" placeholder="Troupes vues, horaires du joueur, cible à nobler…"><%= note %></textarea>
          <div><button class="<%= btn('dark', 'sm') %>">Enregistrer</button></div>
        </form>
      </details>
      <% if (note) { %>
        <p class="px-3 py-2.5 whitespace-pre-line wrap-break-word text-parchment-200"><%= note %></p>
      <% } else { %>
        <p class="px-3 py-2.5 text-sm text-parchment-500">Aucune note sur ce village. Tu peux la partager avec ta tribu dans les <a href="/village/<%= vid %>/account?tab=tribe-settings" class="<%= ui.link %>">réglages tribu</a>.</p>
      <% } %>
      <% if (tribeNotes.length) { %>
        <div class="border-t border-bronze-800">
          <p class="<%= ui.subLabel %> px-3 pt-2">Notes de la tribu</p>
          <% for (const n of tribeNotes) { %>
            <div class="border-b border-bronze-900 px-3 py-2 last:border-b-0">
              <p class="text-xs text-parchment-500"><a href="/village/<%= vid %>/players/<%= n.authorId %>" class="<%= ui.linkPlain %> font-semibold"><%= n.author %></a> · <span class="tabular-nums"><%= whenShort(n.updatedAt, now) %></span></p>
              <p class="whitespace-pre-line wrap-break-word text-parchment-200"><%= n.text %></p>
            </div>
          <% } %>
        </div>
      <% } %>
    </section>

    <%# Attaques entrantes nommées ou annotées par le membre de la tribu qui possède ce village (notes partagées) %>
    <% if (sharedIncomings.length) { %>
    <section class="<%= ui.panel %>">
      <%- panelHead(`Arrivées annotées (${sharedIncomings.length})`) %>
      <% for (const { cmd: c, name } of sharedIncomings) { const left = (new Date(c.arrivesAt) - now) / 1000; %>
        <div class="flex flex-col gap-1 border-b border-bronze-900 px-3 py-2 last:border-b-0">
          <div class="flex min-w-0 flex-wrap items-center gap-x-2.5 gap-y-1">
            <%- incomingBadge(c, 'sm') %>
            <span class="min-w-0 truncate font-semibold <%= c.type === 'attack' ? 'text-blood-300' : 'text-parchment-100' %>"><%= name %></span>
            <span class="text-[13px] text-parchment-500">de <%- villageLink(vid, c.origin, { nameCls: '', coordsCls: '', k: false }) %></span>
            <span class="ml-auto text-[13px] text-parchment-400 tabular-nums"><%= whenShort(c.arrivesAt, now) %> · <span class="font-semibold text-parchment-100" data-countdown="<%= new Date(c.arrivesAt).getTime() %>" data-countdown-noreload><%= duration(left) %></span></span>
          </div>
          <% if (c.incomingNote) { %><p class="whitespace-pre-line wrap-break-word text-sm text-parchment-200"><%= c.incomingNote %></p><% } %>
        </div>
      <% } %>
    </section>
    <% } %>

    <%# Tes ordres vers ce village %>
    <section class="<%= ui.panel %>">
      <%- panelHead(`Propres ordres (${commands.length})`) %>
      <% if (!commands.length) { %>
        <p class="px-3 py-2.5 text-sm text-parchment-500">Aucun de tes ordres en cours vers ce village.</p>
      <% } else { %>
        <div class="overflow-x-auto">
          <table class="<%= ui.table %> text-sm [&_td]:py-1.5">
            <thead><tr><th>Ordre</th><th>Heure d'arrivée</th><th class="text-right">Arrive dans</th></tr></thead>
            <tbody>
            <% for (const c of commands) { const left = (new Date(c.arrivesAt) - now) / 1000; %>
              <tr class="cursor-pointer" data-unfold-row>
                <td>
                  <span class="flex min-w-0 items-center gap-2">
                    <span class="inline-flex shrink-0" data-tip="ordre-<%= c.id %>"><%- include('partials/order-badge', { type: c.type, units: c.units, size: 'sm' }) %></span>
                    <span class="truncate"><span class="text-parchment-400"><%= c.type === 'return' ? 'Retour vers' : `${verbs[c.type] || 'Ordre'} depuis` %></span> <a href="/village/<%= c.origin.id %>" class="<%= ui.linkPlain %> font-semibold"><%= c.origin.name %></a></span>
                    <%- include('partials/order-units', { id: `ordre-${c.id}`, units: c.units, part: 'toggle' }) %>
                  </span>
                </td>
                <td class="whitespace-nowrap text-parchment-300 tabular-nums"><%= whenShort(c.arrivesAt, now) %></td>
                <td class="text-right font-semibold whitespace-nowrap tabular-nums <%= left < 600 ? 'text-blood-450' : 'text-parchment-100' %>" data-countdown="<%= new Date(c.arrivesAt).getTime() %>"><%= duration(left) %></td>
              </tr>
              <tr id="ordre-<%= c.id %>" hidden><td colspan="3" class="pt-0!"><%- include('partials/order-units', { units: c.units, loot: c.type === 'return' ? c.loot : null, part: 'panel' }) %></td></tr>
            <% } %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>

    <% if (!mine && dist) { %>
      <section class="<%= ui.panel %>">
        <%- panelHead('Durées de trajet', `<span class="font-sans text-[11px] text-parchment-300">Depuis ${esc(ctx.village.name)}</span>`) %>
        <%# Une rangée jusqu'à 10 unités, sinon deux rangées égales (comme l'infobulle de la carte). %>
        <div class="grid gap-px bg-bronze-900 p-px" style="grid-template-columns: repeat(<%= travel.length <= 10 ? travel.length : Math.ceil(travel.length / 2) %>, minmax(50px, 1fr))">
          <% for (const t of travel) { %>
            <span class="flex flex-col items-center gap-1 bg-panel-top px-1.5 pt-1.5 pb-1 whitespace-nowrap" title="<%= unitName(t.id) %>"><span class="text-gold-400"><%- unitIcon(t.id, 'size-4', 2) %></span><span class="text-xs font-semibold text-parchment-200 tabular-nums"><%= duration(t.seconds) %></span></span>
          <% } %>
        </div>
      </section>
    <% } %>
  </div>
</div>

<%# Tes rapports sur ce village %>
<section class="<%= ui.panel %>">
  <%- panelHead('Rapports sur ce village', `<span class="text-[13px] text-parchment-500 tabular-nums">${reports.length}</span>`) %>
  <% if (!reports.length) { %>
    <p class="px-3 py-2.5 text-sm text-parchment-500">Aucun rapport sur ce village.</p>
  <% } else { %>
    <form method="post" action="/village/<%= vid %>/reports/bulk" id="village-reports" data-confirm="Supprimer les rapports sélectionnés ?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="action" value="delete"></form>
    <div class="overflow-x-auto">
      <table class="<%= ui.table %> text-sm [&_td]:py-1.5">
        <thead><tr><th class="w-8"></th><th>Objet</th><th class="text-right">Reçu</th></tr></thead>
        <tbody>
        <% for (const r of reports) { const o = reportOutcome(r); const dot = o ? attackDot(o.result, 'size-4') : ''; %>
          <tr class="<%= r.isRead ? '' : 'font-semibold' %>">
            <td><input type="checkbox" name="ids" value="<%= r.id %>" form="village-reports" class="<%= ui.checkbox %>" data-select-item aria-label="Sélectionner « <%= reportTitle(r) %> »"></td>
            <td><span class="inline-flex items-center gap-2"><%- dot %><a href="/village/<%= vid %>/reports/<%= r.id %>" class="<%= ui.linkPlain %>"><%= reportTitle(r) %></a><%- o ? haulIcon(o.haul, 'size-5') : '' %><% if (!r.isRead) { %> <span class="text-[11px] font-normal text-gold-400">(nouveau)</span><% } %></span></td>
            <td class="text-right whitespace-nowrap text-parchment-400 tabular-nums"><%= whenShort(r.happenedAt, now) %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-bronze-900 px-3 py-2.5">
      <label class="inline-flex cursor-pointer items-center gap-2 text-sm text-parchment-300"><input type="checkbox" class="<%= ui.checkbox %>" data-select-all="village-reports">Sélectionner tout</label>
      <button class="<%= btn('danger', 'sm') %>" form="village-reports"><%- icon('trash', 'size-3.5', 2) %>Effacer</button>
    </div>
  <% } %>
</section>
<script src="<%= asset('/js/terrain.js') %>" defer></script>
<script src="<%= asset('/js/minimap.js') %>" defer></script>
<%- include('partials/footer') %>
