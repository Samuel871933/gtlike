<%- include('partials/header', { title: target.name }) %>
<%
  const vid = ctx.village.id;
  const REL = {
    own: ['Ton village', 'border-rel-own text-rel-own'], tribe: ['Ta tribu', 'border-rel-tribe text-rel-tribe'], own_tribe: ['Ta tribu', 'border-rel-tribe text-rel-tribe'],
    ally: ['Allié', 'border-rel-ally text-rel-ally'], nap: ['PNA', 'border-rel-nap text-rel-nap'], enemy: ['Ennemi', 'border-rel-enemy text-rel-enemy'],
    other: ['Joueur', 'border-rel-other text-rel-other'], barb: ['Barbare', 'border-rel-barb text-rel-barb'],
  };
  // relationsOf renvoie 'own' pour la tribu du joueur : c'est « Ta tribu » quand le village n'est pas à lui.
  const rel = REL[relation === 'own' && target.playerId !== ctx.village.playerId ? 'tribe' : relation] || REL.other;
  const owner = target.Player;
  const tribe = owner && owner.Tribe;
  const mine = target.playerId === ctx.village.playerId;
  const meta = [
    ['Coordonnées', `${target.x} | ${target.y}`, 'border-t-gold-400'],
    ['Continent', continent(target.x, target.y), 'border-t-bronze-500'],
    ['Points', num(target.points), 'border-t-blood-700'],
    ['Distance', dist ? `${(Math.round(dist * 10) / 10).toLocaleString('fr-FR')} cases` : '—', 'border-t-bronze-500'],
    ...(morale != null ? [['Morale', `${Math.round(morale * 100)} %`, morale < 1 ? 'border-t-blood-450' : 'border-t-olive-500']] : []),
  ];
%>
<div class="flex flex-wrap items-start gap-3.5">
  <div class="flex min-w-0 flex-[999_1_560px] flex-col gap-3.5">
    <%# Titre du village %>
    <div class="<%= ui.panel %> flex flex-wrap items-center justify-between gap-2.5 py-2.5 pr-3.5 pl-5">
      <div class="absolute inset-y-0 left-0 w-1.5 border-r-2 border-black bg-[repeating-linear-gradient(180deg,var(--color-blood-800)_0_8px,var(--color-blood-900)_8px_16px)]" aria-hidden="true"></div>
      <div class="flex min-w-0 flex-col gap-1">
        <h1 class="m-0 truncate font-display text-[26px] font-bold tracking-[0.02em] text-parchment-100 [text-shadow:2px_2px_0_#000,4px_4px_0_var(--color-blood-900)]"><%= target.name %></h1>
        <span class="self-start border px-1.5 py-px text-[11px] font-semibold tracking-[0.02em] <%= rel[1] %>"><%= rel[0] %></span>
      </div>
      <div class="flex flex-wrap gap-1">
        <% for (const [k, val, c] of meta) { %>
          <div class="flex min-w-16 flex-col border border-bronze-800 border-t-2 bg-night px-2.5 py-[3px] <%= c %>">
            <span class="text-[10px] tracking-[0.02em] text-parchment-500"><%= k %></span>
            <span class="text-base font-semibold text-parchment-100 tabular-nums"><%= val %></span>
          </div>
        <% } %>
      </div>
    </div>

    <section class="<%= ui.panel %>">
      <%- panelHead('Informations') %>
      <table class="<%= ui.table %>">
        <tbody>
          <tr><td class="w-40 text-parchment-500">Joueur</td><td><% if (owner) { %><a href="/village/<%= vid %>/players/<%= owner.id %>" class="<%= ui.link %>"><%= owner.name %></a><% } else { %>Barbares<% } %></td></tr>
          <tr><td class="text-parchment-500">Tribu</td><td><% if (tribe) { %><a href="/village/<%= vid %>/tribes/<%= tribe.id %>" class="<%= ui.link %>">[<%= tribe.tag %>] <%= tribe.name %></a><% } else { %>—<% } %></td></tr>
          <tr><td class="text-parchment-500">Points</td><td class="font-semibold tabular-nums"><%= num(target.points) %></td></tr>
          <% if (morale != null) { %><tr><td class="text-parchment-500">Morale de tes attaques</td><td><b class="tabular-nums <%= morale < 1 ? 'text-blood-450' : '' %>"><%= Math.round(morale * 100) %> %</b> <span class="text-[13px] text-parchment-500">· plus le joueur est petit face à toi, plus tes troupes perdent en force</span></td></tr><% } %>
          <% if (target.special) { %><tr><td class="text-parchment-500">Particularité</td><td class="font-semibold text-gold-400"><%= target.special === 'rune' ? 'Village de rune' : 'Quartier du Grand Siège' %></td></tr><% } %>
        </tbody>
      </table>
    </section>

    <% if (!mine && dist) { %>
      <section class="<%= ui.panel %>">
        <%- panelHead('Durées de trajet', `<span class="font-sans text-[11px] text-parchment-300">Depuis ${esc(ctx.village.name)}</span>`) %>
        <table class="<%= ui.table %>">
          <thead><tr><th>Unité la plus lente</th><th class="text-right">Durée</th></tr></thead>
          <tbody>
            <% for (const t of travel) { %>
              <tr><td><span class="inline-flex items-center gap-2"><span class="text-gold-400"><%- unitIcon(t.id, 'size-4', 2) %></span><%= unitName(t.id) %></span></td><td class="text-right font-semibold tabular-nums"><%= duration(t.seconds) %></td></tr>
            <% } %>
          </tbody>
        </table>
      </section>
    <% } %>
  </div>

  <aside class="flex max-w-full flex-[1_1_280px] flex-col gap-3">
    <section class="<%= ui.panel %>">
      <%- panelHead('Actions') %>
      <div class="<%= ui.panelBody %> gap-2">
        <% if (mine) { %>
          <a href="/village/<%= target.id %>" class="<%= btn('gold', 'md', 'w-full') %>">Ouvrir le village</a>
        <% } else { %>
          <a href="/village/<%= vid %>/place?x=<%= target.x %>&y=<%= target.y %>" class="<%= btn('red', 'md', 'w-full') %>"><%- icon('attack', 'size-3.5', 2.2) %>Envoyer des troupes</a>
          <a href="/village/<%= vid %>/market?tab=send&x=<%= target.x %>&y=<%= target.y %>" class="<%= btn('dark', 'md', 'w-full') %>">Envoyer des ressources</a>
          <% if (owner) { %><a href="/village/<%= vid %>/messages/new?to=<%= encodeURIComponent(owner.name) %>" class="<%= btn('dark', 'md', 'w-full') %>">Écrire au joueur</a><% } %>
        <% } %>
        <form method="post" action="/village/<%= vid %>/favorites/<%= target.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="<%= btn('dark', 'md', 'w-full') %>"><span class="text-gold-200">★</span><%= favorite ? 'Retirer des favoris' : 'Ajouter aux favoris' %></button>
        </form>
        <a href="/village/<%= vid %>/map?x=<%= target.x %>&y=<%= target.y %>&sx=<%= target.x %>&sy=<%= target.y %>" class="<%= ui.link %> self-center text-[13px]">» Centrer la carte sur ce village</a>
      </div>
    </section>
  </aside>
</div>
<%- include('partials/footer') %>
