<%- include('partials/header', { title: buildingName('market') }) %>
<%
  // Marché, agencé comme sur GT (sans le centre d'échange premium) : menu à gauche, en-tête des marchands et des
  // ressources arrivantes / sortantes, puis la page choisie.
  const vid = ctx.village.id;
  const m = `/village/${vid}/market`;
  const res = Object.fromEntries(RESOURCES.map((r) => [r.id, r]));
  const menu = [
    ['offers', 'Échange'], ['create', 'Créer des offres'], ['mass', 'Créer des offres en masse'], ['send', 'Envoyer des ressources'],
    ['transports', 'Transports'], ['merchants', 'Statut des marchands'], ['own', 'Toutes tes propres offres'], ['request', 'Demande'],
  ];
  // Icône de ressource : composant commun (images des ressources, helpers.resourceIcon), avec le nom au survol.
  const resIcon = (id) => `<span class="inline-flex" title="${esc(res[id].label)}">${resourceIcon(id)}</span>`;
  const amount = (id, n) => `<span class="inline-flex items-center gap-1.5 whitespace-nowrap font-semibold tabular-nums">${resIcon(id)}${num(n)}</span>`;
  const flowLine = (list) => (RESOURCES.some((r) => list[r.id] > 0)
    ? RESOURCES.filter((r) => list[r.id] > 0).map((r) => amount(r.id, list[r.id])).join(' ')
    : '<span class="text-parchment-500">—</span>');
  const count = (n) => `<span class="${ui.headCount}">${n}</span>`;
  const infoTile = 'flex items-center gap-2 border border-bronze-800 bg-night px-2.5 py-1.5 text-sm';
  // Rangée de boutons radio de ressources (formulaires Je veux / J'offre) ; `off` : ressource désactivée.
  const radios = (name, current, { all = false, off = null } = {}) => [
    ...(all ? [`<label class="inline-flex cursor-pointer items-center gap-1.5"><input type="radio" name="${name}" value="" ${!current ? 'checked' : ''} class="accent-gold-400">tout</label>`] : []),
    ...RESOURCES.map((r) => `<label class="inline-flex items-center gap-1.5 ${r.id === off ? 'opacity-40' : 'cursor-pointer'}"><input type="radio" name="${name}" value="${r.id}" ${current === r.id ? 'checked' : ''} ${r.id === off ? 'disabled' : ''} class="accent-gold-400">${resIcon(r.id)}<span class="sr-only">${r.label}</span></label>`),
  ].join('');
  // Limites d'une offre, en texte (les capitales des tags sont réservées au tag de tribu).
  const limitTags = (o) => [o.maxHours ? `≤ ${o.maxHours} h` : '', o.tribeOnly ? 'tribu uniquement' : ''].filter(Boolean).map((t) => `<span class="border border-bronze-700 px-1 text-[12px] whitespace-nowrap text-parchment-400">${t}</span>`).join(' ');
%>
<div class="flex flex-col gap-4">
  <%- include('partials/building-header', { buildingId: 'market' }) %>

  <div class="grid grid-cols-1 items-start gap-4 md:grid-cols-[210px_minmax(0,1fr)]">
    <%- sideNav(menu.map(([id, label]) => ({ href: `${m}?tab=${id}`, label, active: id === tab })), { label: buildingName('market'), cls: ui.panel }) %>

    <div class="flex min-w-0 flex-col gap-4">
      <%# En-tête : marchands, quantité transportable, ressources arrivantes et sortantes. %>
      <div class="flex flex-wrap gap-2">
        <span class="<%= infoTile %>"><span class="text-parchment-500">Marchands :</span><b class="tabular-nums"><%= merchants.free %>/<%= merchants.total %></b></span>
        <span class="<%= infoTile %>"><span class="text-parchment-500">Quantité de transport maximale :</span><b class="tabular-nums"><%= num(merchants.free * cap) %></b></span>
        <span class="<%= infoTile %>"><span class="text-parchment-500">Arrivant :</span><%- flowLine(flows.incoming) %></span>
        <span class="<%= infoTile %>"><span class="text-parchment-500">Sortant :</span><%- flowLine(flows.outgoing) %></span>
      </div>

<%# Onglet choisi (le menu limite ?tab= à ces valeurs) ; ses helpers lui sont passés, un include ne voit pas les const d'ici. %>
<% if (['offers', 'create', 'mass', 'send', 'transports', 'merchants', 'own', 'request'].includes(tab)) { %>
  <%- include(`partials/market/${tab}`, { m, vid, res, resIcon, amount, flowLine, count, infoTile, radios, limitTags }) %>
<% } %>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
