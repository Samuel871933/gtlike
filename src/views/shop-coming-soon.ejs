<%- include('partials/header', { title: 'Paiement en construction' }) %>
<%# Paiement pas encore disponible : page d'attente des boutons « Acheter » des packs d'Adartons. %>
<div class="flex flex-col gap-3.5 pb-4">
  <section class="<%= ui.panel %> flex flex-col items-center gap-3 px-6 py-8 text-center">
    <%- icon('adarton', 'size-24 drop-shadow-[0_0_14px_rgba(227,178,60,0.45)] -rotate-6') %>
    <h1 class="m-0 font-display text-2xl font-semibold text-parchment-100">En construction</h1>
    <p class="text-parchment-400">Le paiement n’est pas encore ouvert<% if (pack) { %> : le pack de <span class="font-semibold text-gold-200"><%= num(pack.adartons) %> Adartons</span> (<%= pack.price %>) sera bientôt disponible<% } %>. Aucun montant n’a été débité.</p>
    <% if (happy.active) { %><p class="text-sm font-semibold text-gold-200">C’est l’happy hour : les packs achetés maintenant donnent +<%= Math.round(happy.bonus * 100) %> % d’Adartons.</p><% } %>
    <div class="flex flex-wrap justify-center gap-2">
      <a href="/shop<%= shopQuery %>" class="<%= btn('gold', 'sm') %>">Retour à la boutique</a>
      <a href="/worlds" class="<%= btn('dark', 'sm') %>">Accueil</a>
    </div>
  </section>
</div>
<%- include('partials/footer') %>
