<%- include('partials/header', { title: 'Quartier général' }) %>
<%
  // Quartier général, agencé comme sur Guerre Tribale : onglets Construction / Démolition, file en cours
  // (construction, durée, achèvement, annulation), puis tableau des bâtiments (besoins, bouton du niveau suivant).
  // Pas de colonne « Accélération » : la boutique ne vend pas d'accélération (le premium allonge seulement la file).
  const vid = ctx.village.id;
  // Premium (boutique) : file de construction plus longue ; au-delà des emplacements au prix normal, des ordres en
  // plus de plus en plus chers (VillageService.queueSurcharge). Sans premium, incitation quand la file est pleine.
  const queueFull = ctx.buildOrders.length >= ctx.buildQueueMax;
  const surcharge = Math.round((queueSurcharge - 1) * 100);
  const extraPct = Math.round((ctx.cfg.premium.extraOrderFactor - 1) * 100);
  const premiumHref = `/shop/item/premium?world=${encodeURIComponent(ctx.world.slug)}`;
  const premiumSlots = ctx.buildQueueSlots + ctx.cfg.premium.buildQueueBonus;
  const favs = new Set(favoriteBuildings(player, ctx));
  const tabHref = (t) => `/village/${vid}/main${t === 'demolition' ? '?tab=demolition' : ''}`;
  const clock = (s) => `<span class="inline-flex items-center gap-1.5 text-parchment-300 tabular-nums"><span class="text-parchment-600">${icon('clock', 'size-3.5', 2)}</span>${duration(s)}</span>`;
  const rows = [...available, ...maxed];
  // Info-bulle d'un bâtiment (onglet Construction) : son rôle, son effet au niveau actuel et au suivant, et ce que le
  // niveau suivant débloque (bâtiments dont c'est la dernière condition manquante).
  const unlocksAt = (id, level) => locked.filter((l) => l.missing.length && l.missing.every((m) => m.building === id && m.level <= level)).map((l) => l.type.name);
  const infoTip = (o, level) => {
    const next = o.maxed ? null : level + 1;
    const now_ = level > 0 ? buildingStat(o.type.id, level, ctx.cfg) : null;
    const then = next ? buildingStat(o.type.id, next, ctx.cfg) : null;
    const unlocks = next ? unlocksAt(o.type.id, next) : [];
    const stat = then || now_;
    return `<div class="pointer-events-none absolute top-full left-0 z-30 mt-1.5 hidden w-72 flex-col gap-1.5 border-2 border-black bg-panel-top p-2.5 text-left text-[13px] font-normal shadow-[inset_0_0_0_1px_var(--color-bronze-500),5px_5px_0_#000] group-hover/info:flex group-focus-within/info:flex" role="tooltip">
      <span class="font-semibold text-parchment-100">${esc(o.type.name)} <span class="font-normal text-gold-400">· ${level > 0 ? `niveau ${level}` : 'non construit'}${next ? ` → ${next}` : ''}</span></span>
      <span class="text-parchment-400">${esc(o.type.description)}</span>
      ${stat ? `<span class="flex flex-wrap items-baseline gap-x-1.5 border-t border-bronze-800 pt-1.5"><span class="text-parchment-500">${esc(stat.label)} :</span>
        <span class="font-semibold text-parchment-100 tabular-nums">${now_ ? esc(now_.value) : '—'}</span>
        ${then ? `<span class="text-gold-400">${icon('arrowRight', 'size-3', 2.6)}</span><span class="font-semibold text-gold-200 tabular-nums">${esc(then.value)}</span><span class="text-parchment-500">au niveau ${next}</span>` : ''}</span>` : ''}
      ${unlocks.length ? `<span class="border-t border-bronze-800 pt-1.5"><span class="text-parchment-500">Le niveau ${next} débloque :</span> <span class="font-semibold text-parchment-100">${unlocks.map(esc).join(', ')}</span></span>` : ''}
      ${o.maxed ? '<span class="text-parchment-500">Niveau maximum atteint.</span>' : ''}
    </div>`;
  };
  const nameCell = (o, level, tip = false) => `
    <div class="${tip ? 'group/info relative ' : ''}flex items-center gap-3">${tip ? infoTip(o, level) : ''}
      <span class="relative shrink-0">
        ${buildingImg(o.type.id, level, 'h-[35px] w-10 minimal:h-7 minimal:w-8')}
      </span>
      <span class="flex min-w-0 flex-col">
        <span class="flex items-center gap-1">
          <a href="/village/${vid}/${buildingPath(o.type.id, ctx.cfg)}" class="${ui.linkPlain} font-semibold">${esc(o.type.name)}</a>
          ${favStar(vid, o.type.id, favs.has(o.type.id), csrfToken, 'size-5')}
        </span>
        <span class="text-[13px] text-parchment-500">${level > 0 ? `Niveau ${level}` : 'non construit'}</span>
      </span>
    </div>`;
%>
<div class="flex flex-col gap-5">
  <%- include('partials/building-header', { buildingId: 'main' , illustration: 'wide' }) %>

  <%# Comme sur GT : grande illustration du bâtiment à gauche sur les écrans larges (vignette dans l'en-tête sinon). %>
  <div class="<%= ui.buildingGrid %>">
    <div class="<%= ui.buildingAside %>"><%- include('partials/building-illustration', { buildingId: 'main' }) %><%- include('partials/quest-aside') %></div>
    <div class="flex min-w-0 flex-col gap-5">

  <%- segTabs([[tabHref('build'), 'Construction', tab === 'build'], [tabHref('demolition'), 'Démolition', tab === 'demolition']]) %>

  <%# File en cours (constructions et démolitions). %>
  <% if (ctx.buildOrders.length) { %>
    <section class="<%= ui.panel %> min-w-0">
      <%- panelHead('Constructions en cours', `<span class="flex items-center gap-2">${ctx.premium ? `<span class="${ui.tagGold}">Premium</span>` : ''}${surcharge && !queueFull ? `<span class="text-[13px] font-semibold text-gold-200 tabular-nums" title="Coût supplémentaire de la prochaine construction de la file">prochaine : +${surcharge} %</span>` : ''}<span class="text-[13px] font-semibold ${queueFull || surcharge ? 'text-gold-200' : 'text-parchment-500'} tabular-nums" title="${ctx.premium ? `${ctx.buildQueueSlots} au prix normal, ${ctx.buildQueueMax} au plus` : ''}">${ctx.buildOrders.length} / ${ctx.buildQueueMax}</span></span>`) %>
      <div class="overflow-x-auto">
        <table class="<%= ui.table %>">
          <thead><tr><th>Construction</th><th>Durée</th><th class="max-sm:hidden">Achèvement</th><th class="text-right">Annulation</th></tr></thead>
          <tbody>
          <% for (const o of ctx.buildOrders) {
               const running = new Date(o.startsAt) <= now; const start = new Date(o.startsAt).getTime(); const end = new Date(o.endsAt).getTime();
               const pct = running ? Math.max(0, Math.min(100, ((now - start) / (end - start)) * 100)) : 0;
               const freeAt = end - ctx.cfg.freeFinishSeconds * 1000; %>
            <tr class="<%= running ? '[&>td]:border-b-0' : '' %>">
              <td>
                <div class="flex items-center gap-2.5">
                  <%- buildingImg(o.building, o.level, 'h-7 w-8') %>
                  <span class="flex flex-col">
                    <span class="font-semibold"><%= buildingName(o.building) %></span>
                    <span class="text-[13px] <%= o.demolish ? 'text-blood-300' : 'text-parchment-500' %>"><%= o.demolish ? `Démolition → niveau ${o.level}` : `Niveau ${o.level}` %></span>
                  </span>
                </div>
              </td>
              <td class="font-semibold whitespace-nowrap tabular-nums">
                <% if (running) { %><span class="text-gold-200" data-countdown="<%= end %>"><%= duration((end - now) / 1000) %></span><% } else { %><span class="text-parchment-400"><%= duration((end - start) / 1000) %></span><% } %>
              </td>
              <td class="whitespace-nowrap text-parchment-300 max-sm:hidden"><%= when(o.endsAt, now) %></td>
              <td class="text-right">
                <div class="inline-flex items-center gap-1.5">
                  <% if (running && !o.demolish) { %>
                    <%# Terminer gratuitement : visible dès qu'il reste au plus 3 minutes (game.js l'affiche au bon moment). %>
                    <form method="post" action="/village/<%= vid %>/build/<%= o.id %>/finish" class="<%= now >= freeAt ? '' : 'hidden' %>" data-free-at="<%= freeAt %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="<%= btn('gold', 'sm') %>" title="Gratuit : moins de <%= Math.round(ctx.cfg.freeFinishSeconds / 60) %> minutes restantes">Terminer</button>
                    </form>
                  <% } %>
                  <form method="post" action="/village/<%= vid %>/build/<%= o.id %>/cancel"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="<%= btn('danger', 'sm') %>"><%- icon('close', 'size-3', 2.6) %>Annuler</button>
                  </form>
                </div>
              </td>
            </tr>
            <% if (running) { %>
              <tr class="hover:bg-transparent!"><td colspan="4" class="pt-0!"><span class="<%= ui.track %>"><span class="<%= ui.fill %>" style="width: <%= pct.toFixed(1) %>%" data-progress-start="<%= start %>" data-progress-end="<%= end %>"></span></span></td></tr>
            <% } %>
          <% } %>
          </tbody>
        </table>
      </div>
      <% if (!ctx.premium) { %>
        <%# Incitation au premium : 3 emplacements de plus ; mise en avant quand la file est pleine. %>
        <%- include('partials/premium-banner', {
          href: premiumHref, highlight: queueFull,
          title: queueFull ? `File pleine ? Avec le premium, enchaîne jusqu’à ${premiumSlots} constructions au prix normal.` : `Le premium allonge la file à ${premiumSlots} constructions au prix normal.`,
          detail: `Puis jusqu’à ${ctx.cfg.premium.maxQueue} en payant ${extraPct} % de plus à chaque construction · dès 30 Adartons`,
        }) %>
      <% } %>
      <p class="border-t border-bronze-800 px-3 py-1.5 text-xs text-parchment-600">
        <% if (ctx.premium && ctx.buildQueueMax > ctx.buildQueueSlots) { %>Premium : <%= ctx.buildQueueSlots %> constructions au prix normal, puis jusqu’à <%= ctx.buildQueueMax %>, chacune <%= extraPct %> % plus chère que la précédente<%= surcharge ? ` (prochaine : +${surcharge} %)` : '' %> ·<% } %>
        Une annulation rembourse <%= Math.round(ctx.cfg.cancelRefund * 100) %> % des ressources (rien pour une démolition) ·
        moins de <%= Math.round(ctx.cfg.freeFinishSeconds / 60) %> minutes restantes : « Terminer » est gratuit.
      </p>
    </section>
  <% } %>

  <% if (tab === 'build') { %>
    <%# Bâtiments : besoins du niveau suivant (bois, argile, fer, durée, population) et bouton de construction. %>
    <section class="<%= ui.panel %> min-w-0">
      <%- panelHead('Bâtiments', `<span class="${ui.headCount}">${available.length} à construire</span>`) %>
      <% if (surcharge && !queueFull) { %>
        <%# File au-delà des emplacements au prix normal (premium) : les coûts de la liste incluent le surcoût. %>
        <p class="flex items-center gap-2 border-b border-bronze-800 bg-gold-400/12 px-3 py-2 text-sm text-parchment-200" role="note">
          <span class="text-gold-200"><%- icon('alert', 'size-4', 2.2) %></span>
          <span>La prochaine construction dépasse les <%= ctx.buildQueueSlots %> emplacements au prix normal : les coûts ci-dessous incluent <strong class="font-semibold text-gold-200">+<%= surcharge %> %</strong>. Survole un coût pour voir le prix normal.</span>
        </p>
      <% } %>
      <%# Défilement horizontal sur écran étroit seulement : au-delà, les info-bulles des bâtiments débordent du tableau. %>
      <div class="overflow-x-auto md:overflow-visible">
        <table class="<%= ui.table %>">
          <thead>
            <tr>
              <th>Bâtiments</th>
              <th colspan="5" class="max-md:hidden">Besoins</th>
              <th class="text-right">Construction</th>
            </tr>
          </thead>
          <tbody>
          <% for (const o of rows) { %>
            <%# data-build-row : ligne mise en avant par une quête du tutoriel (game/tutorial.js). %>
            <tr data-build-row="<%= o.type.id %>">
              <td class="md:min-w-56"><%- nameCell(o, o.current, true) %></td>
              <% if (o.maxed) { %>
                <td colspan="6" class="text-center text-sm text-parchment-500">Bâtiment complètement terminé</td>
              <% } else { const reason = o.blockers[0] || null; %>
                <% const extra = o.surcharge > 1; %>
                <% for (const r of RESOURCES) { const short = o.cost[r.id] > ctx.state.resources[r.id]; %>
                  <td class="whitespace-nowrap tabular-nums max-md:hidden"><span class="inline-flex items-center gap-1.5 <%= short ? 'text-blood-400' : extra ? 'text-gold-200' : '' %>"<%- extra ? ` title="${r.label} : ${num(o.baseCost[r.id])} au prix normal, ${num(o.cost[r.id])} avec le surcoût de la file (+${surcharge} %)"` : '' %>><span><%- resourceIcon(r.id) %></span><%= num(o.cost[r.id]) %></span></td>
                <% } %>
                <td class="whitespace-nowrap max-md:hidden"><%- clock(o.duration) %></td>
                <td class="whitespace-nowrap tabular-nums max-md:hidden"><span class="inline-flex items-center gap-1.5 <%= reason === 'La ferme est trop petite' ? 'text-blood-400' : 'text-parchment-300' %>"><span><%- resourceIcon('pop') %></span><%= num(o.pop) %></span></td>
                <td class="text-right">
                  <% if (extra && !reason) { %>
                    <%# Surcoût de la file : ancien et nouveau coût au survol. %>
                    <span class="mb-1 flex justify-end"><span class="inline-flex items-center gap-1 border border-gold-400 bg-night px-1.5 py-px text-[11px] font-semibold text-gold-200 tabular-nums" title="Surcoût de la file : <%= RESOURCES.map((r) => `${r.label} ${num(o.baseCost[r.id])} → ${num(o.cost[r.id])}`).join(' · ') %>"><%- icon('alert', 'size-3', 2.4) %>+<%= surcharge %> %</span></span>
                  <% } %>
                  <% if (reason === 'La file de construction est pleine' && !ctx.premium) { %>
                    <span class="flex flex-col items-end text-[13px] leading-tight"><span class="text-parchment-500">File pleine</span><a href="<%= premiumHref %>" class="<%= ui.link %> inline-flex items-center gap-1"><%- icon('adarton', 'size-4') %>Agrandir la file</a></span>
                  <% } else if (reason) { %>
                    <span class="text-[13px] text-parchment-500"><%= reason %></span>
                  <% } else if (o.lacksResources) { %>
                    <span class="text-[13px] leading-tight text-parchment-500"><%= resourcesWhen(ctx.state, o.cost, now) %></span>
                  <% } else { %>
                    <form method="post" action="/village/<%= vid %>/build" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="building" value="<%= o.type.id %>">
                      <button class="<%= btn('gold', 'sm', 'min-w-28') %>" data-build-submit><%= o.level === 1 ? 'Construire' : `Niveau ${o.level}` %></button>
                    </form>
                  <% } %>
                  <span class="mt-1 flex flex-wrap justify-end gap-x-3 gap-y-1 text-xs md:hidden"><%- include('partials/cost', { cost: o.cost, pop: o.pop, have: ctx.state.resources }) %><%- clock(o.duration) %></span>
                </td>
              <% } %>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </section>

    <% if (locked.length) { %>
      <section class="<%= ui.panel %>">
        <%- panelHead('Pas encore disponible') %>
        <ul class="grid sm:grid-cols-2 xl:grid-cols-3">
          <% for (const o of locked) { %>
            <li class="flex items-center gap-3 border-b border-bronze-800 px-3 py-2">
              <%- buildingImg(o.type.id, 0, 'h-7 w-8') %>
              <span class="flex min-w-0 flex-col">
                <span class="font-semibold text-parchment-300"><%= o.type.name %></span>
                <span class="text-[13px] text-parchment-500"><%= o.missing.map((m) => `${buildingName(m.building)} niveau ${m.level}`).join(' · ') %></span>
              </span>
            </li>
          <% } %>
        </ul>
      </section>
    <% } %>
  <% } else { %>
    <%# Démolition : un niveau à la fois, gratuite et sans remboursement ; QG niveau 15 et loyauté à 100 %. %>
    <section class="<%= ui.panel %> min-w-0">
      <%- panelHead('Démolition') %>
      <p class="border-b border-bronze-800 px-3 py-2 text-sm text-parchment-400">
        Démolir fait perdre un niveau au bâtiment, sans rendre de ressources ; la population qu'il occupait est libérée.
        Il faut un quartier général de niveau <%= ctx.cfg.demolishMainLevel %> et une loyauté de 100 %.
      </p>
      <div class="overflow-x-auto">
        <table class="<%= ui.table %>">
          <thead><tr><th>Bâtiments</th><th>Durée</th><th class="text-right">Démolition</th></tr></thead>
          <tbody>
          <% for (const o of demolitions) { const reason = o.blockers[0] || null; %>
            <tr>
              <td class="md:min-w-56"><%- nameCell(o, o.current) %></td>
              <td class="whitespace-nowrap"><%- reason === 'Niveau minimal' ? '' : clock(o.duration) %></td>
              <td class="text-right">
                <% if (reason) { %>
                  <span class="text-[13px] text-parchment-500"><%= reason %></span>
                <% } else { %>
                  <form method="post" action="/village/<%= vid %>/demolish" class="inline" data-confirm="Démolir <%= o.type.name %> au niveau <%= o.level %> ?"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="building" value="<%= o.type.id %>">
                    <button class="<%= btn('danger', 'sm', 'min-w-28') %>">Niveau <%= o.level %></button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% } %>
          </tbody>
        </table>
      </div>
    </section>
  <% } %>
    </div>
  </div>
</div>
<%- include('partials/footer') %>
