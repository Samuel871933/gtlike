<%- include('partials/header', { title: 'Messages' }) %>
<div class="flex flex-col gap-5">
  <section class="<%= ui.panel %>">
    <%- panelHead('Messages', `<a href="/village/${ctx.village.id}/messages/new" class="${btn('gold', 'sm')}">${icon('plus', 'size-3.5', 2.4)}Nouveau message</a>`, { tag: 'h1' }) %>
    <% if (!inbox.length) { %>
      <p class="px-4.5 py-4 text-parchment-500">Aucune conversation.</p>
    <% } else { %>
      <ul>
        <% for (const { conversation: c, unread, others } of inbox) { %>
          <li class="border-b border-bronze-700/35 last:border-b-0">
            <a href="/village/<%= ctx.village.id %>/messages/<%= c.id %>" class="group flex min-h-14 items-center gap-3 px-4.5 py-2.5 no-underline transition hover:bg-gold-400/5 <%= unread ? 'bg-gold-400/5' : '' %>">
              <span class="<%= unread ? ui.medallionGold : ui.medallion %> size-9 <%= unread ? '' : 'opacity-70' %>"><%- icon('messages', 'size-4') %></span>
              <span class="flex min-w-0 flex-1 flex-col">
                <span class="truncate transition group-hover:text-gold-200 <%= unread ? 'font-extrabold text-parchment-100' : 'text-parchment-300' %>"><%= c.subject %></span>
                <span class="truncate text-[13px] text-parchment-500">avec <%= others.join(', ') || 'personne' %></span>
              </span>
              <% if (unread) { %><span class="size-2 shrink-0 rounded-full bg-gold-400 shadow-[0_0_6px_var(--color-gold-400)]" title="Non lu"></span><span class="sr-only">Non lu</span><% } %>
              <span class="shrink-0 text-right text-[13px] text-parchment-500 tabular-nums"><%= when(c.lastMessageAt, now) %></span>
            </a>
          </li>
        <% } %>
      </ul>
    <% } %>
    <%- corners() %>
  </section>
</div>
<%- include('partials/footer') %>
