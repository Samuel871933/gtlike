<%- include('partials/header', { title: 'Confirmer l’ordre' }) %>
<%# Confirmation d'une attaque ou d'un soutien, sur le modèle de Guerre Tribale : tableau de l'ordre, troupes en ligne, bouton d'envoi. %>
<% const t = plan.target; const isAttack = plan.type === 'attack'; const vid = ctx.village.id;
   const label = 'w-32 whitespace-nowrap text-parchment-500'; %>
<section class="<%= ui.panel %> mx-auto w-full max-w-3xl">
  <%- panelHead(`${isAttack ? 'Attaque' : 'Soutien'} sur ${t.name}`, `<span class="${isAttack ? ui.tagRed : ui.tagOlive}">${isAttack ? 'Attaque' : 'Soutien'}</span>`, { tag: 'h1' }) %>
  <form method="post" action="/village/<%= vid %>/place/send" class="<%= ui.panelBody %> gap-4"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="x" value="<%= t.x %>">
    <input type="hidden" name="y" value="<%= t.y %>">
    <input type="hidden" name="type" value="<%= plan.type %>">
    <% for (const [id, n] of Object.entries(plan.units)) { %><input type="hidden" name="<%= id %>" value="<%= n %>"><% } %>

    <%# 1. L'ordre. %>
    <table class="<%= ui.tableSm %> border border-bronze-800 sm:max-w-md">
      <thead><tr><th colspan="2" class="text-left"><span class="flex items-center gap-1.5"><span class="<%= isAttack ? 'text-blood-450' : 'text-olive-300' %>"><%- icon(isAttack ? 'attack' : 'support', 'size-3.5', 2.2) %></span>Ordre</span></th></tr></thead>
      <tbody>
        <tr><td class="<%= label %>">Destination</td><td>
          <a href="/village/<%= vid %>/villages/<%= t.id %>" class="<%= ui.link %>"><%= t.name %> <span class="tabular-nums">(<%= t.x %>|<%= t.y %>)</span> <%= continent(t.x, t.y) %></a>
        </td></tr>
        <% if (t.Player) { %>
          <tr><td class="<%= label %>">Joueur</td><td>
            <a href="/village/<%= vid %>/players/<%= t.Player.id %>" class="<%= ui.link %>"><%= t.Player.name %></a> <span class="text-parchment-500 tabular-nums">· <%= num(t.Player.points) %> points</span>
          </td></tr>
        <% } %>
        <tr><td class="<%= label %>">Distance</td><td class="tabular-nums"><%= plan.distance.toFixed(1) %> cases</td></tr>
        <tr><td class="<%= label %>">Durée</td><td class="tabular-nums"><%= duration(plan.seconds) %></td></tr>
        <tr><td class="<%= label %>">Arrivée</td><td class="tabular-nums" data-arrive-in="<%= plan.seconds * 1000 %>" data-arrival-step="<%= ctx.cfg.arrivalStepMs %>"><%= when(plan.arrivesAt, now) %></td></tr>
        <% if (isAttack) { %>
          <tr><td class="<%= label %>">Moral</td><td class="font-semibold tabular-nums"><%= Math.round(plan.morale * 100) %> %</td></tr>
          <% if (ctx.cfg.hasFeature('church')) { %>
            <%# Comme sur GT : force de l'attaque selon la foi du village d'origine (zone d'influence de vos églises). %>
            <tr><td class="<%= label %>">Foi</td><td class="tabular-nums"><span class="font-semibold <%= plan.faith < 1 ? 'text-blood-450' : '' %>"><%= Math.round(plan.faith * 100) %> %</span> <span class="text-parchment-500"><%= plan.faith < 1 ? '· hors de la zone de vos églises' : '· dans la zone de vos églises' %></span></td></tr>
          <% } %>
          <tr><td class="<%= label %>">Butin possible</td><td><span class="flex items-center gap-1.5 tabular-nums" title="Capacité de transport des troupes"><span><%- resourceIcon('storage') %></span><%= num(carry) %></span></td></tr>
        <% } %>
      </tbody>
    </table>

    <%# 2. Les troupes : toutes les unités du monde, celles qui ne partent pas en retrait. %>
    <div class="overflow-x-auto" data-multi-single>
      <table class="<%= ui.tableSm %> border border-bronze-800 [&_td]:px-1 [&_td]:text-center [&_th]:px-1">
        <thead><tr>
          <% for (const u of worldUnits) { const n = plan.units[u.id] || 0; %>
            <th class="text-center" title="<%= u.name %>"><span class="flex justify-center <%= n ? 'text-gold-400' : 'opacity-40' %>"><%- unitIcon(u.id, 'size-4') %></span></th>
          <% } %>
        </tr></thead>
        <tbody><tr>
          <% for (const u of worldUnits) { const n = plan.units[u.id] || 0; %>
            <td class="tabular-nums <%= n ? 'font-semibold text-parchment-100' : 'text-parchment-600' %>" title="<%= u.name %>"><%= num(n) %></td>
          <% } %>
        </tr></tbody>
      </table>
    </div>

    <%# Attaques supplémentaires (comme sur GT) : chaque ajout répartit les troupes restantes entre les lignes ; elles
        partent à la suite et arrivent dans l'ordre, à chainGapMs d'écart au moins (multi-attack dans game.js). %>
    <% if (isAttack) { const multiUnits = worldUnits.filter((u) => available[u.id] > 0); %>
      <div class="flex flex-col gap-3" data-multi-attack data-gap="<%= chainGapMs %>" data-max="<%= maxChained %>"
           data-units="<%= JSON.stringify(multiUnits.map((u) => u.id)) %>"
           data-available="<%= JSON.stringify(Object.fromEntries(multiUnits.map((u) => [u.id, available[u.id] || 0]))) %>"
           data-first="<%= JSON.stringify(plan.units) %>">
        <button type="button" class="<%= ui.link %> flex cursor-pointer items-center gap-1.5 self-start" data-multi-add><%- icon('plus', 'size-3.5', 2.4) %>Ajouter une attaque supplémentaire</button>
        <div class="flex flex-col gap-3" data-multi-panel hidden>
          <div class="overflow-x-auto">
            <%# Seules les unités présentes au village ont une colonne (comme sur GT). Le tableau prend la largeur de son
                contenu et les champs rétrécissent quand il y a beaucoup de colonnes : pas de défilement latéral. %>
            <table class="<%= ui.tableSm %> w-auto! max-w-full border border-bronze-800 [&_td]:px-1 [&_td]:text-center [&_th]:px-1">
              <thead><tr>
                <th class="text-left">Attaques</th>
                <% for (const u of multiUnits) { %><th class="text-center" title="<%= u.name %>"><span class="flex justify-center"><%- unitIcon(u.id, 'size-4') %></span></th><% } %>
              </tr></thead>
              <tbody data-multi-rows>
                <tr>
                  <td class="text-left! whitespace-nowrap text-parchment-400">Troupes disponibles</td>
                  <% for (const u of multiUnits) { const n = available[u.id] || 0; %><td class="tabular-nums <%= n ? 'text-parchment-100' : 'text-parchment-600' %>"><%= num(n) %></td><% } %>
                </tr>
                <tr>
                  <td class="text-left! whitespace-nowrap font-semibold text-parchment-100">Attaque #1</td>
                  <% for (const u of multiUnits) { const n = plan.units[u.id] || 0; %><td class="tabular-nums <%= n ? 'font-semibold text-parchment-100' : 'text-parchment-600' %>"><%= num(n) %></td><% } %>
                </tr>
              </tbody>
              <tfoot><tr>
                <td class="text-left! font-semibold text-parchment-300">Total</td>
                <% for (const u of multiUnits) { %><td class="tabular-nums font-semibold" data-multi-total="<%= u.id %>"></td><% } %>
              </tr></tfoot>
            </table>
          </div>
          <p class="<%= ui.alertError %>" data-multi-error hidden>Pas assez d'unités disponibles.</p>
        </div>
        <template data-multi-row>
          <tr>
            <td class="text-left! whitespace-nowrap"><span class="flex items-center justify-between gap-2"><span class="font-semibold text-parchment-100" data-multi-label></span><button type="button" class="cursor-pointer text-blood-450 hover:text-parchment-100" data-multi-remove aria-label="Retirer cette attaque"><%- icon('close', 'size-3.5', 2.6) %></button></span></td>
            <% for (const u of multiUnits) { %><td><input type="number" min="0" inputmode="numeric" data-unit="<%= u.id %>" class="<%= ui.inputSm %> w-full max-w-16 min-w-10 px-1.5! text-right tabular-nums" aria-label="<%= u.name %>"></td><% } %>
          </tr>
        </template>
      </div>
    <% } %>

    <% if (plan.catapultTarget) { %>
      <label class="<%= ui.label %>">Cible des catapultes
        <select name="catapultTarget" class="<%= ui.inputSm %> w-full sm:w-64">
          <% for (const b of catapultTargets) { %>
            <option value="<%= b.id %>" <%= b.id === plan.catapultTarget ? 'selected' : '' %>><%= b.name %></option>
          <% } %>
        </select>
      </label>
    <% } %>

    <%# 3. Envoi. %>
    <div class="flex flex-wrap items-center gap-2">
      <a href="/village/<%= vid %>/place?<%= new URLSearchParams({ x: t.x, y: t.y, ...plan.units }) %>" class="<%= btn('dark', 'sm') %>"><%- icon('arrowLeft', 'size-3.5', 2.2) %>Modifier</a>
      <%# Focus sur le bouton : Entrée envoie l'ordre (et Entrée sur le formulaire précédent déclenche déjà Attaquer). %>
      <button autofocus data-multi-submit class="<%= btn(isAttack ? 'red' : 'olive', 'sm') %>"><%- icon(isAttack ? 'attack' : 'support', 'size-3.5', 2.2) %><%= isAttack ? 'Attaquer' : 'Soutenir' %></button>
    </div>
  </form>
</section>
<%- include('partials/footer') %>
