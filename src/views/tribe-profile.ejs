<%- include('partials/header', { title: tribe.name }) %>
<%
  const relName = { ally: 'Allié', nap: 'PNA', enemy: 'Ennemi' };
  const relTag = 'inline-flex items-center gap-1.5 border px-2 py-0.5 text-[11px] font-semibold tracking-[0.02em]';
  const relBadge = {
    ally: 'border-rel-ally/60 bg-rel-ally/15 text-rel-ally',
    nap: 'border-rel-nap/60 bg-rel-nap/15 text-rel-nap',
    enemy: 'border-rel-enemy/60 bg-rel-enemy/15 text-rel-enemy',
  };
  // Titres en texte (les capitales des tags sont réservées au tag de la tribu).
  const roleTag = { duke: 'font-semibold text-gold-200', baron: 'font-semibold text-gold-200', member: 'text-parchment-300' };
%>
<section class="<%= ui.panel %>">
  <%- panelHead(tribe.name, `<span class="${ui.tagGold}">${esc(tribe.tag)}</span>`, { tag: 'h1' }) %>
  <div class="<%= ui.panelBody %> gap-4">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex min-w-0 items-center gap-3">
        <span class="<%= ui.medallionGold %> size-[46px] minimal:size-[34px]"><%- icon('tribe', 'size-[22px]') %></span>
        <span class="flex min-w-0 flex-col gap-0.5">
          <span class="<%= ui.kicker %>">Tribu</span>
          <span class="truncate font-display text-[17px] font-semibold text-parchment-100"><%= tribe.name %></span>
        </span>
      </div>
      <dl class="grid grid-cols-3 gap-2 sm:w-[420px]">
        <div class="<%= ui.tile %>"><dt class="<%= ui.tileLabel %>">Points</dt><dd class="<%= ui.tileValue %>"><%= num(points) %></dd></div>
        <div class="<%= ui.tile %>"><dt class="<%= ui.tileLabel %>">Villages</dt><dd class="<%= ui.tileValue %>"><%= num(villages) %></dd></div>
        <div class="<%= ui.tile %>"><dt class="<%= ui.tileLabel %>">Membres</dt><dd class="<%= ui.tileValue %>"><%= members.length %></dd></div>
      </dl>
    </div>
    <% if (tribe.description) { %><p class="border-t border-bronze-900 pt-3 whitespace-pre-line text-parchment-300"><%= tribe.description %></p><% } %>
  </div>
</section>

<div class="grid grid-cols-1 items-start gap-5 xl:grid-cols-[minmax(0,1fr)_392px]">
  <section class="<%= ui.panel %> min-w-0">
    <%- panelHead('Membres', `<span class="text-[13px] font-semibold text-parchment-500 tabular-nums">${members.length}</span>`) %>
    <div class="overflow-x-auto">
      <table class="<%= ui.table %>">
        <thead><tr><th>Joueur</th><th>Titre</th><th class="text-right">Points</th><th class="text-right">Villages</th></tr></thead>
        <tbody>
        <% for (const m of members) { %>
          <tr class="<%= m.id === ctx.village.playerId ? ui.rowActive : '' %>">
            <td class="font-semibold"><a href="/village/<%= ctx.village.id %>/players/<%= m.id %>" class="<%= ui.linkPlain %>"><%= m.name %></a></td>
            <td><span class="<%= roleTag[m.tribeRole] %>"><%= tribeRights.TITLES[m.tribeRole] %></span></td>
            <td class="text-right font-semibold tabular-nums"><%= num(m.points) %></td>
            <td class="text-right tabular-nums"><%= m.villageCount %></td>
          </tr>
        <% } %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="<%= ui.panel %>">
    <%- panelHead('Diplomatie') %>
    <div class="<%= ui.panelBody %>">
      <% if (!relations.length) { %><p class="text-parchment-500">Aucune relation publique.</p><% } %>
      <% for (const r of relations) { %>
        <div class="flex items-center gap-3">
          <span class="<%= relTag %> <%= relBadge[r.type] %> w-20 justify-center"><%= relName[r.type] %></span>
          <a href="/village/<%= ctx.village.id %>/tribes/<%= r.other.id %>" class="<%= ui.linkPlain %> inline-flex min-w-0 items-center gap-2 font-semibold"><span class="<%= ui.tagMuted %>"><%= r.other.tag %></span><span class="truncate"><%= r.other.name %></span></a>
        </div>
      <% } %>
    </div>
  </section>
</div>
<%- include('partials/footer') %>
