<%- include('partials/header', { title: 'Mot de passe oublié', hero: true, lobbyPage: 'login' }) %>
<%- include('partials/landing-hero-start', { cta: { href: '/register', label: 'Jouer gratuitement' }, login: true }) %>
  <h1 class="border-b-2 border-bronze-500 bg-head px-3.5 py-2.5 font-display text-xl font-bold tracking-[0.02em]">Mot de passe oublié</h1>
  <div class="flex flex-1 flex-col gap-2.5 p-3.5">
    <% if (sent) { %>
      <div class="<%= ui.alertSuccess %>">Si un compte utilise cette adresse, un lien de réinitialisation vient de lui être envoyé. Il reste valable une heure.</div>
    <% } else { %>
      <p class="text-sm text-parchment-300">Indique l’adresse e-mail de ton compte : tu recevras un lien pour choisir un nouveau mot de passe.</p>
      <% if (error) { %><div class="<%= ui.alertError %>"><%= error %></div><% } %>
      <form method="post" action="/password/forgot" class="flex flex-col gap-2.5"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="<%= ui.label %>">E-mail
          <input type="email" name="email" value="<%= form.email || '' %>" required autofocus class="<%= ui.input %> h-10 w-full">
        </label>
        <button class="<%= btn('gold', 'lg', 'w-full border-[3px] tracking-[0.02em]') %>">Envoyer le lien</button>
      </form>
    <% } %>
    <div class="mt-auto flex flex-col gap-1.5 border-t border-dashed border-bronze-700 pt-2.5">
      <span class="text-xs text-parchment-500">Tu t’en souviens ?</span>
      <a href="/login" class="<%= btn('dark', 'md', 'w-full border-[3px] tracking-[0.02em]') %>">Retour à la connexion</a>
    </div>
  </div>
<%- include('partials/landing-hero-end') %>
<%- include('partials/footer') %>
