<%- include('partials/header', { title: 'Collecte' }) %>
<% const vid = ctx.village.id; const carry = Object.fromEntries(units.map((u) => [u.id, u.carry])); %>
<div class="flex flex-col gap-5">
<%- include('partials/building-header', { buildingId: 'place', illustration: 'wide' }) %>

<section class="<%= ui.panel %>">
  <%- panelHead('Collecte', include('partials/place-tabs', { placeTab: 'scavenge' })) %>
  <div class="<%= ui.panelBody %>">
    <p class="text-parchment-400">
      Envoyez vos troupes ramasser des ressources aux alentours. Choisissez leur nombre dans une collecte disponible, puis lancez l'expédition.
      Les troupes reviennent seules avec leur butin ; une expédition ne peut pas être rappelée.
    </p>
  </div>
</section>

<section class="<%= ui.panel %>" data-scavenge-selection>
  <%# Modèle d'armée : remplit les quantités (au plus les troupes présentes ; les unités exclues de la collecte sont ignorées). %>
  <% const usable = new Set(units.map((u) => u.id));
     const tplUnits = templates.map((tpl) => ({ id: tpl.id, name: tpl.name, units: Object.fromEntries(Object.entries(tpl.units || {}).filter(([id, n]) => usable.has(id) && n > 0)) }))
       .filter((tpl) => Object.keys(tpl.units).length); %>
  <%- panelHead('Troupes à envoyer', `<span class="flex items-center gap-2 text-[13px]">${tplUnits.length
    ? `<label class="flex items-center gap-2"><span class="text-parchment-300">Modèle</span><select class="${ui.inputSm} h-7 w-44" data-scavenge-template><option value="">Choisir un modèle…</option>${tplUnits.map((tpl) => `<option value="${tpl.id}">${esc(tpl.name)}</option>`).join('')}</select></label>`
    : `<a href="/village/${vid}/place#modeles" class="${ui.link}">Créer un modèle d’armée</a>`}</span>`) %>
  <script type="application/json" data-scavenge-templates><%- JSON.stringify(Object.fromEntries(tplUnits.map((tpl) => [tpl.id, tpl.units]))).replace(/</g, '\\u003c') %></script>
  <div class="overflow-x-auto">
    <table class="w-full min-w-[344px] table-fixed border-collapse text-xs sm:min-w-[576px] sm:text-sm [&_td]:px-0.5 [&_td]:py-1 [&_td]:text-center [&_th]:px-0.5 [&_th]:py-1 [&_th]:text-center sm:[&_td]:px-1.5 sm:[&_th]:px-1.5 [&_tr>th:first-child]:w-14 [&_tr>th:first-child]:text-left sm:[&_tr>th:first-child]:w-24">
      <thead class="bg-thead"><tr class="border-b border-bronze-700/50"><th scope="col" class="font-medium text-gold-400">Unités</th><% for (const u of units) { %><th scope="col" title="<%= nameOf(u) %>"><span class="flex justify-center"><%- unitIcon(u.id, 'size-7') %></span><span class="sr-only"><%= nameOf(u) %></span></th><% } %></tr></thead>
      <tbody>
        <tr class="border-b border-bronze-700/50"><th scope="row" class="font-medium text-gold-400">Quantité</th><% for (const u of units) { const have = ctx.state.units[u.id] || 0; %><td><input type="number" name="<%= u.id %>" min="0" max="<%= have %>" placeholder="0" aria-label="<%= nameOf(u) %> à envoyer" class="<%= ui.inputSm %> mx-auto block h-7 w-9 px-0 text-center text-xs tabular-nums [appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none sm:h-8 sm:w-14 sm:text-sm" <%= have ? '' : 'disabled' %>></td><% } %></tr>
        <tr><th scope="row" class="font-medium text-gold-400"><span class="sm:hidden">Dispo.</span><span class="max-sm:hidden">Disponibles</span></th><% for (const u of units) { const have = ctx.state.units[u.id] || 0; %><td><button type="button" class="cursor-pointer text-xs font-semibold tabular-nums sm:text-sm <%= have ? 'text-gold-400 hover:text-gold-200' : 'text-parchment-700' %>" data-fill="<%= u.id %>" data-max="<%= have %>" aria-label="Sélectionner tous les <%= nameOf(u) %> disponibles"><%= num(have) %></button></td><% } %></tr>
      </tbody>
    </table>
  </div>
</section>

<div class="grid items-stretch gap-4 sm:grid-cols-2 xl:grid-cols-4 [&>*]:min-w-0">
  <% for (const { option, unlocked, unlocking, run } of options) {
       const state = run ? ['En cours', ui.tagGold] : unlocked ? ['Disponible', ui.tagOlive] : unlocking ? ['Déblocage', ui.tagGold] : ['Verrouillée', ui.tagMuted];
       const image = ['/img/scavenge/small.png', '/img/scavenge/medium.png', '/img/scavenge/large.png', '/img/scavenge/massive.png'][option.id - 1] || '/img/scavenge/small.png'; %>
    <section class="<%= ui.panel %> flex flex-col overflow-hidden">
      <div class="relative aspect-[4/3] overflow-hidden border-b-2 border-bronze-500 sm:aspect-[3/4]">
        <img src="<%= image %>" alt="" loading="lazy" decoding="async" class="h-full w-full object-cover object-center <%= unlocked || run ? '' : 'grayscale' %>">
        <% if (!unlocked && !run) { %><span class="absolute inset-0 bg-night/20" aria-hidden="true"></span><span class="absolute top-2 right-2 <%= ui.medallion %> size-9"><%- icon('lock', 'size-5') %></span><% } %>
        <% if (!unlocked && !unlocking && !run) { const why = resourcesWhen(ctx.state, option.unlock.cost, now); %>
          <form method="post" action="/village/<%= vid %>/scavenge/<%= option.id %>/unlock" class="absolute inset-x-2 bottom-2 z-10 flex flex-col gap-1.5 border-2 border-black bg-panel-top/95 p-2 shadow-[inset_0_0_0_1px_var(--color-bronze-500),3px_3px_0_#050505]"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <span class="<%= ui.subLabel %>">Coût de déblocage</span>
            <%- include('partials/cost', { cost: option.unlock.cost, have: ctx.state.resources }) %>
            <span class="inline-flex items-center gap-1 text-xs text-parchment-400 tabular-nums"><%- icon('clock', 'size-3.5') %><%= duration(option.unlock.hours * 3600 / ctx.cfg.speed) %></span>
            <button class="<%= btn('dark', 'sm') %> self-start" <%= why ? 'disabled' : '' %>>Débloquer</button>
            <% if (why) { %><span class="text-xs text-blood-300"><%= why %></span><% } %>
          </form>
        <% } %>
      </div>
      <%- panelHead(option.name, `<span class="${state[1]}">${state[0]}</span>`) %>
      <div class="<%= ui.panelBody %> flex-1">
        <p class="text-sm text-parchment-400">Butin : <strong class="text-gold-200 tabular-nums"><%= Math.round(option.lootFactor * 100) %> %</strong> de la capacité de transport</p>

        <% if (!run) { %>
          <div class="<%= ui.boxGold %> flex flex-col gap-1.5 p-2.5" data-scavenge-preview data-loot="<%= option.lootFactor %>" data-speed="<%= ctx.cfg.speed %>" data-carry='<%= JSON.stringify(carry) %>'>
            <span class="<%= ui.subLabel %>">Butin estimé avec la sélection</span>
            <div class="flex flex-wrap gap-x-3 gap-y-1 text-sm font-semibold tabular-nums text-gold-200" aria-live="polite">
              <% for (const r of ['wood', 'stone', 'iron']) { %>
                <span class="inline-flex items-center gap-1" title="<%= r === 'wood' ? 'Bois' : r === 'stone' ? 'Argile' : 'Fer' %>"><%- resourceIcon(r, 'size-7') %><span data-scavenge-resource="<%= r %>">0</span></span>
              <% } %>
            </div>
            <span class="text-xs text-parchment-400">Durée estimée : <strong class="text-gold-200 tabular-nums" data-scavenge-duration>—</strong></span>
          </div>
        <% } %>

        <% if (run) { %>
          <div class="<%= ui.boxGold %> flex items-center gap-3 p-3">
            <span class="<%= ui.medallionOlive %> size-[38px] minimal:size-[28px]"><%- icon('return', 'size-[19px]', 2.2) %></span>
            <span class="flex min-w-0 flex-1 flex-col">
              <span class="<%= ui.kicker %>">Retour</span>
              <span class="text-parchment-200"><%= when(run.endsAt, now) %></span>
            </span>
            <span class="text-lg font-semibold text-gold-200 tabular-nums" data-countdown="<%= new Date(run.endsAt).getTime() %>"><%= duration((new Date(run.endsAt) - now) / 1000) %></span>
          </div>
          <%- include('partials/units', { units: run.units, losses: null }) %>
          <div class="flex flex-wrap items-center gap-3 border-t border-bronze-900 pt-3"><span class="<%= ui.subLabel %>">Butin prévu</span><%- include('partials/cost', { cost: run.resources, have: null }) %></div>
        <% } else if (unlocked) { %>
          <form method="post" action="/village/<%= vid %>/scavenge/<%= option.id %>/send" class="flex flex-col gap-3" data-scavenge
                data-loot="<%= option.lootFactor %>" data-speed="<%= ctx.cfg.speed %>" data-carry='<%= JSON.stringify(carry) %>'><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <% for (const u of units) { %><input type="hidden" name="<%= u.id %>" value="0"><% } %>
            <div class="mt-auto flex justify-end">
              <button class="<%= btn('gold') %>" data-scavenge-send><%- icon('send', 'size-3.5', 2.2) %>Envoyer</button>
            </div>
          </form>
        <% } else if (unlocking) { %>
          <div class="<%= ui.box %> flex items-center gap-3 p-3">
            <span class="<%= ui.medallion %> size-[38px] minimal:size-[28px]"><%- icon('clock', 'size-[19px]') %></span>
            <span class="flex min-w-0 flex-1 flex-col">
              <span class="<%= ui.kicker %>">Débloquée</span>
              <span class="text-parchment-200"><%= when(unlocking.endsAt, now) %></span>
            </span>
            <span class="text-lg font-semibold text-gold-200 tabular-nums" data-countdown="<%= new Date(unlocking.endsAt).getTime() %>"><%= duration((new Date(unlocking.endsAt) - now) / 1000) %></span>
          </div>
        <% } %>
      </div>
    </section>
  <% } %>
</div>
</div>
<%- include('partials/footer') %>
